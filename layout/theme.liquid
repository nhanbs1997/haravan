<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta http-equiv="content-Type" content="text/html; charset=utf-8" />
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=2.0, user-scalable=0' name='viewport' />
    <meta name="revisit-after" content="1 day" />
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="HandheldFriendly" content="true">
    <link
      rel="shortcut icon"
      href="{{ settings.favicon }}"
      type="image/png" />
    <title>
      {{ page_title | strip_html | escape }}{% if current_tags %}
        &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
      {% if current_page != 1 %}
        &ndash; Page {{ current_page }}{% endif %}
      {% unless page_title contains shop.name %}
        &ndash; {{ shop.name }}{% endunless %}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | strip_html | strip_newlines }}" />{%- endif -%}
    <meta name="keywords" content="{{ shop.name }}">
    <meta name="robots" content="index,follow,noodp">
    <meta http-equiv="x-dns-prefetch-control" content="on">
    <link rel="canonical" href="{{ canonical_url }}" />
    <link
      rel="alternate"
      href="{{ canonical_url }}"
      hreflang="vi-vn" />
    <link rel="dns-prefetch" href="{{shop.url}}">
    <link rel="dns-prefetch" href="//hstatic.net">
    <link rel="dns-prefetch" href="//theme.hstatic.net/">
    <link rel="dns-prefetch" href="//file.hstatic.net/">
    <link rel="dns-prefetch" href="//www.google-analytics.com/">
    <link rel="dns-prefetch" href="//www.googletagmanager.com/">
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <meta name="theme-color" content="#fff">
    <meta http-equiv="Content-Security-Policy" content="block-all-mixed-content">
    <!-- ================= Meta ================== -->
    {% if template contains 'index' %}
      {% if settings.home_page_keywords != '' and settings.home_page_keywords != null %}<meta name="keywords" content="{{settings.home_page_keywords}}" />{% else %}<meta name="keywords" content="{{store.name}}, {{store.domain}}" />{% endif %}
      {% elsif template contains 'product' %}<meta name="keywords" content="{{product.name}}, {%for collection in product.collections%}{{collection.name}}, {%endfor%}{%if product.tags.size > 0%}{% for tag in product.tags %}{{tag}}, {%endfor%}{%endif%}{{store.name}}, {{store.domain}}" />{% elsif template contains 'collection' %}<meta name="keywords" content="{{collection.name }}, {{store.name}}, {{store.domain}}" />{% elsif template contains 'blog' %}<meta name="keywords" content="{{blog.name }}, {{store.name}}, {{store.domain}}" />{% elsif template contains 'article' %}<meta name="keywords" content="{{article.title}}, {{blog.name}}, {%if article.tags.size > 0%}{% for tag in article.tags %}{{tag}}, {%endfor%}{%endif%} {{store.name}}, {{store.domain}}" />{% else %}<meta name="keywords" content="{{page_title}}, {{store.name}}, {{store.domain}}" />{% endif %}
    <meta name="robots" content="noodp,index,follow" />
    {% include 'fb-open-graph-tags' %}
    {%- include 'preload_image' - %}
    {%- include 'head_styles' - %}
    {%- include 'schema' - %}
    <script>
      window.routes = {
        cart_url: '/cart.js',
        cart_add_url: '/cart/add.js',
        cart_update_url: '/cart/change.js',
        cart_clear_url: '/cart/clear.js'
      }
      window.cartStrings = {
          		error: '{{settings.cartStringsError}}',
          		//quantityError: `You can only add [quantity] of this item to your cart.`,
          		delete: '{{settings.cartStringsDelete}}'
          	}
          	window.variantStrings = {
          		addToCart: '{{settings.addToCart}}',
          		soldOut: '{{settings.soldOut}}',
          		avaiable: '{{settings.available}}',
          		unAvailable: '{{settings.unAvaiable}}',
          		allowBuyWhenSoldOut: '{{settings.allowBuyWhenSoldOut}}',
          		noPrice: '{{settings.noPrice}}',
          		giftPrice: '{{settings.giftPrice}}'
          	}
      window.toastString = {
        toastAddSuccessTitle: '{{settings.toastAddSuccessTitle}}',
        toastAddErrorTitle: '{{settings.toastAddErrorTitle}}',
        toastAddSuccessMessage: '{{settings.toastAddSuccessMessage}}',
        toastAddErrorMessage: '{{settings.toastAddErrorMessage}}',
        toastOverAddTitle: '{{settings.toastOverAddTitle}}',
        toastOverAddMessage: '{{settings.toastOverAddMessage}}',
        toastExactMatchTitle: '{{settings.toastExactMatchTitle}}',
        toastExactMatchMessage: '{{settings.toastExactMatchMessage}}',
        toastInventoryExccedTitle: '{{settings.toastInventoryExccedTitle}}',
        toastInventoryExccedMessage: '{{settings.toastInventoryExccedMessage}}',
        toastInventoryUnavaiTitle: '{{settings.toastInventoryUnavaiTitle}}',
        toastInventoryUnavaiMessage: '{{settings.toastInventoryUnavaiMessage}}',
        toastValidatePhoneTitle: '{{settings.toastValidatePhoneTitle}}',
        toastValidatePhoneMessage: '{{settings.toastValidatePhoneMessage}}'
      }
      {%-if settings.use_quick_search-%}
      let searchType = ['product'{%if settings.use_quick_search_article%}, 'article'{%endif%}{%if settings.use_quick_search_page%}, 'page'{%endif%}];
      {%endif%}
      {%if settings.use_gift %}
      {%-for link in linklists[settings.gift_product].links limit:1 -%}
          {% assign giftProduct = link.object%}
      {%-endfor-%}
      const giftString = "{{settings.gift_text}}";
      const giftUnlockString = "{{settings.gift_text_unlock}}";
      const giftMinPrice = {{settings.gift_min_price | default: 0}};
      const giftName = '{{ giftProduct.title }}';
      {%endif%}
    </script>
    <script src="{{'haravanutil.js' | asset_url}}" defer></script>
    {%- unless settings.hrvapp_use -%}
      <script src="{{'cash.min.js' | asset_url}}" defer></script>
    {%- endunless -%}
    <script
      fetchpriority="low"
      src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/6.8.4/swiper-bundle.min.js"
      integrity="sha512-BABFxitBmYt44N6n1NIJkGOsNaVaCs/GpaJwDktrfkWIBFnMD6p5l9m+Kc/4SLJSJ4mYf+cstX98NYrsG/M9ag=="
      defer
      crossorigin="anonymous"
      referrerpolicy="no-referrer"></script>
    {%- if template contains 'addresses' - %}
      <script
        src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.slim.min.js"
        integrity="sha512-6ORWJX/LrnSjBzwefdNUyLCMTIsGoNP6NftMy2UAm1JBm6PRZCO1d7OHBStWpVFZLO+RerTvqX/Z9mBFfCJZ4A=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"></script>
      {{ 'boostrap_min.js' | asset_url | script_tag }}
      <script src="{{'address.js' | asset_url}}"></script>
      <script>
            	new Haravan.CountryProvinceSelector('address_country_new', 'address_province_new', {hideElement: 'address_province_container_new'});
            	{% for address in customer.addresses %}
            	new Haravan.CountryProvinceSelector('address_country_{{address.id}}', 'address_province_{{address.id}}', {hideElement: 'address_province_container_{{address.id}}'});
            	{% endfor %}
      </script>
    {%- elsif template == 'page.intro' - %}
      <script
        src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.slim.min.js"
        integrity="sha512-6ORWJX/LrnSjBzwefdNUyLCMTIsGoNP6NftMy2UAm1JBm6PRZCO1d7OHBStWpVFZLO+RerTvqX/Z9mBFfCJZ4A=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"></script>
      {{ 'boostrapdichvu.js' | asset_url | script_tag }}
    {%- else -%}
      {%- if settings.hrvapp_use -%}
        <script
          src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"
          integrity="sha512-894YE6QWD5I59HgZOGReFYm4dnWc1Qt5NtvYSaNcOP+u1T9qYdvdihz0PPSiiqn/+/3e7Jo4EaG7TubfWGUrMQ=="
          defer
          crossorigin="anonymous"
          referrerpolicy="no-referrer"></script>
        <script src="{{'api.jquery.js' | haravan_asset_url}}" defer></script>
      {%- else -%}
      {%- endif -%}
    {%- endif -%}
    {% unless template contains 'customers[addresses]' %}
      <script
        fetchpriority="low"
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js"
        integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF"
        crossorigin="anonymous"
        defer></script>
    {% endunless %}
    <script src="{{'mew_one.js' | asset_url}}" defer></script>
  </head>
  <body
    id="body_m"
    {% if customer %}
    class="customer-logged-in"
    {% endif %}>
    <div class="page-body">
      <div class="hidden-md hidden-lg opacity_menu"></div>
      <div class="opacity_filter"></div>
      <div id="body_overlay" class="position-fixed d-none"></div>
      <div class="w-100 clearfix">
        {%- include 'header' -%}
        <div class="col-right position-relative{%if settings.slogan_top_ena%} open_slogan{%endif%}">
          <div class="contentWarp {%if template == 'page.arthor'%}pb-5{%endif%}">
            {{ content_for_layout }}
          </div>
          {%- include 'footer' -%}
        </div>
      </div>
      <div onclick="scrollToTop(100);" class="back_top d-flex position-fixed justify-content-center align-items-center">
        <img alt="{{settings.other_backtotop}}" src="{{'to-top-arrow2.png' | asset_url}}">
      </div>
      {%- if template != 'product' - %}
        {%- include 'mew_mobi_bar' - %}
      {%- endif -%}
      <div class="toast-container"></div>
      {% if template contains 'index'%}
      {%- include 'popup_onload' -%}
      {% endif %}
      <div
        class="modal fade"
        id="quickviewModal"
        tabindex="-1"
        role="dialog"
        aria-labelledby="exampleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
          <div class="modal-content pt-4 pt-lg-0">
            <div class="border-0 modal-header p-0 position-relative">
              <button
                type="button"
                class="btn btn-close ml-auto mr-1 position-absolute close"
                data-dismiss="modal"
                aria-label="Close"></button>
            </div>
            <div class="modal-body"></div>
          </div>
        </div>
      </div>
      {%- include 'footer_scripts' - %}
      {%- include 'svg-cache' - %}
      {%- capture capserverHead -%}{{ content_for_header }}{%-endcapture-%}
      {%- assign serverHead = capserverHead -%}
      {%- capture capsrcCombo1 -%}"https://combo-omni.haravan.com/js/script_tag_production.js?v=1576487994026"{%-endcapture-%}
      {%- assign srcCombo1 = capsrcCombo1 -%}
      {%- capture capsrcCombo2 -%}"https://combo-omni.haravan.com/js/script_tag_production.js?v=1576487994026",{%-endcapture-%}
      {%- capture capsrcCombo3 -%},"https://combo-omni.haravan.com/js/script_tag_production.js?v=1576487994026"{%-endcapture-%}
      {%- assign srcCombo2 = capsrcCombo2 -%}
      {%- assign srcCombo3 = capsrcCombo3 -%}
      {%- capture capsrcBuyXY1 -%}"https://buyxgety-omni.haravan.com/js/script_tag_production.js?v=1576487994026"{%-endcapture-%}
      {%- assign srcBuyXY1 = capsrcBuyXY1 -%}
      {%- capture capsrcBuyXY2 -%}"https://buyxgety-omni.haravan.com/js/script_tag_production.js?v=1576487994026",{%-endcapture-%}
      {%- capture capsrcBuyXY3 -%},"https://buyxgety-omni.haravan.com/js/script_tag_production.js?v=1576487994026"{%-endcapture-%}
      {%- assign srcBuyXY2 = capsrcBuyXY2 -%}
      {%- assign srcBuyXY3 = capsrcBuyXY3 -%}
      {%- capture capsrcCombo_final1 -%}"https://combo-omni.haravan.com/js/script_tag_production.js?v=1003"{%-endcapture-%}
      {%- assign srcCombo_final1 = capsrcCombo_final1 -%}
      {%- capture capsrcBuyXY_final1 -%}"https://buyxgety-omni.haravan.com/js/script_tag_production.js?v=1002"{%-endcapture-%}
      {%- assign srcBuyXY_final1 = capsrcBuyXY_final1 -%}
      {%- if settings.promotion_hrvapp_use -%}
        {%- if settings.promotion_hrvapp == 'appcombo' - %}
          {%- capture srcHead -%}{{ serverHead | remove: srcBuyXY2 | remove: srcBuyXY3 }}{%- endcapture -%}
          {{ srcHead }}
        {%- elsif settings.promotion_hrvapp == 'appbuyxgety' - %}
          {%- capture srcHead -%}{{ serverHead | remove: srcCombo2 | remove: srcCombo3 }}{%- endcapture -%}
          {{ srcHead }}
        {%- endif -%}
      {%- else -%}
        {{ serverHead | remove: srcBuyXY2 | remove: srcBuyXY3 | remove: srcCombo2 | remove: srcCombo3 | replace: "type='text/javascript'", "type='mewscript' data-mew-type='text/javascript'" | replace: "script>", "script type='mewscript' data-mew-type='text/javascript'>" }}
      {%- endif -%}
    </div>
    <div id="popsale" class='jas-sale-pop flex pf middle-xs rounded-10 bg-white box_shadow position-fixed'></div>
  </body>
</html>
