//scroll
function scrollTo(targetPosition, callback, duration) {
    const startPosition = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop;
    const distance = targetPosition - startPosition;
    const startTime = performance.now();
    duration = typeof duration === 'undefined' ? 500 : duration;
    function easeInOutCubic(t, b, c, d) {
    if ((t /= d / 2) < 1) return c / 2 * t * t * t + b;
    return c / 2 * ((t -= 2) * t * t + 2) + b;
    }
    function scrollAnimation(currentTime) {
        const elapsedTime = currentTime - startTime;
        const newPosition = easeInOutCubic(elapsedTime, startPosition, distance, duration);
        document.documentElement.scrollTop = newPosition;
        document.body.scrollTop = newPosition;
        if (elapsedTime < duration) {
            requestAnimationFrame(scrollAnimation);
        } else {
            if (callback && typeof callback === 'function') callback();
        }
    }
    requestAnimationFrame(scrollAnimation);
}
function scrollDescription() {
  var scrollPos = window.pageYOffset;
  var fixedTopNavDetail = document.body.classList.contains('fixed_top_nav_detail');
  if (fixedTopNavDetail) {
    scrollPos = window.pageYOffset + 120;
  }
  var positionTabfix = document.getElementById('main_info_details').getBoundingClientRect().top + window.pageYOffset - 40;
  if (scrollPos > positionTabfix) {
    document.getElementById('main_info_details').classList.add("fix");
  } else {
    document.getElementById('main_info_details').classList.remove("fix");
  }

  var scrollingTabList = document.querySelectorAll(".tab-link");
  var h_outscroll = document.getElementById('header-pc').offsetHeight + document.getElementById('box-menu').offsetHeight + 17;
  console.log(h_outscroll);
  for (var i = 0; i < scrollingTabList.length; i++) {
    var wrapperId = scrollingTabList[i].getAttribute("data-category");
    var wrapperTopOffset = document.getElementById(wrapperId).getBoundingClientRect().top + window.pageYOffset;
    if (wrapperTopOffset - scrollPos < h_outscroll) {
      for (var j = 0; j < scrollingTabList.length; j++) {
        scrollingTabList[j].classList.remove("active");
      }
      scrollingTabList[i].classList.add("active");
    }
  }
}

document.querySelectorAll('.tab-link').forEach(function(link) {
  link.addEventListener('click', function(e) {
    e.preventDefault();
    var tabId = this.getAttribute('href');
    var tabTopOffset = document.querySelector(tabId).getBoundingClientRect().top + window.pageYOffset;
    var h_outscroll;
    if (tabId === '#tab-1') {
      h_outscroll = tabTopOffset - document.getElementById('header-pc').offsetHeight - document.getElementById('box-menu').offsetHeight - 20;
    } else {
      h_outscroll = tabTopOffset - document.getElementById('header-pc').offsetHeight - document.getElementById('box-menu').offsetHeight;
    }
    scrollTo(h_outscroll, null, 1000);
  });
});


window.addEventListener('scroll', scrollDescription);

let videos = document.querySelectorAll('.open_popup');
let popupVideo = document.querySelector('.popup_box');
let close_vd = document.querySelectorAll('.close_popup');
videos.forEach(v => v.addEventListener('click', function(e) {
	e.preventDefault();
	popupVideo.classList.add('open');
	bodyOverlay.classList.remove("d-none");
	let bVideoContainer = popupVideo.querySelector('.b_video');
	if (bVideoContainer) {
		bVideoContainer.innerHTML = `<div class="embed-responsive embed-responsive-16by9"><iframe class="embed-responsive-item" src="https://www.youtube.com/embed/${e.target.dataset.video}?enablejsapi=1" allow="autoplay; encrypted-media" allowfullscreen></iframe></div>`;
	}
}));
close_vd.forEach(v => v.addEventListener('click', function(e) {
	e.preventDefault();
	popupVideo.classList.remove('open');
	bodyOverlay.classList.add("d-none");
	let bVideoContainer = popupVideo.querySelector('.b_video');
	if (bVideoContainer) {
		setTimeout(function() {
			bVideoContainer.innerHTML = '';
		}, 500);
	}
}));
