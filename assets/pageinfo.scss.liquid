.bg_info {
	background-image: linear-gradient(var(--bg_info_1), var(--bg_info_2));
}
.big_content {
	font-size: 40px;
	line-height: normal;
}
.main_content {
	.tilte {
		font-size: 18px;
	}
	.des {
		font-size: 16px;
	}
}
.serv-item {
	background: var(--bg_item_serv);
}
.serv_content .title {
	font-size: 30px;
}
.end_content {
	width: 812px;
	margin: 60px auto 100px;
	max-width: 100%;
	font-size: 28px;
}
@media (max-width: 991px) {
	.mobile_info {
		padding: 0;
		width: 100%;
		max-width: initial;
		>.row {margin: 0;
			>.col-12 {
				padding: 0;
				>.col-main {
					border-radius: 0 !important;
				}
			}
		}
	}
}
@media (min-width: 567px) and (max-width: 991px) {
	.bg_info {
		padding-left: 10% !important;
		padding-right: 10% !important;
	}
}
@media (max-width: 767px) {
	.big_content {
		font-size: 32px;
	}
	.main_content {
		.title {
			font-size: 16px;
		}
		.des {
			font-size: 14px;
		}
	}
	.serv_content .title {
		font-size: 24px;
	}
	.end_content {
		margin: 40px auto 80px;
		font-size: 22px;
	}
}
.breadcrumbs .text-white {
	a {color: #fff;}
	.slash-divider svg {
		stroke: #fff;
	}
}
