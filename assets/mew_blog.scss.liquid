.pagination{
	li{
		border-color: transparent;
		.page-link{
			min-width: 38px;
			color: var(--mainColor) !important;
			transition: all 0.3s ease;
			&:hover{
				background: var(--mainColor);
				border-color: var(--mainColor);
				color: #fff !important;
			}
			&:focus {
				box-shadow: 0 0 0 0.2rem var(--mainColor);
			}
		}
		&.active{
			.page-link{
				border-color: var(--mainColor);
				color: var(--mainColor) !important;
			}
		}
	}
}
.top_blog {
  top: 40px;
}
.blog-name {
	font-size: 22px;
}
.title-head {
	font-size: 16px;
	&.big {
		background: var(--mainColor);
		color: #fff;
	}
}
a.title-head.big:hover {
	background: var(--mainColor2);
}
.blog-item-list {
	@media (min-width:768px) {
		margin-bottom: 10px !important; 
	}
	&:last-child {margin-bottom: 0px !important; }
	.blog-item-name {
		font-size:1rem;
	}
}
@media (max-width: 575px) {
	.item_list_index {
		transition: all 0.5s;
		margin-bottom:15px;
		.title_blo {
			line-height: normal;
			font-size:1rem;
			a {
				font-size:1rem;
			}
		}
		.entry-date {
			color: #ffffff;
			top: 10px;
			left: -5px;
			background: var(--mainColor);
			padding: 3px 7px;
			line-height: normal;
			z-index: 9;
			&:after {
				content: '';
				width: 0;
				height: 0;
				border-style: solid;
				border-width: 0 5px 5px 0;
				border-color: transparent var(--mainColor) transparent transparent;
				position: absolute;
				left: 0;
				bottom: -5px;
				filter: brightness(0.7);
			}
			p {
				margin: 0;
				&.day {
					font-size: 1.2rem;
				}
				&.yeah {
					font-size: 0.8rem;
				}
			}
		}
		.sum {font-size:0.95rem;}
	}
}
@media (min-width: 768px) {
	.mew_cate_blogs {
		.swiper-slide {
			width: calc(100%/2.5 - 6px);
			margin-right: 8px;
		}
	}
}
@media (min-width: 992px) {
	.mew_cate_blogs {
		.swiper-slide {
			width: calc(100%/3.2 - 6px);
			margin-right: 8px;
		}
	}
}
@media (min-width: 1200px) {
	.mew_cate_blogs {
		.swiper-slide {
			width: calc(100%/4.2 - 6px);
			margin-right: 8px;
		}
	}
}
@media (max-width: 767px) {
	.mew_cate_blogs {
		.swiper-slide {
			width: calc(100%/1.8 - 4px);
			margin-right: 8px;
		}
	}
}
.mew_blog {
  .mew_blog_p {
    bottom: 0;
  }
}
.blog-list{
	.b_item{
		.item {
			&:nth-child(3n+1) .bg{
				background-color: #fff9fb;
				border: 1px solid #ffc5e2;
			}
			&:nth-child(3n+2) .bg{
				background-color: #FFF9E6;
				border: 1px solid #ffd8b3;
			}
			&:nth-child(3n+3) .bg{
				background-color: #F3FDFE;
				border: 1px solid #c1efff;
			}
			.image{
				width: 3rem;
				height: 3rem;
				min-width: 48px;
				img{
					width: 100%;
					height: 100%;
					object-fit: cover;
					mix-blend-mode: multiply;
				}
				@media (max-width: 566px) {
					width: 36px;
					height: 36px;
					min-width: 32px;
				}
			}
			.text{
				h4{
					font-size: 1rem;
					line-height: 1.5rem;
					margin: 0;
					@media (max-width: 566px) {
						font-size: 14px;
						line-height: normal;
					}
				}
				span{font-size: .75rem;
					line-height: 1rem;}
			}
		}
	}
}
.mb_time {display: none;}
.bg-box {
  background: var(--bgmodule);
}
.bg-sale {
  background: var(--bgSale);
}
@media (max-width: 767px) {
	.item_art:not(.one_item) {
		.custom-article-item {
			display: flex;
			.effect-ming {
				min-width: 30%;
				max-width: 30%;
				margin-right: 10px;
			}
			.custom-article-item_info {
				margin-top: 0 !important;
			}
		}
		.modified {display: none;}
		.mb_time {display: block;}
	}
	.mb_item:last-child {
		margin-bottom: 0 !important;
	}
	.one_item .custom-article-item_info {
		a {font-size: 18px;}
	}
}
@media (min-width: 768px) {
	.two_item .custom-article-item_info {
		a {font-size: 18px;}
	}
	.mb_item:nth-last-child(-n+3) {
		margin-bottom: 0 !important;
	}
}
.title_bar a {
  font-size: 14px;
}
.lastest-articles{
	.large-article:after {
		content: '';
		height: 60%;
		width: 100%;
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgb(0, 0, 0) 100%);
	}
	.large-article-info .title_blo{
		a {
			color: #fff;
			&:hover {
				color: var(--menuHover);
			}
		}
	}
	.list_b-infor h3 {
		font-size: 16px;
		line-height: normal;
		a {
			color: #000;
		}
	}
	.large-article-info{
		color: #fff;
		bottom:0;
	}
	.blog_opa {
		right:20px;
		top:20px;
		padding: 20px;
		background: rgba(255, 255, 255, .8);
		backdrop-filter: blur(20px);
		max-height: calc(100% - 40px);
		overflow-y: auto;
		@media (max-width:767px) {
			background: #fff;
			backdrop-filter: initial;
			position: relative !important;
			right: 0;
		}
		&::-webkit-scrollbar-track{
			-webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.1);
			background-color: #f7f7f7;
			border-radius: 10px;
		}
		&::-webkit-scrollbar{
			width: 0px;
			background-color: #f7f7f7;
		}
		&::-webkit-scrollbar-thumb
		{
			border-radius: 10px;
			background-color: #FFF;
			background-image: -webkit-gradient(linear,
				40% 0%,
				75% 84%,
				from(var(--mainColor)),
				to(var(--mainColor)),
				color-stop(.6,var(--mainColor)))
		}
	}
	.item_list {
		border-bottom: 1px solid #fff;
		&:last-child {
			border-bottom: none;
		}
	}
}
.rte a {
	color: #2196f3;
}
#AjaxinatePagination a {
	font-size: 18px;
	min-width: 180px;
	&:hover {
		color: var(--mainColor);
		box-shadow: 0 0px 2px 0 var(--mainColor),0 0px 6px 0px var(--mainColor);
	}
}