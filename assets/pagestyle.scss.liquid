// page intro

.info_prodject {
	.summary {
		width: 850px;
		max-width: 100%;
		margin: 0 auto;
		font-size: 14px;
	}
	.tit_pr {
		font-size: 18px;
		color: var(--mainColor);
		@media (min-width: 768px) {
			pointer-events: none;
		}
		@media (max-width: 767px) {
			font-size: 16px;
			color: #ffffff;
			display: block;
			background: var(--mainColor);
			border-radius: 6px;
			padding: 5px 40px 5px 15px;
			position: relative;
			&:before,&:after {
				content: '';
				width: 12px;
				height: 2px;
				background: #fff;
				position: absolute;
				top: 50%;
				right: 15px;
				transform: translateY(-50%);
			}
			&:after {
				transform: translateY(-50%) rotate(0deg);
			}
			&.collapsed:after {
				transform: translateY(-50%) rotate(-90deg);
			}
		}
	}
	.line_middle:before {
		content: '';
		width: 1px;
		position: absolute;
		height: calc(100% + 40px);
		background: #fff;
		top: 50%;
		transform: translate(-50%,-50%);
		@media (min-width: 768px) {
			left: 50%;
		}
		@media (max-width: 767px) {
			left: 24px;
		}
	}
	.cir:before {
		content: '';
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: var(--mainColor);
		position: absolute;
		top: 8px;
		@media (min-width: 768px) {
			right: 0;
			display:none;
		}
		@media (max-width: 767px) {
			left: 9px;
			display:block;
		}
		transform: translateX(50%);
	}
	@media (min-width: 768px) {
		.cir-block:before {
			display:block;
		}
	}
}
.intro_block{
