            break;
        case "price-desc":
            selectedSortby = "price_min:desc";
            break;
        case "alpha-asc":
            selectedSortby = "name:asc";
            break;
        case "alpha-desc":
            selectedSortby = "name:desc";
            break;
        case "created-desc":
            selectedSortby = "created_on:desc";
            break;
        case "created-asc":
            selectedSortby = "created_on:asc";
            break;
        default:
            selectedSortby = sort;
            break;
    }
}

