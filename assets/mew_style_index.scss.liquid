.time_box {
	.title img {
		max-height: 23px;
		vertical-align: -2px;
	}
	.countdown-item {
		background: var(--bg_fl_2);
		padding: 5px;
		min-width: 36px;
		border: 2px solid;
	}
	.bg_flash {
		top: 50%;
		transform: translateY(-50%);
		left: 0;
