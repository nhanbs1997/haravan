[data-tab],[data-tab2] {
  [data-pos].active{
  	background: #fff;
    color: var(--mainColor);
    border-color: var(--mainColor) !important;
  }
  [data-pos-content] {
  	display: none;
  	top: 0;
    &.active {
    	display: block;
    	transition: all 0.3s ease;
    }
    img.lazy{
    	visibility: hidden;
    	opacity: 0;
    }
    img.loaded{
    	visibility: visible;
    	opacity: 1;
    	transition: all 0.3s ease-in; 
    }
  }
}
html {
	scroll-behavior: smooth;
}