  }
}
{%endif%}
function updateCartItem(line, quantity, cartClass) {
  let cartContainer = $(cartClass);
	if (cartContainer.length) {
    let item = cartContainer.find(`.number-input input[line="${line}"]`);
    if(quantity > 0){
      item.val(quantity);
      item.parents('.cart__basket__item').find('.price').text(Haravan.formatMoney(quantity*parseInt(item.data('price')), "{%raw%}{{amount}}{%endraw%}₫"));
    } else {
      item.parents('.cart__basket__item').addClass('deleted');
      setTimeout(function(){
        item.parents('.cart__basket__item').remove();
      }, 200);
      $(document).trigger('changeAllCart');
    }
  }
}
function updateAllCartForm(data, cartClass) {
	let cartContainer = $(cartClass);
	if (cartContainer.length && data.length) {
		cartContainer.empty();
    cartContainer.html(data);
		cartWarp.removeClass('d-none');
		cartEmpty.addClass('d-none');
	} else{
		cartWarp.addClass('d-none');
		cartEmpty.removeClass('d-none');
	}
}

function updateCartInfo(data){
	if(data.item_count > 0){
		cartCount.text((data.item_count > 99) ? '99+' : data.item_count).removeClass('d-none')
	} else {
		cartCount.text('').addClass('d-none');
	}
	cartTotal.html(Haravan.formatMoney(data.total_price, "{%raw%}{{amount}}{%endraw%}₫"));
  {%if settings.free_shipping_enable%}
		freeShipping(data.total_price);			
	{%endif%}
}

