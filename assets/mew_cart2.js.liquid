function addToCartCallback(el) {
  setTimeout(function(){ 
    el.prop('disabled', false);
    quickviewModal.hide();
    $('.mobile_open_box_swatch').removeClass('active');
    $('#body_overlay').addClass('d-none');
  }, 400);
}

async function addToCart(e){
	e.preventDefault();
	let $this = $(this);
	$this.prop('disabled', true);
	let dataForm = new FormData($this.parents('form')[0]);
	let serialFormData = MewServices.serializeFormData(dataForm);
  let checkQuantityAvailable = await CheckQuantityUtil.check(parseInt(serialFormData.quantity), parseInt(serialFormData.id), serialFormData.productAlias);
  //console.log(checkQuantityAvailable.status);
  switch(checkQuantityAvailable.status) {
		case 'inStock':
		case 'available':
			dataForm.set('quantity', checkQuantityAvailable.quantity);
			break;
		case 'overAdd':
      dataForm.set('quantity', checkQuantityAvailable.quantity);
  		createToast('error', toastString.toastOverAddTitle, toastString.toastOverAddMessage.replace(/\[sl]/ig, checkQuantityAvailable.quantity));
			break;
		case 'exactMatch':
			createToast('warning', toastString.toastExactMatchTitle, toastString.toastExactMatchMessage);
			dataForm.set('quantity', checkQuantityAvailable.quantity);
			break;
		case 'exceeded':
      createToast('error', toastString.toastInventoryExccedTitle, toastString.toastInventoryExccedMessage);
      break;
		case '404':
      createToast('error', toastString.toastInventoryUnavaiTitle, toastString.toastInventoryUnavaiMessage);
			break;
		default:
	}
  if(['exceeded', '404'].includes(checkQuantityAvailable.status)){
    addToCartCallback($(this));
    return false;
  }
  
	let queryString = new URLSearchParams(dataForm).toString();
  MewServices.addFromForm(queryString).then((res) => {
    if(res.status === 422){
        console.log(res.description)
    } else {
        $(document).trigger('changeAllCart');
        createToast('success', toastString.toastAddSuccessTitle, toastString.toastAddSuccessMessage);  
    }
	}).catch(error => {
		createToast('error', toastString.toastAddErrorTitle, toastString.toastAddErrorMessage);
		console.error('Đã có lỗi xảy ra: ' + error.message);
	}).finally(()=>{
		addToCartCallback($(this));
	});
}

$(document).on('click', '.js-step-qty', function(e){
	e.preventDefault();
	let input = $(this).parents('.number-input').find('input'),
		currentVal = parseInt(input.val()),
		variantId = input.data('variantid');
  let tempQuantity = 1;
	if($(this).hasClass('plus')){
    tempQuantity = currentVal + 1;
	} else {
		tempQuantity = (currentVal - 1 <= 0) ? 0 : currentVal - 1;
	}
  input.val(tempQuantity);
});
