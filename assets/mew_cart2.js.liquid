function freeShipping(price) {
  const minOrderValue = parseInt(document.querySelector('.js-free-shipping').dataset.value) || 0;
  const priceCart = price;
  const progressBar = document.querySelector('.js-free-shipping .progress-bar');
  const freeShippingText = document.querySelector('.js-free-shipping-text');
  const freeShippingIcon = document.querySelector('.js-free-shipping .icon');

  if (priceCart >= minOrderValue) {
    progressBar.style.width = '100%';
    progressBar.classList.remove('progress-bar-striped', 'bg-warning');
    progressBar.classList.add('bg-success', 'progress-bar-striped');

    freeShippingIcon.classList.remove('bg-warning');
    freeShippingIcon.classList.add('bg-success');

    freeShippingText.innerHTML = freeShip; // Assuming `freeShip` is a defined string
  } else {
    const percent = priceCart / minOrderValue * 100;
    progressBar.style.width = `${percent}%`;
    progressBar.classList.remove('bg-success', 'progress-bar-striped');
    progressBar.classList.add('progress-bar-striped', 'bg-warning');

    freeShippingIcon.classList.remove('bg-success');
    freeShippingIcon.classList.add('bg-warning');

    const formattedAmount = Haravan.formatMoney(minOrderValue - priceCart, "{%raw%}{{amount}}{%endraw%}₫").replace(/\s+/g, '');
