$(document).on('changeAllCart', debounce(function(){
	MewServices.getCart().then(res => {
    MewServices.getCartByView('item').then(data => updateAllCartForm(data, '.cart__basket'));
		updateCartInfo(res);
    if(typeof MewGift === 'function'){
			{%if settings.use_gift%}
			gift.updateProgress(giftList, res.total_price/100);
			gift.cartCheck(giftList, res, res.total_price/100);
			{%endif%}
		}
	});
}, 300));
$(document).on('changeCart', debounce(function(){
	MewServices.getCart().then(res => {
		updateCartInfo(res);
		if(typeof MewGift === 'function'){
			{%if settings.use_gift%}
			gift.updateProgress(giftList, res.total_price/100);
			gift.cartCheck(giftList, res, res.total_price/100);
			{%endif%}
		}
	});
}, 300));

let updateCartMultiLines = throttle(function(id, qty){
  MewServices.getCart().then((res) => {
     return res.items.map((v, index) => {
      if(v.variant_id === id){
        return qty
      } else{
        return v.quantity
      }
    });
  }).then(arrQuantity => {
    MewServices.updateLinesItem(arrQuantity).then((res) => {
      $(document).trigger('changeAllCart');
    });
  });
}, 800);
let updateCartByLine = throttle(function(line, qty){
  MewServices.updateLineItem(line, qty).then((res) => {
    updateCartItem(line, qty, '.cart__basket')
    $(document).trigger('changeCart');
  });
}, 800);

$(document).on('click', '.js-step-qty', debounce(async function(){
  let input =  $(this).parents('.js-number-input').find('input');
  let line = parseInt(input.attr('line'));
  let quantity = parseInt(input.val());
  let id = parseInt(input.attr('data-variantid'));
  let checkQuantityAvailable = await CheckQuantityUtil.check(quantity, id);
  switch(checkQuantityAvailable.status) {
		case 'inStock':
		case 'available':
			break;
		case 'overAdd':
  		createToast('error', toastString.toastOverAddTitle, toastString.toastOverAddMessage.replace(/\[sl]/ig, checkQuantityAvailable.quantity));
			break;
		case 'exactMatch':
			createToast('warning', toastString.toastExactMatchTitle, toastString.toastExactMatchMessage);
			break;
		case 'exceeded':
      createToast('error', toastString.toastInventoryExccedTitle, toastString.toastInventoryExccedMessage);
      break;
		case '404':
      createToast('error', toastString.toastInventoryUnavaiTitle, toastString.toastInventoryUnavaiMessage);
      return false;
			break;
		default:
	}
  updateCartByLine(line, checkQuantityAvailable.quantity);
}, 500));
$(document).on('click', '.js-remove-item-cart', function(e){
	e.preventDefault();
	let variantId = parseInt($(this).data('variantid'));
	MewServices.updateItem(variantId, 0).then(() =>{
		let variantItem = $(`.variantId-${variantId}`);
		variantItem.addClass('deleted');
		setTimeout(function(){
			variantItem.remove();
		}, 200);
		$(document).trigger('changeAllCart');
	})
});

