.sale-label {
  top: 0px;
  right: 0px;
  color: #ffffff;
  background: var(--accentColor2);
  padding: 2px 4px;
  z-index: 2;
  font-size: 12px;
  border-radius: 3px 10px;
  border: 1px solid #fff;
}
.wishlist-btn {
  left: 5px;
  top: 5px;
  z-index: 2;
  padding: 2px;
  border: 2px solid var(--mainColor);
  background: #fff;
  transition: all .4s;
  position: relative;
  svg {
    fill: var(--mainColor);
    transition: all .4s;
  }
  &:hover {
    background: #fff;
  }
  &.added {
    background: var(--mainColor);
    svg {
      fill: #fff;
    }
  }
  &.loading{
    pointer-events: none;
    &:after{
      content: '';
      box-sizing: border-box;
      position: absolute;
      top: 50%;
      left: 50%;
      width: 20px;
      height: 20px;
      margin-top: -10px;
      margin-left: -10px;
      border-radius: 50%;
      border: 2px solid #ccc;
      border-top-color: var(--mainColor);
      animation: spinner .6s linear infinite;
    }
    svg{
      opacity: 0;
      visibility: hidden;
    }
  }
  &.added.loading{
    &:after{
      border: 2px solid var(--mainColor);
      border-top-color: #ccc;
    }
  }
}
@keyframes spinner {
  to {transform: rotate(360deg);}
}
#wishlist-container{
	transition: all 0.3s ease;
	&.loading{
		pointer-events: none;
		opacity: 0.75
	}
