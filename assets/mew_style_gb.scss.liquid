.btn-primary{
	transition: all 0.5s;
	color:#fff;
	background-color: var(--mainColor);
	border-color: var(--mainColor);
	&:hover,&:active,&:not(:disabled):not(.disabled):active,&:not(:disabled):not(.disabled):active:focus {
