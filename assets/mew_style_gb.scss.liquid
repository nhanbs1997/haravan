		border-radius: 50%;
		height: 1pc;
		width: 1pc;
		left: -4px;
		top: -4px;
		animation: pulsate 1s ease-out;
		animation-iteration-count: infinite;
		opacity: 0;
	}
	.circle {
		width: 8px;
		height: 8px;
		background-color: var(--mainColor);
		background-color: var(--mainColor);
		border-radius: 50%;
		top: 0;
		left: 0;
	}
}
@keyframes pulsate{
	0% {
		-webkit-transform: scale(.1);
		opacity: 0;
	}
	50% {
		opacity: 1;
	}
	100% {
		-webkit-transform: scale(1.2);
		opacity: 0;
	}
}
