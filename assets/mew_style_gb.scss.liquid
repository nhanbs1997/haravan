.product-item {
  transition: 0.4s all;
  &:hover {
    box-shadow: 0px 0px 5px 0px #ccc;
  }
	.item-info {
    @media(max-width: 991px){
      position: static !important;
    }
		.item-title {
			a {
				color: var(--textColor);
				transition: 0.4s color;
				font-size: 14px;
				&:hover {
					color: var(--mainColor);
				}
			}
		}
		&.small .item-title a{
			font-size: 14px;
		}
		.action {
			clear: both;
			padding: 3px 10px;
			border: 1px solid var(--mainColor);
			border-radius: 20px;
			min-width: 120px;
			backdrop-filter: blur(4px);
			transition: 0.4s all;
			color:var(--mainColor);
			&:hover {
				color: #fff;
				background:var(--mainColor);
				i.right_icon { 
					transform: rotate(270deg);
				}
			}
		}
	}
	&:hover .item-info {
		bottom:0;
	}
	.product-item_form{
		top: -45px;
		right: 5px;
    @media(max-width: 991px){
      top: initial;
  		right: 0px;
      bottom: 0px;
    }
		@media(min-width: 992px){
			transform: translateX(100%);
			opacity: 0;
			visibility: hidden;
			transition: 0.3s all ease;
		}
		.btn{
			min-width: 40px;
			height: 40px;
			background: var(--mainColor);
      border: 2px solid #fff;
			&:hover {
				background: var(--mainColor2);
			}
			&.s_out {
				background: #b5b5b5;
				position: relative;
				&:before {
					content: '';
					position: absolute;
					width: 1px;
					height: 100%;
					top: 0;
					left: 50%;
					bottom: 0;
					background: #fff;
					transform: translateX(-50%) rotate(45deg);
				}
			}
		}
		svg{
			fill: #fff;
		}
	}
	@media(min-width: 992px){
		&:hover{
			.product-item_form{
				transform: translateX(0);
				opacity: 1;
				visibility: visible;			
			}
		}
	}
}
