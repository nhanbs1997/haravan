      border-color: transparent transparent #FFFFFF transparent;
      transform: rotate(0deg);
      position: absolute;
      top: -10px;
      right: 30px;
    }
  }
  &:hover .popup-free-ship {
    opacity: 1;
    top: calc(100% + 10px);
    visibility: visible;
  }
}
