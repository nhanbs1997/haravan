	-ms-flex-wrap: unset;
	flex-wrap: unset;
}
.text-main {color:var(--mainColor);}
.navigation-block {
	min-width: calc(100% - 145px);
	background: var(--navColor);
}
.col-left {
	@media (min-width: 991.99px) {
		background: linear-gradient(90deg,var(--mainColor),var(--mainColor2));
	}
}
.col-left{
	transition: all 0.5s ease;
	z-index: 10;
	top: 0 !important;
	@media (max-width: 991.98px) {
    position: fixed !important;
		top: initial !important;
		bottom: 65px !important;
		background: var(--leftColBackground);
		width: var(--menuWidth);
		left: -100%;
		border-radius: 10px;
		overflow: hidden;
		@media (orientation: portrait) {
			max-height: calc(100vh - 220px);
		}
		@media (orientation: landscape) {
			max-height: calc(100vh - 67px);
			&.active{box-shadow: 0 0px 0px 0 #fff, 0 0px 3px 0px #fff;}
		}
		&.active{
			left: 10px;
		}
	}
}
.col-mobile{
	transition: all 0.5s ease;
	height: calc(100% - 65px);
	z-index: 11;
  bottom: 65px !important;
  background: var(--leftColBackground);
  width: var(--menuWidth);
  left: -100%;
  border-radius: 10px;
  overflow: hidden;
  @media (orientation: portrait) {
    max-height: calc(100vh - 220px);
  }
  @media (orientation: landscape) {
    max-height: calc(100vh);
    &.active{box-shadow: 0 0px 0px 0 #fff, 0 0px 3px 0px #fff;}
  }
  @media (min-width: 992px) {
    height: calc(100% - 20px);
    max-width: calc(320px + 103px);
    bottom: 10px !important;
  }
  &.active{
    left: 10px;
  }
}
.mb_logo {max-height: 40px;max-width: 40px;}
.menu_mobile{
	box-shadow: 0px 0px 2px 0px #ccc;
	@media (orientation: landscape) {
		width: 104px;
	}
	#menu-mew{
		overflow: scroll;
		transition: 0.5s all;
		background:#fff;
		z-index:1;
  	&::-webkit-scrollbar-track{
  		-webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.1);
  		background-color: #f7f7f7;
  		border-radius: 10px;
  	}
  	&::-webkit-scrollbar{
  		width: 4px;
  		background-color: #f7f7f7;
  	}
  	&::-webkit-scrollbar-thumb {
  		border-radius: 10px;
  		background-color: var(--mainColor);
  	}
		@media (orientation: portrait) {
			display: flex;
			height: 100px;
			margin-top: calc(100vh - 320px) !important;
      border-top: 1px solid var(--mainColor);
      overflow-y: hidden;
		}
		@media (orientation: landscape) {
			height: 100%;
      overflow-x: hidden;
		}
		.main {z-index: 2;top:0;}
		.level0{
			@media (orientation: portrait) {
				border-right: 1px solid #f2f2f2;
			}
			@media (orientation: landscape) {
				border-bottom: 1px solid #f2f2f2;
			}
			border-top: 0 !important;
			>a{
				line-height: 1.2;
				font-size: 12px;
				color: #333;
				display: table-cell;
				width: 100px;
				vertical-align: middle;
				img{
					pointer-events: none;
					max-width: 45px;
				}
				span {
					height: calc(14px * 2);
					line-height: normal;
					pointer-events: none;
				}
			}
			.lv1{
				top: 0;
				overflow: scroll;
				opacity: 0; 
				z-index: -1;
				@media (orientation: portrait) {
					width: 100%;
					height: calc(100% - 100px);
					left:0%;
				}
				@media (orientation: landscape) {
					width: calc(100vw - 121px);
          max-width: 320px;
					left: 100%;
					height: 100%;
          background: #fff;
          overflow-x: hidden;
				}
				&.waring {opacity: 1;}
			}
			.lv2 {
				.level2:before {
					position: absolute;
					content: '';
					width: 6px;
					height: 6px;
					border-radius: 50%;
					top: 17px;
					left: 11px;
					background: var(--mainColor);
				}
			}
			&.open{
				.lv1{
					opacity: 1; 
					transition: 0.3s ease;
					z-index: 1;
					.level1{
						list-style: none;
					}
				}
				>a{
					color: #fff;
					background: var(--mainColor);
				}
			}
		}
		&.no_waring .waring {display:none;}
	}
}
