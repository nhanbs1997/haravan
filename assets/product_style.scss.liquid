.gradient-load {
	//background: linear-gradient(var(--mainColor), var(--mainColor2));
}
.product-name {
	font-size: 20px;
	@media (max-width: 767px) {
		font-size: 16px;
	}
	vertical-align: 2px;
}
.vendor {font-size: 16px;}
.product-summary {
	img,iframe {
		display: none;
	}
}
.product-main-slide {
	.shadow_product {
		filter: drop-shadow(10px 10px 8px rgba(0,0,0,0.2));
		border-radius: 15px;
	}
}
.arrow_main_slide {
	.swiper-button-next,.swiper-button-prev {
		top: 50% !important;
	}
	.swiper-button-next.swiper-button-disabled, .swiper-button-prev.swiper-button-disabled {
		display: none;
	}
	.swiper-button-next, .swiper-button-prev{
		width: 30px;
		height: 60px;
		display: flex;
		justify-content: center;
		align-items: center;
		background: #f7f7f7;
		box-shadow: 0 0 4px 0 rgba(0,0,0,.2);
		color: #707070;
		top: 50%;
		transform: translateY(-50%);
		margin: 0;
		transition: .3s;
		outline: none;
		opacity: .9;
		&:after{
			font-size: 20px;
			color: #333;
		}
		&:hover:after {color: var(--mainColor);}
	}
	.swiper-button-next{
		border-radius: 5px;
		right: 8px;
	}
	.swiper-button-prev{
		border-radius: 5px;
		left: 8px;
	}
}
.product-layout_col-left {
	position: relative;
}
.product-layout_col-right {
	.haravan-product-reviews-badge {
    p {margin:0;}
    .hrv-product-reviews-star i {
      font-size: 13px;
    }
  }
}
.avatar {
    min-width: 30%;
    max-width: 30%;
}
.btn-shopee {
  svg {
    vertical-align: -1.5px;
  }
}
.product-thumb-slide {
	padding:0px;
	.swiper-slide {
		width: calc(25% - 7.5px);
		margin-right: 10px;
		border: 2px solid #dee2e6;
		background: #fff;
		transition: all 0.3s;
	}
	.swiper-pagination {
		position: relative;
		bottom: 0;
	}
}
.m_thumb_pl{
	&:hover,&.swiper-slide-thumb-active{
		border: 2px solid var(--mainColor) !important;
	}
}
.product-action{
	&_buy{
		background: #fff;
		border:2px solid var(--mainColor);
		color: var(--mainColor);
		transition: all 0.3s;
		svg{
			fill: var(--mainColor);
			transition: all 0.3s;
		}
		&:hover {
			background: var(--mainColor);
			color: #fff;
			svg{
				fill: #fff;
			}
		}
		.button__text {white-space: pre-wrap;min-width: 100px;}
	}
	&_buynow {
		/*background: linear-gradient(var(--mainColor2),var(--mainColor));*/
    background: #e31836;
		transition: all 0.5s;
	}
}
@media (min-width:992px) {
	.olp {
		position: sticky !important;
		top: 5px;
	}
}
.product-price{
	.special-price{
		font-size: 34px;
		color: var(--accentColor2);
    //text-shadow: 1px 1px 0 #fff, -1px -1px 0 #fff, 1px -1px 0 #fff, -1px 1px 0 #fff, 3px 3px 5px #666666;
		@media (max-width: 991px) {
			font-size: 24px;
		}
	}
	.old-price{
		font-size: 18px;
		@media (max-width: 991px) {
			font-size: 14px;
		}
		color: var(--accentColor1);
	}
}
.sale_label {
	background: var(--mainColor);
	//display: inline-flex;
	color: #fff;
	justify-content: center;
	align-items: center;
	z-index: 1;
	.nb_dis {
		font-size: 16px;
		font-weight: 700;
	}
	@media (max-width: 767px) {
		font-size: 10px;
    white-space: nowrap;
		.nb_dis {
			font-size: 12px;
		}
	}
}
.custom-btn-number{
	button{
		width: 38px;
		height: 38px;
		transition: all 0.3s ease;
		color: var(--mainColor);
		svg {
			fill: var(--mainColor);
			min-width: 14px;
		}
		&:hover{
			border-color: var(--mainColor) !important;
		}
		&:focus{
			outline: none
		}
		&.disabled{
			cursor: not-allowed;
			pointer-events: none;
			opacity: 0.5
		}
	}
	input{
		max-width: 80px
	}
}
.product-control .header {
	font-size: 16px;
}
.view_more_pr {
	svg {
		stroke: var(--btnBuy);
	}
	a:hover {
		color: var(--btnBuy);
		text-decoration: underline;
	}
}
.product-summary {
	ol {
		padding-left: 20px;
	}
}
.mew-product-review-details{
	padding-top: 40px;
	#box-menu {
		top: 0px !important;
		margin-top: -40px;
	}
	&.fix{
		#box-menu {
			position: fixed !important;
			margin-top: 0px;
			top: 85px !important;
			z-index: 9;
			box-shadow: 0px 2px 5px 0px rgba(0,0,0,0.1);
			width: 100%;
			left: 0;
			background: #fff;
			@media(max-width: 767px){
				top: 57px !important;
			}
		}
	}
	.content-tab{
		display: flex;
		align-items: center;
		align-content: space-between;
		flex-wrap: nowrap;
		overflow-x: auto !important;
		justify-content: left;
		a{
			border-bottom: 3px solid #fff;
			flex-basis: unset;
			width: auto;
			white-space: nowrap;
			@media(max-width: 767px){
				padding: 5px 10px !important;
			}
			&.active{
				border-bottom: 3px solid var(--accentColor2);
        color: var(--accentColor2);
			}
		}
	}
}
.rte{
	a{
		color: var(--mainColor);
		&:hover {
			filter: brightness(0.7);
		}
	}
	table {
		width: 100%;
		border-collapse: collapse;
		border: 1px solid #d3d3d3;
		margin-bottom: 25px;
		td,th {
			border: solid #dbdbdb;
			border-width: 0 0 1px;
			padding: 0.5em 0.75em;
			vertical-align: top;
		}
	}
}
.title-header,.title-review {
    font-size: 20px;
    color: var(--mainColor);
}
.table-striped tbody tr:nth-of-type(even) {
	background: #f9f9f9;
}
.special-content{
	max-height: 366px;
	line-height: 1.3;
	&_title{
		font-size: 18px;
	}
	table, td{
		border: none;
		margin-bottom: 0;
	}
	table td:first-child {
		width: 115px;
	}
	h4 {
		font-size: 14px;
		font-weight: bold;
		color: var(--mainColor);
		padding: 12px;
		margin-bottom: 0;
	}
	p {padding: 10px;margin-bottom:0;}
}
.view_table,.expandable-content-toggle,.view_mores a {
	font-size: 15px;
	&:hover {
		box-shadow: 0 0px 2px 0 var(--mainColor),0 0px 6px 0px var(--mainColor);
	}
}
@media (min-width:1200px) {
	.psky {
		position: sticky;
		top:0;
	}
}
.top_product {
    top: 90px;
}
.product-info {
    display: grid;
    grid-auto-columns: 1fr;
    grid-template-columns: 1fr 1fr;
    gap: 8px 8px;
	.right_icon {
		left: 0;
		right: initial;
		top: 9px;
	}
}
.linehot_pro {
	img {
		max-width: 40px;
		width: 100%;
	}
	.b_cont a {
		font-size: 20px;
		color: var(--mainColor);
		&:hover {
			color: #00b907;
		}
	}
}
/*====================================*/

.js-learn-more-link{
	color: var(--mainColor);
	&:hover {
		filter: hue-rotate(90deg);
	}
}
#videoModal{
	.modal-header{
		border-color: var(--accentColor1);
	}
	.modal-title{
		color: var(--mainColor);
	}
	.close{
		color: #000;
		text-shadow: none;
		outline: none;
	}
}
.openvideo{
	bottom: 5px;
	left: 5px;
	z-index: 99;
	border: 2px solid var(--mainColor);
}
input::-webkit-outer-spin-button,
input::-webkit-inner-spin-button {
	-webkit-appearance: none;
	margin: 0;
}
input[type='number'] {
	-moz-appearance:textfield;
}
.list_pr_tag {
	.b_pr {
		.item {
			@media (min-width:568px) {
				max-width: calc(100%/3 - 16px);
			}
			@media (max-width:567px) {
				max-width: calc(100%/2 - 8px);
			}
			a {
				border: 1px solid #ccc;
				.price_pr {
					color: #cc0101;
				}
				.ratio {
					width: 12px;
					height: 12px;
					display: inline-block;
					border: 1px solid #ccc;
					border-radius: 50%;
					margin-right: 5px;
					vertical-align: -1px;
				}
			}
			&.active,&:hover { 
				a {
					border: 1px solid var(--mainColor);
					background: #fffaeb;
					.ratio {
						background-image: url({{'check.png' | asset_url}});
						background-repeat: no-repeat;
						background-size: 100%;
						background-position: center;
						border: none;
					}
				}
			}

		}
	}
}

.free-gifts {
	border: 1px solid var(--mainColor);
	padding-bottom: 5px !important;
	.vmore_c {
		left: 0;
		bottom: 0px;
		border-top: 1px solid var(--mainColor);
		background: #fff;
		padding: 7px 0;
		border-bottom-left-radius: 10px;
		border-bottom-right-radius: 10px;
	}
	@media (max-width: 767px) {
		padding-bottom: 40px !important;
		.none_mb {
			visibility: hidden;
			transform: rotateX(90deg);
			transition: margin 0.8s;
			margin-top: -92px;
			&.open_gift {
				visibility: visible;
				transform: rotateX(0deg);
				margin-top: 0;
				transition: margin 0.5s, transform 0.5s;
			}
		}
		.v_more_coupon{color: var(--mainColor);}
	}
	legend {
		img {
			max-width: 23px;
			mix-blend-mode: multiply;
			vertical-align: -3px;
		}
		width: auto;
		color: var(--mainColor);
		font-weight: 600;
		border-radius: 20px;
		border: 1px solid;
		font-size: 18px;
	}
	.item {
		line-height: normal;
		.m_copy {
			background: var(--mainColor);
			border-radius: 15px;
			border: 1px solid;
			&:hover {
				background: #fff;
				color: var(--mainColor) !important;
			}
		}
		.line_b {
			border-bottom: 1px dashed #ff6307;
		}
		&:last-child {
			.line_b {
				border-bottom: none;
				margin-bottom: 0 !important;
				padding-bottom: 0 !important;
			}
		}
	}
}
.rte {
	h2 {
		border-left: 2px solid var(--textColor);
		padding-left: 10px;
		color: var(--textColor);
		font-size: 20px;
		margin-bottom: 10px;
	}
	h3 {font-size: 18px;}
	h4 {font-size: 16px;}
	h5 {font-size: 14px;}
	h6 {font-size: 12px;}
}
.selector-wrapper{
	margin-bottom: .5rem;
	label{
		min-width: 100px;
		font-size: 13px;
		margin-bottom: .5rem;
		font-weight: 700;
	}
}
.mobile_open_box_swatch {
  bottom: -100%;
	&.active {
		position: fixed;
		bottom: 0;
		background: #fff;
		z-index: 11;
		width: calc(100%);
		left: 0;
		padding: 15px 10px 65px 10px;
		border-radius: 20px 20px 0 0;
		box-shadow: 0px 0px 3px 0px #ccc;
		transition: 0.5s all;
	}
}
.more_views {
	&:hover {
		color: var(--btnBuy);
		text-decoration: underline;
	}
	svg {
		stroke: var(--btnBuy);
		vertical-align: -1px;
	}
}
.line_bottom {
	position: relative;
	@media (min-width: 992px) {
		padding-bottom: 30px;
		margin-bottom: 30px;
		&:after {
			content: '';
			position: absolute;
			width: calc(100% - 20px);
			height: 1px;
			background: var(--btnBuy);
			bottom: 0;
			left: 50%;
			transform: translateX(-50%);
		}
	}
}
.hrv-product-reviews-summary {
    background: #fffbed;
    border-radius: 10px;
    margin-bottom: 20px;
    @media (max-width: 991px) {
      width: 40% !important;
    }
    @media (max-width: 767px) {
      width: 100% !important;
    }
}
.product-reviews-summary-actions {margin-bottom: 10px;}
@media (max-width: 991px) {
  .hrv-product-reviews-form {
    width: 100% !important;
  }
}
#btnnewreview,#btnSubmitReview {
    margin-top: 0 !important;
    background: var(--mainColor) !important;
    border-radius: 10px;
    font-weight: bold;
}
#hrv-product-reviews-list>div {
  padding: 15px 0 !important;
}
.hrv-product-reviews-form {
  fieldset {padding: 0 !important;margin: 10px 0;}
  h3,fieldset label {
    display: none;
  }
  fieldset#hrv_product_reviews_form_fieldset_rate {
    display: flex;
    label {display:block;margin-right:10px;}
  }
  input, textarea {
    border-radius: 10px;
  }
}
.simple-pagination li {
	padding: 0 4px;
	.next,.prev {
		font-size: 32px;
		color: var(--mainColor);
	}
}
#specModal{
	@media (min-width: 992px) {
		.modal-lg {
			max-width: 600px;
		}
	}
	.special-content{
		h4 {font-size: 16px;padding: 12px 0;}
		max-height: initial;
		@media(max-width: 767px){
			border: none !important;
		}
		table {
			background: #f9f9f9;
			border-radius: 10px;
			overflow: hidden;
			td:first-child{
				@media(min-width: 768px){
					width: 220px;
				}
			}
		}
	}
	.max-height-popup {
		max-height: calc(100vh - 150px);
		overflow-y: auto;
		&::-webkit-scrollbar-track{
			-webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.1);
			background-color: #f7f7f7;
			border-radius: 10px;
		}
		&::-webkit-scrollbar{
			width: 3px;
			background-color: #f7f7f7;
		}
		&::-webkit-scrollbar-thumb {
			border-radius: 10px;
			background-color: #FFF;
			background-image: -webkit-gradient(linear,
				40% 0%,
				75% 84%,
				from(var(--mainColor)),
				to(var(--mainColor)),
				color-stop(.6,var(--mainColor)))
		}
	}
}
@media (max-width:374px) {
	.mxs_100 {
		flex-direction: column;
		.product-action_buy {
			flex-direction: row !important;
			font-size: 20px;
		}
	}
}
@media (min-width: 992px) {
	.relate_product { 
		.swiper-slide {
			width: calc(100%/2 - 7.5px);
			margin-right: 15px;
		}
	}
}
@media (min-width: 1200px) {
	.relate_product { 
		.swiper-slide {
			width: calc(100%/3 - 10px);
			margin-right: 15px;
		}
	}
}
.mew_mobi_bar {
	.item {
		width: 20%;
	}
	.product-action_buynow {
		min-width: initial;
		width: calc(40% - 8px);
		border-radius: 10px !important;
		margin: 0 10px 12px;
	}
}
.js-tag-blog .item_grid.index .cont h3 {
	line-height: normal;
	a {
		font-size: 16px;
	}
}
.js-buy-alert{
	@media (max-width: 767px){
		top: auto !important;
		bottom: 65px;
		right: 10px;
	}
}
.title_blo a {
    font-size: 14px;
    font-weight: normal;
}
.box-promotion {
  border: 1px solid #fee2e2;
  border-radius: 10px;
  overflow: hidden;
  .promo-head {
    background-color: #fee2e2;
    color: #d70018;
  }
  .promo-content {
    ul,ol {
      padding-left: 20px;
      margin-bottom: 0;
    }
  }
}
a.bg-primary-contact {
    background: #3E9F57 !important;
}
