.main-container {padding:0 0 20px;}
.collection-name {
	font-size: 17px;
}
@media (max-width: 575px) {
	.banner_collection { 
		.swiper-slide {
			width: calc(100%/1.3 - 5px);
			margin-right: 10px;
		}
	}
}
@media (min-width: 576px) {
	.banner_collection { 
		.swiper-slide {
			width: calc(100%/1.5 - 5px);
			margin-right: 10px;
		}
	}
}
@media (min-width: 992px) {
	.banner_collection { 
		.swiper-slide {
			width: calc(100%/2 - 5px);
			margin-right: 10px;
		}
	}
}
@media (min-width: 1200px) {
	.banner_collection { 
		.swiper-slide {
			width: calc(100%/3 - 10px*2/3);
			margin-right: 10px;
		}
	}
}
.special-content_title {
    font-size: 18px;
}
.sortPagiBar {
	@media(max-width: 1199px){
		overflow: auto;
		white-space: nowrap;
		will-change: transform
	}
	.filter-item label {
		cursor: pointer;
	}
	.filter-sort {
		input{
			+.fa2 {
				@media (max-width: 425px) {
					font-size: 12px;
				}
				@media (max-width: 356px) {
					font-size: 11px;
				}
				transition: all 0.4s;
			}
			&:checked + .fa2,&:hover + .fa2{
				color: var(--mainColor);
				&:before {opacity: 1;}
			}
		}
	}
}
.filter-container__selected-filter-header-title {
	color: var(--mainColor);
	font-size: 18px;
}
.filter-container__clear-all {
	line-height: 20px;
}
.filter-container__selected-filter-item{
	svg{
		fill: #d80000;
		background: #fff;
		border-radius: 20px;
		padding: 3px;
		vertical-align: text-top;
	}
	a {
		font-size: 14px;
		color: #fff;
		padding: 3px 10px 3px 5px;
		background: var(--mainColor);
		border-radius: 15px;
		&:hover {
			background: #7c7c7c;
		}
	}
} 
.item_bn_coll {
	border-radius:10px;
	&:hover {
		filter: drop-shadow(2px 4px 6px #000);
	}
}
.h2.title-head {
	font-size: 18px;
}
.title-head.big {
	background: var(--mainColor);
	color: #fff;
}
.pc_button_fill {
  background: var(--mainColor);
  border: 2px solid #fff;
  svg {
    fill: #fff;
  }
}
.filter-container__selected-filter {
	background: var(--bgHead);
}
.filter-item--check-box{
	label {
		cursor:pointer;
		//will-change: transform;
		&:hover {
			color: var(--mainColor);
		}
	}
	.fa {
		width: 20px;
		min-width: 20px;
	}
	input{
		& + .fa:before {
			content: "";
			border-radius: 10px;
			font-size: 18px;
			border: solid 1px var(--accentColor1);
			line-height: 40px;
			position: absolute;
			top: -15px;
			height: 20px !important;
			width: 20px;
		}
		&:checked + .fa:before {
			border-color: var(--mainColor);
			background: var(--mainColor);
		}
		& +.fa:after {
			content: "";
			background-image:url({{'checked_filter.png' | asset_url}});
			background-repeat:no-repeat;
			background-position: center;
			position: absolute;
			background-size: 60%;
			width: 20px;
			height: 20px;
			line-height: 20px;
			top: -16px;
			left: 0px;
			opacity: 0;
			transition: 0.5s all;
		}
		&:hover +.fa:after {
			filter: brightness(0.5);
			opacity: 1;
		}
		&:checked + .fa:after {
			opacity: 1;
		}
		&:checked:hover + .fa:after {
			filter: brightness(1);
		}
	}
	.fa2 {
		transition: all 0.3s ease;
		width: 100%;
	}
	input{
		&:checked + .fa2{
			border-color: var(--mainColor) !important;
			color: var(--mainColor);
		}
		&:hover + .fa2{
			border-color: var(--mainColor) !important;
			color: var(--mainColor);
		}
	}
} 
.filter-group{
	ul {
		overflow-y: auto;
		margin: 15px 0;
    max-height: 200px;
    &::-webkit-scrollbar-track
    {
      -webkit-box-shadow: inset 0 0 6px rgba(0,0,0,0.3);
      background-color: #F5F5F5;
      border-radius: 6px;
    }
    &::-webkit-scrollbar
    {
      width: 2px;
      background-color: #F5F5F5;
    }
    &::-webkit-scrollbar-thumb
    {
      border-radius: 6px;
      background-image:-webkit-gradient(linear, left bottom, left top, color-stop(0.44, var(--mainColor)), color-stop(0.72, var(--mainColor)), color-stop(0.86, var(--mainColor)));
    }
	}
}
.filter-grid{
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 10px;
  @media (max-width: 575px) {
    &.ft_price {
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 0;
      max-height: max-content;
    }
  }
}
.gap-10{
	gap: 10px;
}
.rte {
	h2 {
		border-left: 2px solid var(--mainColor);
		padding-left: 10px;
		color: var(--mainColor);
		font-size: 20px;
		margin-bottom: 10px;
	}
	h3 {
		font-size: 20px;
	}
}
.m_more { animation: m_more infinite 2s ease-in-out }
.m_less { animation: m_less infinite 2s ease-in-out }
@keyframes m_more {
	50% { transform: translateY(7px) }
}
@keyframes m_less {
	50% { transform: rotate(180deg) translateY(-7px) }
}
.view_mores {
	a {
		font-size: 15px;
		&:hover {
			box-shadow: 0 0px 2px 0 var(--mainColor),0 0px 6px 0px var(--mainColor);
		}
	}
	img {
		max-width: 16px;
		vertical-align: -1px;
	}
	.two img {
		transform: rotate(180deg);
	}
}
.content_coll {
	max-height: 280px;
	overflow: hidden;
	&.active {
		max-height: initial;
	}
}
.bg_cl {
	height: 150px;
	bottom: 0;
	background: linear-gradient(#ffffff00, #fff);
}
.sidebar_mobi {
  position: fixed;
  right: 10px;
  width: 0;
  z-index: 11;
  height: calc(100vh - 16px);
  visibility: hidden;
  @media (min-width:992px) {
  	top: 8px !important;
  }
  @media (max-width:991px) {
    height: calc(100% - 76px);
    bottom: 70px;
  }
  opacity: 0;
  transition: 0.3s all ease;
  &.open {
    visibility: visible;
    opacity: 1;
    width: 25%;
    @media (max-width:991px) {
      width: calc(100% - 20px);
    }
  }
  .close_fillter {
    border: 2px solid #fff;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--mainColor); 
    svg {fill:#fff;}
  }
}
.aside-filter {
  overflow-y: auto;
}
.bg-main {
	background: var(--mainColor);
}
.aside-content {
	&.bg-main {
		filter: hue-rotate(17deg) contrast(1.2);
	}
	.nav {
		background: rgba(255, 255, 255, .6);
		gap:5px;
	}
}
.nav-item {
	&.active,&:hover { 
		>a {
      color: #fff;
			background: var(--mainColor);
      border-radius: 8px;
		}
		>i.down_icon:before {
			border-color: var(--mainColor) transparent transparent transparent;
		}
	}
	.menu_down {
		list-style: none;
		padding: 0;
	}
	.down_icon {
		width: 32px;
    height: 32px;
    top: 0;
    right: 0;
    transition: 0.5s all;
    cursor: pointer;
    z-index: 2;
		&.cls_mn {
			transform: rotate(180deg);
		}
	}
}
.blog-item-list {
	.thumb_img_blog_list {
		min-width: 100px;
		max-width: 100px;
	}
	.blog-item-name {
		font-size:1rem;
	}
}
.pagination{
	li{
		border-color: transparent;
		.page-link{
			width: 38px;
			height: 38px;
			color: rgba(30, 30, 30, .5) !important;
			transition: all 0.3s ease;
			&:hover{
				background: var(--mainColor);
				border-color: var(--mainColor);
				box-shadow: 0 0 0 0.2rem var(--mainColor);
				color: #fff !important;
				svg {
					fill: #fff;
				}
			}
			&:focus {
				box-shadow: 0 0 0 0.2rem var(--mainColor);
			}
			svg {
				fill:var(--mainColor);
				transition: all 0.3s ease;
			}
		}
		&.disabled .page-link {
			
		}
		&.active{
			.page-link{
				background: var(--mainColor);
				border-color: var(--mainColor);
				color: #fff !important;
			}
		}
	}
	.prev svg{
		transform: translateX(-1px);
	}
	.next svg{
		transform: translateX(1px);
	}
}
