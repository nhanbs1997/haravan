.sectionContentStore {
	.leftCollumStore {
		background: var(--lightLeftColBackground);
		.form-group {
			label {
				display:block;
				&.select-city-label {
					font-size: 1rem;
				}
			}
		}
		.resultStore {
			@media (min-width: 768px) {
				height: 395px;
			}
			@media (max-width: 767px) {
				height: calc(300px - 92px);
			}
			overflow-y: auto;
			#list-store {
				.item {
					font-size: 0.875rem;
					cursor:pointer;
					border: 1px solid var(--mainColor);
					//color: #fff;
					transition: all 0.5s;
					background: #fff;
					&:hover,&.checked {
						background: var(--mainColor);
						color: #fff
					}
				}
			}
			&::-webkit-scrollbar {
				width: 3px;
				background-color: var(--mainColor);
			}
			&::-webkit-scrollbar-thumb {
				border-radius: 0;
				-webkit-box-shadow: none;
				-moz-box-shadow: none;
				background-color: var(--mainColor);
			}
			&::-webkit-scrollbar-track {
				-webkit-box-shadow: none;
				-moz-box-shadow: none;
				border-radius: 0;
				background-color: #ddd;
			}
		} 
	}
	#map {
		@media (min-width: 768px) {
			height: 500px;
		}
		@media (max-width: 767px) {
			height: 300px;
		}
		width: 100%;
	}
}
.district {
	font-size: 1rem;
}
@keyframes cssload-load{0%{left:0;height:29px;width:15px}50%{height:8px;width:39px}100%{left:229px;height:29px;width:15px}}
@-o-keyframes cssload-load{0%{left:0;height:29px;width:15px}50%{height:8px;width:39px}100%{left:229px;height:29px;width:15px}}
@-ms-keyframes cssload-load{0%{left:0;height:29px;width:15px}50%{height:8px;width:39px}100%{left:229px;height:29px;width:15px}}
@-webkit-keyframes cssload-load{0%{left:0;height:29px;width:15px}50%{height:8px;width:39px}100%{left:229px;height:29px;width:15px}}
@-moz-keyframes cssload-load{0%{left:0;height:29px;width:15px}50%{height:8px;width:39px}100%{left:229px;height:29px;width:15px}}
.cssload-loader {
	width: 244px;
	height: 49px;
	line-height: 49px;
	text-align: center;
	position: relative;
	left: 50%;
	transform: translate(-50%, -50%);
	-o-transform: translate(-50%, -50%);
	-ms-transform: translate(-50%, -50%);
	-webkit-transform: translate(-50%, -50%);
	-moz-transform: translate(-50%, -50%);
	text-transform: uppercase;
	font-weight: 500;
	font-size: 18px;
	color: #1c1c1c;
	margin: 30px 0;
	&::before,&::after {
		content: "";
		display: block;
		width: 15px;
		height: 15px;
		background: #1c1c1c;
		position: absolute;
		animation: cssload-load 0.81s infinite alternate ease-in-out;
		-o-animation: cssload-load 0.81s infinite alternate ease-in-out;
		-ms-animation: cssload-load 0.81s infinite alternate ease-in-out;
		-webkit-animation: cssload-load 0.81s infinite alternate ease-in-out;
		-moz-animation: cssload-load 0.81s infinite alternate ease-in-out;
	}
	&:before {
		top:0;
	}
	&:after {
		bottom:0;
	}
}
#store-list{
	.store-item{
		transition: all 0.3s ease;
		border: 1px solid var(--mainColor);
		&.active, &:hover{
			color: #fff;
			background: var(--mainColor);
			a{
				color: #fff
			}
		}
	}
	.store-list-left{
		.b_store {
			max-height: 395px;
			overflow: auto;
			padding: 5px;
			border: 1px solid #dee2e6;
			border-radius: 5px;
			&::-webkit-scrollbar {
				width: 3px;
				background-color: var(--mainColor);
			}
			&::-webkit-scrollbar-thumb {
				border-radius: 0;
				-webkit-box-shadow: none;
				-moz-box-shadow: none;
				background-color: var(--mainColor);
			}
			&::-webkit-scrollbar-track {
				-webkit-box-shadow: none;
				-moz-box-shadow: none;
				border-radius: 0;
				background-color: #ddd;
			}
		}
	}
}
#js-select-province{
	box-shadow: none
}
.item_nb {
	border-radius: 10px;
	line-height: normal;
	.tt {
		font-size: 18px;
	}
	.bt {
		font-size: 36px;
	}
	&:after {
		content: '';
		position: absolute;
		bottom: 0;
		right: 15px;
		width: 84px;
		height: 72px;
		background-position: bottom center;
		background-size: contain;
		background-repeat: no-repeat;
		@media (min-width: 768px) and (max-width: 991px) {
			width: 55px;
		}
		@media (max-width: 480px) {
			width: 55px;
		}
	}
	&.b_1 {
		background-color: #ff9800;
		&:after {
			background-image: url({{'nb_ico_1.png' | asset_url}});
		}
	}
	&.b_2 {
		background-color: #03a9f4;
		&:after {
			background-image: url({{'nb_ico_2.png' | asset_url}});
		}
	}
	&.b_3 {
		background-color: #4caf50;
		&:after {
			background-image: url({{'nb_ico_3.png' | asset_url}});
		}
	}
	&.b_4 {
		background-color: #9c27b0;
		&:after {
			background-image: url({{'nb_ico_4.png' | asset_url}});
		}
	}
}
@media (max-width: 991px) {
	.title-head:before {
		left: 0;
		transform: translateX(0);
	}
}
