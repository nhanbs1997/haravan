<section class="m_video_review mb-4 mb-lg-5" style="--bgVideoCl: {{settings.bgvideocolor}};--bgVideoCls: {{settings.bgvideocolors}};--bgVideo: url({{settings.bgvideo}});">
  <div class="container">
    {%-assign article_size = blogs[settings.project_video_handle].articles_count-%}
    {%-if article_size > 0-%}
    <div class="mew_video_index swiper-container position-relative pb-3 pb-lg-0">
      <div class="swiper-wrapper">
        <div class="swiper-slide title rounded-10 d-flex flex-column align-items-center justify-content-center overflow-hidden">
    			<a class="text-uppercase font-weight-bold position-relative" href="{{blogs[settings.project_video_handle].url}}" title="{{settings.project_video_title}}">
            {{settings.project_video_title}}
          </a>
          <span class="position-relative text-white font-weight-bold">{{settings.video_sup_title}}</span>
    		</div>
        {% for article in blogs[settings.project_video_handle].articles limit: settings.project_video_limit  %}
        <div class="swiper-slide">
          {%- include 'blog_item_video' -%}
        </div>
        {% endfor %}
      </div>
			<div class="swiper-scrollbar sb_video d-lg-none"></div>
    </div>
    {%-else-%}
    <p class="alert alert-warning">{{settings.other_updating}}</p>
    {%-endif-%}
  </div>
</section>
<div class="popup_box position-fixed w-100 h-100 justify-content-center align-items-center d-flex">
  <div class="position-relative max-100">
    <a href="javascript:;" class="close_popup position-absolute d-flex justify-content-center align-items-center bg-dark" title="{{settings.tit_close}}">
		<svg width="18" height="18">
			<use href="#svg-close"/>
		</svg>
    </a>
    <div class="b_video p-2 p-md-3 bg-white rounded-10 m-auto"></div>
  </div>
</div>


