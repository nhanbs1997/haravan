<div class="align-items-center menu_mobile position-relative h-100">
	<ul id="menu-mew" class="list-unstyled m-0 p-0">
    {%-for link in linklists[settings.menu_site_mb].links-%}
    {% assign test = link.title | downcase %}
    <li class="level0 d-block w-100 position-static">
      {%-if linklists[link.handle] != null-%}
      <a title="{{link.title}}" class="position-relative d-flex js-submenu flex-column justify-content-center align-items-center text-center p-2">
        {%-capture menuicon-%}icon_menu_{{forloop.index}}{%-endcapture-%}
        {% assign icon = settings[menuicon] %}
        <img class="lazy d-block pb-2 m-auto" src="{{'placeholder_1x1.png' | asset_url}}" data-src="{{ icon }}" onError="this.src='{{settings.favicon}}'" alt="icon-{{link.url}}">
        <span class="line_1 line_2">{{link.title}}</span>
      </a>
      <ul class="lv1 p-0 list-unstyled position-absolute m_chill m-0">
        {%-for childlink in linklists[link.handle].links-%}
        {%-if forloop.first-%}
        <li class="level1 main position-sticky bg-white">
          <a href="{{link.url}}" class="font-weight-bold d-flex pt-2 pb-2 border-bottom align-items-center w-100 justify-content-center text-main" title="{{settings.sup_text_main_menu}}">
            {{settings.sup_text_main_menu}}
          </a>
        </li>
        {%-endif-%}
        <li class="level1 position-relative">
          {%-if linklists[link.handle] != null-%}
          <a href="{{ childlink.url }}" class="font-weight-bold d-flex pt-2 pb-2 border-bottom mr-2 ml-2 align-items-center" title="{{ childlink.title }}">
            {{ childlink.title }}
          </a>
          <ul class="lv2 d-flex list-unstyled flex-column pl-0">
            {%-for childlink2 in linklists[childlink.handle].links-%}
            <li class="level2 position-relative">
              <a href="{{ childlink2.url }}" class="h-100 d-flex pl-3 pt-2 pb-2 border-bottom mr-2 ml-2 align-items-center" title="{{ childlink2.title }}">
                {{ childlink2.title }}
              </a>
            </li>
            {%-endfor-%}
          </ul>
          {%-else-%}
          <a href="{{ childlink.url }}" class="h-100 d-flex pt-2 pb-2 border-bottom mr-2 ml-2 align-items-center" title="{{ childlink.title }}">
            {{ childlink.title }}
          </a>
          {%-endif-%}
        </li>
        {%-endfor-%}
      </ul>
      {%else%}
      <a href="{{link.url}}" title="{{link.title}}" class="position-relative d-flex flex-column justify-content-center align-items-center text-center p-2">
        {%-capture menuicon-%}icon_menu_{{forloop.index}}{%-endcapture-%}
        {% assign icon = settings[menuicon] %}
        <img class="lazy d-block pb-2 m-auto" src="{{'placeholder_1x1.png' | asset_url}}" data-src="{{ icon }}" onError="this.src='{{settings.favicon}}'" alt="icon-{{link.url}}">
        <span class="line_1 line_2">{{link.title}}</span>
      </a>
      {%-if forloop.first-%}
      <ul class="lv1 p-1 position-absolute h-100 waring">
        <li class="level1 position-relative mb-1">
          <p class="text-center alert alert-warning">
            {{settings.emptyCollection}}
          </p>
        </li>
      </ul>
      {%-endif-%}
      {%-endif-%}
    </li>
    {%-endfor-%}
	</ul>
</div>
<a class="align-items-center close_menu_mobile d-flex justify-content-center position-absolute d-lg-none" href="javascript:;" title="{{settings.tit_close}}">
	<svg width="18" height="18">
		<use href="#svg-close"/>
	</svg>
</a>
