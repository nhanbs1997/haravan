<div class="align-items-center border-bottom d-flex justify-content-between pb-2 pt-2 sortPagiBar">
	<ul class="aside-content filter-sort list-unstyled mb-0 d-flex align-items-baseline gap-10">
		{%-if settings.sortby_name.size > 0-%}
		<li>
			<span class="h6 title-head m-0 pt-2 pb-2 font-weight-bold">{{settings.sortby_name}}</span>
		</li>
		{%-endif-%}
		<li class="filter-item filter-item--check-box">
			<label class="d-flex align-items-baseline pt-1 pb-1 m-0">
				<input type="radio" class="d-none sortby-default" name="sortBy" onclick="sortby('default')" checked>
				<span class="fa2 px-2 py-1 rounded-pill border">{{settings.sortby_default"}}</span> 
			</label>
		</li>
		{%-if settings.sortby_az.size > 0-%}
		<li class="filter-item filter-item--check-box">
			<label class="d-flex align-items-baseline pt-1 pb-1 m-0">
				<input type="radio" class="d-none sortby-alpha-asc" name="sortBy" onclick="sortby('alpha-asc')">
				<span class="fa2 px-2 py-1 rounded-pill border">{{settings.sortby_az}}</span> 
			</label>
		</li>
		{%-endif-%}
		{%-if settings.sortby_za.size > 0-%}
		<li class="filter-item filter-item--check-box">
			<label class="d-flex align-items-baseline pt-1 pb-1 m-0">
				<input type="radio" class="d-none sortby-alpha-desc" name="sortBy" onclick="sortby('alpha-desc')">
				<span class="fa2 px-2 py-1 rounded-pill border">{{settings.sortby_za}}</span> 
			</label>
		</li>
		{%-endif-%}
		{%-if settings.sortby_price_asc.size > 0-%}
		<li class="filter-item filter-item--check-box">
			<label class="d-flex align-items-baseline pt-1 pb-1 m-0">
				<input type="radio" class="d-none sortby-price-asc" name="sortBy" onclick="sortby('price-asc')">
				<span class="fa2 px-2 py-1 rounded-pill border">{{settings.sortby_price_asc}}</span> 
			</label>
		</li>
		{%-endif-%}
		{%-if settings.sortby_price_desc.size > 0-%}
		<li class="filter-item filter-item--check-box">
			<label class="d-flex align-items-baseline pt-1 pb-1 m-0">
				<input type="radio" class="d-none sortby-price-desc" name="sortBy" onclick="sortby('price-desc')">
				<span class="fa2 px-2 py-1 rounded-pill border">{{settings.sortby_price_desc}}</span> 
			</label>
		</li>
		{%-endif-%}
		{%-if settings.sortby_create_asc.size > 0-%}
		<li class="filter-item filter-item--check-box">
			<label class="d-flex align-items-baseline pt-1 pb-1 m-0">
				<input type="radio" class="d-none sortby-created-asc" name="sortBy" onclick="sortby('created-asc')">
				<span class="fa2 px-2 py-1 rounded-pill border">{{settings.sortby_create_asc}}</span> 
			</label>
		</li>
		{%-endif-%}
		{%-if settings.sortby_create_desc.size > 0-%}
		<li class="filter-item filter-item--check-box">
			<label class="d-flex align-items-baseline pt-1 pb-1 m-0">
				<input type="radio" class="d-none sortby-created-desc" name="sortBy" onclick="sortby('created-desc')">
				<span class="fa2 px-2 py-1 rounded-pill border">{{settings.sortby_create_desc}}</span> 
			</label>
		</li>
		{%-endif-%}
	</ul>
  <a href="javascript:;" class="open-filters d-none d-lg-flex pc_button_fill px-3 py-2 rounded-pill text-white font-weight-bold gap_8 shadow-sm">
    <svg width="22" height="22">
			<use href="#svg-filter" />
		</svg>
    {{settings.breadcrumb_fillter}}
  </a>
</div>