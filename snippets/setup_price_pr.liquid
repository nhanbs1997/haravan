{%-assign sold_out = true-%}
{%-if product.available-%}
{%-assign sold_out = false-%}
{%-assign dq-price = product.selected_or_first_available_variant.price-%}
{%-assign dq-compare-price = product.selected_or_first_available_variant.compare_at_price-%}
{%-else-%}
{%-assign dq-price = product.variants[0].price-%}
{%-assign dq-compare-price = product.variants[0].compare_at_price-%}
{%-endif-%} 
{%-assign contacts = false-%}
{%-if dq-price < 1-%}
{%-assign contacts = true-%}
{%-endif-%}
{%-assign on_sale = false-%}
{%-if dq-compare-price > dq-price-%}
{%-assign on_sale = true-%}
{%-endif-%}
{%-assign variantCount = product.variants | size-%}
{%-assign on_var = false-%}
{%-if variantCount > 1-%}
{%-assign on_var = true-%}
{%-endif-%}
{%-capture thrifty-%} 
{{-dq-compare-price | minus:dq-price | divided_by: 100-}}
{%-endcapture %}
{%-capture discount-%}
{{-dq-compare-price | minus:dq-price | times:100 | divided_by:dq-compare-price | round-}}
{%-endcapture %}
{%-assign pt = dq-compare-price  | minus:dq-price | times:100 | divided_by:dq-compare-price-%}
{%-if pt > 99-%}
{%-capture discount-%}99{%-endcapture-%}
{%-endif-%}
{%-if pt < 1-%}
{%-capture discount-%}1{%-endcapture-%}
{%-endif-%}
{%assign new = false%}
{%assign hot= false%}
{%for tag in product.tags%}
{%if tag contains 'New' or tag contains 'NEW'%}
{%assign new = true%}
{%endif%}
{%if tag contains 'Hot' or tag contains 'HOT'%}
{%assign hot = true%}
{%endif%}
{%endfor%}
