<script>
	let giftList = [{%-for link in linklists[settings.gift_menu].links-%}
		{ 
			"entry": {{link.title | remove: '.'}},
			"alias": "{{link.url | replace_first: '/', ''}}",
			"id": {{link.object.variants[0].id}},
			"name": "{{link.object.title}}",
			"image": "{{link.object.featured_image.src | img_url: 'small' }}"
		}{%unless forloop.last%},{%endunless%}
		{%-endfor-%}];
</script>
