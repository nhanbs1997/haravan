{%-if settings.use_wishlist-%}
<script src="{{'classwishlist.js' | asset_url}}" defer></script>
<script>
  var wl;
	window.addEventListener('load', () => {
		wl = new Wishlist({
        url: "{{pages[settings.wishlist_page].url}}",
        notifyEmpty: "{{settings.wishlist_list_empty}}"
    });
		wl.init();
    window.addEventListener('wishlist:rendered', () => {
      let arrImg = document.querySelector('#wishlist-container').querySelectorAll('.lazy');
      arrImg.forEach((v) => { io.observe(v);})
    });
    window.addEventListener('wishlist:added', (e) => {
      createToast('success', '{{settings.wishlist_action_add}}', `{{settings.wishlist_action_add_content}}`.replace(/\[sp]/ig, e.detail.infor.title));  
    });
    window.addEventListener('wishlist:removed', (e) => {
      createToast('warning', '{{settings.wishlist_action_remove}}', `{{settings.wishlist_action_remove_content}}`.replace(/\[sp]/ig, e.detail.infor.title)); 
    });
    window.addEventListener('wishlist:renderError', (e) => {
      createToast('error', '{{settings.wishlist_action_error}}', `{{settings.wishlist_action_error_content}}`); 
    });
    window.addEventListener('wishlist:removedError', (e) => {
      createToast('error', '{{settings.wishlist_action_error}}', `{{settinngs.wishlist_action_error_content}}`); 
    });
	});
</script>
{%-endif-%}
