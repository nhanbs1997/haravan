  const popsale_cate = [{%for product in collections[settings.popsale_cate].products%}{
		"img_url": "{{product.featured_image.src}}",
		"title": "{{product.title}}",
		"url": "{{product.url}}",
	}{%unless forloop.last%},{%endunless%}{%endfor%}];
  let pmin = "{{settings.pmin}}";
  let ptit = "{{settings.ptit}}";
  let pdes = "{{settings.pdes}}";
  const timeToShow = {{settings.ptime | times: 1000}};
  const timeDelay = {{settings.pdelay | times: 1000}};
  const timeSpace = {{settings.ptime | plus: settings.pdelay | times: 1000}};
</script>
{%endif%}
{%if settings.free_shipping_enable%}
