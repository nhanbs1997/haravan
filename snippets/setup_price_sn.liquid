{%-assign sold_out = true-%}
{%-if product.available-%}
{%-assign sold_out = false-%}
{%-endif-%} 
{%-assign dq-price = product.variants[0].price-%}
{%-assign dq-compare-price = product.variants[0].compare_at_price-%}
{%-assign contact_item = false-%}
{%-if dq-price < 1-%}
{%-assign contact_item = true-%}
{%-endif-%}
{%-assign on_sale = false-%}
{%-if dq-compare-price > dq-price-%}
{%-assign on_sale = true-%}
{%-endif-%}
{%-assign variantCount = product.variants | size-%}
{%-assign on_var = false-%}
{%-if variantCount > 1-%}
{%-assign on_var = true-%}
{%-endif-%}
{%-capture discount-%}{{-dq-compare-price | minus:dq-price | times:100 | divided_by:dq-compare-price | round-}}{%-endcapture %}
{%-assign pt = dq-compare-price  | minus:dq-price | times:100 | divided_by:dq-compare-price-%}
{%-if pt > 99-%}{%-capture discount-%}99{%-endcapture-%}{%-endif-%}
{%-if pt < 1-%}{%-capture discount-%}1{%-endcapture-%}{%-endif-%}
