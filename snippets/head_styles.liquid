		--mainColor: {{settings.main_color}};
		--mainColor2: {{settings.main_color_2}};
    --navColor: {{settings.nav_color}};
    --navTextColor: {{settings.navtext_color}};
		--menuHover: {{settings.menu_hover}};
    --bgBottomTitle: url({{settings.bottomtitle}});
    --footerBg: {{settings.footer_bg}};
    --footerText: {{settings.footer_text}};
    --footerTextHover: {{settings.footer_text_hv}};
		--accentColor1: #929292;
		--accentColor2: {{settings.accent_2}}; /*Màu giá*/
		--textColor: #424242;
		--toastSuccessBg: {{settings.toastSuccessBg | default: '#d1e7dd'}};
		--toastSuccessCl: {{settings.toastSuccessCl | default: '#0f5132'}};
		--toastWarningBg: {{settings.toastWarningBg | default: '#fff3cd'}};
		--toastWarningCl: {{settings.toastWarningCl | default: '#664d03'}};
		--toastErrorBg: {{settings.toastErrBg | default: '#f8d7da'}};
		--toastErrorCl: {{settings.toastErrCl | default: '#842029'}};
		--toastSystemBg: {{settings.toastSysBg | default: '#d3d3d4'}};
		--toastSystemCl: {{settings.toastSysCl | default: '#141619'}};
    --overlayimg: url({{settings.overlayimg}});
	}
</style>
