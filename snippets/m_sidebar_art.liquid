{% if settings.blogs_aside_event_2_enable %}
<div class="aside-item mb-2">
	<div class="title-head mb-2 font-weight-bold">
		<a class="h2 title-head font-weight-bold big text-uppercase d-block mb-2 p-2 rounded" href="{{settings.bogs_aside_event_2_url}}" title="{{ settings.bogs_aside_event_2_title }}">
			{{ settings.bogs_aside_event_2_title }}
		</a>
	</div>
	<div class="list-blogs">
		{% for article in blogs[settings.bogs_aside_event_2_url].articles  limit : 5%}
		<article class="d-flex blog-item blog-item-list clearfix {%unless forloop.last%}border-bottom {%endunless%}pt-2 pb-2">
			<div class="img_art thumb_img_blog_list">
				{%- if article.image != null -%}
				<a href="{{ article.url }}" title="{{ article.title }}" class="effect-ming">
					<div class="position-relative w-100 m-0 be_opa modal-open ratio3by2 has-edge aspect rounded">
						<img src="{{'placeholder_1x1.png' | asset_url}}" data-src="{{ article.image.src | img_url: 'large'}}" class="lazy d-block img img-cover position-absolute" alt="{{ article.title }}">
					</div>
				</a>
				{%- else -%}
				<a href="{{ article.url }}" title="{{ article.title }}" class="effect-ming">
					<div class="position-relative w-100 m-0 be_opa modal-open ratio3by2 has-edge aspect rounded">
						<img src="{{ 'no_image.jpg' | asset_url }}" alt="{{ article.title }}" class="lazy d-block img img-cover position-absolute"> 
						<div class="position-absolute w-100 h-100 overlay"></div>	
					</div>
				</a>                      
				{%- endif -%} 
			</div>
			<h3 class="blog-item-name pl-3 m-0 position-relative line_3">
				<a href="{{ article.url }}" title="{{ article.title | escape }}">{{ article.title | truncatewords: 20 | escape }}</a>
			</h3>
		</article>			
		{% endfor %}
	</div>
</div>
{%endif%}
