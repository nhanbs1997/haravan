{%- include 'breadcrumb' -%}
<section class="acc_layout my-3">
	<div class='container'>
    <div class="row">
        <div class="col-12 col-lg-8">
          <div class="registered-users">
            <div class="content">
              {% form 'reset_customer_password' %}
              <h2 class="page_title mb-3">{{settings.breadcrumb_reset_password}}</h2>
              <div class="form-signup text-danger mb-2 text-center" >
                {{ form.errors | default_errors }}
              </div>
              <div class="form-group">
                <label for="Password" class="col-form-label d-none">{{settings.account_changepass_newpass}}<span class="text-danger">*</span></label>
                <input type="password" class="mew-control rounded-10 border border-main" value="" title="{{settings.register_pass}}" name="Password" id="password" placeholder="{{settings.account_changepass_newpass}}*" >
              </div>
              <div class="form-group">
                <label for="ConfirmPassword" class="col-form-label d-none">{{settings.account_changepass_confirm}}<span class="text-danger">**</span></label>        
                <input type="password" class="mew-control rounded-10 border border-main" value="" title="{{settings.register_pass}}" name="ConfirmPassword" id="confirm_password" placeholder="{{settings.account_changepass_confirm}}*" >
              </div>	
              <p class="required text-muted">* {{settings.form_contact_require}}</p>
              <div class="buttons-set">
                <button id="send2" type="submit" class="btn btn-primary mew-control font-weight-bold btn_login"><span>{{settings.account_changepass}}</span></button>              
              </div>
              {% endform %}
            </div>
          </div>
        </div>
        <div class="col-12 col-lg-4">
          <div class="new-users">
            <h3 class="page_title mb-3">{{settings.register_text}}</h3>
            <div class="content">
              <p class="border border-main line_cus p-3 rounded-10 text-center  text-center">{{settings.register_content}}</p>
              <div class="buttons-set text-center">
                <button class="btn btn-primary  mew-control font-weight-bold mb-2" onclick="window.location.href='/account/register'">{{settings.register_create}}</button>
              </div>
            </div>
          </div>
        </div>
      </div>
	</div>
</section>