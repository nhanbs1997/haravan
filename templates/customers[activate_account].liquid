{%- include 'breadcrumb' -%}
<section class="acc_layout my-3">
	<div class='container'>
    <div class="row justify-content-center">
      <div class="col-lg-6 col-12 wrapbox-content-account">
        <div class="registered-users">
          <h2 class="page_title mb-3">{{settings.active_account_title}}</h2>
          {%form 'activate_customer_password'%}
          {{ form.errors | default_errors }}
          <p class=" create-password">{{settings.active_account_sup}}</p>
          <div class="form-group">
            <label for="customer_password" class="col-form-label d-none">{{settings.active_account_pass}}</label>
            <input required type="password" value="" name="customer[password]" id="customer_password" placeholder="{{settings.active_account_pass}}" class="mew-control rounded-10 border border-main"/>      
          </div>
          <div class="form-group">
            <label for="customer_password" class="col-form-label d-none">{{settings.active_account_confirmpass}}</label>
            <input required type="password" value="" name="customer[password_confirmation]" id="customer_password" placeholder="{{settings.active_account_confirmpass}}" class="mew-control rounded-10 border border-main"/>      
          </div>
          <div class="clearfix large_form sitebox-recaptcha d-none" >
            This site is protected by reCAPTCHA and the Google
            <a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">Privacy Policy</a> 
            and <a href="https://policies.google.com/terms" target="_blank" rel="noreferrer">Terms of Service</a> apply.
          </div>	
          <div class="form-group d-flex justify-content-between align-items-center">
              <input class="btn_login btn btn-primary mew-control font-weight-bold mb-3 rounded-10" type="submit" value="{{settings.active_account_btn}}" />
              <a href="/" class="font-weight-bold">{{settings.active_account_cancer}}</a>
          </div>
          {%endform%}
      </div>
		</div>
	</div>
</section>
