{%-layout none-%}
{%-if collection.products.size > 0-%}
{%-assign product_url = collection.url-%}
<div class="swiper-wrapper">
	{% for product in collection.products limit: 15 %}
	<div class="swiper-slide box_padding">
		{%-include 'product-grid-item'-%}
	</div>
	{%-endfor-%}
</div>
<div class="swiper-button-prev mf_prev"></div>
<div class="swiper-button-next mf_next"></div>
<div class="swiper-scrollbar sb_aj d-lg-none"></div>
{%unless collection.products.size < 5%}
<div class="view_more text-center mt-3 position-relative">
  <a href="{{product_url}}" title="{{settings.seemore_text}}" class="position-relative d-inline-block rounded-pill font-weight-bold py-2 px-4">
    {{settings.seemore_text}}
  </a>
</div>
{%endunless%}
{%-else-%}
<div class="mt-2 mb-2">
	<p class="alert alert-warning mb-0">{{settings.emptyCollection}}</p>
</div>
{%-endif-%}