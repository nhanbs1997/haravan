{%-layout none-%}
{%if search.results.size > 0%}
<div class="overflow-auto search-result-warpper px-2">
  <div class="searchResult_products_text d-inline-block font-weight-bold h6 mt-2 py-2 px-3 rounded-10 text-left text-white position-relative mb-3">{{settings.quick_search_page_heading}} (<span>{{-search.results_count-}}</span>)</div>
  <div class="searchResult_products">
    {%for item in search.results limit: settings.quick_search_page_limit%}
    <div class="w-100">
      <a href="{{item.url}}" title="{{item.title}}" class="d-flex align-items-start w-100 result-item rounded-10 align-item p-2 mb-2">
        <div class="result-item_image d-flex h-100 align-items-center justify-content-center">
          <img alt="{{item.title}}" src="{{ settings.favicon | img_url: 'small' }}" class="img-fluid rounded">
        </div>
        <div class="result-item_detail px-2">
          <h3 class="result-item_name mb-1">{{item.title}}</h3>
          <p class="m-0 result-item_content">{{item.content | strip_html | strip_newlines | truncatewords: 15}}</p>
        </div>
      </a>
    </div>
    {%endfor%}
  </div>
  {%-if search.results_count > settings.quick_search_page_limit-%}
  <a href="/search?q={{search.terms}}&type=page&view=pages" class="all-result border border-main btn d-block font-weight-bold mb-2 rounded-10 text-main w-100">{{settings.quick_search_all}}</a>
  {%-endif-%}
</div>
{%endif%}