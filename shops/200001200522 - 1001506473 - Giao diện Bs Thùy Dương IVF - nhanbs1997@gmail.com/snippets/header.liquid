								{% if template == 'index' %}
								<a href="{{shop.url}}"  itemprop="url">
									<img itemprop="logo" src="{{ settings.logo }}" alt="{{ shop.name }}" class="img-responsive logoimg lazyload hrv-cf-logo" setting-id="logo" setting-type="image" />
								</a>			
								<h1 style="display:none"><a href="{{shop.url}}" itemprop="url">{{ shop.name }}</a></h1>
								{% else %}
								<a href="{{shop.url}}"  itemprop="url">
									<img itemprop="logo" src="{{ settings.logo }}" alt="{{ shop.name }}" class="img-responsive logoimg lazyload hrv-cf-logo" setting-id="logo" setting-type="image" />
								</a>
								{% endif %}
								{% else %}
								{% if template == 'index' %}	<h1><a href="{{shop.url}}" itemprop="url">{{ shop.name }}</a></h1>
