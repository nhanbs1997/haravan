{%-if settings.product_grid_desktop == 'grid-desk-6'-%}
	{%- assign width-desk = '2' -%}
{%-elsif settings.product_grid_desktop == 'grid-desk-5'-%}
	{%-assign width-desk = 'cus5' -%}
{%-elsif settings.product_grid_desktop == 'grid-desk-4'-%}
	{%-assign width-desk = '3'-%}
{%-else-%}
	{%-assign width-desk = '4'-%}
{%- endif -%}
{%-if settings.product_grid_mobile == 'grid-mb-3'-%}
	{%- assign width-mb = '4' -%}
{%-elsif settings.product_grid_mobile == 'grid-mb-2'-%}
	{%-assign width-mb = '6' -%}
{%-else-%}
	{%-assign width-mb = '12'-%}
{%- endif -%}
<div class="col-lg-{{width-desk | lstrip | rstrip}} col-md-{{width-mb | lstrip | rstrip}} col-{{width-mb | lstrip | rstrip}} product-loop{% if settings.product_grid_mobile == 'grid-mb-3' %} prod-action-small{% elsif settings.product_grid_mobile == 'grid-mb-1' %} product-only{% endif %}" 
		 data-id="{{ product.variants.first.id }}">
	<div class="product-inner">
		<div class="proloop-image">
			<div class="pro-sale"><span>-14%</span></div>
			<div class="lazy-img">
				<a href="/adminv2/products_new" title="Tiêu đề sản phẩm {{i}}">
					<img class="lazyload img-loop" src="{{ 'no_image.jpg' | asset_url }}" alt="Tiêu đề sản phẩm {{i}}"  />
				</a>
			</div>
		</div>					
		<div class="proloop-detail">
			<h3>
				<a href="/adminv2/products_new" title="Tiêu đề sản phẩm {{i}}">Tiêu đề sản phẩm {{i}}</a>
			</h3>
			<p class="proloop--price">
				<span class="price">3,150,000₫</span>				
				<span class="price-del">3,650,000₫</span>		
			</p>
		</div>
	</div>
</div>




