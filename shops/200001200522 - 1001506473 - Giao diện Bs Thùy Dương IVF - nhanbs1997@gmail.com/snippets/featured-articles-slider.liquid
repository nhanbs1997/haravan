{%- capture featured_show_key -%}show_{{ featured_articles_prefix }}_articles{%- endcapture -%}
{%- capture featured_kicker_key -%}{{ featured_articles_prefix }}_articles_title1{%- endcapture -%}
{%- capture featured_title_key -%}{{ featured_articles_prefix }}_articles_title2{%- endcapture -%}
{%- capture featured_blog_key -%}{{ featured_articles_prefix }}_articles_blog_handle{%- endcapture -%}
{%- capture featured_button_key -%}{{ featured_articles_prefix }}_articles_btn{%- endcapture -%}
{%- capture featured_background_key -%}{{ featured_articles_prefix }}_articles_bg{%- endcapture -%}
{%- capture featured_accent_key -%}{{ featured_articles_prefix }}_articles_accent{%- endcapture -%}
{%- assign featured_blog_handle = settings[featured_blog_key] -%}
{%- assign featured_blog = blogs[featured_blog_handle] -%}

{%- if settings[featured_show_key] -%}
<section
	class="section-featured-articles section-featured-articles--{{ featured_articles_prefix }}"
	id="section-{{ featured_articles_prefix }}-articles"
	style="--featured-articles-bg: {{ settings[featured_background_key] | default: '#fffafd' }}; --featured-articles-accent: {{ settings[featured_accent_key] | default: '#ca3394' }};"
>
	<div class="container">
		<div class="featured-articles-heading text-center">
			{%- if settings[featured_kicker_key] != blank -%}
			<p class="featured-articles-kicker hrv-cf-{{ featured_kicker_key }}" setting-id="{{ featured_kicker_key }}" setting-type="text">{{ settings[featured_kicker_key] }}</p>
			{%- endif -%}
			{%- if settings[featured_title_key] != blank -%}
			<h2 class="featured-articles-title hrv-cf-{{ featured_title_key }}" setting-id="{{ featured_title_key }}" setting-type="text">{{ settings[featured_title_key] }}</h2>
			{%- endif -%}
      {{ blog.description }}
		</div>

		{%- if featured_blog != blank and featured_blog.articles.size > 0 -%}
		<div class="featured-articles-slider owl-carousel owl-theme" aria-label="{{ settings[featured_title_key] | default: settings[featured_kicker_key] | escape }}">
			{%- for article in featured_blog.articles limit: 10 -%}
				{%- include 'article-image' with article:article -%}
        {% assign b = '' %}
{% for tag in product.tags %}
{% if tag contains 'link_' %}
{% assign b = tag | remove: 'link' %}
{% break %}
{% endif %}
{% endfor %}

				<article class="featured-article-card">
             {% assign a = '' %}
{% for tag in article.tags %}
{% if tag contains 'logo_' %}
{% assign a = tag | remove: 'logo_' %}
{% break %}
{% endif %}
{% endfor %}
         
            {% unless b  %}
            {% assign b = article.url %}
              {% endunless %}
           
          
{% if a %}
  <a href="{{ b }}" target="_blank"><img src="{{ a }}"></a>
{% endif %}
					<a class="featured-article-image" href="{{ b }}" target="_blank" aria-label="{{ article.title | escape }}">
         
						<img loading="lazy" src="{{ imageUrl | product_img_url: 'large' }}" alt="{{ article.title | escape }}">
					</a>
					<div class="featured-article-content">
						<h3 class="featured-article-title"><a href="{{ b }}" target="_blank">{{ article.title }}</a></h3>
						{%- assign featured_summary = article.excerpt_or_content | strip_html | strip -%}
						{%- if featured_summary != blank -%}
						<p class="featured-article-summary">{{ featured_summary | truncatewords: 18 }}</p>
						{%- endif -%}
						<a class="featured-article-link" href="{{ b }}" target="_blank">Xem chi tiết <span aria-hidden="true">→</span></a>
					</div>
				</article>
			{%- endfor -%}
		</div>

		{%- if settings[featured_button_key] != blank -%}
		<div class="featured-articles-more text-center">
			<a href="{{ featured_blog.url }}" class="button hrv-cf-{{ featured_button_key }}" setting-id="{{ featured_button_key }}" setting-type="text">{{ settings[featured_button_key] }}</a>
		</div>
		{%- endif -%}
		{%- else -%}
		<p class="featured-articles-empty text-center">Vui lòng chọn danh mục bài viết trong phần thiết lập giao diện.</p>
		{%- endif -%}
	</div>
</section>

<style>
	.section-featured-articles {
		background: var(--featured-articles-bg);
		padding: 72px 0 64px;
		overflow: hidden;
	}
	.section-featured-articles .featured-articles-heading {
		margin: 0 auto 34px;
		max-width: 920px;
	}
	.section-featured-articles .featured-articles-kicker {
		color: #202634;
		font-size: 15px;
		font-weight: 600;
		letter-spacing: .08em;
		line-height: 1.4;
		margin: 0 0 5px;
		text-transform: uppercase;
	}
	.section-featured-articles .featured-articles-title {
		color: #171b26;
		font-size: clamp(30px, 3.1vw, 48px);
		font-weight: 600;
		line-height: 1.12;
		margin: 0;
	}
	.section-featured-articles .featured-articles-slider {
		position: relative;
	}
	.section-featured-articles .featured-articles-slider .owl-stage {
		display: flex;
	}
	.section-featured-articles .featured-articles-slider .owl-item {
		display: flex;
		height: auto;
	}
	.section-featured-articles .featured-article-card {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		min-width: 0;
		text-align: center;
	}
	.section-featured-articles .featured-article-image {
		background: #f0edf0;
		border-radius: 18px;
		display: block;
		overflow: hidden;
		position: relative;
    margin-top: 5px;
	}
	.section-featured-articles .featured-article-image:before {
		content: "";
		display: block;
		padding-top: 66.666%;
	}
	.section-featured-articles .featured-article-image img {
		height: 100%;
		inset: 0;
		object-fit: cover;
		position: absolute;
		transition: transform .45s ease;
		width: 100%;
	}
	.section-featured-articles .featured-article-card:hover .featured-article-image img {
		transform: scale(1.035);
	}
	.section-featured-articles .featured-article-content {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		padding: 16px 4px 3px;
	}
	.section-featured-articles .featured-article-title {
		display: -webkit-box;
		font-size: 16px;
		font-weight: 600;
		line-height: 1.45;
		margin: 0 0 8px;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}
	.section-featured-articles .featured-article-title a {
		color: #202634;
	}
	.section-featured-articles .featured-article-summary {
		color: #606574;
		display: -webkit-box;
		font-size: 13px;
		line-height: 1.55;
		margin: 0 0 12px;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}
	.section-featured-articles .featured-article-link {
		color: var(--featured-articles-accent);
		font-size: 13px;
		font-weight: 600;
		margin-top: auto;
	}
	.section-featured-articles .featured-article-link span {
		display: inline-block;
		transition: transform .2s ease;
	}
	.section-featured-articles .featured-article-link:hover span {
		transform: translateX(4px);
	}
	.section-featured-articles .featured-articles-slider .owl-nav button {
		align-items: center;
		background: #fff;
		border: 1px solid rgba(202, 51, 148, .18);
		border-radius: 50%;
		box-shadow: 0 8px 24px rgba(68, 36, 56, .1);
		color: var(--featured-articles-accent);
		display: flex;
		font-size: 30px;
		height: 42px;
		justify-content: center;
		margin: 0;
		position: absolute;
		top: 30%;
		transform: translateY(-50%);
		width: 42px;
	}
	.section-featured-articles .featured-articles-slider .owl-nav .owl-prev { left: -21px; }
	.section-featured-articles .featured-articles-slider .owl-nav .owl-next { right: -21px; }
	.section-featured-articles .featured-articles-slider .owl-dots {
		margin-top: 24px;
		text-align: center;
	}
	.section-featured-articles .featured-articles-slider .owl-dot span {
		background: rgba(202, 51, 148, .2);
		border-radius: 999px;
		display: block;
		height: 7px;
		margin: 0 4px;
		transition: width .25s ease, background .25s ease;
		width: 7px;
	}
	.section-featured-articles .featured-articles-slider .owl-dot.active span {
		background: var(--featured-articles-accent);
		width: 22px;
	}
	.section-featured-articles .featured-articles-more {
		margin-top: 30px;
	}
	.section-featured-articles .featured-articles-more .button {
		background: var(--featured-articles-accent);
		border-color: var(--featured-articles-accent);
		border-radius: 999px;
		color: #fff;
		min-width: 132px;
		padding: 11px 24px;
	}
	.section-featured-articles .featured-articles-empty {
		color: #777;
		margin: 0;
	}
	@media (max-width: 767px) {
		.section-featured-articles {
			padding: 48px 0 44px;
		}
		.section-featured-articles .featured-articles-heading {
			margin-bottom: 24px;
		}
		.section-featured-articles .featured-articles-kicker {
			font-size: 12px;
		}
		.section-featured-articles .featured-articles-title {
			font-size: 56px;
		}
		.section-featured-articles .featured-article-image {
			border-radius: 12px;
		}
		.section-featured-articles .featured-article-content {
			padding: 12px 1px 2px;
		}
		.section-featured-articles .featured-article-title {
			font-size: 13px;
			line-height: 1.4;
			-webkit-line-clamp: 3;
		}
		.section-featured-articles .featured-article-summary {
			display: none;
		}
		.section-featured-articles .featured-article-link {
			font-size: 12px;
		}
		.section-featured-articles .featured-articles-slider .owl-nav {
			display: none;
		}
	}
</style>

<script>
	(function ($) {
		function initFeaturedArticleSliders() {
			if (!$ || !$.fn || !$.fn.owlCarousel) return;
			$('.featured-articles-slider').each(function () {
				var $slider = $(this);
				if ($slider.attr('data-featured-slider-ready') === 'true') return;
				var itemCount = $slider.children().length;
				$slider.attr('data-featured-slider-ready', 'true').owlCarousel({
					items: 5,
					margin: 20,
					loop: itemCount > 5,
					nav: itemCount > 5,
					navText: ['<span aria-hidden="true">‹</span>', '<span aria-hidden="true">›</span>'],
					dots: itemCount > 2,
					autoplay: itemCount > 5,
					autoplayTimeout: 4500,
					autoplayHoverPause: true,
					smartSpeed: 550,
					slideBy: 1,
					responsive: {
						0: { items: 2, margin: 12, loop: itemCount > 2 },
						768: { items: 3, margin: 18, loop: itemCount > 3 },
						1200: { items: 5, margin: 20, loop: itemCount > 5 }
					}
				});
				$slider.find('.owl-prev').attr('aria-label', 'Bài viết trước');
				$slider.find('.owl-next').attr('aria-label', 'Bài viết tiếp theo');
			});
		}
		$(initFeaturedArticleSliders);
	})(window.jQuery);
</script>
{%- endif -%}
