						{%assign htmt_title = ''%}
						{% for folder in category.folders %}
						{% if folder.articles_count > 0 %}
						<div class="item" id="folder_{{folder.id}}">
							<h3 class="title {%if forloop.first%} check {%endif%}" data-id="id_{{folder.id}}" {%if forloop.first%} data-check="true" {%else%} data-check="false" {%endif%}>{{ folder.name }}</h3>
							<div class="wrapper {%if forloop.first%} show {%endif%}" id="id_{{folder.id}}">
								<ul class="list-item ">
									{% for article in folder.articles %}
									<li>
