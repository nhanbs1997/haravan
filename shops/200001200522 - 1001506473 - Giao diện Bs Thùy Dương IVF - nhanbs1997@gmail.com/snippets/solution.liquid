<script>
	var HRSolution = {
		init: function() {
			var that = this;
			that.fixViTri();
			that.checkUrl();
			that.scroll();
			that.clickSolution();
		},	
		fixViTri: function() {
			if ( !! jQuery('.aside-groupNav').length) {
				var product_info = jQuery('.content-list');
				var el = jQuery('.aside-groupNav');
				var stickyTop = (el.offset().top) - 80; // returns number
				var stickwidth = (el.width()) + 0;
				jQuery(window).scroll(function() { // scroll event
					var footerTop = (jQuery('.support-zone-4').offset().top) - 80; // returns number
					var stickyHeight = el.height();
					var height_info = product_info.height();
					var limit = footerTop - stickyHeight - 50;
					var windowTop = jQuery(window).scrollTop(); // returns number
					var windowsize = jQuery(window).width();
					if (windowsize > 991) {
						if (height_info <= stickyHeight) {} 
						else {
							if (stickyTop < windowTop) {
								el.css({
									position: 'fixed',
									top: 100,
									width: stickwidth,
								});
								jQuery('.sidebar-sticky').height(stickyHeight);
							} else {
								el.css({
									position: 'static',
									top: 100,
								});
							}
							if (limit < windowTop) {
								var diff = limit - windowTop;
								el.css({
									top: diff
								});
							}
						}
					}
					{%comment%}
					jQuery('.content-list > .item').each(function(){
						if ((jQuery(this).find('h3').offset().top - jQuery(window).scrollTop() + 500) < jQuery(window).height() && (jQuery(this).find('h3').offset().top - jQuery(window).scrollTop()) > 0) {
							jQuery('.menuScroll-link li').removeClass('active');
							jQuery('.menuScroll-link li[data-id="'+jQuery(this).attr('id')+'"]').addClass('active');
							return;
						} 
						{%if category.id == 42000065889111%}
						if ((jQuery(this).find('h2').offset().top - jQuery(window).scrollTop() + 500) < jQuery(window).height() && (jQuery(this).find('h2').offset().top - jQuery(window).scrollTop()) > 0) {
							jQuery('.menuScroll-link li').removeClass('active');
							jQuery('.menuScroll-link li[data-id="'+jQuery(this).attr('id')+'"]').addClass('active');
							return;
						} 
						 {%endif%}
						 })
						 {%endcomment%}
						 {%if category.id == 42000068125%}
						 jQuery('.content-list h2').each(function(){
							 if ((jQuery(this).offset().top - jQuery(window).scrollTop() + (window.innerHeight / 2 + 130)) < jQuery(window).height() && (jQuery(this).offset().top - jQuery(window).scrollTop()) > 0) {
								 jQuery('.menuScroll-link li').removeClass('active');
								 jQuery('.menuScroll-link li[data-id="'+jQuery(this).parent().attr('id')+'"]').addClass('active');
								 return;
							 } 
						 })
							{%endif%}
							jQuery('.content-list h3').each(function(){
								if ((jQuery(this).offset().top - jQuery(window).scrollTop() + (window.innerHeight / 2 + 130)) < jQuery(window).height() && (jQuery(this).offset().top - jQuery(window).scrollTop()) > 0) {
									jQuery('.menuScroll-link li').removeClass('active');
									jQuery('.menuScroll-link li[data-id="'+jQuery(this).parent().attr('id')+'"]').addClass('active');
									return;
								} 
							})
							});
						 }
						 },
							 checkUrl: function(){
								 var url = window.location.href;
								 var id = '';
								 if (url.indexOf('#') > -1){
									 id = url.split('#')[1];
									 var split = id.indexOf('&');

									 if(split < 0) {}
									 else{
										 id = id.substring(0, split);
									 }
									 /*setTimeout(function() {
					jQuery("html,body").animate({ scrollTop: jQuery('#'+id).offset().top - 80 }, 600)	;
				}, 850);*/
									 jQuery('#'+id).get(0).scrollIntoView();
								 }
							 },
								 scroll: function(){
									 var url = window.location.href;
									 jQuery('.menuScroll-link li').click(function(){
										 var id = jQuery(this).attr('data-id');
										 if(url.indexOf('#') > -1){
											 url = url.split('#')[0]
										 }
										 window.location.href = url + '#'+id;
										 console.log('a'+id);
										 //jQuery('#'+id).get(0).scrollIntoView();
										 jQuery("html,body").animate({ scrollTop: jQuery('#'+id).offset().top - 90 }, 100)	;
										 /*setTimeout(function() {
					jQuery("html,body").animate({ scrollTop: jQuery('#'+id).offset().top - 90 }, 100)	;
				}, 50);*/
									 })

								 },
									 clickSolution: function(){
										 if(jQuery(window).width() < 992){
											 jQuery('.content-list > .item').each(function(){
												 if(jQuery(this).find('.wrapper').hasClass('show') == true){
													 setTimeout(function() {
														 jQuery(this).find('.wrapper').height(jQuery(this).find('.list-item').outerHeight(true));
													 }, 100);
												 }else{
													 jQuery(this).find('.wrapper').height(0);
												 }
											 })
											 jQuery('.content-list > .item .title').click(function(){
												 var check = jQuery(this).attr('data-check'), id = jQuery(this).attr('data-id');
												 if(check == 'true'){
													 jQuery(this).attr('data-check', false);
													 jQuery(this).removeClass('check');
													 jQuery(this).parent().find('.wrapper').height(0);
												 }else{
													 jQuery(this).attr('data-check', true);
													 jQuery(this).addClass('check');
													 jQuery(this).parent().find('.wrapper').height(jQuery(this).parent().find('.list-item').outerHeight(true));
												 }
											 })
										 }
									 }
						};	
						jQuery(document).ready(function(){	
							HRSolution.init(); 	
						});

</script>






