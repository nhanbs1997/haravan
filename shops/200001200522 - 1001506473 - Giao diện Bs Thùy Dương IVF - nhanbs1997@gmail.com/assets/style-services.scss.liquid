{%- assign webfont_title = settings.base_font_title | split : ':' | first -%}
$colorText: {{settings.shop_text_color}};	
$colorMain: {{ settings.shop_main_color | default: '#000000' }};
[class^="section-page-"] {
	padding: 80px 0;
}
@media(max-width: 767px){
	[class^="section-page-"] {
		padding: 40px 0;
	}
}
.btn-scroll{
	display: inline-block;
	width: 30px;
	height: 30px;
	svg{width: 16px;height: 16px;transition: all 0.3s;}
	&:hover{
		svg{
			transform: translateY(8px);
		}
	}
}
#btn-scroll{
	scroll-margin-block-start: 110px;
}
.section-breadcrumb{
	padding: 100px 0 40px;
	h1{font-size: 56px;}
	@media(max-width: 767px){
		padding: 60px 0 20px;
		h1{
			font-size: 28px;
		}
	}
}
.section-page-service{
	.list-service {
		justify-content: center;
		gap: 30px;
		margin: 0;
		.service-item{
			-ms-flex: 0 0 calc(100%/4 - 24px);
			flex: 0 0 calc(100%/4 - 24px);
			max-width: calc(100%/4 - 24px);
			.item-img{
				margin-bottom: 25px;
				img{max-height: 60px;transition: all 0.5s;}
			}
			.item-detail{
				.title{font-size: 30px;margin-bottom: 20px;letter-spacing: 3px;}
				.desc{font-size: 18px;color: color-mix(in srgb, {{settings.shop_text_color}} 60%, transparent);margin-bottom: 30px;}
			}
		}
	}
	@media(min-width: 992px){
		.list-service {
			.service-item{
				position: relative;
				.item-detail{
					overflow: hidden;
					.link{
						--left: calc(-100% + 20px);
						transition: all 0.5s;
						display: inline-block;
						transform: translateX(var(--left));
						font-weight: 600;
					}
				}
				&:hover{
					.item-img img{filter: grayscale(100%);-webkit-filter: grayscale(100%);}
					.item-detail{
						.link{
							transform: translateX(0);
						}
					}
				}
			}
		}
	}
	@media(max-width: 991px){
		text-align: center;
		.list-service{
			.service-item{
				-ms-flex: 0 0 calc(50% - 15px);
				flex: 0 0 calc(50% - 15px);
				max-width: calc(50% - 15px);
			}
		}
	}
	@media(max-width: 767px){
		.list-service{
			.service-item{
				-ms-flex: 0 0 100%;
				flex: 0 0 100%;
				max-width: 100%;
				padding: 0;
				.item-img {
					margin-bottom: 10px;
					img{max-height: 50px;}
				}
				.item-detail {
					.title {
						font-size: 18px;
						margin-bottom: 10px;
					}
					.desc{
						font-size: 14px;
						margin-bottom: 10px;
					}
				}
			}
		}
	}
}
.section-page-about{
	background: #F7F7F9;padding-bottom: 160px;
	.about-banner{
		position: relative;
		.banner-item{
			&--1{
				width: 75%;
				margin-left: auto;
			}
			&--2{
				position: absolute;
				top: 45%;
				left: 15px;
				width: 50%;
			}
		}
	}
	.list-desc {
		display: flex;
		flex-flow: wrap;
		gap: 10px 20px;
		list-style: disc;
		padding-left: 20px;
		.desc-item{
			-ms-flex: 0 0 calc(50% - 10px);
			flex: 0 0 calc(50% - 10px);
			max-width: calc(50% - 10px);
			font-size: 18px;
			color: color-mix(in srgb, {{settings.shop_text_color}} 60%, transparent);
			&::marker{
				color: var(--shop-color-main);
			}
		}
	}
	@media(min-width: 1200px){
		.about-content{padding-left: 100px;}
	}
	@media(max-width: 991px){
		.about-banner{
			margin-top: 30px;
		}
	}
	@media(max-width: 767px){
		padding-bottom: 80px;
		.about-content{
			text-align: center;
		}
		.list-desc {
			.desc-item{
				font-size: 14px;
				text-align: left;
			}
		}
	}
}
.section-page-price{
	.price-item{
		background: #f7f7f9;
		padding: 70px 30px;
		-webkit-box-shadow: 0 23px 90px rgba(0, 0, 0, 0.05);
		-ms-box-shadow: 0 23px 90px rgba(0, 0, 0, 0.05);
		box-shadow: 0 23px 90px rgba(0, 0, 0, 0.05);
		.title{
			font-size: 22px;
			font-weight: 600;
			margin-bottom: 10px;
		}
		.num{
			font-size: 40px;
			font-weight: 600;
			margin-bottom: 10px;
			transition: all 0.45s;
		}
		.desc{
			color: color-mix(in srgb, {{settings.shop_text_color}} 40%, transparent);
		}
		.list-desc {
			margin: 40px 0;
			.desc-item{
				margin-bottom: 8px;
				color: color-mix(in srgb, {{settings.shop_text_color}} 60%, transparent);
				svg{fill: var(--shop-color-button);}
			}
		}
		.btn-more{
			.button{
				padding: 15px 35px;
				background-color: #f7f7f9;
				border: 1px solid var(--shop-color-text);
				color: var(--shop-color-text);
				&:before{
					content: none;
				}
				&:hover{
					background-color: var(--shop-color-button);
					border-color: var(--shop-color-button);
					color: var(--shop-color-button-text);
				}
			}
		}
		&--2{
			position: relative;
			background-image: url('{{ settings.page_price_2_img }}');
			background-size: cover;
			background-position: center;
			color: #fff;
			&:before{
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: color-mix(in srgb, {{ settings.shop_main_color | default: '#000000' }} 90%, transparent); 
			}
			.item-content{position: relative;}
			.desc, .list-desc .desc-item{
				color: #fff;
			}
			.list-desc .desc-item svg{fill: #fff;}
			.btn-more{
				.button{
					background-color: transparent;
					border-color: #fff;
					color: #fff;
					&:hover{
						background-color: #fff;
						border-color: #fff;
						color: #0c0f26;
					}
				}
			}
			&:hover{
				.btn-more{
					.button{
						background-color: #fff;
						border-color: #fff;
						color: #0c0f26;
					}
				}
			}
		}
		&:not(.price-item--2){
			&:hover{
				.num{color: var(--shop-color-button);}
				.btn-more{
					.button{
						background-color: var(--shop-color-button);
						border-color: var(--shop-color-button);
						color: var(--shop-color-button-text);
					}
				}
			}
		}
	}
	@media(max-width: 991px){
		.row{gap: 20px;}
	}
	@media(max-width: 767px){
		.price-item{
			padding: 50px 20px;
			.title{
				font-size: 18px;
			}
			.num{
				font-size: 30px;
			}
			.list-desc {
				margin: 20px 0;
			}
			.btn-more{
				.button{
					padding: 10px 35px;
				}
			}
		}
	}
}
@media(max-width: 767px){
	.section-page-price{
		.price-list.page-price-slider{
			display: block;
			gap: 0;
			margin-left: 0;
			margin-right: 0;
			.owl-item > .col-lg-4{
				-ms-flex: 0 0 100%;
				flex: 0 0 100%;
				max-width: 100%;
				padding-left: 15px;
				padding-right: 15px;
			}
			.owl-dots{margin-top: 20px;}
		}
	}
}


@media (max-width: 767px){
  .price-list .col-12{padding: 0}
  .price-list .owl-nav button span {
    background: #ca3394;
    color: #fff;
    display: inline-block;
    width: 30px;
    height: 30px;
    margin-top: 20px;
    line-height: 28px;
    border-radius: 50%;
    margin: 20px 5px 0;
}
   .price-list .owl-nav button:focus{
     outline: none
   }
}
@media (max-width: 991px) {
    .section-page-price .row {
        /* gap: 20px; */
      gap: 0 !important;
      margin: 0 !important
    }
}

@media (max-width: 767px) {
  .section-page-service .list-service .service-item .item-img img {
    max-height: 50px;
    width: auto;
    margin: 0 auto;
  }

  .section-page-service .list-service.owl-carousel {
    display: block;
    gap: 0;
    margin-left: 0;
    margin-right: 0;
  }

  .section-page-service .list-service.owl-carousel .owl-item > .service-item {
    display: block;
    width: 100%;
    max-width: 100%;
    padding-left: 15px;
    padding-right: 15px;
  }

  .section-page-service .list-service.owl-carousel .owl-dots {
    margin-top: 20px;
  }

  .section-page-service .list-service.owl-carousel .owl-nav button span {
    display: inline-block;
    width: 30px;
    height: 30px;
    margin: 20px 5px 0;
    border-radius: 50%;
    background: var(--shop-color-button, #ca3394);
    color: var(--shop-color-button-text, #fff);
    line-height: 28px;
  }

  .section-page-service .list-service.owl-carousel .owl-nav button:focus {
    outline: none;
  }
}
