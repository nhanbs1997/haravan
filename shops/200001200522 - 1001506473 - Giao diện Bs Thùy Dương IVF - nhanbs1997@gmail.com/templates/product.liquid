									<div id="buyxgety-product-list" data-id="{{product.id}}" data-title="{{product.title}}">
										<div class="buyxgety_content clearfix">									
											<div class="buyxgety_lists"></div>
										</div>
									</div>
								</div>
							</div>
							{% endif %}
