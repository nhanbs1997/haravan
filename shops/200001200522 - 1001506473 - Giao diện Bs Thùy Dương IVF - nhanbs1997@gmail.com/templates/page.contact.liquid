<div class="layout-pageContact">
	<div class="hidden">
		{%- include 'breadcrumb' -%}
	</div>
	<div class="wrapper-bodycontact">
		<div class="heading-pageDetail d-none"><div class="container"><h1>{{ page.title }}</h1></div></div>
		<div class="wrapbox-content-contact">
			{% if settings.google_maps_show and settings.google_maps_code != blank %}
			<div class="box-map-contact hrv-cf-google_maps_code" setting-id="google_maps_code" setting-type="textarea">
				{{ settings.google_maps_code }}
			</div>
			{% endif %}
			<div class="container">	
				<div class="row widthContent contact-info">
					<div class="col-lg-4 col-md-12 col-12 wrapbox-content-left">
						<div class="box-info-contact">
							{%if settings.contact_title != ''%}<h2 setting-id="contact_title" setting-type="text" class="hrv-cf-contact_title">{{settings.contact_title}}</h2>{%endif%}
							<ul class="infoList-contact">
								{%- if settings.contact_address != blank -%}
								<li>
									<p setting-id="contact_address" setting-type="text" class="hrv-cf-contact_address">{{settings.contact_address}}</p>
								</li>
								{%- endif -%}
								{%- if settings.contact_email != blank -%}
								<li class="email">
									<p><a href="mailto:{{settings.contact_email}}" setting-id="contact_email" setting-type="text" class="hrv-cf-contact_email">{{settings.contact_email}}</a></p>
								</li>
								{%- endif -%}
								{%- if settings.contact_phone != blank -%}
								<li class="phone">
									<p><a href="tel:{{settings.contact_phone  | replace: '.', ''| replace: ' ', ''}}" rel="noopener" setting-id="contact_phone" setting-type="text" class="hrv-cf-contact_phone">{{settings.contact_phone}}</a></p>
								</li>
								{%- endif -%}
							</ul>
							{%if settings.show_contact_social%}
							<ul class="contact-social">
								{%-if settings.social_link_facebook != blank -%}<li><a href="{{settings.social_link_facebook}}" target="_blank" rel="noopener" title="Facebook" aria-label="Facebook" setting-id="social_link_facebook" class="hrv-cf-social_link_facebook"><i class="fa fa-facebook"></i></a></li>	{%-endif-%}
								{%-if settings.social_link_youtube != blank -%}<li><a href="{{settings.social_link_youtube}}" target="_blank" rel="noopener" title="Youtube" aria-label="Youtube" setting-id="social_link_youtube" class="hrv-cf-social_link_youtube"><i class="fa fa-youtube-play"></i></a></li>	{%-endif-%}
								{%-if settings.social_link_instagram != blank -%}<li><a href="{{settings.social_link_instagram}}" target="_blank" rel="noopener" title="Instagram" aria-label="Instagram" setting-id="social_link_instagram" class="hrv-cf-social_link_instagram"><i class="fa fa-instagram"></i></a></li>	{%-endif-%}
								{%-if settings.social_link_tiktok != blank -%}<li class="social-svg"><a href="{{settings.social_link_tiktok}}" target="_blank" rel="noopener" title="Tiktok" aria-label="Tiktok" setting-id="social_link_tiktok" class="hrv-cf-social_link_tiktok"><svg xmlns="http://www.w3.org/2000/svg" x="0px" y="0px" width="48" height="48" viewBox="0 0 48 48"><path d="M 11.5 6 C 8.4802259 6 6 8.4802259 6 11.5 L 6 36.5 C 6 39.519774 8.4802259 42 11.5 42 L 36.5 42 C 39.519774 42 42 39.519774 42 36.5 L 42 11.5 C 42 8.4802259 39.519774 6 36.5 6 L 11.5 6 z M 11.5 9 L 36.5 9 C 37.898226 9 39 10.101774 39 11.5 L 39 36.5 C 39 37.898226 37.898226 39 36.5 39 L 11.5 39 C 10.101774 39 9 37.898226 9 36.5 L 9 11.5 C 9 10.101774 10.101774 9 11.5 9 z M 26.435547 13.023438 A 1.50015 1.50015 0 0 0 25 14.5 L 25 28 C 25 30.227598 23.227598 32 21 32 C 18.772402 32 17 30.227598 17 28 C 17 25.772402 18.772402 24 21 24 A 1.50015 1.50015 0 1 0 21 21 C 17.151598 21 14 24.151598 14 28 C 14 31.848402 17.151598 35 21 35 C 24.848402 35 28 31.848402 28 28 L 28 20.335938 C 29.268121 21.316987 30.78243 22 32.5 22 A 1.50015 1.50015 0 1 0 32.5 19 C 29.996501 19 28 17.003499 28 14.5 A 1.50015 1.50015 0 0 0 26.435547 13.023438 z"></path></svg></a></li>	{%-endif-%}
