							{%endif%}
						</div> 
					</div>
					<div class="col-lg-8 col-md-12 col-12 wrapbox-content-right">
						<div class="box-send-contact">
							<div id="col-left contactFormWrapper">
								{% form 'contact' %}
								{% if form.posted_successfully? %}
								<div class="alert alert-success">
									Cám ơn bạn đã liên hệ! Chúng tôi sẽ trả lời ngay khi có thể
								</div>
								{% endif %}
								<div class="contact-form">
									<div class="row">
										<div class="col-sm-12 col-xs-12">
											<div class="input-group">
												<svg width="20px" height="20px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM6 8a6 6 0 1 1 12 0A6 6 0 0 1 6 8zm2 10a3 3 0 0 0-3 3 1 1 0 1 1-2 0 5 5 0 0 1 5-5h8a5 5 0 0 1 5 5 1 1 0 1 1-2 0 3 3 0 0 0-3-3H8z" /></svg>
