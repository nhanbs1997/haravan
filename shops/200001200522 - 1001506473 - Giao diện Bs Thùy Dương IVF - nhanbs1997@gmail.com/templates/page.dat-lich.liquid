    <script>
  $(window).ready(function(){
    $('#datlich form.contact-form').submit(function(e){
      
      e.preventDefault();
      var self = $(this);
      var namee = self.find('input[name="contact[name]"]').val(),
            phonee = self.find('input[name="contact[phone]"]').val(),
            emaill = self.find('input[name="contact[email]"]').val(),
            message = '';
            message += "\nĐịa chỉ: "+ self.find('.diachi').val();
            message += "\nGiới tính: "+ self.find('input[type="radio"]:checked').val();
            message += "\nTriệu chứng: "+ self.find(".trieuchung").val();
        grecaptcha.ready(function() {
         grecaptcha.execute('6LchSLkqAAAAABVHBpeFgg8N-WgkYsr5fO6GUF_s', {action: 'submit'}).then(function(token) {
          self.find('input[name="g-recaptcha-response"]').val(token);
                $.ajax({
           type: 'POST',
           url:'/contact',
           data: "form_type=contact&utf8=✓&__RequestVerificationToken="+self.find('input[name="__RequestVerificationToken"]').val()+"&utf8=✓&contact[name]="+namee+"&contact[phone]="+phonee+"&contact[email]="+emaill+"&contact[body]="+message+"&g-recaptcha-response="+self.find('input[name="g-recaptcha-response"]').val(),
           success:function(data){
            alert("Đăng ký thành công!");
           }
          })
               })
        })
    })
  })
</script>