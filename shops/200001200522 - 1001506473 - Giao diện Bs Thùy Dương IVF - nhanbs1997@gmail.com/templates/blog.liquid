<div class="layout-blogs">
	{% paginate blog.articles by settings.blogs_pagination_limit %}
	<section class="section-breadcrumb text-center">
		<div class="container breadcrumb-content">
			<h1 class="title">{{blog.title}}</h1>
			<a href="#btn-scroll" class="btn-scroll">
				<svg xmlns="http://www.w3.org/2000/svg" width="14.626" height="8.639" viewBox="0 0 14.626 8.639"><g id="down-arrow" transform="translate(0 -70.698)"><g id="Group_8820" data-name="Group 8820" transform="translate(0 100.698)"><path id="Path_6507" data-name="Path 6507" d="M14.392,101.42l-.479-.482a.8.8,0,0,0-1.132,0L7.316,106.4l-5.472-5.472a.8.8,0,0,0-1.132,0l-.479.479a.8.8,0,0,0,0,1.131l6.515,6.538a.818.818,0,0,0,.567.257h0a.818.818,0,0,0,.566-.257l6.508-6.52a.808.808,0,0,0,.234-.571A.8.8,0,0,0,14.392,101.42Z" transform="translate(0 -130.698)"></path></g></g></svg>
			</a>
		</div>
		<div class="hidden">
			{%include 'breadcrumb'%}
		</div>
	</section>
	<div class="wrapper-contentBlogs" id="btn-scroll">
		<div class="container pd-top">
			<div class="row dFlex-row">
				<div class="col-lg-9 col-md-12 col-12 boxBlog-left">
					<div class="listBlogs-content">	
						<div class="list-article-content blog-posts row">
							{%if blog.articles.size == 0%}
							<p class="txt-noArticle">Chưa có bài viết nào trong mục này</p>
							{%else%}
							<!-- Begin: Nội dung blog -->      
							{% for article in blog.articles limit: settings.blogs_pagination_limit %}
							{% include 'article-image' with article:article %}
							<article class="article-loop">
								<div class="article-inner">				
									<div class="article-image">
										<a href="{{ article.url}}" class="blog-post-thumbnail" title="{{ article.title }}" rel="nofollow">
											<img class="lazyload" {%if forloop.first%} data-src="{{ imageUrl | product_img_url : '1024x1024' }}"{%else%}data-src="{{ imageUrl | product_img_url : 'grande' }}"{%endif%}
													 src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
													 alt="{{ article.title }}" >
										</a>
									</div>
									<div class="article-detail">	
										<div class="cate"><a href="{{article.blog.url}}"><span>{{ article.blog.title }}</span></a></div>
										<div class="article-title">
											<h3 class="post-title">
												<a href="{{ article.url}}" title="{{ article.title }}">{{ article.title }}</a>
											</h3>
										</div>		

										<p class="entry-content">{{ article.content | strip_html | truncatewords: 35 }}</p>

										<div class="article-post-meta">   
											{%comment%}<span class="author">bởi: {{article.author}}</span>{%endcomment%}
											<span class="date">                
												<time pubdate datetime="{{ article.published_at | date: '%d Tháng %m, %Y' }}">{{ article.published_at | date: '%d Tháng %m, %Y' }}</time>
											</span>
											{% if blog.comments_enabled? %}
											<span class="comment"><i class="comment-icon fa fa-comment-o"></i>
												<a href="{{ article.url }}">
													{{ article.comments_count }}<span> {{ article.comments_count | pluralize: 'Bình luận','Bình luận' }}</span>
												</a>
											</span>
											{% endif %}	
										</div>										
									</div>
								</div>						
							</article>
							{% endfor %}
							{%endif%}
						</div>
						<div class="pagination-shop pagi  text-center">				
							{% include 'pagination-default' %}				
						</div>
					</div>
				</div>
				<div class="col-lg-3 col-md-12 col-12 boxBlog-right">				
					{% include 'sidebar-blog' %}	
				</div>
			</div>
		</div>
	</div>
	{% endpaginate %}
</div>
