        }
        {% endcomment %}
        function activeTabMeta() {
          return APP_TABS.find((tab) => tab.id === activeTab) || APP_TABS[0];
        }
        function mobileTabbarHtml() {
          const primaryTabIds = ["tasks", "knowledge", "mindmap", "haravan-code"];
          const primaryTabs = APP_TABS.filter((tab) =>
            primaryTabIds.includes(tab.id),
          );
          const moreTabs = APP_TABS.filter(
            (tab) => !primaryTabIds.includes(tab.id),
          );
          const moreIsActive = moreTabs.some((tab) => tab.id === activeTab);
          return `<nav class="mobile-tabbar" aria-label="Điều hướng chính">
            ${primaryTabs
              .map(
                (tab) =>
                  `<button type="button" class="mobile-tabbar-item ${tab.id === activeTab ? "active" : ""}" data-action="select-tab" data-tab="${tab.id}" aria-current="${tab.id === activeTab ? "page" : "false"}"><span aria-hidden="true">${tab.icon}</span><span>${tab.label}</span></button>`,
              )
              .join("")}
            <button type="button" class="mobile-tabbar-item ${moreIsActive || mobileNavExpanded ? "active" : ""}" data-action="toggle-mobile-nav" aria-expanded="${mobileNavExpanded}"><span aria-hidden="true">⋯</span><span>Thêm</span></button>
          </nav>
          ${
            mobileNavExpanded
              ? `<nav class="mobile-nav-sheet" aria-label="Khu vực khác">${moreTabs
                  .map(
                    (tab) =>
                      `<button type="button" class="mobile-nav-sheet-item ${tab.id === activeTab ? "active" : ""}" data-action="select-tab" data-tab="${tab.id}"><span aria-hidden="true">${tab.icon}</span><span>${tab.label}</span></button>`,
                  )
                  .join("")}</nav>`
              : ""
          }`;
        }
        function workspaceTabsHtml() {
          return `<aside class="workspace-tabs">
        <div class="workspace-brand"><a href="/" class="workspace-brand-mark"></span><span>TODOLIST<br>TREE</a></div>
      <nav class="workspace-tab-list" role="tablist" aria-label="Khu vực ứng dụng">
        ${APP_TABS.map(
          (tab) => `<button type="button" class="workspace-tab ${tab.id === activeTab ? "active" : ""}" id="tab-${tab.id}" role="tab" aria-selected="${tab.id === activeTab}" aria-controls="panel-${tab.id}" data-action="select-tab" data-tab="${tab.id}"><span class="workspace-tab-icon" aria-hidden="true">${tab.icon}</span><span>${tab.label}</span></button>`,
        ).join("")}
      </nav>
    </aside>${mobileTabbarHtml()}`;
        }
        function tabPanelStart(tabId) {
          return `<section class="tab-panel ${activeTab === tabId ? "active" : ""}" id="panel-${tabId}" role="tabpanel" aria-labelledby="tab-${tabId}">`;
        }
        function setActiveTab(tabId) {
          if (!APP_TABS.some((tab) => tab.id === tabId)) return;
          if (tabId === activeTab) {
            if (!mobileNavExpanded) return;
            mobileNavExpanded = false;
            render();
            return;
          }
          mobileNavExpanded = false;
          activeTab = tabId;
          try {
            localStorage.setItem("todolist_active_tab", activeTab);
          } catch (e) {}
          render();
          requestAnimationFrame(() =>
            document.getElementById(`tab-${activeTab}`)?.focus(),
          );
        }
        function parkWorkspaceWidgets() {
          const staging = document.getElementById("left-sidebar");
          if (!staging) return;
          [
            document.getElementById("current-doing-widget"),
            document.getElementById("mini-timeline-widget"),
            document.getElementById("pomodoro-widget"),
          ]
            .filter(Boolean)
            .forEach((widget) => staging.appendChild(widget));
        }
        function mountWorkspaceWidgets() {
          const staging = document.getElementById("left-sidebar");
          const current = document.getElementById("current-doing-widget");
          const mini = document.getElementById("mini-timeline-widget");
          const pomodoro = document.getElementById("pomodoro-widget");
          const todayPomodoroSlot = document.getElementById(
            "today-pomodoro-slot",
          );
          const widgets = [current, mini, pomodoro].filter(Boolean);
          widgets.forEach((widget) => (widget.style.display = ""));
          if (activeTab === "tasks" && todayPomodoroSlot) {
            if (pomodoro) todayPomodoroSlot.appendChild(pomodoro);
            [current, mini].filter(Boolean).forEach((widget) => staging?.appendChild(widget));
          } else {
            widgets.forEach((widget) => staging?.appendChild(widget));
          }
        }

        // ---------- Dashboard tuần ----------
        function formatShortDate(dateStr) {
          const parts = String(dateStr || "").split("-");
          return parts.length === 3 ? `${parts[2]}/${parts[1]}` : "—";
        }
        function collectTaskNodes() {
          const nodes = [];
          const visit = (list) => {
            (list || []).forEach((node) => {
              if (
                !node._pinned &&
                !node._todayAuto &&
                node.kind !== "kienthuc"
              ) {
                nodes.push(node);
              }
              visit(node.children);
            });
          };
          getAllRootLists().forEach(visit);
          return nodes;
        }
        function getTodayCompletedTaskCount() {
          const completedIds = new Set();
          const todayKey = dateKey(new Date());
          ((state.completedArchive || {})[todayKey] || []).forEach((item) => {
            const id = item.taskId || item.id;
            if (id) completedIds.add(id);
          });
          // Dự phòng cho dữ liệu cũ chưa có lịch sử hoàn thành đầy đủ.
          collectTaskNodes().forEach((task) => {
            if (
              task.status === "done" &&
              task.endTime &&
              dateKey(new Date(task.endTime)) === todayKey
            ) {
              completedIds.add(task.id);
            }
          });
          return completedIds.size;
        }
        function getUnfinishedWorkTaskIds() {
          const ids = [];
          const visit = (list) => {
            (list || []).forEach((node) => {
              if (
                !node._pinned &&
                !node._todayAuto &&
                node.kind !== "kienthuc" &&
                node.status !== "done"
              ) {
                ids.push(node.id);
              }
              visit(node.children);
            });
          };
          // Thứ tự hiển thị trong tab Công việc: Hôm nay trước, rồi task gốc.
          if (state.todayTask) visit(state.todayTask.children);
          visit(state.tasks);
          return ids;
        }
        function updateNextUnfinishedTaskButton() {
          const button = document.getElementById("next-unfinished-task-btn");
          if (!button) return;
          const count = getUnfinishedWorkTaskIds().length;
          button.hidden = activeTab !== "tasks";
          button.disabled = count === 0;
          button.textContent = `Đi đến các task chưa làm${count ? ` (${count})` : ""}`;
          button.setAttribute(
            "aria-label",
            count
              ? `Đi đến task chưa làm, còn ${count} task`
              : "Không còn task chưa làm",
          );
        }
        function expandTaskParents(id) {
          let parent = findParentNodeAny(id);
          while (parent) {
            state.collapsed[parent.id] = false;
            parent = findParentNodeAny(parent.id);
          }
        }
        function goToNextUnfinishedTask() {
          const ids = getUnfinishedWorkTaskIds();
          if (!ids.length) {
            showToast("Không còn task chưa làm");
            return;
          }
          const currentIndex = ids.indexOf(unfinishedTaskNavigationCursorId);
          const nextId = ids[(currentIndex + 1) % ids.length];
          unfinishedTaskNavigationCursorId = nextId;
          if (!state.collapsedSections) state.collapsedSections = {};
          state.collapsedSections["tasks-task"] = false;
          expandTaskParents(nextId);
          render();
          requestAnimationFrame(() => {
            const row = document.querySelector(`[data-row-id="${nextId}"]`);
            if (!row) return;
            const reducedMotion =
              typeof window.matchMedia === "function" &&
              window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            row.scrollIntoView({
              behavior: reducedMotion ? "auto" : "smooth",
              block: "center",
            });
            row.focus({ preventScroll: true });
            row.classList.add("task-navigation-target");
            window.setTimeout(
              () => row.classList.remove("task-navigation-target"),
              1400,
            );
          });
        }

        function openTaskInWorkspace(id) {
          const task = findNodeAny(id);
          if (!task) return;
          mobileNavExpanded = false;
          if (!state.collapsedSections) state.collapsedSections = {};
          state.collapsedSections["tasks-task"] = false;
          expandTaskParents(id);
          activeTab = "tasks";
          try {
            localStorage.setItem("todolist_active_tab", activeTab);
          } catch (error) {}
          render();
          requestAnimationFrame(() => {
            const row = document.querySelector(`[data-row-id="${id}"]`);
            if (!row) return;
            const reducedMotion =
              typeof window.matchMedia === "function" &&
              window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            row.scrollIntoView({
              behavior: reducedMotion ? "auto" : "smooth",
              block: "center",
            });
            row.focus({ preventScroll: true });
            row.classList.add("task-navigation-target");
            window.setTimeout(
              () => row.classList.remove("task-navigation-target"),
              1400,
            );
          });
        }

        function normalizedCommandSearch(value) {
          return String(value || "")
            .toLocaleLowerCase("vi-VN")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/đ/g, "d");
        }

        function commandItemMatches(item, query) {
          if (!query) return true;
          const haystack = normalizedCommandSearch(
            `${item.title || ""} ${item.detail || ""}`,
          );
          return haystack.includes(query);
        }

        function activateCommandTab(tabId) {
          mobileNavExpanded = false;
          activeTab = tabId;
          try {
            localStorage.setItem("todolist_active_tab", activeTab);
          } catch (error) {}
          render();
        }

        function flattenCommandNodes(nodes, items) {
          (nodes || []).forEach((node) => {
            items.push(node);
            flattenCommandNodes(node.children, items);
          });
          return items;
        }

        function getCommandPaletteItems(query) {
          const normalizedQuery = normalizedCommandSearch(query);
          const quickActions = [
            {
              group: "Thao tác nhanh",
              icon: "＋",
              title: "Tạo task mới",
              detail: "Mở ô thêm task cấp một",
              run: () => {
                activeTab = "tasks";
                rootAddKind = "task";
                try {
                  localStorage.setItem("todolist_active_tab", activeTab);
                } catch (error) {}
                render();
                requestAnimationFrame(() =>
                  document.getElementById("root-add-input")?.focus(),
                );
              },
            },
            {
              group: "Thao tác nhanh",
              icon: "◷",
              title: "Mở lịch sử sao lưu",
              detail: "Xem và khôi phục các phiên bản dữ liệu",
              run: () => showBackupHistoryDialog(),
            },
          ];
          const destinations = APP_TABS.map(
            (tab) => ({
              group: "Điều hướng",
              icon: tab.icon,
              title: tab.label,
              detail: tab.description,
              run: () => activateCommandTab(tab.id),
            }),
          );
          const results = [...quickActions, ...destinations].filter((item) =>
            commandItemMatches(item, normalizedQuery),
          );

          if (!normalizedQuery) return results;

          const matchingTasks = collectTaskNodes()
            .filter((task) =>
              commandItemMatches(
                {
                  title: task.text,
                  detail: `${(task.tags || []).join(" ")} ${task.status || ""}`,
                },
                normalizedQuery,
              ),
            )
            .slice(0, 10)
            .map((task) => ({
              group: "Task",
              icon: task.status === "done" ? "✓" : "□",
              title: task.text || "Task chưa đặt tên",
              detail: [
                taskPriorityLabel(task.priority),
                ...(task.tags || []).map((tag) => `#${tag}`),
                task.dueDate ? `Hạn ${formatShortDate(task.dueDate)}` : "",
              ]
                .filter(Boolean)
                .join(" · "),
              run: () => openTaskInWorkspace(task.id),
            }));

          const mindmapNodes = flattenCommandNodes(
            state.mindmap?.root ? [state.mindmap.root] : [],
            [],
          )
            .filter((node) =>
              commandItemMatches(
                { title: node.text, detail: "Mindmap" },
                normalizedQuery,
              ),
            )
            .slice(0, 8)
            .map((node) => ({
              group: "Mindmap",
              icon: "⎇",
              title: node.text || "Nhánh chưa đặt tên",
              detail: "Mở và chọn nhánh trong Mindmap",
              run: () => {
                selectedMindmapNodeId = node.id;
                selectedMindmapNodeIds = new Set([node.id]);
                activateCommandTab("mindmap");
              },
            }));

          const codeNodes = flattenCommandNodes(state.haravanCode || [], [])
            .filter((node) =>
              commandItemMatches(
                { title: node.text, detail: "Haravan Code" },
                normalizedQuery,
              ),
            )
            .slice(0, 8)
            .map((node) => ({
              group: "Haravan Code",
              icon: "⌘",
              title: node.text || "Mục code chưa đặt tên",
              detail: "Mở kho Haravan Code",
              run: () => activateCommandTab("haravan-code"),
            }));
          return [...results, ...matchingTasks, ...mindmapNodes, ...codeNodes];
        }

        function closeCommandPalette() {
          document.getElementById("command-palette")?.remove();
          commandPaletteItems = [];
          commandPaletteActiveIndex = 0;
        }

        function renderCommandPaletteResults(query) {
          const palette = document.getElementById("command-palette");
          const results = palette?.querySelector(".command-palette-results");
          if (!results) return;
          commandPaletteItems = getCommandPaletteItems(query);
          commandPaletteActiveIndex = Math.min(
            commandPaletteActiveIndex,
            Math.max(0, commandPaletteItems.length - 1),
          );
          if (!commandPaletteItems.length) {
            results.innerHTML =
              '<div class="command-palette-empty">Không tìm thấy thao tác hoặc dữ liệu phù hợp.</div>';
            return;
          }
          let lastGroup = "";
          results.innerHTML = commandPaletteItems
            .map((item, index) => {
              const group =
                item.group !== lastGroup
                  ? `<div class="command-palette-group-label">${escapeHtml(item.group)}</div>`
                  : "";
              lastGroup = item.group;
              return `${group}<button type="button" class="command-palette-item ${index === commandPaletteActiveIndex ? "is-active" : ""}" data-command-index="${index}" role="option" aria-selected="${index === commandPaletteActiveIndex}"><span class="command-palette-item-icon" aria-hidden="true">${item.icon}</span><span class="command-palette-item-copy"><span class="command-palette-item-title">${escapeHtml(item.title)}</span><span class="command-palette-item-detail">${escapeHtml(item.detail || "")}</span></span></button>`;
            })
            .join("");
          results
            .querySelector(`[data-command-index="${commandPaletteActiveIndex}"]`)
            ?.scrollIntoView({ block: "nearest" });
        }

        function openCommandPalette() {
          const existingPalette = document.getElementById("command-palette");
          if (existingPalette) {
            existingPalette.querySelector(".command-palette-search")?.focus();
            return;
          }
          const palette = document.createElement("div");
          palette.id = "command-palette";
          palette.className = "command-palette-backdrop";
          palette.innerHTML = `<section class="command-palette" role="dialog" aria-modal="true" aria-label="Lệnh nhanh"><input class="command-palette-search" type="search" autocomplete="off" placeholder="Tìm task, nhánh hoặc thao tác..." aria-label="Tìm lệnh" /><div class="command-palette-results" role="listbox"></div><footer class="command-palette-footer"><span>↑ ↓ để chọn · Enter để mở</span><span>Esc để đóng</span></footer></section>`;
          document.body.appendChild(palette);
          const input = palette.querySelector(".command-palette-search");
          const runActiveCommand = () => {
            const command = commandPaletteItems[commandPaletteActiveIndex];
            if (!command) return;
            closeCommandPalette();
            command.run();
          };
          input.addEventListener("input", () => {
            commandPaletteActiveIndex = 0;
            renderCommandPaletteResults(input.value);
          });
          input.addEventListener("keydown", (event) => {
            if (event.key === "ArrowDown" || event.key === "ArrowUp") {
              event.preventDefault();
              if (!commandPaletteItems.length) return;
              const direction = event.key === "ArrowDown" ? 1 : -1;
              commandPaletteActiveIndex =
                (commandPaletteActiveIndex + direction + commandPaletteItems.length) %
                commandPaletteItems.length;
              renderCommandPaletteResults(input.value);
              return;
            }
            if (event.key === "Enter") {
              event.preventDefault();
              runActiveCommand();
              return;
            }
            if (event.key === "Escape") {
              event.preventDefault();
              closeCommandPalette();
            }
          });
          palette.addEventListener("click", (event) => {
            if (event.target === palette) {
              closeCommandPalette();
              return;
            }
            const option = event.target.closest("[data-command-index]");
            if (!option) return;
            commandPaletteActiveIndex = Number(option.dataset.commandIndex);
            runActiveCommand();
          });
          renderCommandPaletteResults("");
          input.focus();
        }

        function setDueDate(id, dueDate) {
          const node = findNodeAny(id);
          if (!node) return;
          node.dueDate = /^\d{4}-\d{2}-\d{2}$/.test(dueDate || "")
            ? dueDate
            : "";
          renderWithoutFlicker();
          scheduleAutoExport();
        }

        // ---------- drag & drop -> nest as child ----------
        function makeChild(draggedId, targetId) {
          if (draggedId === targetId) return;
          const draggedNode = findNodeAny(draggedId);
          const targetNode = findNodeAny(targetId);
          if (!draggedNode || !targetNode) return;
          if (draggedNode.kind !== targetNode.kind) {
            showToast("Không thể trộn Công việc và Kiến thức trong cùng nhánh");
            return;
          }
          if (isPinnedTodayTask(draggedNode)) {
            showToast(`${pinnedDayTaskLabel(draggedNode)} là task cố định và không thể di chuyển`);
            return;
          }
          if (isDescendant(draggedNode, targetId)) return; // prevent cycle
          const removed = removeNodeAny(draggedId);
          if (!removed) return;
          alphaInsert(targetNode.children, removed);
          state.collapsed[targetId] = false;
          renderWithoutFlicker();
          scheduleAutoExport();
        }
        function promoteTaskToRoot(id) {
          const parent = findParentNodeAny(id);
          if (!parent || parent._pinned) {
            showToast("Task này đã ở cấp 1 hoặc thuộc nhóm ngày cố định");
            return;
          }
          const childIndex = parent.children.findIndex((node) => node.id === id);
          if (childIndex === -1) return;

          let rootNode = parent;
          while (true) {
            const ancestor = findParentNodeAny(rootNode.id);
            if (!ancestor || ancestor._pinned) break;
            rootNode = ancestor;
          }
          const rootIndex = state.tasks.findIndex((node) => node.id === rootNode.id);
          if (rootIndex === -1) return;

          const [node] = parent.children.splice(childIndex, 1);
          state.tasks.splice(rootIndex + 1, 0, node);
          renderWithoutFlicker();
          restoreTaskRowFocus(id);
          scheduleAutoExport();
        }
        function restoreTaskRowFocus(id) {
          requestAnimationFrame(() => {
            document.querySelector(`[data-row-id="${id}"]`)?.focus();
          });
        }
        // Phương án thay thế kéo-thả cho bàn phím: Alt+→ để thụt lề,
        // Alt+← để đưa task ra cấp trên.
        function indentTask(id) {
          const siblings = findParentListAny(id);
          if (!siblings) return;
          const index = siblings.findIndex((node) => node.id === id);
          if (index <= 0) {
            showToast("Cần có task đứng trước để thụt lề");
            return;
          }
          const [node] = siblings.splice(index, 1);
          const newParent = siblings[index - 1];
          newParent.children.push(node);
          state.collapsed[newParent.id] = false;
          renderWithoutFlicker();
          restoreTaskRowFocus(id);
          scheduleAutoExport();
        }
        function outdentTask(id) {
          const parent = findParentNodeAny(id);
          if (!parent || parent._pinned) {
            showToast("Task này không thể đưa ra cấp trên");
            return;
          }
          const parentList = findParentListAny(parent.id);
          const childIndex = parent.children.findIndex((node) => node.id === id);
          const parentIndex = parentList
            ? parentList.findIndex((node) => node.id === parent.id)
            : -1;
          if (childIndex === -1 || parentIndex === -1) return;
          const [node] = parent.children.splice(childIndex, 1);
          parentList.splice(parentIndex + 1, 0, node);
          renderWithoutFlicker();
          restoreTaskRowFocus(id);
          scheduleAutoExport();
        }

        // ---------- calendar tasks (tạo bằng kéo-thả trên lịch) ----------
        // Mỗi việc trên lịch: {id, text, date, start, end, repeatDays}.
        // repeatDays rỗng => việc chỉ diễn ra đúng ngày `date`.
        // repeatDays có giá trị => lặp lại vào các thứ đó, kể từ ngày `date`.
        function addCalendarTask(text, date, start, end, repeatDays) {
          if (!text || !text.trim() || !date) return;
          if (!state.calendarTasks) state.calendarTasks = [];
          state.calendarTasks.push({
            id: genId("ct"),
            text: text.trim(),
            date,
            start,
            end,
            repeatDays: repeatDays && repeatDays.length ? repeatDays.slice() : [],
          });
          renderCalendarOnly();
          renderMiniTimeline();
          scheduleAutoExport();
        }
        function deleteCalendarTask(id) {
          state.calendarTasks = (state.calendarTasks || []).filter(
            (t) => t.id !== id,
          );
          renderCalendarOnly();
          renderMiniTimeline();
          scheduleAutoExport();
        }
        function calendarTaskOccursOn(t, dKey, weekday) {
          if (t.repeatDays && t.repeatDays.length) {
            return t.repeatDays.includes(weekday) && dKey >= t.date;
          }
          return t.date === dKey;
        }

        // ---------- Pomodoro ----------
        // Chu kì 1 pomodoro (120 phút): 25 làm - 5 nghỉ - 25 làm - 5 nghỉ - 25 làm - 5 nghỉ - 15 làm - 15 nghỉ
        // 1 ngày (24h) = 12 pomodoro liên tiếp, bắt đầu từ 0h.
        const POMODORO_PHASES = [
          { dur: 25, type: "work", label: "Làm việc" },
          { dur: 5, type: "break", label: "Nghỉ ngắn" },
          { dur: 25, type: "work", label: "Làm việc" },
          { dur: 5, type: "break", label: "Nghỉ ngắn" },
          { dur: 25, type: "work", label: "Làm việc" },
          { dur: 5, type: "break", label: "Nghỉ ngắn" },
          { dur: 15, type: "work", label: "Làm việc dài" },
          { dur: 15, type: "break", label: "Nghỉ dài" },
        ];
        const POMODORO_CYCLE_MIN = POMODORO_PHASES.reduce(
          (s, p) => s + p.dur,
          0,
        ); // 120 phút
        const POMODORO_PER_DAY = Math.round(1440 / POMODORO_CYCLE_MIN); // 12

        function pomodoroTone(phase) {
          if (phase.type === "work")
            return phase.dur === 15 ? "long-work" : "work";
          return phase.dur === 15 ? "long-break" : "short-break";
        }

        // Trả về danh sách các quãng nghỉ (nghỉ ngắn 5' và nghỉ dài 15') trong
        // 1 ngày (0-1440 phút) theo chu kỳ Pomodoro cố định, dùng để vẽ lên lịch.
        function computePomodoroBreakRanges() {
          const ranges = [];
          for (
            let cycleStart = 0;
            cycleStart < 1440;
            cycleStart += POMODORO_CYCLE_MIN
          ) {
            let acc = cycleStart;
            POMODORO_PHASES.forEach((phase) => {
              if (phase.type === "break") {
                ranges.push({
                  startMin: acc,
                  endMin: acc + phase.dur,
                  label: phase.label,
                });
              }
              acc += phase.dur;
            });
          }
          return ranges;
        }

        let pomodoroTickInterval = null;
        const POMODORO_RUNTIME_KEY = "__todolistPomodoroRuntime";

        // ---------- Pomodoro Audio & Notifications ----------
        let pomodoroAudioCtx = null;
        let pomodoroSoundEnabled = true;
        try {
          const savedSound = localStorage.getItem("todolist_pomodoro_sound");
          if (savedSound !== null) pomodoroSoundEnabled = savedSound === "true";
        } catch (e) {}

        function getPomodoroAudioContext() {
          if (!pomodoroAudioCtx) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (AudioCtx) pomodoroAudioCtx = new AudioCtx();
          }
          if (pomodoroAudioCtx && pomodoroAudioCtx.state === "suspended") {
            pomodoroAudioCtx.resume().catch(() => {});
          }
          return pomodoroAudioCtx;
        }

        function playPomodoroSound(type = "work") {
          if (!pomodoroSoundEnabled) return;
          try {
            const ctx = getPomodoroAudioContext();
            if (!ctx) return;

            const now = ctx.currentTime;

            if (type === "work") {
              // Giai điệu truyền cảm hứng 5 giây cho phiên Làm việc
              // C5 (523Hz), E5 (659Hz), G5 (784Hz), C6 (1046Hz), G5 (784Hz), C6 (1046Hz)
              const notes = [
                { freq: 523.25, start: 0.0, dur: 0.8 },
                { freq: 659.25, start: 0.6, dur: 0.8 },
                { freq: 783.99, start: 1.2, dur: 0.8 },
                { freq: 1046.50, start: 1.8, dur: 1.2 },
                { freq: 783.99, start: 2.8, dur: 0.8 },
                { freq: 1046.50, start: 3.4, dur: 1.5 },
              ];

              notes.forEach((note) => {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = "sine";
                osc.frequency.setValueAtTime(note.freq, now + note.start);

                const noteStart = now + note.start;
                const noteEnd = noteStart + note.dur;
                gain.gain.setValueAtTime(0, noteStart);
                gain.gain.linearRampToValueAtTime(0.25, noteStart + 0.05);
                gain.gain.exponentialRampToValueAtTime(0.001, noteEnd);

                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(noteStart);
                osc.stop(noteEnd);
              });
            } else {
              // Giai điệu thư giãn 5 giây cho phiên Nghỉ ngơi
              // G5 (784Hz), E5 (659Hz), D5 (587Hz), C5 (523Hz), G4 (392Hz), C5 (523Hz)
              const notes = [
                { freq: 783.99, start: 0.0, dur: 0.9 },
                { freq: 659.25, start: 0.7, dur: 0.9 },
                { freq: 587.33, start: 1.4, dur: 0.9 },
                { freq: 523.25, start: 2.1, dur: 1.1 },
                { freq: 392.00, start: 3.0, dur: 0.8 },
                { freq: 523.25, start: 3.6, dur: 1.4 },
              ];

              notes.forEach((note) => {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = "sine";
                osc.frequency.setValueAtTime(note.freq, now + note.start);

                const noteStart = now + note.start;
                const noteEnd = noteStart + note.dur;
                gain.gain.setValueAtTime(0, noteStart);
                gain.gain.linearRampToValueAtTime(0.22, noteStart + 0.06);
                gain.gain.exponentialRampToValueAtTime(0.001, noteEnd);

                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(noteStart);
                osc.stop(noteEnd);
              });
            }
          } catch (e) {
            console.error("Lỗi phát âm thanh Pomodoro:", e);
          }
        }

        function playTaskCheckSound(isDone = true) {
          if (!pomodoroSoundEnabled) return;
          try {
            const ctx = getPomodoroAudioContext();
            if (!ctx) return;
            const now = ctx.currentTime;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();

            osc.connect(gain);
            gain.connect(ctx.destination);

            if (isDone) {
              // Âm thanh pop giòn giã khi check hoàn thành (600Hz -> 1200Hz pop)
              osc.type = "sine";
              osc.frequency.setValueAtTime(600, now);
              osc.frequency.exponentialRampToValueAtTime(1200, now + 0.08);
              gain.gain.setValueAtTime(0.35, now);
              gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
              osc.start(now);
              osc.stop(now + 0.15);
            } else {
              // Âm thanh uncheck nhẹ nhàng (900Hz -> 450Hz)
              osc.type = "sine";
              osc.frequency.setValueAtTime(900, now);
              osc.frequency.exponentialRampToValueAtTime(450, now + 0.08);
              gain.gain.setValueAtTime(0.25, now);
              gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
              osc.start(now);
              osc.stop(now + 0.12);
            }
          } catch (e) {}
        }

        function togglePomodoroSound() {
          getPomodoroAudioContext();
          pomodoroSoundEnabled = !pomodoroSoundEnabled;
          try {
            localStorage.setItem("todolist_pomodoro_sound", pomodoroSoundEnabled);
          } catch (e) {}
          if ("Notification" in window && Notification.permission === "default") {
            Notification.requestPermission();
          }
          if (pomodoroSoundEnabled) {
            playPomodoroSound("work");
          }
          renderPomodoro();
        }

        let lastPomodoroPhaseKey = null;

        function checkPomodoroPhaseChange(info) {
          const currentKey = `${info.cycleIndex}-${info.phaseIndex}`;
          if (lastPomodoroPhaseKey !== null && lastPomodoroPhaseKey !== currentKey) {
            playPomodoroSound(info.phase.type);
            if ("Notification" in window && Notification.permission === "granted") {
              try {
                const title = info.phase.type === "work" ? "⏰ Đã đến giờ làm việc!" : "☕ Đã đến giờ nghỉ ngơi!";
                new Notification(title, {
                  body: `${info.phase.label} (${info.phase.dur} phút)`,
                });
              } catch (e) {}
            }
          }
          lastPomodoroPhaseKey = currentKey;
        }

        function getPomodoroRuntime() {
          if (!window[POMODORO_RUNTIME_KEY]) {
            window[POMODORO_RUNTIME_KEY] = {
              tickInterval: null,
            };
          }
          return window[POMODORO_RUNTIME_KEY];
        }

        function getPomodoroInfo(now) {
          const minutesSinceMidnight =
            now.getHours() * 60 + now.getMinutes() + now.getSeconds() / 60;
          const cycleIndex = Math.floor(
            minutesSinceMidnight / POMODORO_CYCLE_MIN,
          );
          let minuteInCycle = minutesSinceMidnight % POMODORO_CYCLE_MIN;
          const dayStart = new Date(now);
          dayStart.setHours(0, 0, 0, 0);
          const cycleStartMinute = cycleIndex * POMODORO_CYCLE_MIN;
          let acc = 0;
          for (let i = 0; i < POMODORO_PHASES.length; i++) {
            const phase = POMODORO_PHASES[i];
            if (minuteInCycle < acc + phase.dur) {
              const elapsedMin = minuteInCycle - acc;
              const remainingMin = phase.dur - elapsedMin;
              return {
                cycleIndex,
                phaseIndex: i,
                phase,
                elapsedSec: Math.round(elapsedMin * 60),
                remainingSec: Math.round(remainingMin * 60),
                progressPercent: (elapsedMin / phase.dur) * 100,
                phaseEndTime:
                  dayStart.getTime() +
                  (cycleStartMinute + acc + phase.dur) * 60 * 1000,
              };
            }
            acc += phase.dur;
          }
          // fallback (không nên xảy ra)
          const phase = POMODORO_PHASES[POMODORO_PHASES.length - 1];
          return {
            cycleIndex,
            phaseIndex: POMODORO_PHASES.length - 1,
            phase,
            elapsedSec: 0,
            remainingSec: phase.dur * 60,
            progressPercent: 0,
            phaseEndTime:
              dayStart.getTime() +
              (cycleStartMinute + POMODORO_CYCLE_MIN) * 60 * 1000,
          };
        }

        function getPomodoroWorkSecondsBetween(startValue, endValue) {
          const start = new Date(startValue).getTime();
          const end = new Date(endValue).getTime();
          if (!Number.isFinite(start) || !Number.isFinite(end) || end <= start)
            return 0;
          let cursor = start;
          let workMilliseconds = 0;
          while (cursor < end) {
            const info = getPomodoroInfo(new Date(cursor));
            const phaseEnd = Math.min(end, info.phaseEndTime);
            if (!Number.isFinite(phaseEnd) || phaseEnd <= cursor) break;
            if (info.phase.type === "work")
              workMilliseconds += phaseEnd - cursor;
            cursor = phaseEnd;
          }
          return workMilliseconds / 1000;
        }

        function getTaskDoingSummary(taskId, endValue = new Date()) {
          const cutoff = new Date(endValue).getTime();
          if (!taskId || !Number.isFinite(cutoff))
            return { seconds: 0, firstStart: null };
          let seconds = 0;
          let firstStart = null;
          (state.events || []).forEach((event) => {
            if (event.taskId !== taskId || !event.start) return;
            const start = new Date(event.start).getTime();
            const end = event.end
              ? Math.min(new Date(event.end).getTime(), cutoff)
              : cutoff;
            if (!Number.isFinite(start) || !Number.isFinite(end) || end <= start)
              return;
            if (firstStart === null || start < firstStart) firstStart = start;
            seconds += getPomodoroWorkSecondsBetween(start, end);
          });
          return { seconds, firstStart };
        }

        function getTodayDoingSeconds(now = new Date()) {
          const currentTime = new Date(now).getTime();
          if (!Number.isFinite(currentTime)) return 0;
          const todayStart = new Date(now);
          todayStart.setHours(0, 0, 0, 0);
          const startTime = todayStart.getTime();
          return (state.events || []).reduce((total, event) => {
            const eventStart = new Date(event.start).getTime();
            const eventEnd = event.end
              ? new Date(event.end).getTime()
              : currentTime;
            if (
              !Number.isFinite(eventStart) ||
              !Number.isFinite(eventEnd)
            )
              return total;
            const overlapStart = Math.max(eventStart, startTime);
            const overlapEnd = Math.min(eventEnd, currentTime);
            return overlapEnd > overlapStart
              ? total + getPomodoroWorkSecondsBetween(overlapStart, overlapEnd)
              : total;
          }, 0);
        }

        function getPomodoroDoingProgressSegments(
          taskStartValue,
          taskEndValue,
          now,
          cycleIndex,
        ) {
          const taskStart = new Date(taskStartValue).getTime();
          const taskEnd = new Date(taskEndValue).getTime();
          const currentTime = new Date(now).getTime();
          if (
            !Number.isFinite(taskStart) ||
            !Number.isFinite(taskEnd) ||
            !Number.isFinite(currentTime)
          )
            return [];
          const dayStart = new Date(now);
          dayStart.setHours(0, 0, 0, 0);
          const cycleStart =
            dayStart.getTime() + cycleIndex * POMODORO_CYCLE_MIN * 60 * 1000;
          const cycleEnd = cycleStart + POMODORO_CYCLE_MIN * 60 * 1000;
          const visibleStart = Math.max(taskStart, cycleStart);
          const visibleEnd = Math.min(taskEnd, currentTime, cycleEnd);
          if (visibleEnd <= visibleStart) return [];

          let phaseOffsetMinutes = 0;
          return POMODORO_PHASES.reduce((segments, phase) => {
            const phaseStart = cycleStart + phaseOffsetMinutes * 60 * 1000;
            const phaseEnd = phaseStart + phase.dur * 60 * 1000;
            phaseOffsetMinutes += phase.dur;
            if (phase.type !== "work") return segments;
            const start = Math.max(visibleStart, phaseStart);
            const end = Math.min(visibleEnd, phaseEnd);
            if (end <= start) return segments;
            segments.push({
              left: ((start - cycleStart) / (cycleEnd - cycleStart)) * 100,
              width: ((end - start) / (cycleEnd - cycleStart)) * 100,
            });
            return segments;
          }, []);
        }

        function formatMMSS(totalSeconds) {
          const m = Math.floor(totalSeconds / 60);
          const s = totalSeconds % 60;
          return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
        }

        function renderTodayPomodoroHtml(info, now) {
          const completedMinutes = POMODORO_PHASES.slice(0, info.phaseIndex).reduce(
            (total, phase) => total + phase.dur,
            0,
          );
          const elapsedMinutes = completedMinutes + info.elapsedSec / 60;
          const cycleProgress = (elapsedMinutes / POMODORO_CYCLE_MIN) * 100;
          const phaseLabel = `${info.phase.label} (${info.phase.dur} phút)`;
          const currentDoing = findCurrentDoingNode();
          const todayDoingSeconds = getTodayDoingSeconds(now);
          const segments = POMODORO_PHASES.map((phase, index) => {
            const tone = pomodoroTone(phase);
            const isCurrentPhase = index === info.phaseIndex;
            const width =
              index < info.phaseIndex
                ? 100
                : isCurrentPhase
                  ? info.progressPercent
                  : 0;
            return `<span class="today-pomodoro-segment tone-${tone}" style="flex:${phase.dur}" aria-label="${escapeHtml(phase.label)}, ${phase.dur} phút"><span class="today-pomodoro-segment-fill" style="width:${width}%;"></span></span>`;
          }).join("");
          const pomodoroNumber = (info.cycleIndex % POMODORO_PER_DAY) + 1;
          const doingTaskHtml = currentDoing
            ? `<div class="today-pomodoro-doing" aria-live="polite"><span class="today-pomodoro-doing-label">Đang làm</span><span class="today-pomodoro-doing-name">${escapeHtml(currentDoing.text)}</span><span class="today-pomodoro-doing-run" aria-hidden="true"></span></div>`
            : "";
          const doingProgress = (state.events || [])
            .filter((event) => event.start)
            .flatMap((event) =>
              getPomodoroDoingProgressSegments(
                event.start,
                event.end || now,
                now,
                info.cycleIndex,
              ),
            )
            .map(
              (segment) =>
                `<div class="today-pomodoro-doing-progress" style="left:${segment.left}%; width:${segment.width}%;" aria-hidden="true"></div>`,
            )
            .join("");

          const soundIcon = pomodoroSoundEnabled ? "🔔" : "🔕";
          const soundTitle = pomodoroSoundEnabled ? "Bật âm thanh Pomodoro" : "Tắt âm thanh Pomodoro";

          return `
        <div class="today-pomodoro-header">
          <div>
            <strong>Chu trình Pomodoro · ${POMODORO_CYCLE_MIN} phút</strong>
            <span style="display:block; font-size:11px; color:var(--ui-text-muted,#9b9ba1); margin-top:2px;">Chu trình ${pomodoroNumber}/${POMODORO_PER_DAY}</span>
          </div>
          <div class="today-pomodoro-actions">
            <button type="button" id="today-pomodoro-sound-toggle" class="today-pomo-action-btn ${pomodoroSoundEnabled ? "active" : ""}" title="${soundTitle}" aria-label="${soundTitle}">
              ${soundIcon} ${pomodoroSoundEnabled ? "Âm thanh: Bật" : "Âm thanh: Tắt"}
            </button>
            <button type="button" id="today-pomodoro-sound-test" class="today-pomo-action-btn" title="Thử âm thanh Pomodoro" aria-label="Thử âm thanh Pomodoro">
              🎵 Thử
            </button>
          </div>
        </div>
        <div class="today-pomodoro-cycle" role="progressbar" aria-label="Tiến độ chu trình Pomodoro 2 giờ" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${Math.round(cycleProgress)}" aria-valuetext="${escapeHtml(phaseLabel)}, còn ${formatMMSS(info.remainingSec)}">
          ${segments}
          ${doingProgress}
        </div>
        <div class="today-pomodoro-meta">
          <span class="today-pomodoro-status">${escapeHtml(phaseLabel)}</span>
          <span>Còn ${formatMMSS(info.remainingSec)}</span>
        </div>
        <div class="today-pomodoro-total"><span>Hôm nay đã Doing</span><strong>${formatElapsed(Math.floor(todayDoingSeconds))}</strong></div>
        ${doingTaskHtml}
      `;
        }

        function renderPomodoro() {
          const widget = document.getElementById("pomodoro-widget");
          if (!widget) return;
          const now = new Date();
          const info = getPomodoroInfo(now);

          checkPomodoroPhaseChange(info);

          const pomodoroNumber = (info.cycleIndex % POMODORO_PER_DAY) + 1;
          const phaseLabel = `${info.phase.label} (${info.phase.dur}p)`;
          const isTodayPomodoroBar = !!widget.closest("#today-pomodoro-slot");

          if (isTodayPomodoroBar) {
            widget.innerHTML = renderTodayPomodoroHtml(info, now);
            document
              .getElementById("today-pomodoro-sound-toggle")
              ?.addEventListener("click", () => togglePomodoroSound());
            document
              .getElementById("today-pomodoro-sound-test")
              ?.addEventListener("click", () => {
                getPomodoroAudioContext();
                playPomodoroSound(info.phase.type);
              });
            return;
          }

          const collapsedPomo = isSectionCollapsed("pomodoro");
          widget.innerHTML = `
        <div class="pomodoro-title widget-title-flex">
          <span>Pomodoro ${pomodoroNumber}/${POMODORO_PER_DAY}</span>
          <div style="display:flex; align-items:center; gap:4px;">
            <button type="button" class="widget-toggle-btn" id="pomodoro-sound-toggle-side" title="${pomodoroSoundEnabled ? "Tắt âm thanh" : "Bật âm thanh"}" aria-label="Bật/Tắt âm thanh">${pomodoroSoundEnabled ? "🔔" : "🔕"}</button>
            <button type="button" class="widget-toggle-btn" id="pomodoro-collapse-btn" aria-label="${collapsedPomo ? "Hiện" : "Ẩn"} Pomodoro" aria-expanded="${!collapsedPomo}">${collapsedPomo ? "▸" : "▾"}</button>
          </div>
        </div>
        <div class="widget-body" style="${collapsedPomo ? "display:none;" : ""}">
          <div class="pomodoro-phase-label ${info.phase.type}">${escapeHtml(phaseLabel)}</div>
          <div class="pomodoro-timer">${formatMMSS(info.remainingSec)}</div>
          <div class="pomodoro-progress-track">
            <div class="pomodoro-progress-fill ${info.phase.type}" style="width:${info.progressPercent}%;"></div>
          </div>
          <div class="pomodoro-meta">Còn lại trong giai đoạn này</div>
        </div>
      `;
          document
            .getElementById("pomodoro-sound-toggle-side")
            ?.addEventListener("click", () => togglePomodoroSound());
          document
            .getElementById("pomodoro-collapse-btn")
            ?.addEventListener("click", () =>
              toggleWidgetCollapse("pomodoro", renderPomodoro),
            );
        }

        function startPomodoroTicking() {
          const runtime = getPomodoroRuntime();
          if (pomodoroTickInterval) clearInterval(pomodoroTickInterval);
          if (runtime.tickInterval) clearInterval(runtime.tickInterval);
          renderPomodoro();
          pomodoroTickInterval = setInterval(renderPomodoro, 1000);
          runtime.tickInterval = pomodoroTickInterval;
        }

        function formatElapsed(totalSeconds) {
          const h = Math.floor(totalSeconds / 3600);
          const m = Math.floor((totalSeconds % 3600) / 60);
          const s = totalSeconds % 60;
          if (h > 0)
            return `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
          return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
        }

        function renderCurrentDoingWidget() {
          const widget = document.getElementById("current-doing-widget");
          if (!widget) return;
          const n = findCurrentDoingNode();
          if (!n) {
            widget.innerHTML = `
        <div class="current-doing-title"><span class="current-doing-dot" style="background:#6e6e73; animation:none;"></span>Đang làm</div>
        <div class="current-doing-empty">Chưa có việc nào đang làm</div>
      `;
            return;
          }
          const elapsedSec = n.startTime
            ? Math.floor(getPomodoroWorkSecondsBetween(n.startTime, new Date()))
            : 0;
          widget.innerHTML = `
        <div class="current-doing-title"><span class="current-doing-dot"></span>Đang làm</div>
        <div class="current-doing-text">${escapeHtml(n.text)}</div>
        <div class="current-doing-time">⏱ ${formatElapsed(elapsedSec)}</div>
        <div class="current-doing-actions">
          <button class="btn btn-pending" data-action="pending" data-id="${n.id}">Pending</button>
          <button class="btn btn-done" data-action="done" data-id="${n.id}">Xong</button>
        </div>
      `;
          widget
            .querySelector('[data-action="pending"]')
            ?.addEventListener("click", () => setPending(n.id));
          widget
            .querySelector('[data-action="done"]')
            ?.addEventListener("click", () => setDone(n.id));
        }

        // ---------- Mini timeline: toàn bộ khung 8h-24h (16 tiếng) ----------
        const MINI_TL_PX_PER_MIN = 1.2; // 1.2px / phút => ~1152px cho 16 giờ

        function buildMiniTlBlock(
          top,
          height,
          text,
          typeClass,
          kind,
          id,
          title,
          z,
        ) {
          const delBtnHtml =
            kind === "pomo"
              ? ""
              : `<button type="button" class="cal-event-del" data-mini-kind="${kind}" data-mini-id="${id}" aria-label="Xóa ${escapeHtml(text)}">×</button>`;
          const pointerStyle = kind === "pomo" ? " pointer-events:none;" : "";
          return `<div class="cal-event ${typeClass}" style="position:absolute; left:2px; right:2px; top:${top}px; height:${height}px; z-index:${z};${pointerStyle}" title="${escapeHtml(title)}">
        <span class="cal-event-label">${escapeHtml(text)}</span>
        ${delBtnHtml}
      </div>`;
        }

        function renderMiniTimeline() {
          const widget = document.getElementById("mini-timeline-widget");
          if (!widget) return;
          const now = new Date();
          const todayKey = dateKey(now);
          const todayWeekday = now.getDay();
          const nowMin =
            now.getHours() * 60 + now.getMinutes() + now.getSeconds() / 60;
          const winStart = CAL_HOUR_START * 60;
          const winEnd = 1440;
          const trackHeight = (winEnd - winStart) * MINI_TL_PX_PER_MIN;

          const minToTop = (m) => (m - winStart) * MINI_TL_PX_PER_MIN;

          // vạch chia mốc mỗi giờ
          let rulerHtml = "";
          for (let m = winStart; m <= winEnd; m += 60) {
            const top = minToTop(m);
            const norm = ((Math.round(m) % 1440) + 1440) % 1440;
            rulerHtml += `<div class="mini-tl-ruler-line" style="top:${top}px;"></div><div class="mini-tl-ruler-label" style="top:${top}px;">${minutesToHHMMStr(norm)}</div>`;
          }

          let blocksHtml = "";
          let miniZ = 1;

          computePomodoroBreakRanges().forEach((b) => {
            if (b.endMin <= winStart || b.startMin >= winEnd) return;
            const cs = Math.max(b.startMin, winStart);
            const ce = Math.min(b.endMin, winEnd);
            const top = minToTop(cs);
            const height = Math.max((ce - cs) * MINI_TL_PX_PER_MIN, 6);
            blocksHtml += buildMiniTlBlock(
              top,
              height,
              "☕ " + b.label,
              "is-pomo-break",
              "pomo",
              "",
              `${b.label} (Pomodoro)`,
              0,
            );
          });

          state.events
            .filter((e) => e.date === todayKey)
            .forEach((ev) => {
              const start = new Date(ev.start);
              const end = ev.end ? new Date(ev.end) : now;
              let sm =
                start.getHours() * 60 +
                start.getMinutes() +
                start.getSeconds() / 60;
              let em =
                end.getHours() * 60 +
                end.getMinutes() +
                end.getSeconds() / 60;
              if (em <= sm) em = sm + 1;
              if (em < winStart || sm > winEnd) return;
              const cs = Math.max(sm, winStart);
              const ce = Math.min(em, winEnd);
              const top = minToTop(cs);
              const height = Math.max((ce - cs) * MINI_TL_PX_PER_MIN, 16);
              const isYellow = ev.end === null || ev.incomplete;
              const title = `${ev.text}: ${fmtTime(start)} – ${ev.end ? fmtTime(end) : "đang chạy"}`;
              blocksHtml += buildMiniTlBlock(
                top,
                height,
                ev.text,
                isYellow ? "is-doing" : "is-done",
                "event",
                ev.id,
                title,
                miniZ++,
              );
            });

          (state.calendarTasks || [])
            .filter((t) => calendarTaskOccursOn(t, todayKey, todayWeekday))
            .forEach((t) => {
              const [sh, sm2] = t.start.split(":").map(Number);
              const [eh, em2] = t.end.split(":").map(Number);
              let sm = sh * 60 + sm2;
              let em = eh * 60 + em2;
              if (em <= sm) em = sm + 30;
              if (em < winStart || sm > winEnd) return;
              const cs = Math.max(sm, winStart);
              const ce = Math.min(em, winEnd);
              const top = minToTop(cs);
              const height = Math.max((ce - cs) * MINI_TL_PX_PER_MIN, 16);
              const isRepeating = t.repeatDays && t.repeatDays.length > 0;
              const title = `${t.text}: ${t.start} – ${t.end}${isRepeating ? " (lặp lại)" : ""}`;
              blocksHtml += buildMiniTlBlock(
                top,
                height,
                (isRepeating ? "🔁 " : "") + t.text,
                "is-caltask",
                "caltask",
                t.id,
                title,
                0,
              );
            });

          const nowInRange = nowMin >= winStart && nowMin <= winEnd;
          const nowTop = minToTop(nowMin);
          const nowLineHtml = nowInRange
            ? `<div class="mini-tl-now-line" style="top:${nowTop}px;"><span class="mini-tl-now-dot"></span></div>`
            : "";

          const collapsedMini = isSectionCollapsed("mini-timeline");
          widget.innerHTML = `
        <div class="mini-timeline-title widget-title-flex">
          <span>⏱ Khung giờ (8h–24h)</span>
          <button type="button" class="widget-toggle-btn" id="mini-tl-collapse-btn" aria-label="${collapsedMini ? "Hiện" : "Ẩn"} khung giờ" aria-expanded="${!collapsedMini}">${collapsedMini ? "▸" : "▾"}</button>
        </div>
        <div class="widget-body" style="${collapsedMini ? "display:none;" : ""}">
          <div class="mini-timeline-track" style="height:${trackHeight}px;">
            ${rulerHtml}
            ${blocksHtml}
            ${nowLineHtml}
          </div>
        </div>
      `;
          document
            .getElementById("mini-tl-collapse-btn")
            ?.addEventListener("click", () =>
              toggleWidgetCollapse("mini-timeline", renderMiniTimeline),
            );
          widget.querySelectorAll(".cal-event-del").forEach((btn) => {
            btn.addEventListener("mousedown", (e) => e.stopPropagation());
            btn.addEventListener("click", (e) => {
              e.stopPropagation();
              const kind = btn.dataset.miniKind;
              const id = btn.dataset.miniId;
              if (kind === "event") deleteEvent(id);
              else deleteCalendarTask(id);
            });
          });
        }

        function renderNode(node, depth, prefix, branchColor, viewKind = "tasks") {
          const hasChildren = node.children.length > 0;
          // Bộ lọc/tìm kiếm chỉ quyết định node nào được hiển thị; không được
          // ghi đè thao tác thu gọn/mở rộng mà người dùng vừa chọn.
          const isCollapsed = !!state.collapsed[node.id];
          const isKnowledge = viewKind === "knowledge" || node.kind === "kienthuc";
          const isPinnedDay = isPinnedDayTask(node);
          const taskBranchColor = branchColor || TASK_BRANCH_COLORS[0];
          const progress = !isKnowledge && !isPinnedDay ? countProgress(node) : null;
          const taskProgressPercent =
            progress && progress.total
              ? Math.round((progress.done / progress.total) * 100)
              : !isKnowledge && !isPinnedDay && node.status === "done"
                ? 100
                : 0;
          const isNoteOpen = !isPinnedDay && openNoteEditorIds.has(node.id);
          const isTaskSelected =
            !isKnowledge && !isPinnedDay && selectedTaskIds.has(node.id);
          const contentInfo = noteContentInfo(node.note);
          const contentLabel = noteContentLabel(contentInfo);
          const contentTitle = noteContentTitle(contentInfo);
          const rowCls = isKnowledge
            ? "kienthuc"
            : node.status === "doing"
              ? "doing"
              : node.status === "done"
                ? "done"
              : node.status === "pending"
                ? "pending"
                : "";

          let html = `<div>`;
          const statusText = isKnowledge
            ? "Kiến thức"
            : node.status === "doing"
              ? "Đang làm"
              : node.status === "done"
                ? "Đã hoàn thành"
                : node.status === "pending"
                  ? "Đang chờ"
                  : "Chưa bắt đầu";
          const rowLabel = isPinnedDay
            ? `${pinnedDayTaskLabel(node)}. Task cố định để ghi các việc trong ngày.`
            : `${escapeHtml(node.text)}. Trạng thái: ${statusText}. Enter để thêm task cùng cấp, Tab để thêm task con. Alt Shift mũi tên phải để thụt lề, Alt Shift mũi tên trái để đưa ra cấp trên.`;
          html += `<div class="row ${rowCls}${isPinnedDay ? " fixed-today" : ""}${isTaskSelected ? " task-selected" : ""}" data-row-id="${node.id}" data-view-kind="${viewKind}" style="margin-left:${depth * 16}px;--task-branch-color:${taskBranchColor};--task-progress:${taskProgressPercent}%;" draggable="${!isPinnedDay}" tabindex="0" role="group" aria-roledescription="task" aria-keyshortcuts="Enter Tab" aria-selected="${isTaskSelected}" aria-label="${rowLabel}">`;
             html += isPinnedDay
               ? `<span class="drag-handle" aria-hidden="true"></span>`
               : `<span class="drag-handle" title="Kéo để chuyển thành con của task khác" aria-hidden="true">⠿</span>`;

             if (!isKnowledge && !isPinnedDay) {
               const isChecked = node.status === "done";
               const isPartial = !isChecked && progress && progress.done > 0 && progress.done < progress.total;
               const checkTitle = isChecked ? "Đánh dấu chưa xong" : "Đánh dấu đã hoàn thành";
               html += `<button type="button" class="task-checkbox ${isChecked ? "is-checked" : ""} ${isPartial ? "is-partial" : ""}" data-action="toggle-task-done" data-id="${node.id}" title="${checkTitle}" aria-label="${checkTitle} ${escapeHtml(node.text)}"></button>`;
             }

            html += `<span class="idx">${prefix}</span>`;
            if (isPinnedDay) {
              html += `<div class="label fixed-today-label">${escapeHtml(node.text)}</div>`;
            } else {
              html += `<div class="label ${node.status === "done" && !isKnowledge ? "done-text" : ""}" data-edit="${node.id}" tabindex="0" role="button" aria-label="Sửa tên ${escapeHtml(node.text)}. Trạng thái: ${statusText}">${escapeHtml(node.text)}</div>`;
            }
             if (!isPinnedDay)
               html += `<button type="button" class="btn btn-note note-content-info${contentInfo ? "" : " is-empty"}${isNoteOpen ? " active" : ""}" data-action="toggle-note" data-id="${node.id}" data-note-info-for="${node.id}" title="Mở Note · ${escapeHtml(contentTitle)}" aria-label="Mở Note của ${escapeHtml(node.text)}. ${escapeHtml(contentTitle)}" aria-expanded="${isNoteOpen}">${escapeHtml(contentLabel)}</button>`;

            if (!isPinnedDay)
              html += `<button type="button" class="btn btn-del mobile-task-delete" data-action="delete" data-id="${node.id}" title="Xóa task" aria-label="Xóa task ${escapeHtml(node.text)}">×</button>`;

              if (!isPinnedDay && (viewKind === "knowledge" || !isKnowledge)) {
                const taskBadges = taskBadgesHtml(node);
                if (taskBadges) html += `<span class="task-badges">${taskBadges}</span>`;
              }

            if (!isKnowledge && !isPinnedDay) {
              if (node.status === "doing" && node.startTime)
                html += `<span class="time-info">bắt đầu ${fmtTime(new Date(node.startTime))}</span>`;

              if (node.status === "doing")
                html += `<span class="status-tag doing">▶ DOING</span>`;
              if (node.status === "pending")
                html += `<span class="status-tag pending">⏸ PENDING</span>`;
            }
            if (hasChildren) {
              html += `<button type="button" class="toggle-btn" data-action="collapse" data-id="${node.id}" aria-label="${isCollapsed ? "Mở rộng" : "Thu gọn"} ${escapeHtml(node.text)}" aria-expanded="${!isCollapsed}">${isCollapsed ? "+" : "−"}</button>`;
              html += `<span class="pill-count task-child-count" title="${node.children.length} task con" aria-label="${node.children.length} task con">${node.children.length}</span>`;
            }
              html += `</div>`;

           if ((viewKind === "knowledge" || !isKnowledge) && !isPinnedDay)
             html += `<div style="margin-left:${(depth + 1) * 16}px;">${taskMetadataControlsHtml(node)}</div>`;

           html += `<div class="child-input-row" data-input-for="${node.id}" style="display:none; margin-left:${(depth + 1) * 16}px;">
       <input type="text" placeholder="Nhập nhiệm vụ con (ngăn cách bằng dấu chấm phẩy)" data-child-input="${node.id}" />
       <button data-action="confirm-add-child" data-id="${node.id}">Thêm</button>
     </div>`;

           if (!isKnowledge && !isPinnedDay) {
             html += `<div class="child-input-row sibling-input-row" data-sibling-input-for="${node.id}" style="display:none; margin-left:${depth * 16}px;">
       <input type="text" placeholder="Nhập task cùng cấp (ngăn cách bằng dấu chấm phẩy)" data-sibling-input="${node.id}" />
       <button data-action="confirm-add-sibling" data-id="${node.id}">Thêm</button>
     </div>`;
           }

          if (!isPinnedDay) {
            html += `<div class="note-editor-wrap" data-note-wrap-for="${node.id}" style="display:${isNoteOpen ? "block" : "none"}; margin-left:${(depth + 1) * 16}px;">
      <div class="note-toolbar" role="toolbar" aria-label="Công cụ soạn thảo nội dung task">
        <button type="button" class="note-tool-btn" data-note-cmd="bold" data-id="${node.id}" title="In đậm" aria-label="In đậm"><b>B</b></button>
        <button type="button" class="note-tool-btn" data-note-cmd="italic" data-id="${node.id}" title="In nghiêng" aria-label="In nghiêng"><i>I</i></button>
        <button type="button" class="note-tool-btn" data-note-cmd="underline" data-id="${node.id}" title="Gạch chân" aria-label="Gạch chân"><u>U</u></button>
        <button type="button" class="note-tool-btn" data-note-cmd="strikeThrough" data-id="${node.id}" title="Gạch ngang" aria-label="Gạch ngang"><s>S</s></button>
        <label class="note-tool-btn note-color-control" title="Màu chữ">A
          <input type="color" value="#f2f2f2" data-note-color="${node.id}" aria-label="Chọn màu chữ" />
        </label>
        <label class="note-tool-btn note-color-control" title="Màu nền chữ">▉
          <input type="color" value="#4b2d75" data-note-highlight="${node.id}" aria-label="Chọn màu nền chữ" />
        </label>
        <select class="note-font-size" data-note-font-size="${node.id}" aria-label="Chọn cỡ chữ" title="Cỡ chữ">
          <option value="">Cỡ chữ</option>
          <option value="2">12 px</option>
          <option value="3">14 px</option>
          <option value="4">16 px</option>
          <option value="5">18 px</option>
          <option value="6">24 px</option>
          <option value="7">30 px</option>
        </select>
        <span class="note-toolbar-divider" aria-hidden="true"></span>
        <button type="button" class="note-tool-btn" data-note-cmd="formatBlock:H1" data-id="${node.id}" title="Tiêu đề lớn">H1</button>
        <button type="button" class="note-tool-btn" data-note-cmd="formatBlock:H2" data-id="${node.id}" title="Tiêu đề vừa">H2</button>
        <button type="button" class="note-tool-btn" data-note-cmd="formatBlock:H3" data-id="${node.id}" title="Tiêu đề nhỏ">H3</button>
        <button type="button" class="note-tool-btn" data-note-cmd="formatBlock:BLOCKQUOTE" data-id="${node.id}" title="Trích dẫn" aria-label="Trích dẫn">❝</button>
        <button type="button" class="note-tool-btn" data-note-cmd="formatBlock:PRE" data-id="${node.id}" title="Khối mã" aria-label="Khối mã">&lt;/&gt;</button>
        <span class="note-toolbar-divider" aria-hidden="true"></span>
        <button type="button" class="note-tool-btn" data-note-cmd="insertUnorderedList" data-id="${node.id}" title="Danh sách gạch đầu dòng">• List</button>
        <button type="button" class="note-tool-btn" data-note-cmd="insertOrderedList" data-id="${node.id}" title="Danh sách đánh số">1. List</button>
        <button type="button" class="note-tool-btn" data-note-action="insert-link" data-id="${node.id}" title="Chèn liên kết" aria-label="Chèn liên kết">🔗 Link</button>
        <button type="button" class="note-tool-btn" data-note-action="insert-table" data-id="${node.id}" title="Chèn bảng" aria-label="Chèn bảng">▦ Bảng</button>
        <span class="note-toolbar-divider" aria-hidden="true"></span>
        <button type="button" class="note-tool-btn" data-note-action="insert-image-url" data-id="${node.id}" title="Chèn ảnh bằng URL" aria-label="Chèn ảnh bằng URL">🖼 URL</button>
        <label class="note-tool-btn note-upload-btn" title="Tải ảnh từ máy" aria-label="Tải ảnh từ máy">⬆ Ảnh
          <input type="file" accept="image/*" data-note-image="${node.id}" style="display:none;" />
        </label>
        <button type="button" class="note-tool-btn" data-note-action="toggle-source" data-id="${node.id}" title="Sửa mã HTML" aria-label="Sửa mã HTML" aria-pressed="false">&lt;/&gt; HTML</button>
      </div>
      <div class="note-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Nội dung task" data-note-editor="${node.id}">${sanitizeNoteHtml(node.note || "")}</div>
      <textarea class="note-source-editor" data-note-source="${node.id}" aria-label="Mã HTML của nội dung task" spellcheck="false" style="display:none;"></textarea>
    </div>`;
          }

          if (hasChildren) {
            html += `<div style="${isCollapsed ? "display:none;" : ""}">`;
            const visibleChildren =
              viewKind === "knowledge"
                ? visibleKnowledgeChildren(node.children)
                : visibleTaskChildren(node.children);
            visibleChildren.forEach((c, i) => {
              html += renderNode(
                c,
                depth + 1,
                `${prefix}.${i + 1}`,
                taskBranchColor,
                viewKind,
              );
            });
            if (node.children.length > 10 && visibleChildren.length > 0) {
              const lastChild = visibleChildren[visibleChildren.length - 1];
              html += `<div class="sibling-add-row" style="margin-left:${(depth + 1) * 16}px;">
      <button class="btn btn-add btn-add-sibling" data-action="add-sibling" data-id="${lastChild.id}" aria-label="Thêm task cùng cấp dưới ${escapeHtml(lastChild.text)}">+ Thêm task cùng cấp</button>
    </div>`;
            }
            html += `</div>`;
          }
          html += `</div>`;
          return html;
        }

        function renderHaravanCodeNode(node, depth, prefix) {
          const hasChildren = node.children.length > 0;
          const isCollapsed = !!state.haravanCodeCollapsed[node.id];
          const isCodeOpen = openHaravanCodeEditorIds.has(node.id);
          const lineCount = haravanCodeLineCount(node.code);
          let html = `<div class="haravan-code-node">`;
          html += `<div class="haravan-code-row" data-haravan-code-row="${node.id}" style="margin-left:${depth * 16}px;" draggable="true" tabindex="0" role="treeitem" aria-level="${depth + 1}" aria-expanded="${hasChildren ? !isCollapsed : ""}">`;
          html += `<span class="drag-handle" title="Kéo để chuyển thành nhánh con" aria-hidden="true">⠿</span>`;
          if (hasChildren) {
            html += `<button type="button" class="toggle-btn" data-action="toggle-haravan-code-collapse" data-id="${node.id}" aria-label="${isCollapsed ? "Mở rộng" : "Thu gọn"} ${escapeHtml(node.text)}" aria-expanded="${!isCollapsed}">${isCollapsed ? "+" : "−"}</button>`;
          } else {
            html += `<span class="toggle-btn leaf" aria-hidden="true"></span>`;
          }
          html += `<span class="idx">${prefix}</span>`;
          html += `<div class="haravan-code-title" data-haravan-code-edit="${node.id}" role="button" tabindex="0" title="Bấm để đổi tên">${escapeHtml(node.text)}</div>`;
          html += `<span class="haravan-code-meta">${lineCount ? `${lineCount} dòng` : "Chưa có code"}</span>`;
          html += `<div class="actions">`;
          html += `<button type="button" class="btn btn-add" data-action="add-haravan-code-child" data-id="${node.id}">+ Con</button>`;
          html += `<button type="button" class="btn btn-note${isCodeOpen ? " active" : ""}" data-action="toggle-haravan-code-editor" data-id="${node.id}" aria-expanded="${isCodeOpen}">&lt;/&gt; Code</button>`;
          html += `<button type="button" class="btn btn-del" data-action="delete-haravan-code" data-id="${node.id}">Xóa</button>`;
          html += `</div></div>`;

          html += `<div class="haravan-code-child-row" data-haravan-code-child-row="${node.id}" style="display:none; margin-left:${(depth + 1) * 16}px;">
      <input type="text" data-haravan-code-child-input="${node.id}" placeholder="Tên tính năng hoặc nhánh code con (dùng ; để thêm nhiều mục)" />
      <button type="button" class="btn btn-add" data-action="confirm-haravan-code-child" data-id="${node.id}">Thêm</button>
    </div>`;

          html += `<div class="haravan-code-editor-wrap" data-haravan-code-editor-wrap="${node.id}" style="display:${isCodeOpen ? "block" : "none"}; margin-left:${(depth + 1) * 16}px;">
      <div class="haravan-code-editor-toolbar">
        <span>Code / ghi chú kỹ thuật cho “${escapeHtml(node.text)}”</span>
        <button type="button" class="note-tool-btn" data-action="copy-haravan-code" data-id="${node.id}">Sao chép</button>
      </div>
      <textarea class="haravan-code-editor" data-haravan-code-editor="${node.id}" aria-label="Code Haravan cho ${escapeHtml(node.text)}" placeholder="Dán Liquid, HTML, CSS, JavaScript hoặc ghi chú kỹ thuật tại đây..." spellcheck="false">${escapeHtml(node.code)}</textarea>
    </div>`;

          if (hasChildren) {
            html += `<div role="group" style="${isCollapsed ? "display:none;" : ""}">`;
            node.children.forEach((child, index) => {
              html += renderHaravanCodeNode(
                child,
                depth + 1,
                `${prefix}.${index + 1}`,
              );
            });
            html += `</div>`;
          }
          html += `</div>`;
          return html;
        }

        // ---------- Calendar ----------
        function getWeekDates(offset) {
          const today = new Date();
          today.setHours(0, 0, 0, 0);
          const dow = today.getDay();
          const monday = new Date(today);
          monday.setDate(today.getDate() - ((dow + 6) % 7) + offset * 7);
          const days = [];
          for (let i = 0; i < 7; i++) {
            const d = new Date(monday);
            d.setDate(monday.getDate() + i);
            days.push(d);
          }
          return days;
        }
        function getDayDate(offset) {
          const d = new Date();
          d.setHours(0, 0, 0, 0);
          d.setDate(d.getDate() + offset);
          return d;
        }

        function renderCalendar() {
          const todayKey = dateKey(new Date());
          let days, navLabel;
          if (calView === "week") {
            days = getWeekDates(weekOffset);
            navLabel = `${days[0].getDate()}/${days[0].getMonth() + 1} – ${days[6].getDate()}/${days[6].getMonth() + 1}/${days[6].getFullYear()}`;
          } else {
            const d = getDayDate(dayOffset);
            days = [d];
            navLabel = `${DAY_NAMES[d.getDay()]}, ${d.getDate()}/${d.getMonth() + 1}/${d.getFullYear()}`;
          }

          let html = `<div class="cal-nav">
      <button data-action="cal-prev" aria-label="Xem khoảng thời gian trước">‹</button>
      <span class="cal-nav-label">${navLabel}</span>
      <button data-action="cal-next" aria-label="Xem khoảng thời gian tiếp theo">›</button>
    </div>`;

          html += `<div class="cal-scroll"><div class="cal-wrap" style="min-width:${days.length === 1 ? "320px" : "600px"};"><div class="cal-grid" id="cal-grid-inner" style="grid-template-columns: 44px repeat(${days.length}, 1fr);">`;
          html += `<div class="cal-corner"></div>`;
          days.forEach((d) => {
            const key = dateKey(d);
            html += `<div class="cal-head-cell ${key === todayKey ? "today" : ""}">${DAY_NAMES[d.getDay()]}<br>${d.getDate()}/${d.getMonth() + 1}</div>`;
          });

          for (let h = CAL_HOUR_START; h < 24; h++) {
            html += `<div class="cal-hour-label">${String(h).padStart(2, "0")}:00</div>`;
            days.forEach((d, dayIdx) => {
              html += `<div class="cal-cell" data-day="${dayIdx}" data-hour="${h}"></div>`;
            });
          }
          html += `</div></div></div>`;
          return { html, days };
        }

        function deleteEvent(id) {
          state.events = state.events.filter((e) => e.id !== id);
          renderCalendarOnly();
          renderMiniTimeline();
          scheduleAutoExport();
        }

        function placeEvents(days) {
          const grid = document.getElementById("cal-grid-inner");
          if (!grid) return;
          const dayKeys = days.map(dateKey);
          const now = new Date();
          const rangeStart = CAL_HOUR_START * 60;
          state.events.forEach((ev) => {
            const dayIdx = dayKeys.indexOf(ev.date);
            if (dayIdx === -1) return;
            const start = new Date(ev.start);
            const end = ev.end ? new Date(ev.end) : now;
            const startMinutes = start.getHours() * 60 + start.getMinutes();
            let endMinutes = end.getHours() * 60 + end.getMinutes();
            if (endMinutes <= startMinutes) endMinutes = startMinutes + 5;
            if (endMinutes <= rangeStart) return; // nằm hoàn toàn trước 8h -> ẩn
            const clampedStart = Math.max(startMinutes, rangeStart);
            const top = ((clampedStart - rangeStart) / 60) * ROW_H;
            const height = Math.max(
              ((endMinutes - clampedStart) / 60) * ROW_H,
              14,
            );
            const cell = grid.querySelector(
              `.cal-cell[data-day="${dayIdx}"][data-hour="${CAL_HOUR_START}"]`,
            );
            if (!cell) return;
            const block = document.createElement("div");
            const isYellow = ev.end === null || ev.incomplete;
            block.className =
              "cal-event " + (isYellow ? "is-doing" : "is-done");
            block.style.top = top + "px";
            block.style.height = height + "px";
            block.style.zIndex = String(calZCounter++);
            block.title = `${ev.text}: ${fmtTime(start)} – ${ev.end ? fmtTime(end) : "đang chạy"}${ev.incomplete ? " (đã bỏ Doing)" : ""}`;

            const label = document.createElement("span");
            label.className = "cal-event-label";
            label.textContent = ev.text;
            block.appendChild(label);

            const delBtn = document.createElement("button");
            delBtn.type = "button";
            delBtn.className = "cal-event-del";
            delBtn.textContent = "×";
            delBtn.title = "Xóa mốc thời gian này";
            block.appendChild(delBtn);

            cell.style.position = cell.style.position || "relative";
            cell.appendChild(block);
            delBtn.addEventListener("mousedown", (e) => {
              e.stopPropagation();
            });
            delBtn.addEventListener("click", (e) => {
              e.stopPropagation();
              deleteEvent(ev.id);
            });
          });
        }

        function placePomodoroBreaks(days) {
          const grid = document.getElementById("cal-grid-inner");
          if (!grid) return;
          const rangeStart = CAL_HOUR_START * 60;
          const breaks = computePomodoroBreakRanges();
          days.forEach((d, dayIdx) => {
            const cell = grid.querySelector(
              `.cal-cell[data-day="${dayIdx}"][data-hour="${CAL_HOUR_START}"]`,
            );
            if (!cell) return;
            breaks.forEach((b) => {
              if (b.endMin <= rangeStart) return;
              const clampedStart = Math.max(b.startMin, rangeStart);
              const top = ((clampedStart - rangeStart) / 60) * ROW_H;
              const height = Math.max(
                ((b.endMin - clampedStart) / 60) * ROW_H,
                6,
              );
              const block = document.createElement("div");
              block.className = "cal-event is-pomo-break";
              block.style.top = top + "px";
              block.style.height = height + "px";
              block.style.pointerEvents = "none";
              block.title = `${b.label} (Pomodoro)`;
              const label = document.createElement("span");
              label.className = "cal-event-label";
              label.textContent = "☕ " + b.label;
              block.appendChild(label);
              cell.style.position = cell.style.position || "relative";
              cell.appendChild(block);
            });
          });
        }

        function placeCalendarTasks(days) {
          const grid = document.getElementById("cal-grid-inner");
          if (!grid) return;
          const rangeStart = CAL_HOUR_START * 60;
          days.forEach((d, dayIdx) => {
            const dKey = dateKey(d);
            const weekday = d.getDay();
            const items = (state.calendarTasks || []).filter((t) =>
              calendarTaskOccursOn(t, dKey, weekday),
            );
            items.forEach((t) => {
              const [sh, sm] = t.start.split(":").map(Number);
              const [eh, em] = t.end.split(":").map(Number);
              let startMinutes = sh * 60 + sm;
              let endMinutes = eh * 60 + em;
              if (endMinutes <= startMinutes) endMinutes = startMinutes + 30;
              if (endMinutes <= rangeStart) return; // nằm hoàn toàn trước 8h -> ẩn
              const clampedStart = Math.max(startMinutes, rangeStart);
              const top = ((clampedStart - rangeStart) / 60) * ROW_H;
              const height = Math.max(
                ((endMinutes - clampedStart) / 60) * ROW_H,
                14,
              );
              const cell = grid.querySelector(
                `.cal-cell[data-day="${dayIdx}"][data-hour="${CAL_HOUR_START}"]`,
              );
              if (!cell) return;
              const isRepeating = t.repeatDays && t.repeatDays.length > 0;
              const block = document.createElement("div");
              block.className = "cal-event is-caltask";
              block.style.top = top + "px";
              block.style.height = height + "px";
              block.title = `${t.text}: ${t.start} – ${t.end}${isRepeating ? " (lặp lại " + t.repeatDays.map((wd) => DAY_NAMES[wd]).join(", ") + ")" : ""}`;
              block.dataset.caltaskId = t.id;

              const label = document.createElement("span");
              label.className = "cal-event-label";
              label.textContent = (isRepeating ? "🔁 " : "") + t.text;
              block.appendChild(label);

              const delBtn = document.createElement("button");
              delBtn.type = "button";
              delBtn.className = "cal-event-del";
              delBtn.textContent = "×";
              delBtn.title = "Xóa việc này";
              block.appendChild(delBtn);

              cell.style.position = cell.style.position || "relative";
              cell.appendChild(block);
              block.addEventListener("click", (e) => {
                e.stopPropagation();
                openCalTaskPopup(t, e.clientX, e.clientY);
              });
              delBtn.addEventListener("mousedown", (e) => {
                e.stopPropagation();
              });
              delBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                deleteCalendarTask(t.id);
              });
            });
          });
        }

        // ---------- kéo-thả để tạo việc mới trên lịch (kiểu Google Calendar) ----------
        let calDragMoveHandler = null;
        let calDragUpHandler = null;

        function minutesToHHMMStr(mins) {
          const m = Math.max(0, Math.min(1440, Math.round(mins)));
          const hh = Math.min(23, Math.floor(m / 60));
          const mm = m % 60;
          return `${String(hh).padStart(2, "0")}:${String(mm).padStart(2, "0")}`;
        }

        let calPopupOutsideHandler = null;

        function closeCalPopup() {
          const el = document.getElementById("cal-popup");
          if (el) el.remove();
          if (calPopupOutsideHandler) {
            document.removeEventListener("click", calPopupOutsideHandler);
            calPopupOutsideHandler = null;
          }
        }

        function positionCalPopup(popup, x, y) {
          document.body.appendChild(popup);
          const pw = popup.offsetWidth || 220;
          const ph = popup.offsetHeight || 200;
          let left = x;
          let top = y;
          if (left + pw > window.innerWidth) left = window.innerWidth - pw - 10;
          if (top + ph > window.innerHeight) top = window.innerHeight - ph - 10;
          popup.style.left = Math.max(8, left) + "px";
          popup.style.top = Math.max(8, top) + "px";
          if (calPopupOutsideHandler) {
            document.removeEventListener("click", calPopupOutsideHandler);
            calPopupOutsideHandler = null;
          }
          setTimeout(() => {
            calPopupOutsideHandler = (e) => {
              if (!popup.contains(e.target)) {
                closeCalPopup();
              }
            };
            document.addEventListener("click", calPopupOutsideHandler);
          }, 0);
        }

        function openCalQuickCreate(dateStr, startMin, endMin, x, y) {
          closeCalPopup();
          const selectedDays = new Set();
          const popup = document.createElement("div");
          popup.id = "cal-popup";
          popup.className = "cal-quickcreate";
          popup.innerHTML = `
      <div class="cal-popup-time">${minutesToHHMMStr(startMin)} – ${minutesToHHMMStr(endMin)}</div>
      <input type="text" class="cal-popup-input" placeholder="Tên công việc..." />
      <input type="date" class="cal-popup-date" value="${dateStr}" />
      <div class="cal-popup-repeat-label">Lặp lại vào (tùy chọn):</div>
      <div class="cal-popup-repeat">
        ${DAY_NAMES.map((d, i) => `<button type="button" class="cal-repeat-chip" data-weekday="${i}">${d}</button>`).join("")}
      </div>
      <div class="cal-popup-actions">
        <button type="button" class="cal-popup-cancel">Hủy</button>
        <button type="button" class="cal-popup-save">Lưu</button>
      </div>
    `;
          positionCalPopup(popup, x, y);
          popup.querySelectorAll(".cal-repeat-chip").forEach((chip) => {
            chip.addEventListener("click", () => {
              const wd = Number(chip.dataset.weekday);
              if (selectedDays.has(wd)) {
                selectedDays.delete(wd);
                chip.classList.remove("active");
              } else {
                selectedDays.add(wd);
                chip.classList.add("active");
              }
            });
          });
          const input = popup.querySelector(".cal-popup-input");
          const dateInput = popup.querySelector(".cal-popup-date");
          input.focus();
          function save() {
            if (!input.value.trim()) {
              input.focus();
              return;
            }
            addCalendarTask(
              input.value,
              dateInput.value || dateStr,
              minutesToHHMMStr(startMin),
              minutesToHHMMStr(endMin),
              [...selectedDays],
            );
            closeCalPopup();
          }
          popup.querySelector(".cal-popup-save").addEventListener("click", save);
          popup
            .querySelector(".cal-popup-cancel")
            .addEventListener("click", closeCalPopup);
          input.addEventListener("keydown", (e) => {
            if (e.key === "Enter") save();
            if (e.key === "Escape") closeCalPopup();
          });
          dateInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") save();
            if (e.key === "Escape") closeCalPopup();
          });
        }


        function openCalTaskPopup(task, x, y) {
          closeCalPopup();
          const isRepeating = task.repeatDays && task.repeatDays.length > 0;
          const popup = document.createElement("div");
          popup.id = "cal-popup";
          popup.className = "cal-quickcreate";
          popup.innerHTML = `
      <div class="cal-popup-time">${escapeHtml(task.text)}</div>
      <div class="cal-popup-repeat-label">${task.start} – ${task.end}${isRepeating ? " · lặp lại " + task.repeatDays.map((d) => DAY_NAMES[d]).join(", ") : ""}</div>
      <div class="cal-popup-actions">
        <button type="button" class="cal-popup-cancel">Đóng</button>
        <button type="button" class="cal-popup-delete">Xóa</button>
      </div>
    `;
          positionCalPopup(popup, x, y);
          popup
            .querySelector(".cal-popup-cancel")
            .addEventListener("click", closeCalPopup);
          popup.querySelector(".cal-popup-delete").addEventListener("click", () => {
            deleteCalendarTask(task.id);
            closeCalPopup();
          });
        }

        function attachCalendarDragCreate(days) {
          const grid = document.getElementById("cal-grid-inner");
          if (!grid) return;
          const dayKeys = days.map(dateKey);
          const rangeStart = CAL_HOUR_START * 60;
          const visibleHours = 24 - CAL_HOUR_START;
          let dragging = null; // {dayIdx, startMin, curMin}

          function minutesFromEvent(e, dayIdx) {
            const cell = grid.querySelector(
              `.cal-cell[data-day="${dayIdx}"][data-hour="${CAL_HOUR_START}"]`,
            );
            if (!cell) return rangeStart;
            const rect = cell.getBoundingClientRect();
            let y = e.clientY - rect.top;
            y = Math.max(0, Math.min(y, visibleHours * ROW_H - 1));
            let minutes = rangeStart + (y / ROW_H) * 60;
            minutes = Math.round(minutes / 15) * 15;
            return Math.max(rangeStart, Math.min(minutes, 1440));
          }

          function renderSelectionBox() {
            grid
              .querySelectorAll(".cal-drag-select")
              .forEach((el) => el.remove());
            if (!dragging) return;
            const cell = grid.querySelector(
              `.cal-cell[data-day="${dragging.dayIdx}"][data-hour="${CAL_HOUR_START}"]`,
            );
            if (!cell) return;
            const s = Math.min(dragging.startMin, dragging.curMin);
            const en = Math.max(dragging.startMin, dragging.curMin, s + 15);
            const box = document.createElement("div");
            box.className = "cal-drag-select";
            box.style.top = ((s - rangeStart) / 60) * ROW_H + "px";
            box.style.height =
              Math.max(((en - s) / 60) * ROW_H, 6) + "px";
            cell.style.position = cell.style.position || "relative";
            cell.appendChild(box);
          }

          grid.querySelectorAll(".cal-cell").forEach((cellEl) => {
            cellEl.addEventListener("mousedown", (e) => {
              if (e.button !== 0) return;
              if (e.target.closest(".cal-event")) return;
              const dayIdx = Number(cellEl.dataset.day);
              const startMin = minutesFromEvent(e, dayIdx);
              dragging = { dayIdx, startMin, curMin: startMin + 30 };
              renderSelectionBox();
              e.preventDefault();
            });
          });

          if (calDragMoveHandler)
            document.removeEventListener("mousemove", calDragMoveHandler);
          if (calDragUpHandler)
            document.removeEventListener("mouseup", calDragUpHandler);

          calDragMoveHandler = (e) => {
            if (!dragging) return;
            dragging.curMin = minutesFromEvent(e, dragging.dayIdx);
            renderSelectionBox();
          };
          calDragUpHandler = (e) => {
            if (!dragging) return;
            if (e.button !== 0) return;
            const d = dragging;
            dragging = null;
            grid
              .querySelectorAll(".cal-drag-select")
              .forEach((el) => el.remove());
            const s = Math.min(d.startMin, d.curMin);
            const en = Math.max(d.startMin, d.curMin, s + 15);
            openCalQuickCreate(dayKeys[d.dayIdx], s, en, e.clientX, e.clientY);
          };
          document.addEventListener("mousemove", calDragMoveHandler);
          document.addEventListener("mouseup", calDragUpHandler);
        }

        function placeNowLine(days) {
          const grid = document.getElementById("cal-grid-inner");
          if (!grid) return;
          const now = new Date();
          const todayKey = dateKey(now);
          const dayIdx = days.findIndex((d) => dateKey(d) === todayKey);
          if (dayIdx === -1) return; // today not visible in this view
          const minutes = now.getHours() * 60 + now.getMinutes();
          const rangeStart = CAL_HOUR_START * 60;
          if (minutes < rangeStart) return; // trước 8h -> chưa vào khung hiển thị
          const top = ((minutes - rangeStart) / 60) * ROW_H;
          const cell = grid.querySelector(
            `.cal-cell[data-day="${dayIdx}"][data-hour="${CAL_HOUR_START}"]`,
          );
          if (!cell) return;
          const line = document.createElement("div");
          line.className = "now-line";
          line.style.top = top + "px";
          line.innerHTML = `<span class="now-dot"></span><span class="now-label">${fmtTime(now)}</span>`;
          cell.style.position = cell.style.position || "relative";
          cell.appendChild(line);
        }

        function renderCalendarOnly() {
          const calContainer = document.getElementById("cal-container");
          if (!calContainer) return;
          let switchHtml = `<div class="view-switch">
      <button data-action="view-day" class="${calView === "day" ? "active" : ""}">Ngày</button>
      <button data-action="view-week" class="${calView === "week" ? "active" : ""}">Tuần</button>
    </div>`;
          const { html, days } = renderCalendar();
          calContainer.innerHTML = switchHtml + html;
          attachCalEvents();
          calZCounter = 1;
          placePomodoroBreaks(days);
          placeCalendarTasks(days);
          placeEvents(days);
          placeNowLine(days);
          attachCalendarDragCreate(days);
        }

        function attachCalEvents() {
          const calContainer = document.getElementById("cal-container");
          const prev = calContainer.querySelector('[data-action="cal-prev"]');
          const next = calContainer.querySelector('[data-action="cal-next"]');
          const viewDay = calContainer.querySelector(
            '[data-action="view-day"]',
          );
          const viewWeek = calContainer.querySelector(
            '[data-action="view-week"]',
          );
          if (prev)
            prev.addEventListener("click", () => {
              if (calView === "week") weekOffset--;
              else dayOffset--;
              renderCalendarOnly();
            });
          if (next)
            next.addEventListener("click", () => {
              if (calView === "week") weekOffset++;
              else dayOffset++;
              renderCalendarOnly();
            });
          if (viewDay)
            viewDay.addEventListener("click", () => {
              calView = "day";
              renderCalendarOnly();
            });
          if (viewWeek)
            viewWeek.addEventListener("click", () => {
              calView = "week";
              renderCalendarOnly();
            });
        }

        // Refresh the stable task rows without replacing #app. This is used
        // for state-only changes (done/doing/pending) so focus, selection and
        // the surrounding workspace remain completely untouched.
        function refreshTaskRowsInPlace() {
          const panel = document.getElementById("section-body-tasks-task");
          if (!panel) return false;
          const rows = Array.from(panel.querySelectorAll(".row[data-row-id]"));
          if (!rows.length) return false;
          let canRefresh = true;
          rows.forEach((row) => {
            const node = findNodeAny(row.dataset.rowId);
            if (!node) {
              canRefresh = false;
              return;
            }
            const isKnowledge = node.kind === "kienthuc";
            const isPinnedDay = isPinnedDayTask(node);
            const progress = !isKnowledge && !isPinnedDay ? countProgress(node) : null;
            const progressPercent =
              progress && progress.total
                ? Math.round((progress.done / progress.total) * 100)
                : !isKnowledge && !isPinnedDay && node.status === "done"
                  ? 100
                  : 0;
            const rowCls = isKnowledge
              ? "kienthuc"
              : node.status === "doing"
                ? "doing"
                : node.status === "done"
                  ? "done"
                  : node.status === "pending"
                    ? "pending"
                    : "";
            ["kienthuc", "doing", "done", "pending"].forEach((className) =>
              row.classList.toggle(className, rowCls === className),
            );
            row.style.setProperty("--task-progress", `${progressPercent}%`);

            const statusText = isKnowledge
              ? "Kiến thức"
              : node.status === "doing"
                ? "Đang làm"
                : node.status === "done"
                  ? "Đã hoàn thành"
                  : node.status === "pending"
                    ? "Đang chờ"
                    : "Chưa bắt đầu";
            const label = row.querySelector(":scope > .label");
            if (label && !label.querySelector("input")) {
              label.textContent = node.text;
              label.classList.toggle("done-text", node.status === "done");
              if (label.dataset.edit)
                label.setAttribute(
                  "aria-label",
                  `Sửa tên ${node.text}. Trạng thái: ${statusText}`,
                );
            }

            const statusTag = row.querySelector(":scope > .status-tag");
            const statusTagText =
              node.status === "doing"
                ? "▶ DOING"
                : node.status === "pending"
                  ? "⏸ PENDING"
                  : "";
            if (statusTagText && !isKnowledge && !isPinnedDay) {
              const tag = statusTag || document.createElement("span");
              tag.className = `status-tag ${node.status}`;
              tag.textContent = statusTagText;
              if (!statusTag) {
                const collapseControl = row.querySelector(
                  ':scope > button[data-action="collapse"]',
                );
                if (collapseControl) row.insertBefore(tag, collapseControl);
                else row.appendChild(tag);
              }
            } else if (statusTag) {
              statusTag.remove();
            }

            const timeInfo = row.querySelector(":scope > .time-info");
            if (node.status === "doing" && node.startTime && !isKnowledge && !isPinnedDay) {
              const time = timeInfo || document.createElement("span");
              time.className = "time-info";
              time.textContent = `bắt đầu ${fmtTime(new Date(node.startTime))}`;
              if (!timeInfo) row.appendChild(time);
            } else if (timeInfo) {
              timeInfo.remove();
            }

            const childCount = row.querySelector(":scope > .task-child-count");
            if (childCount) {
              childCount.textContent = String(node.children.length);
              childCount.setAttribute("title", `${node.children.length} task con`);
              childCount.setAttribute("aria-label", `${node.children.length} task con`);
            } else if (node.children.length) {
              // A new child changes the row structure; let the normal render
              // path rebuild controls and listeners safely.
              canRefresh = false;
            }

            const collapseButton = row.querySelector(':scope > button[data-action="collapse"]');
            if (collapseButton) {
              const isCollapsed = !!state.collapsed[node.id];
              collapseButton.textContent = isCollapsed ? "+" : "−";
              collapseButton.setAttribute("aria-expanded", String(!isCollapsed));
              collapseButton.setAttribute(
                "aria-label",
                `${isCollapsed ? "Mở rộng" : "Thu gọn"} ${node.text}`,
              );
              const wrapper = row.parentElement;
              const childGroup = Array.from(wrapper?.children || []).find(
                (child) =>
                child !== row && child.querySelector?.(".row[data-row-id]"),
              );
              if (childGroup) childGroup.style.display = isCollapsed ? "none" : "";
            }
          });
          return canRefresh;
        }

        // Task mutations should not make the entire workspace visibly blink.
        // Use in-place updates where the DOM shape is stable. For structural
        // changes, View Transitions keeps the old/new snapshots continuous;
        // browsers without the API fall back to a next-frame render.
        function renderWithoutFlicker(options = {}) {
          if (options.inPlace && refreshTaskRowsInPlace()) {
            renderMiniTimeline();
            renderCurrentDoingWidget();
            updateNextUnfinishedTaskButton();
            return;
          }
          const renderNow = () => {
            if (typeof document.startViewTransition === "function") {
              try {
                document.startViewTransition(() => render());
                return;
              } catch (error) {
                // Fall through to the regular render when a transition cannot
                // be started (for example, while another transition is active).
              }
            }
            render();
          };
          requestAnimationFrame(renderNow);
        }

