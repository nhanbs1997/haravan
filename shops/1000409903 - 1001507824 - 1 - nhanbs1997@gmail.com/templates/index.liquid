  }
  @font-face {
    font-family: "Futura6";
    font-weight: 100;
    src: url("https://content.pancake.vn/web-media/5c/ee/45/56/b708ca554bf07d2b6ef1de01974dd8006df88bc1694ac60d4583baa8-w:0-h:0-l:101128-t:application/font-woff.woff") format("woff");
