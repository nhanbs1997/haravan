{% comment %} Todolist Tree — Haravan home page template {% endcomment %}
<div id="app" style="
        font-family: 'Segoe UI', 'Futura6', Arial, sans-serif;
        max-width: 100%;
        margin: 0;
        padding: 0;
        background: #020713;
        min-height: 100vh;
        color: #f5f7ff;
 ">
</div>
<button
  type="button"
  class="btn-show-done"
  id="next-unfinished-task-btn"
  data-action="next-unfinished-task"
  aria-label="Đi đến task chưa làm"
  hidden>Đi đến các task chưa làm</button>
<button
  type="button"
  class="reset-page-btn"
  id="reset-page-btn"
  data-action="reset-page"
  title="Tải lại trang"
  aria-label="Tải lại trang">🔄</button>
<div id="left-sidebar" class="left-sidebar">
  <div id="current-doing-widget" class="current-doing-widget"></div>
  <div id="mini-timeline-widget" class="mini-timeline-widget"></div>
</div>
<div id="right-sidebar" class="right-sidebar">
  <div id="pomodoro-widget" class="pomodoro-widget"></div>
</div>
<div
  id="music-player-bar"
  class="music-player-bar"
  style="display:none;">
  <div id="music-player-slot" class="music-player-slot"></div>
  <div class="music-bar-info">
    <div class="music-bar-title" id="music-bar-title"></div>
    <div class="music-bar-controls">
      <button
        type="button"
        id="music-bar-prev"
        class="music-bar-btn"
        title="Bài trước"
        aria-label="Phát bài trước">⏮</button>
      <button
        type="button"
        id="music-bar-playpause"
        class="music-bar-btn"
        title="Phát / Tạm dừng"
        aria-label="Phát hoặc tạm dừng bài nhạc">⏸</button>
      <button
        type="button"
        id="music-bar-next"
        class="music-bar-btn"
        title="Bài sau"
        aria-label="Phát bài tiếp theo">⏭</button>
      <button
        type="button"
        id="music-bar-expand"
        class="music-bar-btn"
        title="Phóng to video"
        aria-label="Phóng to video đang phát"
        aria-pressed="false">⛶</button>
      <button
        type="button"
        id="music-bar-close"
        class="music-bar-btn"
        title="Đóng"
        aria-label="Đóng trình phát nhạc">×</button>
    </div>
  </div>
</div>

