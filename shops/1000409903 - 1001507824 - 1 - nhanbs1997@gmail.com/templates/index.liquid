        function findCurrentDoingNode() {
          for (const list of getAllRootLists()) {
            const found = (function search(arr) {
              for (const n of arr) {
                if (n._todayAuto) continue;
                if (n.status === "doing") return n;
                const f = search(n.children);
                if (f) return f;
              }
              return null;
            })(list);
            if (found) return found;
          }
          return null;
        }
        function stopDoingNode(n) {
          if (!n || n.status !== "doing") return;
          if (n.runningEventId) {
            const ev = state.events.find((e) => e.id === n.runningEventId);
            if (ev) {
              ev.end = new Date().toISOString();
              ev.incomplete = true;
            }
            n.runningEventId = null;
          }
          n.status = "todo";
          n.startTime = null;
          syncTaskCompletionToMindmap(n);
        }

        function setDoing(id) {
          const n = findNodeAny(id);
          if (!n) return;
          if (isPinnedDayTask(n)) return;
          if (n.status === "doing") {
            stopDoingNode(n);
          } else {
            // chỉ cho phép 1 việc Doing tại 1 thời điểm: tự bỏ Doing việc khác
            const current = findCurrentDoingNode();
            if (current && current.id !== n.id) {
              stopDoingNode(current);
            }
            const now = new Date();
            n.status = "doing";
            n.startTime = now.toISOString();
            const ev = {
              id: genId("e"),
              taskId: n.id,
              text: n.text,
              date: dateKey(now),
              start: now.toISOString(),
              end: null,
              incomplete: false,
            };
            state.events.push(ev);
            n.runningEventId = ev.id;
          }
          syncTaskCompletionToMindmap(n);
          renderWithoutFlicker({ inPlace: true });
          scheduleAutoExport();
        }

