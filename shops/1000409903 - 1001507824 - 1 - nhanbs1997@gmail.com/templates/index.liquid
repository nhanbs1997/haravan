        function normalizeMindmapState(raw) {
          if (!raw || !raw.root || typeof raw.root !== "object")
            return createDefaultMindmapState();

          const seenIds = new Set();
          const normalizeNode = (value, depth, siblingIndex) => {
            const source =
              value && typeof value === "object" ? value : {};
            let id =
              typeof source.id === "string" &&
              /^[a-z0-9_-]{1,100}$/i.test(source.id)
                ? source.id
                : genId("mm");
            if (seenIds.has(id)) id = genId("mm");
            seenIds.add(id);
            const fallback = depth === 0 ? "Mindmap của tôi" : "Nhánh mới";
            const color =
              depth === 0
                ? isMindmapColor(source.color)
                  ? source.color
                  : "#3867ff"
                : depth === 1
                  ? isMindmapColor(source.color)
                    ? source.color
                    : MINDMAP_BRANCH_COLORS[
                        siblingIndex % MINDMAP_BRANCH_COLORS.length
                      ]
                  : "";
            const children = Array.isArray(source.children)
              ? source.children
                  .slice(0, 500)
                  .map((child, index) =>
                    normalizeNode(child, depth + 1, index),
                  )
              : [];
            return {
              id,
              syncKey:
                typeof source.syncKey === "string" &&
                /^[a-z0-9_-]{1,100}$/i.test(source.syncKey)
                  ? source.syncKey
                  : "",
              text: cleanMindmapText(source.text, fallback),
              color,
              collapsed: !!source.collapsed,
              checked: depth === 0 ? false : !!source.checked,
              children,
            };
          };

          const root = normalizeNode(raw.root, 0, 0);
          const rawVersion = Number(raw.version);
          if (!Number.isFinite(rawVersion) || rawVersion < 3) {
            const inheritLegacyCheckedState = (node, inheritedChecked) => {
              if (inheritedChecked) node.checked = true;
              const cascadeChecked = inheritedChecked || !!node.checked;
              node.children.forEach((child) =>
                inheritLegacyCheckedState(child, cascadeChecked),
              );
            };
            root.children.forEach((child) =>
              inheritLegacyCheckedState(child, false),
            );
          }
          reconcileMindmapCompletion(root, true);

          const viewportSource =
            raw.viewport && typeof raw.viewport === "object"
              ? raw.viewport
              : {};
          const x = Number(viewportSource.x);
          const y = Number(viewportSource.y);
          const scale = Number(viewportSource.scale);
          const shouldAlignTopLeft =
            !Number.isFinite(rawVersion) || rawVersion < 4;
          const requestedBranchViewId =
            typeof raw.branchViewNodeId === "string"
              ? raw.branchViewNodeId
              : typeof raw.focusedNodeId === "string"
                ? raw.focusedNodeId
                : "";
          const containsNodeId = (node, id) =>
            node.id === id ||
            node.children.some((child) => containsNodeId(child, id));
          return {
            version: 5,
            showNumbering: raw.showNumbering !== false,
            branchViewNodeId:
              requestedBranchViewId &&
              requestedBranchViewId !== root.id &&
              containsNodeId(root, requestedBranchViewId)
                ? requestedBranchViewId
                : "",
            root,
            viewport: {
              x: shouldAlignTopLeft ? 20 : Number.isFinite(x) ? x : 20,
              y: shouldAlignTopLeft ? 20 : Number.isFinite(y) ? y : 20,
              scale: shouldAlignTopLeft
                ? 1
                : Number.isFinite(scale)
                  ? Math.min(2.5, Math.max(0.35, scale))
                  : 1,
              initialized:
                shouldAlignTopLeft ||
                (!!viewportSource.initialized &&
                  Number.isFinite(x) &&
                  Number.isFinite(y)),
            },
          };
        }

        function ensureMindmapState() {
          if (!state.mindmap || !state.mindmap.root)
            state.mindmap = createDefaultMindmapState();
          else if (state.mindmap.version !== 5)
            state.mindmap = normalizeMindmapState(state.mindmap);
          if (typeof state.mindmap.showNumbering !== "boolean")
            state.mindmap.showNumbering = true;
          if (
            typeof state.mindmap.branchViewNodeId !== "string" ||
            state.mindmap.branchViewNodeId === state.mindmap.root.id ||
            (state.mindmap.branchViewNodeId &&
              !findMindmapNodeRecord(state.mindmap.branchViewNodeId))
          )
            state.mindmap.branchViewNodeId = "";
          if (
            !state.mindmap.viewport ||
            typeof state.mindmap.viewport !== "object"
          ) {
            state.mindmap.viewport = {
              x: 20,
              y: 20,
              scale: 1,
              initialized: true,
            };
          }
          if (!selectedMindmapNodeId)
            selectedMindmapNodeId = state.mindmap.root.id;
          if (!findMindmapNodeRecord(selectedMindmapNodeId))
            selectedMindmapNodeId = state.mindmap.root.id;
          selectedMindmapNodeIds = new Set(
            Array.from(selectedMindmapNodeIds).filter((id) =>
              findMindmapNodeRecord(id),
            ),
          );
          if (!selectedMindmapNodeIds.size)
            selectedMindmapNodeIds.add(selectedMindmapNodeId);
          return state.mindmap;
        }

        function findMindmapNodeRecord(id) {
          if (!state.mindmap || !state.mindmap.root) return null;
          const wantedId = id || state.mindmap.root.id;
          const visit = (node, parent, depth, index, ancestors) => {
            if (node.id === wantedId)
              return { node, parent, depth, index, ancestors };
            for (let childIndex = 0; childIndex < node.children.length; childIndex++) {
              const found = visit(
                node.children[childIndex],
                node,
                depth + 1,
                childIndex,
                ancestors.concat(node),
              );
              if (found) return found;
            }
            return null;
          };
          return visit(state.mindmap.root, null, 0, 0, []);
        }

        function getSelectedMindmapTaskRecords() {
          return Array.from(selectedMindmapNodeIds)
            .map((id) => findMindmapNodeRecord(id))
            .filter((record) => record && record.depth > 0);
        }

        function setMindmapSelection(ids, primaryId, refreshUi = true) {
          ensureMindmapState();
          const branchViewRecord = state.mindmap.branchViewNodeId
            ? findMindmapNodeRecord(state.mindmap.branchViewNodeId)
            : null;
          const belongsToBranchView = (record) =>
            !branchViewRecord ||
            record.node.id === branchViewRecord.node.id ||
            record.ancestors.some(
              (ancestor) => ancestor.id === branchViewRecord.node.id,
            );
          const validRecords = Array.from(new Set(ids || []))
            .map((id) => findMindmapNodeRecord(id))
            .filter(
              (record) => !!record && belongsToBranchView(record),
            );
          if (!validRecords.length) {
            const rootRecord = findMindmapNodeRecord(
              branchViewRecord?.node.id || state.mindmap.root.id,
            );
            validRecords.push(rootRecord);
          }
          if (
            validRecords.some((record) => record.depth > 0) &&
            validRecords.length > 1
          ) {
            for (let index = validRecords.length - 1; index >= 0; index--) {
              if (validRecords[index].depth === 0)
                validRecords.splice(index, 1);
            }
          }
          selectedMindmapNodeIds = new Set(
            validRecords.map((record) => record.node.id),
          );
          const preferred = findMindmapNodeRecord(primaryId);
          selectedMindmapNodeId =
            preferred && selectedMindmapNodeIds.has(preferred.node.id)
              ? preferred.node.id
              : validRecords[0].node.id;
          if (refreshUi) refreshMindmapSelectionUi();
        }

        function refreshMindmapUndoButton() {
          const button = document.getElementById("mindmap-undo");
          if (button) button.disabled = mindmapUndoStack.length === 0;
        }

        function pushMindmapUndoSnapshot() {
          ensureMindmapState();
          mindmapUndoStack.push({
            mindmap: JSON.parse(JSON.stringify(state.mindmap)),
            selectedId: selectedMindmapNodeId,
            selectedIds: Array.from(selectedMindmapNodeIds),
          });
          if (mindmapUndoStack.length > MINDMAP_UNDO_LIMIT)
            mindmapUndoStack.shift();
          refreshMindmapUndoButton();
        }

        function undoMindmapAction() {
          const snapshot = mindmapUndoStack.pop();
          if (!snapshot) {
            showToast("Chưa có thao tác Mindmap để hoàn tác");
            return false;
          }
          if (mindmapInlineEditorState) {
            mindmapInlineEditorState.button?.classList.remove(
              "is-editing",
            );
            mindmapInlineEditorState.input?.remove();
            mindmapInlineEditorState = null;
          }
          state.mindmap = normalizeMindmapState(snapshot.mindmap);
          const restoredIds = (snapshot.selectedIds || []).filter((id) =>
            findMindmapNodeRecord(id),
          );
          const restoredPrimary = findMindmapNodeRecord(
            snapshot.selectedId,
          )
            ? snapshot.selectedId
            : state.mindmap.root.id;
          setMindmapSelection(
            restoredIds.length ? restoredIds : [restoredPrimary],
            restoredPrimary,
            false,
          );
          refreshMindmapPanel();
          scheduleAutoExport();
          requestAnimationFrame(() => {
            focusSelectedMindmapNode();
          });
          return true;
        }

        function countMindmapDescendants(node) {
          return (node.children || []).reduce(
            (total, child) =>
              total + 1 + countMindmapDescendants(child),
            0,
          );
        }

        function getMindmapTaskStats(progressMap) {
          ensureMindmapState();
          const map =
            progressMap || buildMindmapProgressMap(state.mindmap.root);
          const rootStats = map.get(state.mindmap.root.id) || {
            done: 0,
            total: 0,
            percent: 0,
          };
          return {
            total: rootStats.total,
            checked: rootStats.done,
            percent: rootStats.percent,
          };
        }

        function mindmapBranchNodeForRecord(record) {
          if (!record || record.depth === 0) return state.mindmap.root;
          if (record.depth === 1) return record.node;
          return record.ancestors[1] || record.node;
        }

        const MINDMAP_TASK_OFFSET = 32;
        const MINDMAP_NODE_GAP = 7;
        const MINDMAP_PROGRESS_SIZE = 58;
        let mindmapMeasureContext = null;

        function measureMindmapTextWidth(
          text,
          font,
          fallbackCharacterWidth,
        ) {
          const lines = String(text || "").split(/\r?\n/);
          try {
            if (!mindmapMeasureContext) {
              const canvas = document.createElement("canvas");
              mindmapMeasureContext = canvas.getContext("2d");
            }
            if (mindmapMeasureContext) {
              mindmapMeasureContext.font = font;
              return Math.ceil(
                Math.max(
                  0,
                  ...lines.map((line) =>
                    mindmapMeasureContext.measureText(line || " ").width,
                  ),
                ),
              );
            }
          } catch (error) {
            // Fall back to character-based sizing in older browsers.
          }
          return Math.max(
            0,
            ...lines.map(
              (line) =>
                Array.from(line).length * fallbackCharacterWidth,
            ),
          );
        }

        function estimateMindmapNumberWidth(numberLabel) {
          if (!state.mindmap.showNumbering || !numberLabel) return 0;
          return (
            measureMindmapTextWidth(
              numberLabel,
              '400 20px "Consolas", "Courier New", monospace',
              12,
            ) + 4
          );
        }

        function estimateMindmapNodeWidth(text, depth, numberLabel) {
          const textWidth = Math.max(
            24,
            measureMindmapTextWidth(
              text,
              '400 20px "Segoe UI", "Futura6", Arial, sans-serif',
              10,
            ),
          );
          if (depth === 0)
            return Math.min(900, Math.max(80, textWidth + 16));

          const numberWidth = estimateMindmapNumberWidth(numberLabel);
          const contentGaps = numberWidth
            ? MINDMAP_NODE_GAP * 2
            : MINDMAP_NODE_GAP;
          return Math.min(
            1200,
            Math.max(
              140,
              MINDMAP_TASK_OFFSET +
                MINDMAP_PROGRESS_SIZE +
                numberWidth +
                contentGaps +
                textWidth +
                12,
            ),
          );
        }

        function buildMindmapLayout() {
          ensureMindmapState();
          const root = state.mindmap.root;
          const records = [];
          const edges = [];
          const branchViewRecord = state.mindmap.branchViewNodeId
            ? findMindmapNodeRecord(state.mindmap.branchViewNodeId)
            : null;
          const rowGap = branchViewRecord ? 150 : 132;
          let leafIndex = 0;
          const numberPartsForRecord = (record) => {
            if (!record || record.depth === 0) return [];
            const lineage = record.ancestors.concat(record.node);
            const parts = [];
            for (let index = 1; index < lineage.length; index++) {
              parts.push(
                lineage[index - 1].children.indexOf(lineage[index]) + 1,
              );
            }
            return parts;
          };

          const placeNode = (
            node,
            depth,
            inheritedColor,
            siblingIndex,
            numberParts,
            visualDepth,
          ) => {
            const color =
              depth === 0
                ? isMindmapColor(node.color)
                  ? node.color
                  : "#3867ff"
                : depth === 1
                  ? isMindmapColor(node.color)
                    ? node.color
                    : MINDMAP_BRANCH_COLORS[
                        siblingIndex % MINDMAP_BRANCH_COLORS.length
                      ]
                  : inheritedColor;
            const childRecords = [];
            if (!node.collapsed) {
              node.children.forEach((child, index) => {
                childRecords.push(
                  placeNode(
                    child,
                    depth + 1,
                    color,
                    index,
                    numberParts.concat(index + 1),
                    visualDepth + 1,
                  ),
                );
              });
            }
            let y;
            if (childRecords.length) {
              y =
                (childRecords[0].y +
                  childRecords[childRecords.length - 1].y) /
                2;
            } else {
              y =
                (branchViewRecord ? 88 : 110) +
                leafIndex * rowGap;
              leafIndex++;
            }
            const inX =
              visualDepth === 0
                ? branchViewRecord
                  ? 30
                  : 60
                : branchViewRecord
                  ? 790 + (visualDepth - 1) * 660
                  : 430 + (visualDepth - 1) * 660;
            const numberLabel = numberParts.join(".");
            const labelWidth = estimateMindmapNodeWidth(
              node.text,
              depth,
              numberLabel,
            );
            const lineWidth = labelWidth;
            const record = {
              id: node.id,
              node,
              depth,
              visualDepth,
              color,
              y,
              inX,
              baselineStartX:
                branchViewRecord && visualDepth === 0 ? 0 : inX,
              outX: inX + lineWidth,
              labelWidth: lineWidth,
              numberParts: numberParts.slice(),
              numberLabel,
              hiddenCount: node.collapsed
                ? countMindmapDescendants(node)
                : 0,
            };
            records.push(record);
            childRecords.forEach((childRecord) => {
              edges.push({
                from: record,
                to: childRecord,
                color: childRecord.color,
              });
            });
            return record;
          };

          const layoutRoot = branchViewRecord?.node || root;
          const layoutDepth = branchViewRecord?.depth || 0;
          const layoutNumberParts = numberPartsForRecord(branchViewRecord);
          const branchColorNode =
            layoutDepth === 1
              ? layoutRoot
              : layoutDepth > 1
                ? branchViewRecord.ancestors[1]
                : root;
          const inheritedColor = isMindmapColor(branchColorNode?.color)
            ? branchColorNode.color
            : "#3867ff";
          placeNode(
            layoutRoot,
            layoutDepth,
            inheritedColor,
            branchViewRecord?.index || 0,
            layoutNumberParts,
            0,
          );
          const maxX = records.reduce(
            (value, record) =>
              Math.max(
                value,
                record.outX + (record.node.children.length ? 56 : 20),
              ),
            900,
          );
          const maxY = records.reduce(
            (value, record) => Math.max(value, record.y),
            110,
          );
          return {
            records,
            edges,
            width: maxX + 40,
            height: Math.max(260, maxY + 120),
          };
        }

        function mindmapEdgePath(edge) {
          const fromX = edge.from.outX;
          const toX = edge.to.inX;
          const bendX = Math.max(fromX + 24, toX - 72);
          return `M ${fromX} ${edge.from.y} L ${bendX} ${edge.to.y} L ${toX} ${edge.to.y}`;
        }

        function renderMindmapHtml() {
          ensureMindmapState();
          const branchViewSelection = state.mindmap.branchViewNodeId
            ? findMindmapNodeRecord(state.mindmap.branchViewNodeId)
            : null;
          const selectedCandidate =
            findMindmapNodeRecord(selectedMindmapNodeId);
          const candidateIsVisible =
            !branchViewSelection ||
            selectedCandidate?.node.id === branchViewSelection.node.id ||
            selectedCandidate?.ancestors.some(
              (ancestor) =>
                ancestor.id === branchViewSelection.node.id,
            );
          const selected =
            (candidateIsVisible ? selectedCandidate : null) ||
            branchViewSelection ||
            findMindmapNodeRecord(state.mindmap.root.id);
          selectedMindmapNodeId = selected.node.id;
          selectedMindmapNodeIds = new Set(
            Array.from(selectedMindmapNodeIds).filter((id) => {
              const record = findMindmapNodeRecord(id);
              return (
                !!record &&
                (!branchViewSelection ||
                  record.node.id === branchViewSelection.node.id ||
                  record.ancestors.some(
                    (ancestor) =>
                      ancestor.id === branchViewSelection.node.id,
                  ))
              );
            }),
          );
          if (!selectedMindmapNodeIds.size)
            selectedMindmapNodeIds.add(selectedMindmapNodeId);
          const selectedTaskCount =
            getSelectedMindmapTaskRecords().length;
          const branchNode = mindmapBranchNodeForRecord(selected);
          const branchColor = isMindmapColor(branchNode.color)
            ? branchNode.color
            : "#3867ff";
          const breadcrumbRecords = [
            findMindmapNodeRecord(state.mindmap.root.id),
            ...(branchViewSelection
              ? branchViewSelection.ancestors
                  .slice(1)
                  .map((node) => findMindmapNodeRecord(node.id))
                  .concat(branchViewSelection)
              : []),
          ].filter(Boolean);
          const currentBreadcrumbId =
            branchViewSelection?.node.id || state.mindmap.root.id;
          const breadcrumbHtml = breadcrumbRecords
            .map((record, index) => {
              const itemBranchNode =
                mindmapBranchNodeForRecord(record);
              const itemColor = isMindmapColor(itemBranchNode?.color)
                ? itemBranchNode.color
                : "#3867ff";
              const isCurrent =
                record.node.id === currentBreadcrumbId;
              return `${index ? '<span class="mindmap-breadcrumb-separator" aria-hidden="true">›</span>' : ""}<button type="button" class="mindmap-breadcrumb-item ${isCurrent ? "is-current" : ""}" data-action="mindmap-breadcrumb" data-id="${record.node.id}" style="--mindmap-current-color:${itemColor};" ${isCurrent ? 'aria-current="page"' : ""} title="${record.depth === 0 ? "Hiển thị toàn bộ Mindmap" : `Đi đến nhánh ${escapeMindmapAttribute(record.node.text)}`}">${record.depth === 0 ? "⌂ " : ""}${escapeHtml(record.node.text)}</button>`;
            })
            .join("");
          const layout = buildMindmapLayout();
          mindmapLastLayout = layout;
          const progressMap = buildMindmapProgressMap(state.mindmap.root);
          const taskStats = getMindmapTaskStats(progressMap);
          const viewport = state.mindmap.viewport;
          const currentCanvas = document.getElementById("mindmap-canvas");
          if (currentCanvas?.clientWidth) {
            viewport.scale = calculateMindmapFitScale(
              layout,
              currentCanvas.clientWidth,
              currentCanvas.clientHeight,
              document.fullscreenElement ===
                document.getElementById("mindmap-shell"),
            );
          }
          viewport.x = 20;
          viewport.y = 20;
          viewport.initialized = true;
          const canvasHeight = layout.height + 40;
          const linesHtml = layout.edges
            .map(
              (edge) =>
                `<path d="${mindmapEdgePath(edge)}" stroke="${edge.color}"></path>`,
            )
            .join("");
          const baselinesHtml = layout.records
            .map(
              (record) =>
                `<line x1="${record.baselineStartX}" y1="${record.y}" x2="${record.outX}" y2="${record.y}" stroke="${record.color}"></line>`,
            )
            .join("");
          const visibleRecords = [...layout.records].sort((left, right) => {
            const leftParts = left.numberParts;
            const rightParts = right.numberParts;
            const length = Math.min(leftParts.length, rightParts.length);
            for (let index = 0; index < length; index++) {
              if (leftParts[index] !== rightParts[index])
                return leftParts[index] - rightParts[index];
            }
            return leftParts.length - rightParts.length;
          });
          const nodesHtml = visibleRecords
            .map((record) => {
              const progress = progressMap.get(record.id) || {
                done: 0,
                total: record.depth === 0 ? 0 : 1,
                percent: 0,
              };
              const isPartial =
                progress.done > 0 && progress.done < progress.total;
              const classes = [
                "mindmap-node",
                record.depth === 0 ? "is-root" : "",
                record.depth === 1 ? "is-level-one" : "",
                record.node.checked ? "is-complete" : "",
                selectedMindmapNodeIds.has(record.id)
                  ? "is-selected"
                  : "",
              ]
                .filter(Boolean)
                .join(" ");
              const taskOffset =
                record.depth === 0 ? 0 : MINDMAP_TASK_OFFSET;
              const progressHtml =
                record.depth > 0
                  ? `<span class="mindmap-node-progress" data-progress-for="${record.id}" data-progress="${progress.percent}" style="--mindmap-progress:${progress.percent}%;" title="${progress.done}/${progress.total} task hoàn thành" aria-hidden="true"><span>${progress.percent}%</span></span>`
                  : "";
              const numberHtml =
                state.mindmap.showNumbering &&
                record.depth > 0 &&
                record.numberLabel
                  ? `<span class="mindmap-node-number" aria-hidden="true">${record.numberLabel}</span>`
                  : "";
              const checkbox =
                record.depth > 0
                  ? `<button type="button" class="mindmap-task-checkbox ${isPartial ? "is-partial" : ""} ${record.node.checked ? "is-checked" : ""}" data-action="mindmap-toggle-check" data-id="${record.id}" style="--mindmap-branch-color:${record.color};left:${record.inX + 3}px;top:${record.y - 27}px;" role="checkbox" aria-checked="${record.node.checked ? "true" : isPartial ? "mixed" : "false"}" aria-label="${record.node.checked ? "Bỏ hoàn thành" : "Đánh dấu hoàn thành"} ${escapeMindmapAttribute(record.node.text)}. Tiến độ ${progress.percent}%" title="${record.node.checked ? "Bỏ hoàn thành toàn bộ nhánh" : `Đánh dấu hoàn thành toàn bộ nhánh · ${progress.percent}%`}">${record.node.checked ? "✓" : ""}</button>`
                  : "";
              const toggle = record.node.children.length
                ? `<button type="button" class="mindmap-branch-toggle" data-action="mindmap-toggle-node" data-id="${record.id}" style="--mindmap-branch-color:${record.color};left:${record.outX + 9}px;top:${record.y}px;" aria-label="${record.node.collapsed ? "Mở rộng" : "Thu gọn"} nhánh ${escapeMindmapAttribute(record.node.text)}" aria-expanded="${!record.node.collapsed}" title="${record.node.collapsed ? `Mở ${record.hiddenCount} mục đang ẩn` : "Thu gọn nhánh"}">${record.node.collapsed ? record.hiddenCount : "…"}</button>`
                : "";
              const accessibleLabel = mindmapNodeAccessibleLabel(
                record,
                progress,
              );
              return `${checkbox}<button type="button" class="${classes}" data-action="mindmap-select-node" data-id="${record.id}" draggable="${record.depth > 0}" style="--mindmap-branch-color:${record.color};left:${record.inX + taskOffset}px;top:${record.y}px;width:${record.labelWidth - taskOffset}px;" aria-pressed="${selectedMindmapNodeIds.has(record.id)}" aria-label="${escapeMindmapAttribute(accessibleLabel)}" aria-keyshortcuts="Enter Tab F2 Delete" title="Kéo giữa task cùng cấp: đổi vị trí · Kéo sang nhánh khác: chuyển task cha · Click chữ: đổi tên">${progressHtml}${numberHtml}<span class="mindmap-node-text">${escapeHtml(record.node.text)}</span></button>${toggle}`;
            })
            .join("");

          return `<div class="mindmap-shell" id="mindmap-shell">
      <div class="mindmap-toolbar" aria-label="Công cụ Mindmap">
        <div class="mindmap-toolbar-group">
          <label class="mindmap-field" for="mindmap-title-input"><span>Đang chọn</span>
            <textarea id="mindmap-title-input" class="mindmap-title-input" maxlength="160" rows="2" aria-keyshortcuts="Control+Enter Tab">${escapeHtml(selected.node.text)}</textarea>
          </label>
          <button type="button" class="mindmap-tool-btn" id="mindmap-save-title">Lưu tên</button>
          <label class="mindmap-field" for="mindmap-color-input" title="Màu của nhánh cấp 1"><span>Màu nhánh</span>
            <input type="color" id="mindmap-color-input" class="mindmap-color-input" value="${branchColor}" />
          </label>
          <button type="button" class="mindmap-tool-btn ${state.mindmap.showNumbering ? "is-active" : ""}" id="mindmap-toggle-numbering" aria-pressed="${state.mindmap.showNumbering}" aria-label="Bật hoặc tắt số thứ tự phân cấp" title="Bật hoặc tắt số thứ tự phân cấp">123</button>
          <button type="button" class="mindmap-tool-btn" id="mindmap-branch-view" ${selected.depth === 0 || selected.node.id === branchViewSelection?.node.id ? "disabled" : ""} title="${selected.node.id === branchViewSelection?.node.id ? "Đang xem nhánh này — chọn một task con để đi sâu hơn" : "Chỉ hiển thị task đang chọn và các task con"}">◎ Xem nhánh</button>
          ${branchViewSelection ? '<button type="button" class="mindmap-tool-btn is-active" id="mindmap-show-all" title="Hiển thị lại toàn bộ Mindmap">◉ Toàn bộ</button>' : ""}
          <span class="mindmap-task-progress" aria-live="polite">✓ ${taskStats.checked}/${taskStats.total} · ${taskStats.percent}%</span>
          <button type="button" class="mindmap-tool-btn" id="mindmap-undo" aria-keyshortcuts="Control+Z" ${mindmapUndoStack.length ? "" : "disabled"}>↶ Hoàn tác</button>
        </div>
        <span class="mindmap-toolbar-divider" aria-hidden="true"></span>
        <div class="mindmap-toolbar-group grow">
          <label class="mindmap-field" for="mindmap-new-node-input"><span>Nhánh mới</span>
            <textarea id="mindmap-new-node-input" class="mindmap-new-input" maxlength="160" rows="2" placeholder="Nhập tên nhánh..." aria-keyshortcuts="Control+Enter Tab"></textarea>
          </label>
          <button type="button" class="mindmap-tool-btn" id="mindmap-add-child">＋ Nhánh con</button>
          <button type="button" class="mindmap-tool-btn" id="mindmap-add-sibling" ${selected.depth === 0 ? "disabled" : ""}>＋ Cùng cấp</button>
          <button type="button" class="mindmap-tool-btn" id="mindmap-toggle-selected" ${selected.node.children.length ? "" : "disabled"}>${selected.node.collapsed ? "Mở nhánh" : "Thu gọn"}</button>
          <button type="button" class="mindmap-tool-btn danger" id="mindmap-delete-selected" ${selectedTaskCount ? "" : "disabled"}>Xóa${selectedTaskCount > 1 ? ` (${selectedTaskCount})` : ""}</button>
        </div>
        <button type="button" class="mindmap-tool-btn" id="mindmap-fullscreen" title="Mở toàn màn hình">⛶</button>
      </div>
      <div class="mindmap-canvas" id="mindmap-canvas" style="--mindmap-canvas-height:${canvasHeight}px;" tabindex="0" role="application" aria-label="Sơ đồ Mindmap luôn tự căn vừa màn hình. Kéo task lên task khác để đổi task cha; kéo trên nền để chọn nhiều task." aria-keyshortcuts="Enter Tab Delete Control+Z">
        <div class="mindmap-stage" id="mindmap-stage" style="width:${layout.width}px;height:${layout.height}px;transform:translate(${viewport.x}px, ${viewport.y}px) scale(${viewport.scale});">
          <svg class="mindmap-lines" width="${layout.width}" height="${layout.height}" viewBox="0 0 ${layout.width} ${layout.height}" aria-hidden="true">
            ${linesHtml}${baselinesHtml}
          </svg>
          ${nodesHtml}
        </div>
        <div class="mindmap-help">${branchViewSelection ? "<strong>Đang xem nhánh</strong>: giao diện đầy đủ của task gốc và cây con · " : ""}<strong>Kéo cùng cấp</strong>: đổi vị trí · <strong>Kéo khác nhánh</strong>: đổi task cha · <strong>Ctrl + Z</strong>: hoàn tác</div>
        <nav class="mindmap-breadcrumb" aria-label="Đường dẫn nhánh Mindmap">${breadcrumbHtml}</nav>
        <div class="mindmap-zoom-controls" aria-label="Trạng thái hiển thị">
          <span class="mindmap-zoom-value" id="mindmap-zoom-value">Vừa · ${Math.round(viewport.scale * 100)}%</span>
        </div>
      </div>
    </div>`;
        }

        function refreshMindmapPanel() {
          const shell = document.getElementById("mindmap-shell");
          if (!shell || activeTab !== "mindmap") {
            render();
            return false;
          }
          const template = document.createElement("template");
          template.innerHTML = renderMindmapHtml().trim();
          const nextShell = template.content?.firstElementChild;
          if (!nextShell) {
            render();
            return false;
          }
          shell.className = nextShell.className;
          shell.innerHTML = nextShell.innerHTML;
          attachMindmapInteractions();
          requestAnimationFrame(() => fitMindmapToViewport(false));
          return true;
        }

        function applyMindmapViewport() {
          if (!state.mindmap) return;
          const stage = document.getElementById("mindmap-stage");
          const value = document.getElementById("mindmap-zoom-value");
          const viewport = state.mindmap.viewport;
          if (stage) {
            stage.style.transform = `translate(${viewport.x}px, ${viewport.y}px) scale(${viewport.scale})`;
          }
          if (value)
            value.textContent = `Vừa · ${Math.round(viewport.scale * 100)}%`;
        }

        function revealMindmapNode(id) {
          if (!id || !findMindmapNodeRecord(id)) return;
          fitMindmapToViewport(false);
        }

        function queueMindmapViewportSave() {
          if (mindmapViewportSaveTimer)
            clearTimeout(mindmapViewportSaveTimer);
          mindmapViewportSaveTimer = setTimeout(() => {
            mindmapViewportSaveTimer = null;
            scheduleAutoExport();
          }, 350);
        }

        function calculateMindmapFitScale(
          layout,
          width,
          height,
          limitHeight,
        ) {
          if (!layout || !width) return 1;
          let scale = (width - 40) / layout.width;
          if (limitHeight && height)
            scale = Math.min(scale, (height - 40) / layout.height);
          return Math.min(1, Math.max(0.05, scale));
        }

        function fitMindmapToViewport(saveViewport = false) {
          const canvas = document.getElementById("mindmap-canvas");
          if (!canvas || !mindmapLastLayout || !state.mindmap) return;
          const width = canvas.clientWidth;
          const height = canvas.clientHeight;
          if (!width || !height) return;
          const shell = document.getElementById("mindmap-shell");
          const isFullscreen = document.fullscreenElement === shell;
          const scale = calculateMindmapFitScale(
            mindmapLastLayout,
            width,
            height,
            isFullscreen,
          );
          state.mindmap.viewport.x = 20;
          state.mindmap.viewport.y = 20;
          state.mindmap.viewport.scale = scale;
          state.mindmap.viewport.initialized = true;
          if (!isFullscreen)
            canvas.style.setProperty(
              "--mindmap-canvas-height",
              `${Math.max(180, Math.ceil(mindmapLastLayout.height * scale + 40))}px`,
            );
          applyMindmapViewport();
          if (saveViewport) queueMindmapViewportSave();
        }

        function initializeMindmapViewport() {
          if (activeTab !== "mindmap" || !state.mindmap) return;
          fitMindmapToViewport(false);
        }

        function updateSelectedMindmapNodeTitle(value) {
          const record = findMindmapNodeRecord(selectedMindmapNodeId);
          if (!record) return false;
          const title = cleanMindmapText(value, record.node.text);
          if (title === record.node.text) return false;
          record.node.text = title;
          syncMindmapTextToTask(record.node);
          return true;
        }

        function focusSelectedMindmapNode() {
          requestAnimationFrame(() => {
            const nodeButton = Array.from(
              document.querySelectorAll(
                '[data-action="mindmap-select-node"]',
              ),
            ).find(
              (button) => button.dataset.id === selectedMindmapNodeId,
            );
            nodeButton?.focus();
          });
        }

        function focusMindmapCheckbox(id) {
          requestAnimationFrame(() => {
            const checkbox = Array.from(
              document.querySelectorAll(
                '[data-action="mindmap-toggle-check"]',
              ),
            ).find((button) => button.dataset.id === id);
            checkbox?.focus();
          });
        }

        function shouldIgnoreMindmapShortcut(event) {
          return (
            event.isComposing ||
            event.keyCode === 229 ||
            event.ctrlKey ||
            event.altKey ||
            event.metaKey ||
            event.repeat
          );
        }

        function commitMindmapNodeTitle(value) {
          const record = findMindmapNodeRecord(
            selectedMindmapNodeId,
          );
          if (!record) return;
          const nextText = cleanMindmapText(value, record.node.text);
          if (nextText === record.node.text) {
            focusSelectedMindmapNode();
            return;
          }
          pushMindmapUndoSnapshot();
          record.node.text = nextText;
          syncMindmapTextToTask(record.node);
          refreshMindmapNodeTextUi(selectedMindmapNodeId);
          scheduleAutoExport();
          focusSelectedMindmapNode();
        }

        function insertMindmapNode(
          mode,
          rawText,
          focusTitleAfter,
          keepSelection,
          skipUndo,
        ) {
          const selected = findMindmapNodeRecord(selectedMindmapNodeId);
          if (!selected) return null;
          const previousSelectionId = selected.node.id;
          const effectiveMode =
            mode === "sibling" && !selected.parent ? "child" : mode;
          const parent =
            effectiveMode === "sibling"
              ? selected.parent
              : selected.node;
          if (!parent) return null;
          if (!skipUndo) pushMindmapUndoSnapshot();
          const text = cleanMindmapText(rawText, "Nhánh mới");
          const isTopLevel = parent.id === state.mindmap.root.id;
          const color = isTopLevel
            ? MINDMAP_BRANCH_COLORS[
                parent.children.length % MINDMAP_BRANCH_COLORS.length
              ]
            : "";
          const node = createMindmapNode(text, color);
          if (effectiveMode === "sibling")
            parent.children.splice(selected.index + 1, 0, node);
          else parent.children.push(node);
          parent.collapsed = false;
          ensureTaskForMindmapNode({
            node,
            parent,
            depth: selected.depth + (effectiveMode === "sibling" ? 0 : 1),
          });
          reconcileMindmapCompletion(state.mindmap.root, true);
          const keepBranchRootForOutsideSibling =
            effectiveMode === "sibling" &&
            !!state.mindmap.branchViewNodeId &&
            state.mindmap.branchViewNodeId === previousSelectionId;
          selectedMindmapNodeId =
            keepSelection || keepBranchRootForOutsideSibling
            ? previousSelectionId
            : node.id;
          if (!keepSelection && !keepBranchRootForOutsideSibling)
            selectedMindmapNodeIds = new Set([node.id]);
          refreshMindmapPanel();
          scheduleAutoExport();
          requestAnimationFrame(() => {
            revealMindmapNode(node.id);
            if (keepSelection) {
              focusSelectedMindmapNode();
            } else if (focusTitleAfter) {
              const titleInput =
                document.getElementById("mindmap-title-input");
              titleInput?.focus();
              titleInput?.select();
            } else {
              document.getElementById("mindmap-new-node-input")?.focus();
            }
          });
          return node;
        }

        function addMindmapNode(mode, keepSelection) {
          const input = document.getElementById("mindmap-new-node-input");
          const text = cleanMindmapText(input?.value, "");
          if (!text) {
            showToast("Nhập tên nhánh trước khi thêm");
            input?.focus();
            return;
          }
          insertMindmapNode(mode, text, false, !!keepSelection);
        }

        function createMindmapNodeFromKeyboard(mode, currentTitle) {
          if (currentTitle !== undefined) {
            pushMindmapUndoSnapshot();
            updateSelectedMindmapNodeTitle(currentTitle);
            insertMindmapNode(
              mode,
              "Nhánh mới",
              false,
              true,
              true,
            );
            return;
          }
          insertMindmapNode(mode, "Nhánh mới", false, true);
        }

        function toggleMindmapNode(id) {
          const record = findMindmapNodeRecord(id);
          if (!record || !record.node.children.length) return;
          pushMindmapUndoSnapshot();
          record.node.collapsed = !record.node.collapsed;
          refreshMindmapPanel();
          scheduleAutoExport();
        }

        function toggleMindmapNodeChecked(id) {
          const record = findMindmapNodeRecord(id);
          if (!record || record.depth === 0) return;
          pushMindmapUndoSnapshot();
          setMindmapSubtreeChecked(record.node, !record.node.checked);
          reconcileMindmapCompletion(state.mindmap.root, true);
          syncMindmapCompletionToTasks(record);
          selectedMindmapNodeId = record.node.id;
          selectedMindmapNodeIds = new Set([record.node.id]);
          // Render lại cả phần công việc để trạng thái task được cập nhật ngay
          // trên màn hình, không chỉ trong dữ liệu Mindmap.
          render();
          scheduleAutoExport();
          requestAnimationFrame(() => focusMindmapCheckbox(record.node.id));
        }

        function toggleMindmapNumbering() {
          ensureMindmapState();
          pushMindmapUndoSnapshot();
          state.mindmap.showNumbering = !state.mindmap.showNumbering;
          refreshMindmapPanel();
          scheduleAutoExport();
          focusSelectedMindmapNode();
        }

        function openSelectedMindmapBranch() {
          ensureMindmapState();
          const record = findMindmapNodeRecord(
            selectedMindmapNodeId,
          );
          if (!record || record.depth === 0) {
            showToast("Chọn một task trước khi xem riêng nhánh");
            return false;
          }
          if (state.mindmap.branchViewNodeId === record.node.id) {
            showToast("Chọn một task con để đi sâu hơn");
            return false;
          }
          record.node.collapsed = false;
          state.mindmap.branchViewNodeId = record.node.id;
          selectedMindmapNodeIds = new Set([record.node.id]);
          refreshMindmapPanel();
          scheduleAutoExport();
          requestAnimationFrame(focusSelectedMindmapNode);
          return true;
        }

        function navigateMindmapBreadcrumb(nodeId) {
          ensureMindmapState();
          const record = findMindmapNodeRecord(nodeId);
          if (!record) return false;
          if (record.depth === 0) {
            state.mindmap.branchViewNodeId = "";
          } else {
            record.node.collapsed = false;
            state.mindmap.branchViewNodeId = record.node.id;
          }
          selectedMindmapNodeId = record.node.id;
          selectedMindmapNodeIds = new Set([record.node.id]);
          refreshMindmapPanel();
          scheduleAutoExport();
          requestAnimationFrame(focusSelectedMindmapNode);
          return true;
        }

        function moveMindmapNodeToParent(draggedId, targetId) {
          const dragged = findMindmapNodeRecord(draggedId);
          const target = findMindmapNodeRecord(targetId);
          if (
            !dragged ||
            !target ||
            dragged.depth === 0 ||
            dragged.node.id === target.node.id
          )
            return false;
          const targetIsInsideDraggedNode = (node) =>
            node.id === target.node.id ||
            node.children.some(targetIsInsideDraggedNode);
          if (targetIsInsideDraggedNode(dragged.node)) {
            showToast("Không thể kéo task vào chính nhánh con của nó");
            return false;
          }
          if (dragged.parent === target.node) {
            showToast("Task này đã là task con của vị trí đã chọn");
            return false;
          }
          pushMindmapUndoSnapshot();
          dragged.parent.children.splice(dragged.index, 1);
          if (
            target.node.id === state.mindmap.root.id &&
            !isMindmapColor(dragged.node.color)
          )
            dragged.node.color =
              MINDMAP_BRANCH_COLORS[
                target.node.children.length %
                  MINDMAP_BRANCH_COLORS.length
              ];
          target.node.children.push(dragged.node);
          target.node.collapsed = false;
          reconcileMindmapCompletion(state.mindmap.root, true);
          selectedMindmapNodeId = dragged.node.id;
          selectedMindmapNodeIds = new Set([dragged.node.id]);
          refreshMindmapPanel();
          scheduleAutoExport();
          requestAnimationFrame(focusSelectedMindmapNode);
          return true;
        }

        function reorderMindmapSibling(
          draggedId,
          targetId,
          position,
        ) {
          const dragged = findMindmapNodeRecord(draggedId);
          const target = findMindmapNodeRecord(targetId);
          if (
            !dragged ||
            !target ||
            dragged.depth === 0 ||
            dragged.node.id === target.node.id ||
            !dragged.parent ||
            dragged.parent !== target.parent
          )
            return false;
          const currentOrder = dragged.parent.children;
          const nextOrder = currentOrder.filter(
            (node) => node.id !== dragged.node.id,
          );
          const targetIndex = nextOrder.findIndex(
            (node) => node.id === target.node.id,
          );
          if (targetIndex < 0) return false;
          const insertIndex =
            targetIndex + (position === "after" ? 1 : 0);
          nextOrder.splice(insertIndex, 0, dragged.node);
          if (
            nextOrder.every(
              (node, index) => node === currentOrder[index],
            )
          )
            return false;
          pushMindmapUndoSnapshot();
          dragged.parent.children.splice(
            0,
            dragged.parent.children.length,
            ...nextOrder,
          );
          reconcileMindmapCompletion(state.mindmap.root, true);
          selectedMindmapNodeId = dragged.node.id;
          selectedMindmapNodeIds = new Set([dragged.node.id]);
          refreshMindmapPanel();
          scheduleAutoExport();
          requestAnimationFrame(focusSelectedMindmapNode);
          return true;
        }

        function deleteSelectedMindmapNode() {
          let selectedRecords = getSelectedMindmapTaskRecords();
          if (!selectedRecords.length) {
            const fallback = findMindmapNodeRecord(
              selectedMindmapNodeId,
            );
            if (fallback?.depth > 0) selectedRecords = [fallback];
          }
          if (!selectedRecords.length) return;
          const selectedIds = new Set(
            selectedRecords.map((record) => record.node.id),
          );
          const topLevelRecords = selectedRecords.filter(
            (record) =>
              !record.ancestors.some((ancestor) =>
                selectedIds.has(ancestor.id),
              ),
          );
          const totalRemoved = topLevelRecords.reduce(
            (total, record) =>
              total + 1 + countMindmapDescendants(record.node),
            0,
          );
          const message =
            topLevelRecords.length === 1
              ? totalRemoved > 1
                ? `Xóa “${topLevelRecords[0].node.text}” và ${totalRemoved - 1} nhánh con?`
                : `Xóa nhánh “${topLevelRecords[0].node.text}”?`
              : `Xóa ${topLevelRecords.length} task đã chọn${totalRemoved > topLevelRecords.length ? ` cùng ${totalRemoved - topLevelRecords.length} nhánh con` : ""}?`;
          if (!window.confirm(message)) return;
          pushMindmapUndoSnapshot();
          const recordsByParent = new Map();
          topLevelRecords.forEach((record) => {
            if (!recordsByParent.has(record.parent))
              recordsByParent.set(record.parent, []);
            recordsByParent.get(record.parent).push(record);
          });
          recordsByParent.forEach((records, parent) => {
            records
              .sort((left, right) => right.index - left.index)
              .forEach((record) =>
                parent.children.splice(record.index, 1),
              );
          });
          reconcileMindmapCompletion(state.mindmap.root, true);
          if (
            state.mindmap.branchViewNodeId &&
            !findMindmapNodeRecord(state.mindmap.branchViewNodeId)
          )
            state.mindmap.branchViewNodeId = "";
          selectedMindmapNodeId = state.mindmap.root.id;
          selectedMindmapNodeIds = new Set([
            state.mindmap.root.id,
          ]);
          refreshMindmapPanel();
          scheduleAutoExport();
        }

        function setSelectedMindmapBranchColor(color) {
          if (!isMindmapColor(color)) return;
          const record = findMindmapNodeRecord(selectedMindmapNodeId);
          if (!record) return;
          const branchNode = mindmapBranchNodeForRecord(record);
          if (branchNode.color === color) return;
          pushMindmapUndoSnapshot();
          branchNode.color = color;
          refreshMindmapPanel();
          scheduleAutoExport();
        }

        function findMindmapNodeButton(id) {
          return Array.from(
            document.querySelectorAll(
              '[data-action="mindmap-select-node"]',
            ),
          ).find((button) => button.dataset.id === id);
        }

        function mindmapNodeAccessibleLabel(record, progress) {
          return `${record.numberLabel && state.mindmap.showNumbering ? `Mục ${record.numberLabel}, ` : ""}${record.node.text}${record.depth > 0 ? `, tiến độ ${progress.percent} phần trăm` : ""}${record.node.checked ? ", đã hoàn thành" : ""}`;
        }

        function refreshMindmapNodeTextUi(id) {
          const record = findMindmapNodeRecord(id);
          const button = findMindmapNodeButton(id);
          if (!record || !button) return;
          const textElement = button.querySelector(
            ".mindmap-node-text",
          );
          if (textElement) textElement.textContent = record.node.text;
          const progress =
            buildMindmapProgressMap(state.mindmap.root).get(id) || {
              done: 0,
              total: record.depth === 0 ? 0 : 1,
              percent: 0,
            };
          button.setAttribute(
            "aria-label",
            mindmapNodeAccessibleLabel(record, progress),
          );
          if (selectedMindmapNodeId === id) {
            const titleInput = document.getElementById(
              "mindmap-title-input",
            );
            if (titleInput) titleInput.value = record.node.text;
          }
        }



        function refreshMindmapSelectionUi() {
          const record = findMindmapNodeRecord(selectedMindmapNodeId);
          if (!record) return;
          document
            .querySelectorAll('[data-action="mindmap-select-node"]')
            .forEach((button) => {
              const selected = selectedMindmapNodeIds.has(
                button.dataset.id,
              );
              button.classList.toggle("is-selected", selected);
              button.setAttribute("aria-pressed", String(selected));
            });
          const titleInput = document.getElementById(
            "mindmap-title-input",
          );
          if (titleInput) titleInput.value = record.node.text;
          const branchNode = mindmapBranchNodeForRecord(record);
          const colorInput = document.getElementById(
            "mindmap-color-input",
          );
          if (colorInput && isMindmapColor(branchNode.color))
            colorInput.value = branchNode.color;
          const siblingButton = document.getElementById(
            "mindmap-add-sibling",
          );
          if (siblingButton) siblingButton.disabled = record.depth === 0;
          const deleteButton = document.getElementById(
            "mindmap-delete-selected",
          );
          if (deleteButton) {
            const selectedTaskCount =
              getSelectedMindmapTaskRecords().length;
            deleteButton.disabled = selectedTaskCount === 0;
            deleteButton.textContent =
              selectedTaskCount > 1
                ? `Xóa (${selectedTaskCount})`
                : "Xóa";
          }
          refreshMindmapUndoButton();
          const toggleButton = document.getElementById(
            "mindmap-toggle-selected",
          );
          if (toggleButton) {
            toggleButton.disabled = !record.node.children.length;
            toggleButton.textContent = record.node.collapsed
              ? "Mở nhánh"
              : "Thu gọn";
          }
          const branchViewButton = document.getElementById(
            "mindmap-branch-view",
          );
          if (branchViewButton) {
            const isCurrentBranch =
              state.mindmap.branchViewNodeId === record.node.id;
            branchViewButton.disabled =
              record.depth === 0 || isCurrentBranch;
            branchViewButton.classList.toggle(
              "is-active",
              false,
            );
            branchViewButton.textContent = "◎ Xem nhánh";
            branchViewButton.title = isCurrentBranch
              ? "Đang xem nhánh này — chọn một task con để đi sâu hơn"
              : "Chỉ hiển thị task đang chọn và các task con";
          }
        }

        function finishMindmapInlineEdit(save, restoreFocus) {
          const editing = mindmapInlineEditorState;
          if (!editing) return;
          mindmapInlineEditorState = null;
          const record = findMindmapNodeRecord(editing.id);
          let changed = false;
          if (save && record) {
            const nextText = cleanMindmapText(
              editing.input.value,
              record.node.text,
            );
            if (nextText !== record.node.text) {
              pushMindmapUndoSnapshot();
              record.node.text = nextText;
              syncMindmapTextToTask(record.node);
              changed = true;
            }
          }
          editing.button?.classList.remove("is-editing");
          editing.input.remove();
          if (changed) {
            refreshMindmapNodeTextUi(editing.id);
            scheduleAutoExport();
          } else {
            refreshMindmapSelectionUi();
          }
          if (restoreFocus !== false)
            focusSelectedMindmapNode();
        }

        function finishMindmapInlineEditAndCreate(mode) {
          const editing = mindmapInlineEditorState;
          if (!editing) return;
          mindmapInlineEditorState = null;
          const record = findMindmapNodeRecord(editing.id);
          if (!record) {
            editing.input.remove();
            return;
          }
          pushMindmapUndoSnapshot();
          record.node.text = cleanMindmapText(
            editing.input.value,
            record.node.text,
          );
          syncMindmapTextToTask(record.node);
          editing.button?.classList.remove("is-editing");
          editing.input.remove();
          selectedMindmapNodeId = editing.id;
          selectedMindmapNodeIds = new Set([editing.id]);
          insertMindmapNode(
            mode,
            "Nhánh mới",
            false,
            true,
            true,
          );
        }

        function beginMindmapInlineEdit(id) {
          if (mindmapInlineEditorState?.id === id) {
            mindmapInlineEditorState.input.focus();
            mindmapInlineEditorState.input.select();
            return;
          }
          if (mindmapInlineEditorState)
            finishMindmapInlineEdit(true, false);
          const record = findMindmapNodeRecord(id);
          const layoutRecord = mindmapLastLayout?.records.find(
            (item) => item.id === id,
          );
          const button = findMindmapNodeButton(id);
          const stage = document.getElementById("mindmap-stage");
          if (!record || !layoutRecord || !button || !stage) return;
          selectedMindmapNodeId = id;
          refreshMindmapSelectionUi();
          const taskOffset =
            record.depth === 0 ? 0 : MINDMAP_TASK_OFFSET;
          const progressOffset =
            record.depth > 0
              ? MINDMAP_PROGRESS_SIZE + MINDMAP_NODE_GAP
              : 0;
          const numberWidth =
            record.depth > 0
              ? estimateMindmapNumberWidth(record.numberLabel)
              : 0;
          const numberOffset =
            numberWidth > 0 ? numberWidth + MINDMAP_NODE_GAP : 0;
          const input = document.createElement("textarea");
          input.maxLength = 160;
          input.rows = 3;
          input.value = record.node.text;
          input.className = [
            "mindmap-inline-editor",
            record.depth === 0 ? "is-root" : "",
            record.depth === 1 ? "is-level-one" : "",
          ]
            .filter(Boolean)
            .join(" ");
          input.setAttribute(
            "aria-label",
            `Sửa tên ${record.node.text}`,
          );
          input.setAttribute(
            "aria-keyshortcuts",
            "Control+Enter Escape Tab",
          );
          input.style.setProperty(
            "--mindmap-branch-color",
            layoutRecord.color,
          );
          input.style.left =
            layoutRecord.inX +
            taskOffset +
            progressOffset +
            numberOffset +
            "px";
          input.style.top = layoutRecord.y + "px";
          input.style.width =
            Math.max(
              120,
              layoutRecord.labelWidth -
                taskOffset -
                progressOffset -
                numberOffset,
            ) + "px";
          button.classList.add("is-editing");
          stage.appendChild(input);
          mindmapInlineEditorState = { id, input, button };
          input.addEventListener("pointerdown", (event) =>
            event.stopPropagation(),
          );
          input.addEventListener("click", (event) =>
            event.stopPropagation(),
          );
          input.addEventListener("keydown", (event) => {
            event.stopPropagation();
            if (event.isComposing || event.keyCode === 229) return;
            if (
              event.key === "Enter" &&
              (event.ctrlKey || event.metaKey)
            ) {
              event.preventDefault();
              finishMindmapInlineEdit(true, true);
            } else if (event.key === "Escape") {
              event.preventDefault();
              finishMindmapInlineEdit(false, true);
            } else if (event.key === "Tab") {
              event.preventDefault();
              finishMindmapInlineEditAndCreate("child");
            }
          });
          input.addEventListener("blur", () => {
            setTimeout(() => {
              if (mindmapInlineEditorState?.input === input)
                finishMindmapInlineEdit(true, false);
            }, 0);
          });
          input.focus();
          input.select();
        }

        function selectMindmapNode(id, editText) {
          if (!findMindmapNodeRecord(id)) return;
          setMindmapSelection([id], id);
          if (editText) beginMindmapInlineEdit(id);
        }

        function toggleMindmapFullscreen() {
          const shell = document.getElementById("mindmap-shell");
          if (!shell) return;
          if (document.fullscreenElement === shell) {
            document.exitFullscreen?.();
          } else if (shell.requestFullscreen) {
            shell.requestFullscreen().catch(() => {
              showToast("Trình duyệt không hỗ trợ mở toàn màn hình");
            });
          }
        }

        function attachMindmapInteractions() {
          const canvas = document.getElementById("mindmap-canvas");
          if (!canvas) return;
          const shell = document.getElementById("mindmap-shell");
          if (shell) shell.onkeydown = (event) => {
            const textEditingTarget = event.target?.matches?.(
              'input, textarea, [contenteditable="true"]',
            );
            if (
              !event.defaultPrevented &&
              !textEditingTarget &&
              (event.ctrlKey || event.metaKey) &&
              !event.shiftKey &&
              event.key.toLowerCase() === "z"
            ) {
              event.preventDefault();
              event.stopPropagation();
              undoMindmapAction();
              return;
            }
            if (
              !event.defaultPrevented &&
              !textEditingTarget &&
              event.key === "Delete" &&
              getSelectedMindmapTaskRecords().length
            ) {
              event.preventDefault();
              event.stopPropagation();
              deleteSelectedMindmapNode();
              return;
            }
            if (
              event.key !== "Tab" ||
              event.defaultPrevented ||
              event.isComposing
            )
              return;
            const focusable = Array.from(
              new Set(
                shell.querySelectorAll(
                  'button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])',
                ),
              ),
            );
            if (!focusable.length) return;
            const currentIndex = focusable.indexOf(
              document.activeElement,
            );
            const shouldWrapBackward =
              event.shiftKey && currentIndex <= 0;
            const shouldWrapForward =
              !event.shiftKey &&
              (currentIndex === -1 ||
                currentIndex === focusable.length - 1);
            if (!shouldWrapBackward && !shouldWrapForward) return;
            event.preventDefault();
            event.stopPropagation();
            const next = shouldWrapBackward
              ? focusable[focusable.length - 1]
              : focusable[0];
            next.focus();
          };

          canvas
            .querySelectorAll('[data-action="mindmap-select-node"]')
            .forEach((button) => {
              button.addEventListener("click", (event) => {
                if (Date.now() < mindmapSuppressClickUntil) {
                  event.preventDefault();
                  event.stopPropagation();
                  return;
                }
                const editText = !!event.target.closest?.(
                  ".mindmap-node-text",
                );
                selectMindmapNode(button.dataset.id, editText);
              });
              button.addEventListener("dblclick", (event) => {
                event.preventDefault();
                event.stopPropagation();
                selectMindmapNode(button.dataset.id, true);
              });
              button.addEventListener("dragstart", (event) => {
                const record = findMindmapNodeRecord(button.dataset.id);
                if (!record || record.depth === 0) {
                  event.preventDefault();
                  return;
                }
                if (mindmapInlineEditorState)
                  finishMindmapInlineEdit(true, false);
                mindmapDraggedNodeId = record.node.id;
                event.dataTransfer.effectAllowed = "move";
                event.dataTransfer.setData(
                  "text/plain",
                  record.node.id,
                );
                button.classList.add("is-dragging");
              });
              button.addEventListener("dragover", (event) => {
                if (
                  !mindmapDraggedNodeId ||
                  mindmapDraggedNodeId === button.dataset.id
                )
                  return;
                event.preventDefault();
                event.dataTransfer.dropEffect = "move";
                button.classList.remove(
                  "is-drop-target",
                  "is-drop-before",
                  "is-drop-after",
                );
                const dragged = findMindmapNodeRecord(
                  mindmapDraggedNodeId,
                );
                const target = findMindmapNodeRecord(button.dataset.id);
                if (
                  dragged?.parent &&
                  dragged.parent === target?.parent
                ) {
                  const rect = button.getBoundingClientRect();
                  const position =
                    event.clientY < rect.top + rect.height / 2
                      ? "before"
                      : "after";
                  button.dataset.mindmapDropMode = position;
                  button.classList.add(
                    position === "before"
                      ? "is-drop-before"
                      : "is-drop-after",
                  );
                } else {
                  button.dataset.mindmapDropMode = "child";
                  button.classList.add("is-drop-target");
                }
              });
              button.addEventListener("dragleave", (event) => {
                if (button.contains(event.relatedTarget)) return;
                button.classList.remove(
                  "is-drop-target",
                  "is-drop-before",
                  "is-drop-after",
                );
                delete button.dataset.mindmapDropMode;
              });
              button.addEventListener("drop", (event) => {
                event.preventDefault();
                event.stopPropagation();
                const dropMode =
                  button.dataset.mindmapDropMode || "child";
                button.classList.remove(
                  "is-drop-target",
                  "is-drop-before",
                  "is-drop-after",
                );
                delete button.dataset.mindmapDropMode;
                const draggedId =
                  event.dataTransfer.getData("text/plain") ||
                  mindmapDraggedNodeId;
                if (!draggedId) return;
                if (dropMode === "before" || dropMode === "after")
                  reorderMindmapSibling(
                    draggedId,
                    button.dataset.id,
                    dropMode,
                  );
                else
                  moveMindmapNodeToParent(
                    draggedId,
                    button.dataset.id,
                  );
              });
              button.addEventListener("dragend", () => {
                mindmapSuppressClickUntil = Date.now() + 220;
                mindmapDraggedNodeId = "";
                canvas
                  .querySelectorAll(
                    ".mindmap-node.is-dragging, .mindmap-node.is-drop-target, .mindmap-node.is-drop-before, .mindmap-node.is-drop-after",
                  )
                  .forEach((node) =>
                    node.classList.remove(
                      "is-dragging",
                      "is-drop-target",
                      "is-drop-before",
                      "is-drop-after",
                    ),
                  );
              });
              button.addEventListener("keydown", (event) => {
                if (shouldIgnoreMindmapShortcut(event)) return;
                if (event.key === "Enter") {
                  event.preventDefault();
                  event.stopPropagation();
                  selectedMindmapNodeId = button.dataset.id;
                  createMindmapNodeFromKeyboard("sibling");
                } else if (event.key === "Tab" && !event.shiftKey) {
                  event.preventDefault();
                  event.stopPropagation();
                  selectedMindmapNodeId = button.dataset.id;
                  createMindmapNodeFromKeyboard("child");
                } else if (event.key === "F2") {
                  event.preventDefault();
                  selectMindmapNode(button.dataset.id, true);
                } else if (event.key === "Insert") {
                  event.preventDefault();
                  selectedMindmapNodeId = button.dataset.id;
                  document.getElementById("mindmap-new-node-input")?.focus();
                } else if (event.key === "Delete") {
                  event.preventDefault();
                  event.stopPropagation();
                  if (
                    !selectedMindmapNodeIds.has(button.dataset.id)
                  ) {
                    setMindmapSelection(
                      [button.dataset.id],
                      button.dataset.id,
                    );
                  } else {
                    selectedMindmapNodeId = button.dataset.id;
                  }
                  deleteSelectedMindmapNode();
                } else if (
                  event.key === " " &&
                  findMindmapNodeRecord(button.dataset.id)?.node.children
                    .length
                ) {
                  event.preventDefault();
                  toggleMindmapNode(button.dataset.id);
                }
              });
            });

          canvas
            .querySelectorAll('[data-action="mindmap-toggle-check"]')
            .forEach((button) =>
              button.addEventListener("click", (event) => {
                event.stopPropagation();
                toggleMindmapNodeChecked(button.dataset.id);
              }),
            );

          canvas
            .querySelectorAll('[data-action="mindmap-toggle-node"]')
            .forEach((button) =>
              button.addEventListener("click", (event) => {
                event.stopPropagation();
                toggleMindmapNode(button.dataset.id);
              }),
            );

          const titleInput = document.getElementById("mindmap-title-input");
          document
            .getElementById("mindmap-save-title")
            ?.addEventListener("click", () =>
              commitMindmapNodeTitle(titleInput?.value),
            );
          titleInput?.addEventListener("keydown", (event) => {
            if (event.isComposing || event.keyCode === 229) return;
            if (
              event.key === "Enter" &&
              (event.ctrlKey || event.metaKey)
            ) {
              event.preventDefault();
              event.stopPropagation();
              commitMindmapNodeTitle(titleInput.value);
              return;
            }
            if (shouldIgnoreMindmapShortcut(event)) return;
            if (event.key === "Enter") {
              event.stopPropagation();
            } else if (event.key === "Tab" && !event.shiftKey) {
              event.preventDefault();
              event.stopPropagation();
              createMindmapNodeFromKeyboard("child", titleInput.value);
            } else if (event.key === "Escape") {
              event.preventDefault();
              refreshMindmapPanel();
            }
          });
          document
            .getElementById("mindmap-color-input")
            ?.addEventListener("change", (event) =>
              setSelectedMindmapBranchColor(event.target.value),
            );
          document
            .getElementById("mindmap-toggle-numbering")
            ?.addEventListener("click", toggleMindmapNumbering);
          document
            .getElementById("mindmap-branch-view")
            ?.addEventListener("click", openSelectedMindmapBranch);
          document
            .getElementById("mindmap-show-all")
            ?.addEventListener("click", () =>
              navigateMindmapBreadcrumb(state.mindmap.root.id),
            );
          canvas
            .querySelectorAll(
              '[data-action="mindmap-breadcrumb"]',
            )
            .forEach((button) =>
              button.addEventListener("click", () =>
                navigateMindmapBreadcrumb(button.dataset.id),
              ),
            );
          document
            .getElementById("mindmap-undo")
            ?.addEventListener("click", undoMindmapAction);
          document
            .getElementById("mindmap-add-child")
            ?.addEventListener("click", () => addMindmapNode("child"));
          document
            .getElementById("mindmap-add-sibling")
            ?.addEventListener("click", () => addMindmapNode("sibling"));
          document
            .getElementById("mindmap-toggle-selected")
            ?.addEventListener("click", () =>
              toggleMindmapNode(selectedMindmapNodeId),
            );
          document
            .getElementById("mindmap-delete-selected")
            ?.addEventListener("click", deleteSelectedMindmapNode);
          document
            .getElementById("mindmap-fullscreen")
            ?.addEventListener("click", toggleMindmapFullscreen);

          const newInput = document.getElementById(
            "mindmap-new-node-input",
          );
          newInput?.addEventListener("keydown", (event) => {
            if (event.isComposing || event.keyCode === 229) return;
            if (
              event.key === "Enter" &&
              (event.ctrlKey || event.metaKey)
            ) {
              event.preventDefault();
              event.stopPropagation();
              addMindmapNode("sibling", true);
              return;
            }
            if (shouldIgnoreMindmapShortcut(event)) return;
            if (event.key === "Enter") {
              event.stopPropagation();
            } else if (
              event.key === "Tab" &&
              !event.shiftKey &&
              cleanMindmapText(newInput.value, "")
            ) {
              event.preventDefault();
              event.stopPropagation();
              addMindmapNode("child", true);
            }
          });

          canvas.addEventListener("pointerdown", (event) => {
            if (
              event.target.closest(
                "button, input, textarea, label, .mindmap-breadcrumb",
              )
            )
              return;
            if (event.button !== 0) return;
            event.preventDefault();
            if (mindmapInlineEditorState)
              finishMindmapInlineEdit(true, false);
            const selectionBox = document.createElement("div");
            selectionBox.className = "mindmap-selection-box";
            selectionBox.setAttribute("aria-hidden", "true");
            canvas.appendChild(selectionBox);
            mindmapSelectionDragState = {
              pointerId: event.pointerId,
              startX: event.clientX,
              startY: event.clientY,
              moved: false,
              additive: event.ctrlKey || event.shiftKey,
              baseIds:
                event.ctrlKey || event.shiftKey
                  ? Array.from(selectedMindmapNodeIds)
                  : [],
              box: selectionBox,
            };
            canvas.setPointerCapture?.(event.pointerId);
            canvas.classList.add("is-selecting");
          });
          canvas.addEventListener("pointermove", (event) => {
            if (
              mindmapSelectionDragState?.pointerId ===
              event.pointerId
            ) {
              const drag = mindmapSelectionDragState;
              const distance = Math.hypot(
                event.clientX - drag.startX,
                event.clientY - drag.startY,
              );
              if (distance >= 4) drag.moved = true;
              if (!drag.moved) return;
              const canvasRect = canvas.getBoundingClientRect();
              const currentX = Math.min(
                canvasRect.right,
                Math.max(canvasRect.left, event.clientX),
              );
              const currentY = Math.min(
                canvasRect.bottom,
                Math.max(canvasRect.top, event.clientY),
              );
              const left = Math.min(drag.startX, currentX);
              const top = Math.min(drag.startY, currentY);
              const right = Math.max(drag.startX, currentX);
              const bottom = Math.max(drag.startY, currentY);
              drag.box.style.left = `${left - canvasRect.left}px`;
              drag.box.style.top = `${top - canvasRect.top}px`;
              drag.box.style.width = `${right - left}px`;
              drag.box.style.height = `${bottom - top}px`;
              const selectedIds = new Set(drag.baseIds);
              let primaryId = drag.baseIds[0] || "";
              canvas
                .querySelectorAll(
                  '[data-action="mindmap-select-node"]',
                )
                .forEach((button) => {
                  const record = findMindmapNodeRecord(
                    button.dataset.id,
                  );
                  if (!record || record.depth === 0) return;
                  const rect = button.getBoundingClientRect();
                  const intersects =
                    rect.right >= left &&
                    rect.left <= right &&
                    rect.bottom >= top &&
                    rect.top <= bottom;
                  if (intersects) {
                    selectedIds.add(record.node.id);
                    if (!primaryId) primaryId = record.node.id;
                  }
                });
              setMindmapSelection(
                Array.from(selectedIds),
                primaryId,
              );
              return;
            }
          });
          const endPointerAction = (event, cancelled) => {
            if (
              mindmapSelectionDragState?.pointerId ===
              event.pointerId
            ) {
              const drag = mindmapSelectionDragState;
              mindmapSelectionDragState = null;
              drag.box.remove();
              canvas.classList.remove("is-selecting");
              if (cancelled) {
                setMindmapSelection(
                  drag.baseIds,
                  drag.baseIds[0],
                );
              } else if (!drag.moved) {
                setMindmapSelection(
                  [state.mindmap.root.id],
                  state.mindmap.root.id,
                );
              }
              canvas.releasePointerCapture?.(event.pointerId);
              canvas.focus();
              return;
            }
          };
          canvas.addEventListener("pointerup", (event) =>
            endPointerAction(event, false),
          );
          canvas.addEventListener("pointercancel", (event) =>
            endPointerAction(event, true),
          );
          canvas.addEventListener("keydown", (event) => {
            if (shouldIgnoreMindmapShortcut(event)) return;
            if (
              event.target === canvas &&
              event.key === "Enter" &&
              !event.repeat
            ) {
              event.preventDefault();
              event.stopPropagation();
              createMindmapNodeFromKeyboard("sibling");
            } else if (
              event.target === canvas &&
              event.key === "Tab" &&
              !event.shiftKey &&
              !event.repeat
            ) {
              event.preventDefault();
              event.stopPropagation();
              createMindmapNodeFromKeyboard("child");
            }
          });
        }

        const LOCAL_BACKUP_KEY = "todolist_state_backup_v1";
        const LOCAL_BACKUP_HISTORY_KEY = "todolist_state_history_v2";
        const LOCAL_BACKUP_HISTORY_LIMIT = 8;
        const CLOUD_BACKUP_HISTORY_LIMIT = 30;
        let lastKnownRemoteSavedAt = 0;
        let lastKnownRemoteFingerprint = null;
        let pendingSaveReason = "Tự động";
        let lastEmptySaveWarningAt = 0;

        function countBackupTreeNodes(nodes) {
          const list = Array.isArray(nodes) ? nodes : [];
          return list.reduce(
            (total, node) =>
              node && node._todayAuto
                ? total
                : total +
                  1 +
                  countBackupTreeNodes(
                    node && Array.isArray(node.children) ? node.children : [],
                  ),
            0,
          );
        }

        function mindmapBackupContent(node) {
          if (!node || typeof node !== "object") return null;
          return {
            text: String(node.text || ""),
            color: String(node.color || ""),
            checked: !!node.checked,
            children: (Array.isArray(node.children) ? node.children : []).map(
              mindmapBackupContent,
            ),
          };
        }

        const DEFAULT_MINDMAP_CONTENT_SIGNATURE = JSON.stringify({
          text: "Mindmap của tôi",
          color: "#3867ff",
          checked: false,
          children: [
            {
              text: "Tài khoản",
              color: "#ff6b35",
              checked: false,
              children: [],
            },
            {
              text: "Vấn đề cuộc sống",
              color: "#a85bb2",
              checked: false,
              children: [],
            },
            {
              text: "Tối ưu máy tính",
              color: "#b7d900",
              checked: false,
              children: [
                {
                  text: "1",
                  color: "",
                  checked: false,
                  children: [],
                },
                {
                  text: "2",
                  color: "",
                  checked: false,
                  children: [],
                },
              ],
            },
            {
              text: "Phong cách ăn mặc",
              color: "#00a9c7",
              checked: false,
              children: [],
            },
          ],
        });

        function mindmapHasBackupContent(candidate) {
          const root = candidate?.mindmap?.root;
          if (!root) return false;
          return (
            JSON.stringify(mindmapBackupContent(root)) !==
            DEFAULT_MINDMAP_CONTENT_SIGNATURE
          );
        }

        function getStateDataSummary(candidate) {
          const source =
            candidate && typeof candidate === "object" ? candidate : {};
          const archiveCount = Object.values(
            source.completedArchive || {},
          ).reduce(
            (total, entries) =>
              total + (Array.isArray(entries) ? entries.length : 0),
            0,
          );
          const taskNodes =
            countBackupTreeNodes(source.tasks) +
            countBackupTreeNodes(source.todayTask?.children) +
            countBackupTreeNodes(source.tomorrowTask?.children);
          const mindmapMeaningful = mindmapHasBackupContent(source);
          const mindmapNodes = mindmapMeaningful
            ? countBackupTreeNodes(source.mindmap?.root?.children)
            : 0;
          const haravanCodeNodes = countBackupTreeNodes(source.haravanCode);
          const moneyEntries = Object.keys(source.money?.entries || {}).length;
          const toolDocuments = [
            source.haravanClone?.source,
            source.haravanClone?.output,
            source.haravanDoubleLayout?.liquid,
            source.haravanDoubleLayout?.setting,
            source.haravanDoubleLayout?.liquidOutput,
            source.haravanDoubleLayout?.settingOutput,
          ].filter((value) => String(value || "").trim()).length;
          const summary = {
            taskNodes,
            recurringRules: Array.isArray(source.recurringRules)
              ? source.recurringRules.length
              : 0,
            archiveEntries: archiveCount,
            calendarTasks: Array.isArray(source.calendarTasks)
              ? source.calendarTasks.length
              : 0,
            events: Array.isArray(source.events) ? source.events.length : 0,
            ideas: Array.isArray(source.ideas) ? source.ideas.length : 0,
            music: Array.isArray(source.music) ? source.music.length : 0,
            musicCategories: Array.isArray(source.musicCategories)
              ? source.musicCategories.length
              : 0,
            moneyEntries,
            alarms: Array.isArray(source.alarms) ? source.alarms.length : 0,
            mindmapNodes,
            haravanCodeNodes,
            toolDocuments,
            trash: Array.isArray(source.trash) ? source.trash.length : 0,
          };
          summary.score = Object.values(summary).reduce(
            (total, value) => total + Number(value || 0),
            0,
          );
          return summary;
        }

        function hasMeaningfulStateData(candidate) {
          return getStateDataSummary(candidate).score > 0;
        }

        function backupComparableState(candidate) {
          const source = cloneBackupState(candidate);
          return {
            tasks: source.tasks || [],
            recurringRules: source.recurringRules || [],
            events: source.events || [],
            calendarTasks: source.calendarTasks || [],
            todayTask: source.todayTask || null,
            tomorrowTask: source.tomorrowTask || null,
            completedArchive: source.completedArchive || {},
            money: source.money || { entries: {} },
            ideas: source.ideas || [],
            music: source.music || [],
            musicCategories: source.musicCategories || [],
            alarms: source.alarms || [],
            mindmap: source.mindmap?.root
              ? { root: source.mindmap.root }
              : null,
            haravanCode: source.haravanCode || [],
            haravanClone: source.haravanClone || null,
            haravanDoubleLayout: source.haravanDoubleLayout || null,
            trash: source.trash || [],
          };
        }

        function hashBackupText(text) {
          let hash = 2166136261;
          for (let index = 0; index < text.length; index++) {
            hash ^= text.charCodeAt(index);
            hash = Math.imul(hash, 16777619);
          }
          return (hash >>> 0).toString(36);
        }

        function stateBackupFingerprint(candidate) {
          return hashBackupText(
            JSON.stringify(backupComparableState(candidate)),
          );
        }

        function cloneBackupState(candidate) {
          const snapshot = JSON.parse(JSON.stringify(candidate || {}));
          const stripAutomaticNodes = (nodes) => {
            if (!Array.isArray(nodes)) return;
            for (let index = nodes.length - 1; index >= 0; index--) {
              const node = nodes[index];
              if (node && node._todayAuto) {
                nodes.splice(index, 1);
                continue;
              }
              stripAutomaticNodes(node?.children);
            }
          };
          stripAutomaticNodes(snapshot.tasks);
          stripAutomaticNodes(snapshot.todayTask?.children);
          stripAutomaticNodes(snapshot.tomorrowTask?.children);
          return snapshot;
        }

        function readLocalCurrentBackup() {
          try {
            const raw = localStorage.getItem(LOCAL_BACKUP_KEY);
            return raw ? JSON.parse(raw) : null;
          } catch (error) {
            console.error("Đọc bản sao lưu cục bộ lỗi", error);
            return null;
          }
        }

        function readLocalBackupHistory() {
          try {
            const raw = localStorage.getItem(LOCAL_BACKUP_HISTORY_KEY);
            const parsed = raw ? JSON.parse(raw) : [];
            return (Array.isArray(parsed) ? parsed : [])
              .filter(
                (entry) =>
                  entry &&
                  entry.data &&
                  hasMeaningfulStateData(entry.data),
              )
              .sort(
                (left, right) =>
                  Number(right.createdAt || right.savedAt || 0) -
                  Number(left.createdAt || left.savedAt || 0),
              );
          } catch (error) {
            console.error("Đọc lịch sử sao lưu cục bộ lỗi", error);
            return [];
          }
        }

        function writeLocalBackupHistory(entries) {
          const history = entries.slice(0, LOCAL_BACKUP_HISTORY_LIMIT);
          while (history.length) {
            try {
              localStorage.setItem(
                LOCAL_BACKUP_HISTORY_KEY,
                JSON.stringify(history),
              );
              return true;
            } catch (error) {
              history.pop();
            }
          }
          try {
            localStorage.setItem(LOCAL_BACKUP_HISTORY_KEY, "[]");
          } catch (error) {}
          return false;
        }

        function addLocalBackupVersion(candidate, reason) {
          if (!hasMeaningfulStateData(candidate)) return false;
          const fingerprint = stateBackupFingerprint(candidate);
          const history = readLocalBackupHistory().filter(
            (entry) => entry.fingerprint !== fingerprint,
          );
          history.unshift({
            id: `local_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`,
            source: "local",
            reason: reason || "Tự động",
            savedAt: Number(candidate.savedAt || Date.now()),
            createdAt: Date.now(),
            fingerprint,
            summary: getStateDataSummary(candidate),
            data: cloneBackupState(candidate),
          });
          return writeLocalBackupHistory(history);
        }

        function persistCurrentStateLocally(reason) {
          if (!hasMeaningfulStateData(state)) return false;
          try {
            const previous = readLocalCurrentBackup();
            if (
              previous &&
              hasMeaningfulStateData(previous) &&
              stateBackupFingerprint(previous) !==
                stateBackupFingerprint(state)
            ) {
              addLocalBackupVersion(
                previous,
                reason || "Trước khi lưu thay đổi mới",
              );
            }
            const serialized = JSON.stringify(cloneBackupState(state));
            let history = readLocalBackupHistory();
            while (true) {
              try {
                localStorage.setItem(LOCAL_BACKUP_KEY, serialized);
                return true;
              } catch (error) {
                if (!history.length) throw error;
                history.pop();
                writeLocalBackupHistory(history);
              }
            }
          } catch (error) {
            console.error("Lưu bản sao cục bộ lỗi", error);
            return false;
          }
        }

        function parseFirestoreDocument(documentValue) {
          const raw = documentValue?.fields?.data?.stringValue;
          if (!raw) return null;
          return JSON.parse(raw);
        }

        async function fetchFirestoreState() {
          try {
            const response = await fetch(FIRESTORE_DOC_URL, {
              cache: "no-store",
            });
            if (response.status === 404) {
              return {
                ok: true,
                exists: false,
                parsed: null,
                updateTime: "",
              };
            }
            if (!response.ok) {
              return {
                ok: false,
                status: response.status,
                exists: false,
                parsed: null,
                updateTime: "",
              };
            }
            const documentValue = await response.json();
            const parsed = parseFirestoreDocument(documentValue);
            if (!parsed || typeof parsed !== "object") {
              return {
                ok: false,
                status: 422,
                exists: true,
                parsed: null,
                updateTime: documentValue.updateTime || "",
              };
            }
            return {
              ok: true,
              exists: true,
              parsed,
              updateTime: documentValue.updateTime || "",
            };
          } catch (error) {
            console.error("Firestore load lỗi", error);
            return {
              ok: false,
              status: 0,
              exists: false,
              parsed: null,
              updateTime: "",
            };
          }
        }

        function applyParsedState(parsed) {
          state.tasks = parsed.tasks || [];
          state.recurringRules = Array.isArray(parsed.recurringRules)
            ? parsed.recurringRules
            : [];
          state.collapsed = parsed.collapsed || {};
          state.events = parsed.events || [];
          state.todayTask = parsed.todayTask || null;
          state.tomorrowTask = parsed.tomorrowTask || null;
          state.lastRolloverDate = parsed.lastRolloverDate || null;
          state.calendarTasks = parsed.calendarTasks || [];
          state.alarms = Array.isArray(parsed.alarms) ? parsed.alarms : [];
          state.completedArchive = parsed.completedArchive || {};
          state.collapsedArchive = parsed.collapsedArchive || {};
          state.collapsedSections = parsed.collapsedSections || {};
          state.savedAt = parsed.savedAt || 0;
          state.showCompletedTasks = !!parsed.showCompletedTasks;
          state.money = parsed.money && parsed.money.entries
            ? parsed.money
            : { entries: {} };
          state.ideas = parsed.ideas || [];
          state.music = (parsed.music || []).map((item) => ({
            ...item,
            categoryId: item.categoryId || null,
          }));
          state.musicCategories = Array.isArray(parsed.musicCategories)
            ? parsed.musicCategories.filter(
                (category) => category && category.id && category.name,
              )
              : [];
          state.mindmap = normalizeMindmapState(parsed.mindmap);
          mindmapUndoStack.length = 0;
          selectedMindmapNodeId = state.mindmap.root.id;
          selectedMindmapNodeIds = new Set([
            state.mindmap.root.id,
          ]);
          state.haravanCode = Array.isArray(parsed.haravanCode)
            ? parsed.haravanCode
            : [];
          state.haravanCodeCollapsed = parsed.haravanCodeCollapsed || {};
          state.haravanCode.forEach(ensureHaravanCodeNodeFields);
          sortHaravanCodeTree(state.haravanCode);
          state.haravanClone = {
            source:
              typeof parsed.haravanClone?.source === "string"
                ? parsed.haravanClone.source
                : "",
            count: Math.min(
              50,
              Math.max(1, Number.parseInt(parsed.haravanClone?.count, 10) || 3),
            ),
            output:
              typeof parsed.haravanClone?.output === "string"
                ? parsed.haravanClone.output
                : "",
            detectedIndex: Number.isInteger(
              parsed.haravanClone?.detectedIndex,
            )
              ? parsed.haravanClone.detectedIndex
              : null,
          };
          <!-- code mới thời gian 14:11:05 23/07/2026 -->
          state.haravanDoubleLayout = {
            liquid:
              typeof parsed.haravanDoubleLayout?.liquid === "string"
                ? parsed.haravanDoubleLayout.liquid
                : "",
            setting:
              typeof parsed.haravanDoubleLayout?.setting === "string"
                ? parsed.haravanDoubleLayout.setting
                : "",
            count: Math.min(
              50,
              Math.max(
                1,
                Number.parseInt(parsed.haravanDoubleLayout?.count, 10) || 2,
              ),
            ),
            liquidOutput:
              typeof parsed.haravanDoubleLayout?.liquidOutput === "string"
                ? parsed.haravanDoubleLayout.liquidOutput
                : "",
            settingOutput:
              typeof parsed.haravanDoubleLayout?.settingOutput === "string"
                ? parsed.haravanDoubleLayout.settingOutput
                : "",
          };
          if (
            state.haravanDoubleLayout.liquid &&
            state.haravanDoubleLayout.setting &&
            (state.haravanDoubleLayout.liquidOutput ||
              state.haravanDoubleLayout.settingOutput)
          ) {
            const refreshedDoubleLayout = generateHaravanDoubleLayout(
              state.haravanDoubleLayout.liquid,
              state.haravanDoubleLayout.setting,
              state.haravanDoubleLayout.count,
            );
            if (!refreshedDoubleLayout.error) {
              state.haravanDoubleLayout.liquidOutput =
                refreshedDoubleLayout.liquidOutput;
              state.haravanDoubleLayout.settingOutput =
                refreshedDoubleLayout.settingOutput;
            }
          }
          <!-- code mới thời gian 14:11:05 23/07/2026 end -->
          state.trash = parsed.trash || [];
          state.tasks.forEach(ensureNodeFields);
          sortTaskTree(state.tasks);
        }

        // ---------- Firestore load/save + version history ----------
        // Quy tắc an toàn:
        // 1) Trạng thái rỗng/default không bao giờ được ghi đè localStorage hay cloud.
        // 2) Mỗi lần ghi cloud phải đọc lại bản hiện tại và dùng updateTime làm precondition.
        // 3) Bản cloud cũ được lưu thành một version riêng trước khi bị thay thế.
        let pendingSync = false;
        let syncInFlight = false;
        let lastCloudBackupFingerprint = "";
        let syncRetryTimer = null;
        const SYNC_RETRY_DELAY_MS = 5000;

        function scheduleTransientSyncRetry() {
          if (syncRetryTimer || !pendingSync) return;
          if (typeof navigator !== "undefined" && navigator.onLine === false)
            return;
          syncRetryTimer = setTimeout(() => {
            syncRetryTimer = null;
            if (pendingSync) syncToFirebase(true, pendingSaveReason);
          }, SYNC_RETRY_DELAY_MS);
        }

        function clearTransientSyncRetry() {
          clearTimeout(syncRetryTimer);
          syncRetryTimer = null;
        }

        function firestoreStringField(documentValue, fieldName) {
          return (
            documentValue?.fields?.[fieldName]?.stringValue ||
            documentValue?.fields?.[fieldName]?.timestampValue ||
            ""
          );
        }

        function firestoreNumberField(documentValue, fieldName) {
          return Number(
            documentValue?.fields?.[fieldName]?.integerValue ||
              documentValue?.fields?.[fieldName]?.doubleValue ||
              0,
          );
        }

        function backupSummaryLabel(summary) {
          const value = summary || {};
          const parts = [];
          if (value.taskNodes) parts.push(`${value.taskNodes} task`);
          if (value.mindmapNodes)
            parts.push(`${value.mindmapNodes} node Mindmap`);
          if (value.ideas) parts.push(`${value.ideas} ý tưởng`);
          if (value.music) parts.push(`${value.music} bài nhạc`);
          if (value.haravanCodeNodes)
            parts.push(`${value.haravanCodeNodes} mục Haravan`);
          if (value.calendarTasks)
            parts.push(`${value.calendarTasks} lịch`);
          if (value.archiveEntries)
            parts.push(`${value.archiveEntries} hoàn thành`);
          return parts.length ? parts.join(" · ") : "Có dữ liệu đã lưu";
        }

        function cloudBackupMetadata(documentValue) {
          let summary = {};
          try {
            summary = JSON.parse(
              firestoreStringField(documentValue, "summary") || "{}",
            );
          } catch (error) {}
          const name = String(documentValue?.name || "");
          return {
            id: name.split("/").pop() || genId("backup"),
            documentName: name,
            source: "cloud",
            reason:
              firestoreStringField(documentValue, "reason") ||
              "Tự động trước khi đồng bộ",
            savedAt: firestoreNumberField(documentValue, "savedAt"),
            createdAt:
              Date.parse(
                firestoreStringField(documentValue, "createdAt"),
              ) || firestoreNumberField(documentValue, "savedAt"),
            fingerprint: firestoreStringField(
              documentValue,
              "fingerprint",
            ),
            summary,
          };
        }

        async function listCloudBackupVersions(pageSize) {
          const params = new URLSearchParams();
          params.set(
            "pageSize",
            String(Math.min(100, Math.max(1, pageSize || 50))),
          );
          [
            "savedAt",
            "createdAt",
            "reason",
            "fingerprint",
            "summary",
          ].forEach((field) => params.append("mask.fieldPaths", field));
          const response = await fetch(
            `${FIRESTORE_BACKUPS_URL}?${params.toString()}`,
            { cache: "no-store" },
          );
          if (response.status === 404) return [];
          if (!response.ok)
            throw new Error(`Firestore backup list ${response.status}`);
          const payload = await response.json();
          return (Array.isArray(payload.documents)
            ? payload.documents
            : []
          )
            .map(cloudBackupMetadata)
            .filter((entry) => /^v_\d+_[a-z0-9]+$/i.test(entry.id))
            .sort(
              (left, right) =>
                Number(right.createdAt || right.savedAt || 0) -
                Number(left.createdAt || left.savedAt || 0),
            );
        }

        async function fetchCloudBackupData(entry) {
          if (!entry?.documentName) return null;
          const response = await fetch(
            `https://firestore.googleapis.com/v1/${entry.documentName}`,
            { cache: "no-store" },
          );
          if (!response.ok)
            throw new Error(`Firestore backup read ${response.status}`);
          return parseFirestoreDocument(await response.json());
        }

        async function trimCloudBackupHistory() {
          try {
            const versions = await listCloudBackupVersions(100);
            const expired = versions.slice(CLOUD_BACKUP_HISTORY_LIMIT);
            await Promise.all(
              expired.map((entry) =>
                fetch(
                  `https://firestore.googleapis.com/v1/${entry.documentName}`,
                  { method: "DELETE" },
                ).catch(() => null),
              ),
            );
          } catch (error) {
            console.error("Dọn lịch sử backup cloud lỗi", error);
          }
        }

        async function createCloudBackupVersion(candidate, reason) {
          if (!hasMeaningfulStateData(candidate)) return false;
          const snapshot = cloneBackupState(candidate);
          const fingerprint = stateBackupFingerprint(snapshot);
          if (fingerprint === lastCloudBackupFingerprint) return true;
          const serialized = JSON.stringify(snapshot);
          if (serialized.length > 900000) {
            console.error("Backup cloud vượt ngưỡng an toàn 900 KB");
            return false;
          }
          const createdAt = new Date().toISOString();
          const documentId = `v_${Date.now()}_${Math.random()
            .toString(36)
            .slice(2, 8)}`;
          const body = {
            fields: {
              data: { stringValue: serialized },
              savedAt: {
                integerValue: String(
                  Number(snapshot.savedAt || Date.now()),
                ),
              },
              createdAt: { timestampValue: createdAt },
              reason: {
                stringValue: String(reason || "Tự động").slice(0, 180),
              },
              fingerprint: { stringValue: fingerprint },
              summary: {
                stringValue: JSON.stringify(getStateDataSummary(snapshot)),
              },
            },
          };
          try {
            const response = await fetch(
              `${FIRESTORE_BACKUPS_URL}/${documentId}?currentDocument.exists=false`,
              {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body),
              },
            );
            if (!response.ok) {
              console.error(
                "Tạo backup cloud lỗi",
                response.status,
                await response.text(),
              );
              return false;
            }
            lastCloudBackupFingerprint = fingerprint;
            trimCloudBackupHistory();
            return true;
          } catch (error) {
            console.error("Tạo backup cloud lỗi", error);
            return false;
          }
        }

        async function loadState() {
          const remoteResult = await fetchFirestoreState();
          const firestoreParsed = remoteResult.parsed;
          const localParsed = readLocalCurrentBackup();
          const remoteHasData = hasMeaningfulStateData(firestoreParsed);
          const localHasData = hasMeaningfulStateData(localParsed);
          const firestoreSavedAt = Number(firestoreParsed?.savedAt || 0);
          const localSavedAt = Number(localParsed?.savedAt || 0);
          let chosen = null;
          let useLocal = false;

          if (remoteResult.ok) {
            lastKnownRemoteSavedAt = firestoreSavedAt;
            lastKnownRemoteFingerprint = stateBackupFingerprint(
              firestoreParsed || {},
            );
          }

          // Một bản rỗng không bao giờ thắng một bản có dữ liệu, kể cả savedAt mới hơn.
          if (localHasData && !remoteHasData) {
            chosen = localParsed;
            useLocal = true;
          } else if (remoteHasData && !localHasData) {
            chosen = firestoreParsed;
          } else if (remoteHasData && localHasData) {
            useLocal = localSavedAt > firestoreSavedAt;
            chosen = useLocal ? localParsed : firestoreParsed;
          }

          if (chosen) {
            applyParsedState(chosen);
            persistCurrentStateLocally(
              useLocal
                ? "Giữ bản cục bộ an toàn"
                : "Trước khi nhận bản cloud mới",
            );
            ensureDayTasks();
            if (useLocal && remoteResult.ok) {
              showToast(
                remoteHasData
                  ? "Đã giữ bản cục bộ mới hơn và chuẩn bị sao lưu bản cloud cũ"
                  : "Đã chặn bản cloud rỗng và khôi phục dữ liệu từ máy này",
              );
              scheduleAutoExport("Khôi phục bản cục bộ an toàn");
            } else if (useLocal && !remoteResult.ok && localHasData) {
              // Khi tải trang lúc offline, pendingSync bị reset theo phiên.
              // Đánh dấu lại để sự kiện online hoặc retry sau đó không bỏ sót
              // bản local đã được lưu trước khi tải lại trang.
              pendingSync = true;
              scheduleTransientSyncRetry();
            }
          } else if (!remoteResult.ok) {
            showToast(
              "Không tải được cloud — chế độ an toàn đang chặn mọi ghi đè",
            );
          }
        }

        function scheduleAutoExport(reason) {
          clearTimeout(autoSaveTimer);
          if (!hasMeaningfulStateData(state)) {
            const now = Date.now();
            if (now - lastEmptySaveWarningAt > 15000) {
              showToast(
                "Đã chặn lưu: dữ liệu rỗng không được phép ghi đè bản sao lưu",
              );
              lastEmptySaveWarningAt = now;
            }
            return false;
          }
          state.savedAt = Date.now();
          pendingSaveReason = reason || "Tự động trước khi đồng bộ";
          const localSaved = persistCurrentStateLocally(pendingSaveReason);
          if (!localSaved)
            showToast("Không lưu được bản cục bộ — đã dừng đồng bộ cloud");
          if (!localSaved) return false;
          autoSaveTimer = setTimeout(
            () => syncToFirebase(false, pendingSaveReason),
            300,
          );
          return true;
        }

        async function syncToFirebase(silent, reason) {
          if (syncInFlight) {
            pendingSync = true;
            return false;
          }
          if (!hasMeaningfulStateData(state)) {
            if (!silent)
              showToast(
                "Đã chặn đồng bộ: dữ liệu rỗng không thể ghi đè cloud",
              );
            return false;
          }
          if (
            typeof navigator !== "undefined" &&
            navigator.onLine === false
          ) {
            if (!pendingSync && !silent)
              showToast(
                "Không có mạng — đã lưu trên máy và chưa ghi đè cloud",
              );
            pendingSync = true;
            return false;
          }

          syncInFlight = true;
          const snapshot = cloneBackupState(state);
          const snapshotFingerprint = stateBackupFingerprint(snapshot);
          let syncSucceeded = false;
          try {
            // Đọc lại cloud ngay trước khi ghi để không ghi đè thay đổi từ thiết bị khác.
            const remoteResult = await fetchFirestoreState();
            if (!remoteResult.ok) {
              if (!pendingSync && !silent)
                showToast(
                  "Không xác minh được cloud — đã chặn ghi để bảo vệ dữ liệu",
                );
              pendingSync = true;
              scheduleTransientSyncRetry();
              return false;
            }

            const remoteState = remoteResult.parsed;
            const remoteHasData = hasMeaningfulStateData(remoteState);
            const remoteFingerprint = stateBackupFingerprint(
              remoteState || {},
            );
            const remoteSavedAt = Number(remoteState?.savedAt || 0);
            const snapshotSavedAt = Number(snapshot.savedAt || 0);
            const remoteBaselineUnknown = lastKnownRemoteFingerprint === null;
            const remoteChangedElsewhere =
              remoteHasData &&
              remoteFingerprint !== snapshotFingerprint &&
              (remoteBaselineUnknown
                ? remoteSavedAt >= snapshotSavedAt
                : remoteFingerprint !== lastKnownRemoteFingerprint);

            // Nếu app khởi động lúc offline thì chưa có fingerprint cloud để
            // so sánh. Chỉ thiết lập baseline sau khi xác định bản local mới
            // hơn (hoặc trùng) cloud; cloud mới hơn vẫn phải dừng để bảo vệ
            // dữ liệu từ thiết bị khác.
            if (!remoteChangedElsewhere && remoteBaselineUnknown) {
              lastKnownRemoteFingerprint = remoteFingerprint;
            }

            if (remoteChangedElsewhere) {
              addLocalBackupVersion(
                snapshot,
                "Bản trên máy bị chặn do xung đột cloud",
              );
              await createCloudBackupVersion(
                snapshot,
                "Bản trên máy bị chặn do xung đột cloud",
              );
              if (!silent)
                showToast(
                  "Cloud có phiên bản khác — đã chặn ghi đè và lưu bản trên máy vào lịch sử",
                );
              pendingSync = true;
              return false;
            }

            if (
              remoteHasData &&
              remoteFingerprint !== snapshotFingerprint
            ) {
              const backedUp = await createCloudBackupVersion(
                remoteState,
                reason || "Trước khi ghi phiên bản mới",
              );
              if (!backedUp) {
                if (!silent)
                  showToast(
                    "Không tạo được bản sao cloud — đã hủy ghi đè để bảo vệ dữ liệu",
                  );
                pendingSync = true;
                scheduleTransientSyncRetry();
                return false;
              }
            }

            const body = {
              fields: {
                data: { stringValue: JSON.stringify(snapshot) },
              },
            };
            const params = new URLSearchParams();
            params.set("updateMask.fieldPaths", "data");
            if (remoteResult.exists && remoteResult.updateTime) {
              params.set(
                "currentDocument.updateTime",
                remoteResult.updateTime,
              );
            } else if (!remoteResult.exists) {
              params.set("currentDocument.exists", "false");
            }
            const response = await fetch(
              `${FIRESTORE_DOC_URL}?${params.toString()}`,
              {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body),
              },
            );
            if (!response.ok) {
              const responseText = await response.text();
              console.error(
                "Firestore save lỗi",
                response.status,
                responseText,
              );
              if (!silent)
                showToast(
                  response.status === 409 || response.status === 412
                    ? "Cloud vừa thay đổi — đã chặn ghi đè và giữ bản trên máy"
                    : "Lưu cloud thất bại — bản trên máy vẫn an toàn",
                );
              pendingSync = true;
              if (response.status !== 409 && response.status !== 412)
                scheduleTransientSyncRetry();
              return false;
            }

            const savedDocument = await response.json();
            lastKnownRemoteSavedAt = Number(snapshot.savedAt || remoteSavedAt);
            lastKnownRemoteFingerprint = snapshotFingerprint;
            if (savedDocument.updateTime)
              remoteResult.updateTime = savedDocument.updateTime;
            pendingSync = false;
            clearTransientSyncRetry();
            syncSucceeded = true;
            return true;
          } catch (error) {
            console.error("Firestore save lỗi", error);
            if (!pendingSync && !silent)
              showToast(
                "Không có mạng — bản trên máy vẫn an toàn và cloud không bị ghi đè",
              );
            pendingSync = true;
            scheduleTransientSyncRetry();
            return false;
          } finally {
            syncInFlight = false;
            if (
              syncSucceeded &&
              hasMeaningfulStateData(state) &&
              stateBackupFingerprint(state) !== snapshotFingerprint
            ) {
              clearTimeout(autoSaveTimer);
              autoSaveTimer = setTimeout(
                () => syncToFirebase(false, pendingSaveReason),
                300,
              );
            }
          }
        }

        // Khi có mạng trở lại, xác minh cloud trước rồi mới thử đồng bộ.
        window.addEventListener("online", () => {
          if (pendingSync) {
            clearTransientSyncRetry();
            showToast("Đã có mạng, đang xác minh phiên bản cloud...");
            syncToFirebase(false, pendingSaveReason);
          }
        });

        // ---------- manual JSON file export/import (real downloadable .json) ----------
        function downloadBackupState(candidate, fileName, silent) {
          try {
            const blob = new Blob([JSON.stringify(candidate, null, 2)], {
              type: "application/json",
            });
            const url = URL.createObjectURL(blob);
            const a = document.createElement("a");
            a.href = url;
            a.download = fileName || FILE_NAME;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(url), 1000);
            if (!silent) showToast("Đã xuất file " + a.download);
            return true;
          } catch (e) {
            console.error("Export thất bại", e);
            if (!silent) showToast("Không xuất được file sao lưu");
            return false;
          }
        }

        function exportJsonFile(silent) {
          return downloadBackupState(state, FILE_NAME, silent);
        }

        function importJsonFile(file) {
          const reader = new FileReader();
          reader.onload = () => {
            try {
              const parsed = JSON.parse(reader.result);
              if (!hasMeaningfulStateData(parsed)) {
                showToast(
                  "Đã chặn nhập: file không chứa dữ liệu để khôi phục",
                );
                return;
              }
              addLocalBackupVersion(state, "Trước khi nhập file JSON");
              applyParsedState(parsed);
              ensureDayTasks();
              render();
              showToast("Đã nhập dữ liệu từ file");
              scheduleAutoExport("Khôi phục từ file JSON");
            } catch (e) {
              showToast("File JSON không hợp lệ");
            }
          };
          reader.readAsText(file);
        }

        let backupHistoryDialogEntries = [];

        function backupVersionDate(entry) {
          const timestamp = Number(
            entry?.createdAt || entry?.savedAt || Date.now(),
          );
          try {
            return new Date(timestamp).toLocaleString("vi-VN");
          } catch (error) {
            return "Không rõ thời gian";
          }
        }

        function closeBackupHistoryDialog() {
          document.getElementById("backup-history-modal")?.remove();
        }

        function renderBackupHistoryDialog(statusMessage) {
          const list = document.getElementById("backup-history-list");
          if (!list) return;
          const itemsHtml = backupHistoryDialogEntries
            .map((entry, index) => {
              const isCurrent = entry.source === "current";
              const sourceLabel =
                entry.source === "cloud"
                  ? "Cloud"
                  : entry.source === "local"
                    ? "Trình duyệt"
                    : "Hiện tại";
              const title = isCurrent
                ? "Bản dữ liệu đang mở"
                : backupVersionDate(entry);
              const reason = entry.reason || "Tự động";
              const summary = backupSummaryLabel(entry.summary);
              return `<article class="backup-history-item ${isCurrent ? "is-current" : ""}">
                <div>
                  <div class="backup-history-title">${escapeHtml(title)} <span class="backup-history-source">${escapeHtml(sourceLabel)}</span></div>
                  <div class="backup-history-summary">${escapeHtml(reason)} · ${escapeHtml(summary)}</div>
                </div>
                <div class="backup-history-actions">
                  <button type="button" class="backup-history-action" data-backup-action="download" data-backup-index="${index}">Tải JSON</button>
                  ${isCurrent ? "" : `<button type="button" class="backup-history-action restore" data-backup-action="restore" data-backup-index="${index}">Khôi phục</button>`}
                </div>
              </article>`;
            })
            .join("");
          const statusHtml = statusMessage
            ? `<div class="backup-history-empty">${escapeHtml(statusMessage)}</div>`
            : "";
          list.innerHTML =
            itemsHtml ||
            statusHtml ||
            '<div class="backup-history-empty">Chưa có phiên bản sao lưu.</div>';
          if (itemsHtml && statusHtml) list.insertAdjacentHTML("beforeend", statusHtml);
        }

        async function resolveBackupVersionData(entry) {
          if (entry?.data) return cloneBackupState(entry.data);
          if (entry?.source === "cloud")
            return fetchCloudBackupData(entry);
          return null;
        }

        async function restoreBackupVersion(entry) {
          let restored;
          try {
            restored = await resolveBackupVersionData(entry);
          } catch (error) {
            console.error("Đọc phiên bản backup lỗi", error);
            showToast("Không tải được phiên bản sao lưu này");
            return false;
          }
          if (!hasMeaningfulStateData(restored)) {
            showToast("Đã chặn khôi phục một phiên bản rỗng");
            return false;
          }
          if (
            !window.confirm(
              `Khôi phục bản ${backupVersionDate(entry)}? Bản hiện tại sẽ được lưu vào lịch sử trước.`,
            )
          )
            return false;
          addLocalBackupVersion(state, "Trước khi khôi phục phiên bản cũ");
          applyParsedState(restored);
          ensureDayTasks();
          closeBackupHistoryDialog();
          render();
          scheduleAutoExport(
            `Khôi phục phiên bản ${backupVersionDate(entry)}`,
          );
          showToast("Đã khôi phục phiên bản và lưu lại bản trước đó");
          return true;
        }

        async function handleBackupHistoryAction(event) {
          const button = event.target.closest("[data-backup-action]");
          if (!button) return;
          const entry =
            backupHistoryDialogEntries[Number(button.dataset.backupIndex)];
          if (!entry) return;
          button.disabled = true;
          try {
            if (button.dataset.backupAction === "restore") {
              await restoreBackupVersion(entry);
              return;
            }
            const data = await resolveBackupVersionData(entry);
            if (!hasMeaningfulStateData(data)) {
              showToast("Phiên bản này không chứa dữ liệu");
              return;
            }
            const datePart = new Date(
              Number(entry.createdAt || entry.savedAt || Date.now()),
            )
              .toISOString()
              .replace(/[:.]/g, "-");
            downloadBackupState(
              data,
              `todolist-backup-${datePart}.json`,
              false,
            );
          } catch (error) {
            console.error("Thao tác backup lỗi", error);
            showToast("Không thực hiện được thao tác với bản sao lưu");
          } finally {
            if (button.isConnected) button.disabled = false;
          }
        }

        async function showBackupHistoryDialog() {
          closeBackupHistoryDialog();
          const backdrop = document.createElement("div");
          backdrop.id = "backup-history-modal";
          backdrop.className = "backup-history-backdrop";
          backdrop.innerHTML = `<section class="backup-history-dialog" role="dialog" aria-modal="true" aria-labelledby="backup-history-title">
            <header class="backup-history-header">
              <div>
                <h2 id="backup-history-title">Lịch sử sao lưu</h2>
                <p>Tối đa ${LOCAL_BACKUP_HISTORY_LIMIT} bản trên trình duyệt và ${CLOUD_BACKUP_HISTORY_LIMIT} bản trên cloud. Mỗi bản cloud được tạo trước khi dữ liệu chính bị thay thế.</p>
              </div>
              <button type="button" class="backup-history-close" data-close-backup-history aria-label="Đóng">×</button>
            </header>
            <div class="backup-history-list" id="backup-history-list"></div>
          </section>`;
          document.body.appendChild(backdrop);
          backdrop
            .querySelector("[data-close-backup-history]")
            ?.addEventListener("click", closeBackupHistoryDialog);
          backdrop.addEventListener("click", (event) => {
            if (event.target === backdrop) closeBackupHistoryDialog();
          });
          backdrop.addEventListener("keydown", (event) => {
            if (event.key === "Escape") closeBackupHistoryDialog();
          });
          backdrop
            .querySelector("#backup-history-list")
            ?.addEventListener("click", handleBackupHistoryAction);
          backdrop
            .querySelector("[data-close-backup-history]")
            ?.focus();

          const currentEntry = hasMeaningfulStateData(state)
            ? {
                id: "current",
                source: "current",
                reason: "Bản dữ liệu đang sử dụng",
                savedAt: Number(state.savedAt || Date.now()),
                createdAt: Date.now(),
                fingerprint: stateBackupFingerprint(state),
                summary: getStateDataSummary(state),
                data: cloneBackupState(state),
              }
            : null;
          const localVersions = readLocalBackupHistory();
          backupHistoryDialogEntries = [
            ...(currentEntry ? [currentEntry] : []),
            ...localVersions,
          ];
          renderBackupHistoryDialog("Đang tải lịch sử cloud...");

          try {
            const cloudVersions = await listCloudBackupVersions(
              CLOUD_BACKUP_HISTORY_LIMIT,
            );
            if (!document.getElementById("backup-history-modal")) return;
            const knownFingerprints = new Set(
              backupHistoryDialogEntries
                .map((entry) => entry.fingerprint)
                .filter(Boolean),
            );
            backupHistoryDialogEntries.push(
              ...cloudVersions.filter(
                (entry) =>
                  !entry.fingerprint ||
                  !knownFingerprints.has(entry.fingerprint),
              ),
            );
            renderBackupHistoryDialog("");
          } catch (error) {
            console.error("Tải lịch sử backup cloud lỗi", error);
            renderBackupHistoryDialog(
              "Không tải được lịch sử cloud; các bản trên trình duyệt vẫn dùng được.",
            );
          }
        }

        let toastTimer = null;
        function showToast(msg) {
          let el = document.getElementById("toast-el");
          if (!el) {
            el = document.createElement("div");
            el.id = "toast-el";
            el.setAttribute("role", "status");
            el.setAttribute("aria-live", "polite");
            el.setAttribute("aria-atomic", "true");
            el.style.position = "fixed";
            el.style.bottom = "16px";
            el.style.left = "50%";
            el.style.transform = "translateX(-50%)";
            el.style.background = "#3a3a3c";
            el.style.color = "#fff";
            el.style.padding = "8px 14px";
            el.style.borderRadius = "8px";
            el.style.fontSize = "12px";
            el.style.zIndex = "9999";
            document.body.appendChild(el);
          }
          el.textContent = msg;
          el.style.display = "block";
          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => {
            el.style.display = "none";
          }, 2000);
        }

        function startTicking() {
          clearInterval(tickInterval);
          tickInterval = setInterval(() => {
            const rolledOver = rolloverIfNeeded();
            if (rolledOver || recurringChanged) {
              render();
              return;
            }
            renderMiniTimeline();
          }, 30000);
          setInterval(renderCurrentDoingWidget, 1000);
        }

        // ---------- tree helpers ----------
        const TASK_PRIORITY_LABELS = {
          none: "Không ưu tiên",
          low: "Thấp",
          medium: "Trung bình",
          high: "Cao",
        };
        const TASK_BRANCH_COLORS = [
          "#2b8cff",
          "#a855f7",
          "#18c8e9",
          "#e879f9",
          "#ff8a24",
          "#ff5e72",
          "#f6c344",
          "#d25cff",
          "#4f7cff",
          "#14b8a6",
        ];

        function taskBranchColorDistance(first, second) {
          const parse = (value) => {
            const hex = String(value || "").replace("#", "");
            if (!/^[0-9a-f]{6}$/i.test(hex)) return [0, 0, 0];
            return [0, 2, 4].map((offset) =>
              Number.parseInt(hex.slice(offset, offset + 2), 16),
            );
          };
          const left = parse(first);
          const right = parse(second);
          return Math.hypot(
            left[0] - right[0],
            left[1] - right[1],
            left[2] - right[2],
          );
        }

        // Chọn màu theo các task đang hiển thị, ưu tiên màu xa hai task gần
        // nhất và không dùng lại màu cho tới khi đã dùng hết bảng màu.
        function taskBranchColorMap(nodes) {
          const colors = new Map();
          const used = new Set();
          const recent = [];
          (nodes || []).forEach((node) => {
            const available = TASK_BRANCH_COLORS.filter(
              (color) => !used.has(color),
            );
            const pool = available.length ? available : TASK_BRANCH_COLORS;
            const ranked = pool
              .map((color, paletteIndex) => ({
                color,
                paletteIndex,
                distance: recent.length
                  ? Math.min(
                      ...recent.map((previous) =>
                        taskBranchColorDistance(color, previous),
                      ),
                    )
                  : Number.POSITIVE_INFINITY,
              }))
              .sort(
                (first, second) =>
                  second.distance - first.distance ||
                  first.paletteIndex - second.paletteIndex,
              );
            const color = ranked[0]?.color || TASK_BRANCH_COLORS[0];
            colors.set(node.id, color);
            used.add(color);
            recent.push(color);
            if (recent.length > 2) recent.shift();
          });
          return colors;
        }

        function normalizeTaskPriority(value) {
          return Object.prototype.hasOwnProperty.call(TASK_PRIORITY_LABELS, value)
            ? value
            : "none";
        }

        function normalizeTaskTags(value) {
          const raw = Array.isArray(value)
            ? value
            : typeof value === "string"
              ? value.split(",")
              : [];
          const seen = new Set();
          return raw
            .map((tag) => String(tag || "").trim().replace(/\s+/g, " ").slice(0, 24))
            .filter((tag) => {
              const key = tag.toLocaleLowerCase("vi");
              if (!tag || seen.has(key)) return false;
              seen.add(key);
              return true;
            })
            .slice(0, 8);
        }

        function taskPriorityLabel(priority) {
          return TASK_PRIORITY_LABELS[normalizeTaskPriority(priority)];
        }

        function taskPriorityRank(priority) {
          return { high: 0, medium: 1, low: 2, none: 3 }[
            normalizeTaskPriority(priority)
          ];
        }

        const TASK_VIEW_FILTER_STORAGE_KEY = "todolist_task_view_filters";
        const TASK_VIEW_FILTER_DEFAULTS = Object.freeze({
          priority: "all",
          tag: "all",
          status: "all",
          due: "all",
          created: "all",
          sort: "tree",
        });

        function normalizeTaskViewFilters(candidate) {
          const value = candidate && typeof candidate === "object" ? candidate : {};
          const allowed = {
            priority: ["all", ...Object.keys(TASK_PRIORITY_LABELS)],
            status: ["all", "unfinished", "todo", "doing", "pending", "done"],
            due: ["all", "overdue", "today", "next7", "scheduled", "unscheduled"],
            created: ["all", "today"],
            sort: ["tree", "priority", "due", "title"],
          };
          return {
            priority: allowed.priority.includes(value.priority)
              ? value.priority
              : TASK_VIEW_FILTER_DEFAULTS.priority,
            tag:
              typeof value.tag === "string" && value.tag.trim()
                ? value.tag.trim().slice(0, 24)
                : TASK_VIEW_FILTER_DEFAULTS.tag,
            status: allowed.status.includes(value.status)
              ? value.status
              : TASK_VIEW_FILTER_DEFAULTS.status,
            due: allowed.due.includes(value.due)
              ? value.due
              : TASK_VIEW_FILTER_DEFAULTS.due,
            created: allowed.created.includes(value.created)
              ? value.created
              : TASK_VIEW_FILTER_DEFAULTS.created,
            sort: allowed.sort.includes(value.sort)
              ? value.sort
              : TASK_VIEW_FILTER_DEFAULTS.sort,
          };
        }

        function loadTaskViewFilters() {
          try {
            const saved = localStorage.getItem(TASK_VIEW_FILTER_STORAGE_KEY);
            taskViewFilters = saved
              ? normalizeTaskViewFilters(JSON.parse(saved))
              : { ...TASK_VIEW_FILTER_DEFAULTS };
          } catch (error) {
            taskViewFilters = { ...TASK_VIEW_FILTER_DEFAULTS };
          }
        }

        function persistTaskViewFilters() {
          try {
            localStorage.setItem(
              TASK_VIEW_FILTER_STORAGE_KEY,
              JSON.stringify(taskViewFilters),
            );
          } catch (error) {}
        }

        function setTaskViewFilter(name, value) {
          taskViewFilters = normalizeTaskViewFilters({
            ...taskViewFilters,
            [name]: value,
          });
          persistTaskViewFilters();
          renderWithoutFlicker();
        }



        function hasActiveTaskViewFilters() {
          return Object.keys(TASK_VIEW_FILTER_DEFAULTS).some(
            (key) => taskViewFilters[key] !== TASK_VIEW_FILTER_DEFAULTS[key],
          );
        }

        function isTaskCreatedToday(node) {
          const timestamp = Number(node?.createdAt);
          if (!Number.isFinite(timestamp) || timestamp <= 0) return false;
          return dateKey(new Date(timestamp)) === dateKey(new Date());
        }

        function taskMatchesCurrentFilters(node) {
          if (!node || node._pinned) return true;
          if (node.kind === "kienthuc") return !hasActiveTaskViewFilters();
          const filter = taskViewFilters;
          if (
            filter.priority !== "all" &&
            normalizeTaskPriority(node.priority) !== filter.priority
          )
            return false;
          if (filter.status === "unfinished" && node.status === "done")
            return false;
          if (
            filter.status !== "all" &&
            filter.status !== "unfinished" &&
            node.status !== filter.status
          )
            return false;
          if (
            filter.tag !== "all" &&
            !normalizeTaskTags(node.tags).some(
              (tag) => tag.toLocaleLowerCase("vi") === filter.tag.toLocaleLowerCase("vi"),
            )
          )
            return false;
          if (
            filter.created === "today" &&
            !isTaskCreatedToday(node)
          )
            return false;
          const todayKey = dateKey(new Date());
          const dueDate = String(node.dueDate || "");
          if (filter.due === "overdue" && !(dueDate && dueDate < todayKey))
            return false;
          if (filter.due === "today" && dueDate !== todayKey) return false;
          if (filter.due === "next7") {
            const end = new Date();
            end.setDate(end.getDate() + 7);
            const endKey = dateKey(end);
            if (!(dueDate && dueDate >= todayKey && dueDate <= endKey)) return false;
          }
          if (filter.due === "scheduled" && !dueDate) return false;
          if (filter.due === "unscheduled" && dueDate) return false;
          return true;
        }

        function nodeSelfMatchesTaskView(node) {
          if (
            !state.showCompletedTasks &&
            node?.status === "done" &&
            !node?._todayAuto &&
            taskViewFilters.status !== "done"
          )
            return false;
          return taskMatchesCurrentFilters(node);
        }

        function nodeHasVisibleTaskView(node) {
          if (!node || node.kind === "kienthuc") return false;
          if (nodeSelfMatchesTaskView(node)) return true;
          return (node?.children || []).some((child) =>
            nodeHasVisibleTaskView(child),
          );
        }

        function knowledgeSelfMatchesSearch(node) {
          if (
            knowledgeCreatedFilter === "today" &&
            !isTaskCreatedToday(node)
          )
            return false;
          const query = String(knowledgeSearchQuery || "")
            .trim()
            .toLocaleLowerCase("vi");
          if (!query) return true;
          return (
            String(node?.text || "")
              .toLocaleLowerCase("vi")
              .includes(query) ||
            normalizeTaskTags(node?.tags).some((tag) =>
              tag.toLocaleLowerCase("vi").includes(query),
            )
          );
        }

        function knowledgeNodeHasVisibleView(node) {
          if (!node || node.kind !== "kienthuc") return false;
          if (knowledgeSelfMatchesSearch(node)) return true;
          return (node.children || []).some((child) =>
            knowledgeNodeHasVisibleView(child),
          );
        }

        function visibleKnowledgeChildren(nodes) {
          return sortTaskNodesForView(
            (nodes || []).filter((node) => knowledgeNodeHasVisibleView(node)),
          );
        }

        function knowledgeRootNodes() {
          const roots = [];
          const visit = (nodes, insideKnowledge = false) =>
            (nodes || []).forEach((node) => {
              if (!node || node._todayAuto || node._pinned) return;
              const isKnowledge = node.kind === "kienthuc";
              if (isKnowledge && !insideKnowledge) roots.push(node);
              visit(node.children, insideKnowledge || isKnowledge);
            });
          visit(state.tasks);
          visit(state.todayTask?.children);
          visit(state.tomorrowTask?.children);
          return sortTaskNodesForView(
            roots.filter((node) => knowledgeNodeHasVisibleView(node)),
          );
        }

        function sortTaskNodesForView(nodes) {
          const source = [...(nodes || [])];
          if (taskViewFilters.sort === "tree") return source;
          const byDueDate = (node) => node.dueDate || "9999-12-31";
          return source.sort((first, second) => {
            if (taskViewFilters.sort === "priority") {
              const priority =
                taskPriorityRank(first.priority) - taskPriorityRank(second.priority);
              if (priority) return priority;
              return byDueDate(first).localeCompare(byDueDate(second));
            }
            if (taskViewFilters.sort === "due") {
              const due = byDueDate(first).localeCompare(byDueDate(second));
              if (due) return due;
              return taskPriorityRank(first.priority) - taskPriorityRank(second.priority);
            }
            return compareTaskTitles(first.text, second.text);
          });
        }

        function visibleTaskChildren(nodes) {
          return sortTaskNodesForView(
            (nodes || []).filter((node) => nodeHasVisibleTaskView(node)),
          );
        }

        function ensureNodeFields(n) {
          if (n.status === undefined) n.status = "todo";
          if (n.startTime === undefined) n.startTime = null;
          if (n.endTime === undefined) n.endTime = null;
          if (n.runningEventId === undefined) n.runningEventId = null;
          if (n.createdAt === undefined) n.createdAt = inferTaskCreatedAt(n.id);
          if (n.syncKey === undefined) n.syncKey = "";
          // Giữ loại node để các mục Kiến thức vẫn nằm trong tab riêng sau khi
          // tải lại dữ liệu từ cloud. Dữ liệu cũ không có kind mặc định là task.
          n.kind = n.kind === "kienthuc" ? "kienthuc" : "task";
          if (n.note === undefined) n.note = ""; // nội dung HTML (văn bản + ảnh) của task
          if (n.dueDate === undefined) n.dueDate = ""; // hạn hoàn thành, yyyy-mm-dd
          n.priority = normalizeTaskPriority(n.priority);
          n.tags = normalizeTaskTags(n.tags);
          // Loại bỏ các trường của cơ chế repeat cũ còn sót trong dữ liệu cloud.
          delete n.repeat;
          delete n.repeatGenerated;
          if (!Array.isArray(n.children)) n.children = [];
          n.children.forEach(ensureNodeFields);
        }

        function isPinnedDayTask(node) {
          return (
            !!node &&
            node._pinned === true &&
            (node === state.todayTask || node === state.tomorrowTask)
          );
        }

        // Tên cũ được giữ để các thao tác xoá/kéo/hoàn thành đang gọi helper này
        // tiếp tục chặn an toàn cho cả hai task hệ thống.
        function isPinnedTodayTask(node) {
          return isPinnedDayTask(node);
        }

        function isSelectableTaskNode(node) {
          return !!node &&
            !node._pinned &&
            !node._todayAuto &&
            node.kind !== "kienthuc";
        }

        function getSelectedTaskNodes() {
          const nodes = [];
          selectedTaskIds.forEach((id) => {
            const node = findNodeAny(id);
            if (isSelectableTaskNode(node)) nodes.push(node);
            else selectedTaskIds.delete(id);
          });
          return nodes;
        }

        function updateTaskSelectionUi() {
          const selectedNodes = getSelectedTaskNodes();
          document
            .querySelectorAll("#section-body-tasks-task .row[data-row-id]")
            .forEach((row) => {
              const selected = selectedTaskIds.has(row.dataset.rowId);
              row.classList.toggle("task-selected", selected);
              row.setAttribute("aria-selected", String(selected));
            });
          const toolbar = document.getElementById("task-selection-toolbar");
          if (!toolbar) return;
          toolbar.hidden = selectedNodes.length === 0;
          const count = toolbar.querySelector("[data-selection-count]");
          if (count)
            count.textContent = `${selectedNodes.length} task đã chọn`;
          toolbar
            .querySelectorAll('[data-action="bulk-task-action"]')
            .forEach((button) => {
              button.disabled = selectedNodes.length === 0;
            });
        }

        function toggleTaskSelection(id, forceSelected = null) {
          const node = findNodeAny(id);
          if (!isSelectableTaskNode(node)) return;
          const shouldSelect =
            forceSelected === null ? !selectedTaskIds.has(id) : forceSelected;
          if (shouldSelect) selectedTaskIds.add(id);
          else selectedTaskIds.delete(id);
          updateTaskSelectionUi();
        }

        function clearTaskSelection() {
          if (!selectedTaskIds.size) {
            updateTaskSelectionUi();
            return;
          }
          selectedTaskIds.clear();
          updateTaskSelectionUi();
        }

        function getTopLevelSelectedTaskNodes() {
          const selectedNodes = getSelectedTaskNodes();
          const selectedIds = new Set(selectedNodes.map((node) => node.id));
          return selectedNodes.filter((node) => {
            let parent = findParentNodeAny(node.id);
            while (parent) {
              if (selectedIds.has(parent.id)) return false;
              parent = findParentNodeAny(parent.id);
            }
            return true;
          });
        }

        function runBulkTaskAction(action) {
          const selectedNodes = getTopLevelSelectedTaskNodes();
          if (!selectedNodes.length) {
            clearTaskSelection();
            return;
          }
          if (action === "done") {
            selectedNodes
              .filter((node) => node.status !== "done")
              .forEach((node) => setDone(node.id));
          } else if (action === "pending") {
            selectedNodes
              .filter((node) => node.status !== "pending")
              .forEach((node) => setPending(node.id));
          } else if (action === "delete") {
            selectedNodes.forEach((node) => {
              if (findNodeAny(node.id)) deleteNode(node.id);
            });
          } else {
            return;
          }
          selectedTaskIds.clear();
          render();
          const labels = {
            done: "hoàn thành",
            pending: "đặt Pending",
            delete: "xóa",
          };
          showToast(`Đã ${labels[action]} ${selectedNodes.length} task`);
        }

        function pinnedDayTaskLabel(node) {
          return node === state.tomorrowTask ? "Ngày mai" : "Hôm nay";
        }

        // Đảm bảo task cố định Hôm nay và vùng đệm Ngày mai luôn tồn tại.
        function ensureDayTasks() {
          if (!state.todayTask) {
            state.todayTask = newNode("Hôm nay");
            state.todayTask._pinned = true;
          } else {
            ensureNodeFields(state.todayTask);
            state.todayTask._pinned = true;
          }
          state.todayTask.text = "Hôm nay";
          state.todayTask.kind = "task";
          if (!state.tomorrowTask) {
            state.tomorrowTask = newNode("Ngày mai");
            state.tomorrowTask._pinned = true;
          } else {
            ensureNodeFields(state.tomorrowTask);
            state.tomorrowTask._pinned = true;
          }
          // rollover nếu qua ngày mới
          rolloverIfNeeded();
          sortTaskTree(state.tasks);
          sortTaskTree([state.todayTask]);
          sortTaskTree([state.tomorrowTask]);
        }

        function rolloverIfNeeded() {
          const todayKey = dateKey(new Date());
          if (state.lastRolloverDate === todayKey) return false;

          if (state.lastRolloverDate && state.lastRolloverDate < todayKey) {
            // Ngày mai cũ → Hôm nay mới
            const oldTomorrow = state.tomorrowTask;
            const oldToday = state.todayTask;

            // Chỉ carry over các task CHƯA hoàn thành (đã done → xóa luôn)
            const carry = oldToday.children.filter(
              (c) => !c._todayAuto && c.status !== "done",
            );
            carry.forEach((c) => {
              // reset trạng thái doing/pending về todo khi sang ngày mới
              if (c.status === "doing") stopDoingNode(c);
              oldTomorrow.children.push(c);
            });

            oldTomorrow.text = "Hôm nay";
            oldTomorrow._pinned = true;
            oldTomorrow.kind = "task";
            state.todayTask = oldTomorrow;

            const fresh = newNode("Ngày mai");
            fresh._pinned = true;
            state.tomorrowTask = fresh;
          }

          state.lastRolloverDate = todayKey;
          scheduleAutoExport();
          return true;
        }

        function syncTodayTaskAutomaticItems() {
          if (!state.todayTask) return false;
          const todayKey = dateKey(new Date());
          const completedTodayIds = new Set(
            (Array.isArray((state.completedArchive || {})[todayKey])
              ? (state.completedArchive || {})[todayKey]
              : [])
              .map((item) => item?.taskId || item?.id)
              .filter(Boolean),
          );
          const sourceNodes = [];
          const visit = (nodes) =>
            (nodes || []).forEach((node) => {
              if (!node._pinned && !node._todayAuto && node.kind !== "kienthuc")
                sourceNodes.push(node);
              visit(node.children);
            });
          visit(state.tasks);
          visit(state.tomorrowTask ? state.tomorrowTask.children : []);
          const eligible = sourceNodes.filter(
            (node) =>
              node.status === "doing" ||
              (node.status === "done" &&
                (completedTodayIds.has(node.id) ||
                  (node.endTime && dateKey(new Date(node.endTime)) === todayKey))),
          );
          const eligibleIds = new Set(eligible.map((node) => node.id));
          const manualChildren = state.todayTask.children.filter(
            (node) => !node._todayAuto,
          );
          const existingAuto = new Map(
            state.todayTask.children
              .filter((node) => node._todayAuto)
              .map((node) => [node.id, node]),
          );
          const automaticChildren = eligible.map((source) => {
            const mirror = existingAuto.get(source.id) || {
              id: source.id,
              children: [],
            };
            Object.assign(mirror, source);
            mirror.children = [];
            mirror._todayAuto = true;
            delete mirror._pinned;
            return mirror;
          });
          const changed =
            manualChildren.length + automaticChildren.length !==
              state.todayTask.children.length ||
            automaticChildren.some(
              (node, index) => state.todayTask.children[manualChildren.length + index] !== node,
            ) ||
            state.todayTask.children.some(
              (node) => node._todayAuto && !eligibleIds.has(node.id),
            );
          state.todayTask.children = [...manualChildren, ...automaticChildren];
          if (changed) scheduleAutoExport("Cập nhật task tự động trong Hôm nay");
          return changed;
        }

        // Di chuyển 1 con từ Hôm nay → Ngày mai
        function moveTomorrow(childId) {
          const idx = state.todayTask.children.findIndex(
            (c) => c.id === childId && !c._todayAuto,
          );
          if (idx === -1) return;
          const [node] = state.todayTask.children.splice(idx, 1);
          state.tomorrowTask.children.push(node);
          renderWithoutFlicker();
          scheduleAutoExport();
        }

        function findNode(list, id) {
          for (const n of list) {
            if (n._todayAuto) continue;
            if (n.id === id) return n;
            const f = findNode(n.children, id);
            if (f) return f;
          }
          return null;
        }
        function findParentList(list, id) {
          for (const n of list) {
            if (n._todayAuto) continue;
            if (n.id === id) return list;
            const f = findParentList(n.children, id);
            if (f) return f;
          }
          return null;
        }
        function findParentNode(list, id, parent) {
          for (const n of list) {
            if (n._todayAuto) continue;
            if (n.id === id) return parent || null;
            const f = findParentNode(n.children, id, n);
            if (f !== undefined) return f;
          }
          return undefined;
        }
        // ---------- helper: tìm kiếm xuyên suốt các danh sách gốc ----------
        function getAllRootLists() {
          const extras = [];
          if (state.todayTask) extras.push([state.todayTask]);
          if (state.tomorrowTask) extras.push([state.tomorrowTask]);
          return [state.tasks, ...extras];
        }
        function findNodeAny(id) {
          for (const list of getAllRootLists()) {
            const n = findNode(list, id);
            if (n) return n;
          }
          return null;
        }
        function findParentListAny(id) {
          for (const list of getAllRootLists()) {
            const f = findParentList(list, id);
            if (f) return f;
          }
          return null;
        }
        function findParentNodeAny(id) {
          for (const list of getAllRootLists()) {
            const p = findParentNode(list, id, null);
            if (p !== undefined) return p;
          }
          return undefined;
        }
        function removeNodeAny(id) {
          for (const list of getAllRootLists()) {
            const r = removeNode(list, id);
            if (r) return r;
          }
          return null;
        }

        function removeNode(list, id) {
          const idx = list.findIndex((n) => n.id === id && !n._todayAuto);
          if (idx !== -1) {
            const [r] = list.splice(idx, 1);
            return r;
          }
          for (const n of list) {
            if (n._todayAuto) continue;
            const r = removeNode(n.children, id);
            if (r) return r;
          }
          return null;
        }
        function isDescendant(node, targetId) {
          for (const c of node.children) {
            if (c.id === targetId) return true;
            if (isDescendant(c, targetId)) return true;
          }
          return false;
        }
        function countProgress(node) {
          if (!node.children.length) return null;
          let total = 0,
            done = 0;
          node.children.forEach((c) => {
            total++;
            if (c.status === "done") done++;
          });
          return { done, total };
        }
        // Node khớp tìm kiếm nếu bản thân nó hoặc bất kỳ con cháu nào chứa từ khoá.
        function nodeMatchesSearch(node, query) {
          const q = String(query || "")
            .trim()
            .toLowerCase();
          if (!q) return true;
          if (node.text.toLowerCase().includes(q)) return true;
          if ((node.tags || []).some((tag) => tag.toLowerCase().includes(q)))
            return true;
          return node.children.some((c) => nodeMatchesSearch(c, q));
        }
        function newNode(text) {
          return {
            id: genId("t"),
            syncKey: "",
            text: text.trim(),
            createdAt: Date.now(),
            status: "todo",
            startTime: null,
            endTime: null,
            runningEventId: null,
            kind: "task", // "task" | "kienthuc"
            note: "", // nội dung HTML (văn bản + ảnh) cho việc dạng Kiến thức
            dueDate: "",
            priority: "none",
            tags: [],
            children: [],
          };
        }
        function compareTaskTitles(first, second) {
          return String(first || "").localeCompare(String(second || ""), "vi", {
            numeric: true,
            sensitivity: "base",
          });
        }

        function sortTaskTree(list) {
          if (!Array.isArray(list)) return;
          list.sort((first, second) =>
            compareTaskTitles(first.text, second.text),
          );
          list.forEach((node) => sortTaskTree(node.children));
        }

        function alphaInsert(list, node) {
          let i = 0;
          while (i < list.length && compareTaskTitles(list[i].text, node.text) <= 0)
            i++;
          list.splice(i, 0, node);
        }

        // ---------- Liên kết Task ↔ Mindmap ----------
        // Mỗi node được tạo mới ở một bên nhận một syncKey chung với node
        // tương ứng ở bên còn lại. Các dữ liệu cũ không có syncKey vẫn được
        // giữ nguyên, không tự ghép theo tên để tránh nhân bản ngoài ý muốn.
        function isSyncableTaskNode(node) {
          return !!node && !node._pinned && node.kind !== "kienthuc";
        }

        function findMindmapNodeBySyncKey(syncKey) {
          const wanted = String(syncKey || "");
          if (!wanted || !state.mindmap?.root) return null;
          const visit = (node) => {
            if (!node) return null;
            if (node.syncKey === wanted) return node;
            for (const child of node.children || []) {
              const found = visit(child);
              if (found) return found;
            }
            return null;
          };
          return visit(state.mindmap.root);
        }

        function findTaskNodeBySyncKey(syncKey) {
          const wanted = String(syncKey || "");
          if (!wanted) return null;
          const visit = (nodes) => {
            for (const node of nodes || []) {
              if (node._todayAuto) continue;
              if (node.syncKey === wanted) return node;
              const found = visit(node.children);
              if (found) return found;
            }
            return null;
          };
          for (const list of getAllRootLists()) {
            const found = visit(list);
            if (found) return found;
          }
          return null;
        }

        function ensureTaskMindmapLink(taskNode) {
          if (!isSyncableTaskNode(taskNode)) return "";
          if (!taskNode.syncKey) taskNode.syncKey = genId("link");
          return taskNode.syncKey;
        }

        function ensureMindmapNodeLink(mindmapNode) {
          if (!mindmapNode || !mindmapNode.id) return "";
          if (!mindmapNode.syncKey) mindmapNode.syncKey = genId("link");
          return mindmapNode.syncKey;
        }

        function ensureMindmapForTaskNode(taskNode, preferredParentTask) {
          const root = state.mindmap?.root;
          if (!root || !isSyncableTaskNode(taskNode)) return root || null;
          const existingKey = taskNode.syncKey;
          if (existingKey) {
            const existing = findMindmapNodeBySyncKey(existingKey);
            if (existing) return existing;
          }

          let parentMindmap = null;
          if (preferredParentTask) {
            parentMindmap = isSyncableTaskNode(preferredParentTask)
              ? ensureMindmapForTaskNode(preferredParentTask)
              : root;
          } else {
            const parentTask = findParentNodeAny(taskNode.id);
            parentMindmap = parentTask && isSyncableTaskNode(parentTask)
              ? ensureMindmapForTaskNode(parentTask)
              : root;
          }
          if (!parentMindmap) parentMindmap = root;

          const syncKey = ensureTaskMindmapLink(taskNode);
          const alreadyLinked = findMindmapNodeBySyncKey(syncKey);
          if (alreadyLinked) return alreadyLinked;
          const isTopLevel = parentMindmap === root;
          const color = isTopLevel
            ? MINDMAP_BRANCH_COLORS[
                parentMindmap.children.length % MINDMAP_BRANCH_COLORS.length
              ]
            : "";
          const mindmapNode = createMindmapNode(taskNode.text, color);
          mindmapNode.syncKey = syncKey;
          parentMindmap.children.push(mindmapNode);
          parentMindmap.collapsed = false;
          return mindmapNode;
        }

        function ensureTaskForMindmapNode(recordOrNode) {
          const root = state.mindmap?.root;
          const record = recordOrNode?.node
            ? recordOrNode
            : recordOrNode?.id
              ? findMindmapNodeRecord(recordOrNode.id)
              : null;
          if (!root || !record || record.depth === 0) return null;
          const mindmapNode = record.node;
          if (mindmapNode.syncKey) {
            const existing = findTaskNodeBySyncKey(mindmapNode.syncKey);
            if (existing) return existing;
          }

          const syncKey = ensureMindmapNodeLink(mindmapNode);
          const existing = findTaskNodeBySyncKey(syncKey);
          if (existing) return existing;

          let parentTask = null;
          if (record.parent && record.parent !== root) {
            parentTask = ensureTaskForMindmapNode(
              findMindmapNodeRecord(record.parent.id),
            );
          }
          const taskNode = newNode(mindmapNode.text);
          taskNode.syncKey = syncKey;
          taskNode.kind = "task";
          if (parentTask) {
            alphaInsert(parentTask.children, taskNode);
            state.collapsed[parentTask.id] = false;
          } else {
            alphaInsert(state.tasks, taskNode);
          }
          return taskNode;
        }

        function linkTaskTreeToMindmap(taskNode, parentTask) {
          if (!isSyncableTaskNode(taskNode)) return null;
          const mindmapNode = ensureMindmapForTaskNode(taskNode, parentTask);
          (taskNode.children || []).forEach((child) =>
            linkTaskTreeToMindmap(child, taskNode),
          );
          return mindmapNode;
        }

        function syncTaskTextToMindmap(taskNode) {
          if (!taskNode?.syncKey) return;
          const mindmapNode = findMindmapNodeBySyncKey(taskNode.syncKey);
          if (mindmapNode)
            mindmapNode.text = cleanMindmapText(taskNode.text, mindmapNode.text);
        }

        function syncMindmapTextToTask(mindmapNode) {
          if (!mindmapNode?.syncKey) return;
          const taskNode = findTaskNodeBySyncKey(mindmapNode.syncKey);
          if (taskNode) taskNode.text = String(mindmapNode.text || taskNode.text).trim();
        }

        function syncTaskCompletionToMindmap(taskNode, checked) {
          if (!taskNode || !state.mindmap?.root) return;
          const shouldCreateLink =
            checked === true ||
            (checked === undefined && taskNode.status === "done");
          let mindmapNode = taskNode.syncKey
            ? findMindmapNodeBySyncKey(taskNode.syncKey)
            : null;
          if (!mindmapNode && shouldCreateLink)
            mindmapNode = ensureMindmapForTaskNode(taskNode);
          if (!mindmapNode) return;
          mindmapNode.checked =
            checked === undefined ? taskNode.status === "done" : !!checked;
          if (mindmapNode.checked)
            reconcileMindmapCompletion(state.mindmap.root, true);
        }

        function reopenTaskFromMindmap(taskNode) {
          if (!taskNode || isPinnedDayTask(taskNode)) return false;
          if (taskNode.status === "done") {
            removeFromCompletedArchive(
              taskNode.id,
              taskNode.endTime ? new Date(taskNode.endTime) : null,
            );
            taskNode.status = "todo";
            taskNode.endTime = null;
          } else if (taskNode.status === "doing") {
            stopDoingNode(taskNode);
            taskNode.endTime = null;
          } else if (taskNode.status === "pending") {
            taskNode.status = "todo";
            taskNode.startTime = null;
            taskNode.endTime = null;
          }
          syncTaskCompletionToMindmap(taskNode, false);
          return true;
        }

        function syncMindmapCompletionToTasks(record) {
          if (!record?.node) return;
          const recordsById = new Map();
          const addRecord = (node) => {
            const current = findMindmapNodeRecord(node?.id);
            if (current && current.depth > 0)
              recordsById.set(current.node.id, current);
          };
          const visit = (node) => {
            addRecord(node);
            (node?.children || []).forEach(visit);
          };
          visit(record.node);
          (record.ancestors || []).forEach(addRecord);

          const taskEntries = [];
          const seenTaskIds = new Set();
          Array.from(recordsById.values()).forEach((entry) => {
            let taskNode = entry.node.syncKey
              ? findTaskNodeBySyncKey(entry.node.syncKey)
              : null;
            if (!taskNode && entry.node.checked)
              taskNode = ensureTaskForMindmapNode(entry);
            if (
              taskNode &&
              !isPinnedDayTask(taskNode) &&
              !seenTaskIds.has(taskNode.id)
            ) {
              seenTaskIds.add(taskNode.id);
              taskEntries.push({ entry, taskNode });
            }
          });

          const completedEntries = taskEntries
            .filter(({ entry }) => !!entry.node.checked)
            .sort((left, right) => right.entry.depth - left.entry.depth);
          const reopenedEntries = taskEntries
            .filter(({ entry }) => !entry.node.checked)
            .sort((left, right) => left.entry.depth - right.entry.depth);
          if (completedEntries.length) {
            const completedAt = new Date();
            completedEntries.forEach(({ taskNode }) =>
              completeSingleTaskNode(taskNode, completedAt),
            );
          }
          reopenedEntries.forEach(({ taskNode }) =>
            reopenTaskFromMindmap(taskNode),
          );
        }

        function removeMindmapLinksForSyncKeys(syncKeys) {
          const wanted = new Set(
            Array.from(syncKeys || []).filter((key) => String(key || "")),
          );
          const root = state.mindmap?.root;
          if (!root || !wanted.size) return false;
          let changed = false;
          const visit = (parent) => {
            for (let index = parent.children.length - 1; index >= 0; index--) {
              const child = parent.children[index];
              if (wanted.has(child.syncKey)) {
                parent.children.splice(index, 1);
                changed = true;
                continue;
              }
              visit(child);
            }
          };
          visit(root);
          if (!changed) return false;
          reconcileMindmapCompletion(root, true);
          if (
            state.mindmap.branchViewNodeId &&
            !findMindmapNodeRecord(state.mindmap.branchViewNodeId)
          ) {
            state.mindmap.branchViewNodeId = "";
          }
          selectedMindmapNodeIds = new Set(
            Array.from(selectedMindmapNodeIds).filter((id) =>
              findMindmapNodeRecord(id),
            ),
          );
          if (!selectedMindmapNodeIds.size) {
            selectedMindmapNodeId = root.id;
            selectedMindmapNodeIds = new Set([root.id]);
          } else if (!findMindmapNodeRecord(selectedMindmapNodeId)) {
            selectedMindmapNodeId = Array.from(selectedMindmapNodeIds)[0];
          }
          return true;
        }

        // ---------- Haravan Code tree ----------
        function ensureHaravanCodeNodeFields(node) {
          if (!node || typeof node !== "object") return;
          if (!node.id) node.id = genId("hc");
          node.text = String(node.text || "Chưa đặt tên");
          node.code = typeof node.code === "string" ? node.code : "";
          if (!Array.isArray(node.children)) node.children = [];
          node.children.forEach(ensureHaravanCodeNodeFields);
        }

        function newHaravanCodeNode(text) {
          return {
            id: genId("hc"),
            text: text.trim(),
            code: "",
            children: [],
          };
        }

        function sortHaravanCodeTree(list) {
          if (!Array.isArray(list)) return;
          list.sort((first, second) =>
            compareTaskTitles(first.text, second.text),
          );
          list.forEach((node) => sortHaravanCodeTree(node.children));
        }

        function alphaInsertHaravanCode(list, node) {
          let index = 0;
          while (
            index < list.length &&
            compareTaskTitles(list[index].text, node.text) <= 0
          )
            index++;
          list.splice(index, 0, node);
        }

        function findHaravanCodeNode(list, id) {
          for (const node of list || []) {
            if (node.id === id) return node;
            const found = findHaravanCodeNode(node.children, id);
            if (found) return found;
          }
          return null;
        }

        function findHaravanCodeParentList(list, id) {
          for (const node of list || []) {
            if (node.id === id) return list;
            const found = findHaravanCodeParentList(node.children, id);
            if (found) return found;
          }
          return null;
        }

        function removeHaravanCodeNode(list, id) {
          const index = (list || []).findIndex((node) => node.id === id);
          if (index !== -1) return list.splice(index, 1)[0];
          for (const node of list || []) {
            const removed = removeHaravanCodeNode(node.children, id);
            if (removed) return removed;
          }
          return null;
        }

        function isHaravanCodeDescendant(node, targetId) {
          return (node.children || []).some(
            (child) =>
              child.id === targetId ||
              isHaravanCodeDescendant(child, targetId),
          );
        }

        function haravanCodeTextParts(text) {
          return String(text || "")
            .split(";")
            .map((part) => part.trim())
            .filter(Boolean);
        }

        function addHaravanCodeRoot(text) {
          const parts = haravanCodeTextParts(text);
          if (!parts.length) return;
          parts.forEach((part) =>
            alphaInsertHaravanCode(
              state.haravanCode,
              newHaravanCodeNode(part),
            ),
          );
          render();
          scheduleAutoExport();
        }

        function addHaravanCodeChild(parentId, text) {
          const parent = findHaravanCodeNode(state.haravanCode, parentId);
          const parts = haravanCodeTextParts(text);
          if (!parent || !parts.length) return;
          parts.forEach((part) =>
            alphaInsertHaravanCode(
              parent.children,
              newHaravanCodeNode(part),
            ),
          );
          state.haravanCodeCollapsed[parentId] = false;
          render();
          scheduleAutoExport();
        }

        function renameHaravanCodeNode(id, text) {
          const node = findHaravanCodeNode(state.haravanCode, id);
          if (!node || !String(text || "").trim()) {
            render();
            return;
          }
          node.text = String(text).trim();
          sortHaravanCodeTree(state.haravanCode);
          render();
          scheduleAutoExport();
        }

        function deleteHaravanCodeNode(id) {
          const node = findHaravanCodeNode(state.haravanCode, id);
          if (!node) return;
          const childNotice = node.children.length
            ? ` và ${node.children.length} nhánh con trực tiếp`
            : "";
          if (
            !window.confirm(
              `Xóa “${node.text}”${childNotice} khỏi Haravan Code?`,
            )
          )
            return;
          const removed = removeHaravanCodeNode(state.haravanCode, id);
          if (!removed) return;
          collectIdsDeep(removed, []).forEach((nodeId) => {
            openHaravanCodeEditorIds.delete(nodeId);
            delete state.haravanCodeCollapsed[nodeId];
          });
          render();
          scheduleAutoExport();
        }

        function toggleHaravanCodeCollapse(id) {
          state.haravanCodeCollapsed[id] =
            !state.haravanCodeCollapsed[id];
          render();
          scheduleAutoExport();
        }

        function toggleHaravanCodeEditor(id) {
          if (openHaravanCodeEditorIds.has(id)) {
            openHaravanCodeEditorIds.delete(id);
          } else {
            openHaravanCodeEditorIds.add(id);
          }
          render();
          if (openHaravanCodeEditorIds.has(id)) {
            requestAnimationFrame(() =>
              document.querySelector(`[data-haravan-code-editor="${id}"]`)?.focus(),
            );
          }
        }

        function saveHaravanCode(id, code) {
          const node = findHaravanCodeNode(state.haravanCode, id);
          if (!node) return;
          node.code = code;
          scheduleAutoExport();
        }

        function makeHaravanCodeChild(draggedId, targetId) {
          if (!draggedId || !targetId || draggedId === targetId) return;
          const dragged = findHaravanCodeNode(state.haravanCode, draggedId);
          const target = findHaravanCodeNode(state.haravanCode, targetId);
          if (!dragged || !target || isHaravanCodeDescendant(dragged, targetId))
            return;
          const removed = removeHaravanCodeNode(
            state.haravanCode,
            draggedId,
          );
          if (!removed) return;
          alphaInsertHaravanCode(target.children, removed);
          state.haravanCodeCollapsed[targetId] = false;
          render();
          scheduleAutoExport();
        }

        function countHaravanCodeNodes(list) {
          return (list || []).reduce(
            (total, node) => total + 1 + countHaravanCodeNodes(node.children),
            0,
          );
        }

        function haravanCodeLineCount(code) {
          return code ? code.split(/\r?\n/).length : 0;
        }

        function detectHaravanCloneIndex(html) {
          const source = String(html || "");
          const headingPatterns = [
            {
              pattern: /<h3\b[^>]*>([\s\S]*?)<\/h3\s*>/gi,
              label: "thẻ h3",
            },
            {
              pattern: /<h[1-6]\b[^>]*>([\s\S]*?)<\/h[1-6]\s*>/gi,
              label: "thẻ tiêu đề",
            },
          ];
          for (const heading of headingPatterns) {
            let match;
            while ((match = heading.pattern.exec(source))) {
              const plainText = match[1].replace(/<[^>]*>/g, " ");
              const numbers = plainText.match(/\d+/g);
              if (numbers && numbers.length) {
                return {
                  index: Number.parseInt(numbers[numbers.length - 1], 10),
                  source: heading.label,
                };
              }
            }
          }

          // Nếu không có tiêu đề, lấy hậu tố số xuất hiện nhiều nhất trong
          // các thuộc tính định danh thường dùng của HTML.
          const candidates = new Map();
          const attributePattern =
            /\b(?:name|id|for)\s*=\s*["']([^"']+)["']/gi;
          let attributeMatch;
          while ((attributeMatch = attributePattern.exec(source))) {
            const suffixMatch = attributeMatch[1].match(
              /(\d+)(?:\.[a-z0-9_-]+)?$/i,
            );
            if (!suffixMatch) continue;
            const value = Number.parseInt(suffixMatch[1], 10);
            candidates.set(value, (candidates.get(value) || 0) + 1);
          }
          let best = null;
          candidates.forEach((count, index) => {
            if (!best || count > best.count)
              best = { index, count, source: "thuộc tính name/id/for" };
          });
          return best;
        }

        function replaceHaravanCloneIndex(html, fromIndex, toIndex) {
          // Chỉ thay một số độc lập, không thay chữ số nằm trong số lớn hơn.
          // Ví dụ i=4 sẽ thay use4/img4 nhưng không làm đổi 480 thành 580.
          const pattern = new RegExp(
            `(^|[^0-9])${String(fromIndex)}(?=[^0-9]|$)`,
            "g",
          );
          return html.replace(
            pattern,
            (matched, prefix) => `${prefix}${toIndex}`,
          );
        }

        function generateHaravanCloneOutput(source, count) {
          const cleanSource = String(source || "").trim();
          const safeCount = Math.min(
            50,
            Math.max(1, Number.parseInt(count, 10) || 1),
          );
          if (!cleanSource) return { error: "Hãy nhập code HTML cần nhân bản" };
          const detected = detectHaravanCloneIndex(cleanSource);
          if (!detected || !Number.isInteger(detected.index)) {
            return {
              error:
                "Không xác định được i. Hãy đặt số thứ tự ở cuối nội dung thẻ h3, ví dụ <h3>Banner 4</h3>.",
            };
          }
          const blocks = [];
          for (let offset = 1; offset <= safeCount; offset++) {
            blocks.push(
              replaceHaravanCloneIndex(
                cleanSource,
                detected.index,
                detected.index + offset,
              ),
            );
          }
          return {
            output: blocks.join("\n\n"),
            count: safeCount,
            detectedIndex: detected.index,
            detectedSource: detected.source,
          };
        }

