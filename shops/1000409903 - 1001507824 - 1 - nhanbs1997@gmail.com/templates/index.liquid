              if (event.defaultPrevented) return;
              const target = event.target;
              if (
                target?.closest?.(
                  "input, textarea, select, [contenteditable='true'], .note-editor-wrap",
                ) ||
                target?.isContentEditable
              )
                return;
              if (event.ctrlKey || event.metaKey || event.altKey) return;

              const focusedRow = target?.closest?.(".row");
              const row = focusedRow || app.querySelector(".row:hover");
              if (!row || !app.contains(row)) return;
              const id = row.dataset.rowId;
              const node = findNodeAny(id);
              if (!node) return;

              if (event.key === "+" || event.key === "=") {
                event.preventDefault();
                event.stopPropagation();
                toggleTaskChildInput(id);
                return;
