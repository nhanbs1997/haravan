        const SUPPORT_TICKET_DIFFICULTY_LABELS = ["Dễ", "Trung bình", "Khó"];
        function normalizeSupportTicketDifficultyScore(value) {
          if (typeof value === "number" && Number.isInteger(value)) {
            return Math.min(100, Math.max(1, value));
          }
          const raw = String(value ?? "").trim();
          if (/^\d+$/.test(raw)) {
            return Math.min(100, Math.max(1, Number(raw)));
          }
          return 50;
        }
        function normalizeSupportTicketDifficulty(value) {
          const score = normalizeSupportTicketDifficultyScore(value);
          return score <= 33 ? "Dễ" : score <= 66 ? "Trung bình" : "Khó";
        }
        function getSupportTicketDifficulty(ticket) {
          return normalizeSupportTicketDifficulty(
            ticket?.difficultyScore ?? ticket?.difficulty,
          );
        }
        function getSupportTicketDifficultyScore(ticket) {
          return normalizeSupportTicketDifficultyScore(
            ticket?.difficultyScore ?? ticket?.difficulty,
          );
        }

        function normalizeSupportTicketDone(value) {
          if (value === true || value === 1) return true;
          if (typeof value !== "string") return false;
          return ["true", "1", "done", "completed", "đã làm", "da lam"].includes(
            value.trim().toLowerCase(),
          );
        }

        function normalizeSupportTicketAdminUrlCandidate(value) {
          let raw = String(value || "")
            .trim()
            .replace(/[.,;:!?]+$/g, "");
          if (!raw) return "";
          if (!/^https?:\/\//i.test(raw)) raw = `https://${raw}`;
          try {
            const parsed = new URL(raw);
            const hostname = parsed.hostname.toLowerCase();
            if (
              hostname !== "myharavan.com" &&
              !hostname.endsWith(".myharavan.com")
            ) {
              return "";
            }
            return `${parsed.origin}/admin`;
          } catch (error) {
            return "";
          }
        }

        function extractSupportTicketAdminUrlFromText(...values) {
          const source = values
            .map((value) => String(value || ""))
            .filter(Boolean)
            .join(" ");
          if (!source) return "";
          const candidates =
            source.match(/https?:\/\/[^\s<>'"`\)\]}]+/gi) || [];
          for (const candidate of candidates) {
            const adminUrl = normalizeSupportTicketAdminUrlCandidate(candidate);
            if (adminUrl) return adminUrl;
          }
          return "";
        }

        function cloneSupportTicketSeed() {
          return DEFAULT_SUPPORT_TICKETS.map(normalizeSupportTicket).filter(Boolean);
        }

        function normalizeSupportTicket(item, index) {
          if (!item || typeof item !== "object") return null;
          const id = String(item.id || "").replace(/^#/, "").trim();
          if (!id) return null;
          const orgId = String(
            item.orgId || item.org_id || item.orgID || "",
          ).trim();
          const directoryShop = SUPPORT_TICKET_SHOPS_BY_ORG_ID[orgId] || {};
          const contentAdminUrl = extractSupportTicketAdminUrlFromText(
            item.currentContent,
            item.issue,
            item.subject,
            item.content,
            item.body,
            item.description,
            item.handling,
          );
          return {
            id,
            status: String(item.status || "Open"),
            difficulty: normalizeSupportTicketDifficulty(
              item.difficultyScore ?? item.difficulty,
            ),
            difficultyScore: getSupportTicketDifficultyScore({
