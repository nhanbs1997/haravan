  #next-unfinished-task-btn {
    right: 14px;
    bottom: max(78px, calc(78px + env(safe-area-inset-bottom)));
  }
}

/*
   Icon tải lại trang: đặt ngoài #app như #next-unfinished-task-btn để không
   bị tạo lại mỗi lần render; chỉ hiển thị trên mobile, nằm bên trái phía
