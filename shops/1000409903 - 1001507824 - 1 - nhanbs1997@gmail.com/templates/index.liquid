  display: none;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  padding: 0;
  border: 1px solid rgba(111, 147, 206, 0.3);
  border-radius: 12px;
  background: rgba(4, 12, 27, 0.96);
  color: #aebbd4;
  font-size: 17px;
  line-height: 1;
  cursor: pointer;
  box-shadow: 0 16px 38px rgba(0, 0, 0, 0.46);
  backdrop-filter: blur(14px);
}
.reset-page-btn:active {
  border-color: rgba(43, 140, 255, 0.62);
  color: #fff;
}
@media (max-width: 780px) {
  .reset-page-btn {
    display: inline-flex;
    left: 14px;
    bottom: max(78px, calc(78px + env(safe-area-inset-bottom)));
  }
}

