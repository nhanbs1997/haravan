  }
  @font-face {
    font-family: "Futura6";
    font-weight: 900;
    src: url("https://content.pancake.vn/web-media/ac/4a/8b/6f/c3cd47bb4048a897878454876770a8aa6f5f5af15cdee27c95e6bd38-w:0-h:0-l:113024-t:application/font-woff.woff") format("woff");
    font-style: normal;
    font-display: swap;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: "Segoe UI"
    , "Futura6"
    , Arial
    , sans-serif;
  }
  .right-sidebar {
    position: fixed;
    top: 16px;
    right: 16px;
    width: 200px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 50;
  }
  .left-sidebar {
    position: fixed;
    top: 16px;
    left: 16px;
    width: 240px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 50;
    max-height: calc(100vh - 32px);
    overflow-y: auto;
  }
  .current-doing-widget {
    width: 100%;
    background: #1c1c1e;
    border: 1px solid #f2b94a;
    border-radius: 16px;
    padding: 14px;
    font-family: "Segoe UI"
    , "Futura6"
    , Arial
    , sans-serif;
    color: #f2f2f2;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
  }
  .current-doing-title {
    font-size: 11px;
    font-weight: 700;
    color: #f2b94a;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .current-doing-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f2b94a;
    flex: none;
    animation: doing-pulse 1.4s infinite;
  }
  @keyframes doing-pulse {
    0,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }
  .current-doing-text {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 6px;
    word-break: break-word;
  }
  .current-doing-time {
    font-size: 12px;
    color: #9b9ba1;
    margin-bottom: 10px;
    font-variant-numeric: tabular-nums;
  }
  .current-doing-empty {
    font-size: 12px;
    color: #6e6e73;
    text-align: center;
    padding: 8px 0;
  }
  .current-doing-actions {
    display: flex;
    gap: 6px;
  }
  .current-doing-actions .btn {
    flex: 1;
    text-align: center;
    font-size: 10px;
    padding: 6px 4px;
  }
  @media (max-width: 1500px) {
    .left-sidebar {
      display: none;
    }
  }
  .mini-timeline-widget {
    width: 100%;
    background: #1c1c1e;
    border: 1px solid #2c2c2e;
    border-radius: 16px;
    padding: 14px;
    font-family: "Segoe UI"
    , "Futura6"
    , Arial
    , sans-serif;
    color: #f2f2f2;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
  }
  .mini-timeline-title {
    font-size: 11px;
    font-weight: 700;
    color: #9b9ba1;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 10px;
  }
  .mini-timeline-track {
    position: relative;
    margin-left: 38px;
    border-left: 1px solid #2c2c2e;
  }
  .mini-tl-ruler-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;

  }
  .mini-tl-ruler-label {
    position: absolute;
    left: -38px;
    width: 34px;
    text-align: right;
    transform: translateY(-50%);
    font-size: 9px;
    color: #6e6e73;
  }
  .mini-tl-now-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: #ff3b5c;
    z-index: 5;
  }
  .mini-tl-now-dot {
    position: absolute;
    left: -4px;
    top: -3.5px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff3b5c;
  }
  .pomodoro-widget {
    width: 100%;
    background: #1c1c1e;
    border: 1px solid #2c2c2e;
    border-radius: 16px;
    padding: 12px;
    font-family: "Segoe UI"
    , "Futura6"
    , Arial
    , sans-serif;
    color: #f2f2f2;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
  }
  .pomodoro-title {
    font-size: 12px;
    font-weight: 700;
    color: #9b9ba1;
    text-align: center;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .pomodoro-phase-label {
    text-align: center;
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 4px;
  }
  .pomodoro-phase-label.work {
    color: #f2b94a;
  }
  .pomodoro-phase-label.break {
    color: #4cd964;
  }
  .pomodoro-timer {
    text-align: center;
    font-size: 24px;
    font-weight: 800;
    color: var(--ui-ink);
    font-variant-numeric: tabular-nums;
    margin-bottom: 8px;
  }
  .pomodoro-progress-track {
    width: 100%;
    height: 6px;

    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 8px;
  }
  .pomodoro-progress-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.3s linear;
  }
  .pomodoro-progress-fill.work {
    background: #f2b94a;
  }
  .pomodoro-progress-fill.break {
    background: #4cd964;
  }
  .pomodoro-meta {
    text-align: center;
    font-size: 10px;
    color: #9b9ba1;
    margin-bottom: 10px;
  }
  @media (max-width: 1280px) {
    .right-sidebar {
      display: none;
    }
  }

  /* ---- Mobile: show all widgets, stacked in normal flow instead of fixed ---- */
  @media (max-width: 900px) {
    .left-sidebar,
    .right-sidebar {
      display: flex;
      position: static;
      width: 100%;
      max-width: 1000px;
      margin: 0 auto 12px;
      max-height: none;
      top: auto;
      left: auto;
      right: auto;
      padding: 0 12px;
    }
    .right-sidebar {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .right-sidebar > div {
      flex: 1 1 240px;
      min-width: 220px;
    }
    #app {
      padding-top: 0;
    }
  }

  #app button {
    cursor: pointer;
    border: none;
    font-family: inherit;
    font-weight: 600;
    font-size: 13px;
    min-height: 32px;
  }
  #left-sidebar button,
  #right-sidebar button,
  #music-player-bar button {
    min-height: 30px;
    font-size: 13px;
  }
  #app input,
  #app select {
    font-family: inherit;
    font-size: 16px;
    line-height: 1.5;
  }
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  [tabindex="0"]:focus-visible,
  [contenteditable="true"]:focus-visible {
    outline: 3px solid #78a7ff;
    outline-offset: 2px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .top-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .top-input {
    flex: 1;
    min-width: 120px;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid #3a3a3c;

    color: #f2f2f2;
    font-size: 13px;
    outline: none;
  }
  .top-input::placeholder {
    color: #8e8e93;
  }
  .top-add {
    background: #4a6cf7;
    color: white;
    padding: 0 18px;
    border-radius: 8px;
    font-size: 13px;
  }
  

  .file-bar {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
    align-items: center;
  }
  .file-btn {

    color: #6fa8ff;
    padding: 7px 12px;
    border-radius: 8px;
    font-size: 12px;
  }
  .file-note {
    font-size: 11px;
    color: #6e6e73;
  }
  .backup-history-backdrop {
    position: fixed;
    inset: 0;
    z-index: 12000;
    display: grid;
    place-items: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.76);
    backdrop-filter: blur(10px);
  }
  .backup-history-dialog {
    width: min(820px, 100%);
    max-height: min(760px, calc(100vh - 40px));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(111, 168, 255, 0.3);
    border-radius: 18px;
    background: #111318;
    color: #f5f7ff;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.58);
  }
  .backup-history-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .backup-history-header h2 {
    margin: 0 0 5px;
    font-size: 20px;
  }
  .backup-history-header p {
    margin: 0;
    color: #9da6ba;
    font-size: 12px;
    line-height: 1.5;
  }
  .backup-history-close {
    min-width: 38px;
    height: 38px;
    border: 0;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 22px;
    cursor: pointer;
  }
  .backup-history-list {
    display: grid;
    gap: 10px;
    padding: 16px 20px 22px;
    overflow: auto;
  }
  .backup-history-empty {
    padding: 28px 16px;
    border: 1px dashed rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    color: #9da6ba;
    text-align: center;
  }
  .backup-history-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.035);
  }
  .backup-history-item.is-current {
    border-color: rgba(56, 183, 122, 0.48);
    background: rgba(56, 183, 122, 0.08);
  }
  .backup-history-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 5px;
    font-size: 14px;
    font-weight: 700;
  }
  .backup-history-source {
    padding: 3px 7px;
    border-radius: 999px;
    background: rgba(111, 168, 255, 0.12);
    color: #8db9ff;
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .backup-history-summary {
    color: #9da6ba;
    font-size: 12px;
    line-height: 1.5;
  }
  .backup-history-actions {
    display: flex;
    gap: 7px;
  }
  .backup-history-action {
    border: 1px solid rgba(111, 168, 255, 0.32);
    border-radius: 9px;
    background: transparent;
    color: #8db9ff;
    padding: 8px 10px;
    cursor: pointer;
    white-space: nowrap;
  }
  .backup-history-action.restore {
    background: #3867ff;
    color: #fff;
  }
  @media (max-width: 640px) {
    .backup-history-item {
      grid-template-columns: 1fr;
    }
    .backup-history-actions {
      justify-content: flex-end;
    }
  }

  .section-title {
    font-size: 13px;
    font-weight: 700;
    color: #8e8e93;
    margin: 18px 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .section-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin: 18px 0 8px;
  }
  .section-header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .section-title-row .section-title {
    margin: 0;
  }
  .section-add-root-btn,
  .root-add-cancel {
    display: inline-grid;
    width: 30px;
    min-height: 30px;
    place-items: center;
    padding: 0;
    border: 1px solid #7753b5;
    border-radius: 7px;
    background: #33264a;
    color: #d9c5ff;
    font-size: 20px;
    line-height: 1;
  }
  .section-add-root-btn:hover,
  .root-add-cancel:hover {
    background: #51367d;
    color: #fff;
  }
  .root-add-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    padding: 10px;
    border: 1px solid #4b3b66;
    border-radius: 10px;
    background: #25222d;
  }
  .root-add-row input {
    flex: 1;
    min-width: 160px;
    min-height: 36px;
    padding: 7px 10px;
    border: 1px solid #4b3b66;
    border-radius: 7px;
    background: #1c1c1e;
    color: #f2f2f2;
  }
  .section-toggle-btn {
    flex-shrink: 0;

    border: 1px solid #3a3a3c;
    color: #9b9ba1;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    cursor: pointer;
  }
  .section-toggle-btn:hover {
    background: #3a3a3c;
    color: #f2f2f2;
  }
  .widget-title-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .widget-toggle-btn {
    flex-shrink: 0;
    background: transparent;
    border: 1px solid #3a3a3c;
    color: #9b9ba1;
    border-radius: 5px;
    padding: 1px 7px;
    font-size: 11px;
    line-height: 1.5;
    cursor: pointer;
  }
  .widget-toggle-btn:hover {
    background: #3a3a3c;
    color: #f2f2f2;
  }

  /* ---- Stats ---- */

  .row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px;
    border-radius: 8px;
    border-left: 3px solid #4a4a4c;
    margin-bottom: 6px;
    width: fit-content;
    max-width: 100%;
    flex-wrap: wrap;
  }
  .row.doing {
    border-left-color: #f2b94a;
    border-left-style: solid;
  }
  .row.done {
    border-left-color: #4cd964;
    border-left-style: double;
    opacity: 0.65;
  }
  .row.pending {
    border-left-color: #8e8e93;
    border-left-style: dashed;
    opacity: 0.55;
  }
  .row.drag-over-child {
    box-shadow: 0 0 0 2px #4a6cf7 inset;
  }
  .row.dragging {
