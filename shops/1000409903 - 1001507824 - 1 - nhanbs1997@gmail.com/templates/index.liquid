              if (event.key.toLowerCase() === "n" && !isPinnedDayTask(node)) {
                event.preventDefault();
                event.stopPropagation();
                toggleTaskNoteEditor(id);
                return;
              }
              if (
                (event.key === " " || event.key === "Spacebar" || event.code === "Space") &&
                !isPinnedDayTask(node) &&
                row.dataset.viewKind !== "knowledge" &&
                node.kind !== "kienthuc"
