   or make it jump. It stays anchored to the viewport while the task list
   grows.
*/
#next-unfinished-task-btn {
  position: fixed;
  right: max(14px, env(safe-area-inset-right));
  bottom: max(12px, env(safe-area-inset-bottom));
  z-index: 95;
  white-space: nowrap;
}

