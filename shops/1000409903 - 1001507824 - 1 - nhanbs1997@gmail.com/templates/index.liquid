    font-family: "Futura6";
    font-weight: 400;
    src: url("https://content.pancake.vn/web-media/2b/25/af/3d/95e3217587fbdc24d3412ffa500e1e8f240355c600688ef2f294a538-w:0-h:0-l:106872-t:application/font-woff.woff") format("woff");
    font-style: normal;
