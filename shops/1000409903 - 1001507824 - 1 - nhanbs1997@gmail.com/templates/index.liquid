        function isMindmapColor(value) {
          return /^#[0-9a-f]{6}$/i.test(String(value || ""));
        }

        function cleanMindmapText(value, fallback) {
          const text = String(value || "")
            .replace(/\r\n?/g, "\n")
            .split("\n")
            .map((line) => line.replace(/[^\S\r\n]+/g, " ").trim())
            .join("\n")
            .replace(/\n{3,}/g, "\n\n")
            .trim()
            .slice(0, 160)
            .trim();
          return text || fallback;
        }

        function escapeMindmapAttribute(value) {
          return escapeHtml(String(value || ""))
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
        }

        function createMindmapNode(text, color) {
          return {
            id: genId("mm"),
            syncKey: "",
            text: cleanMindmapText(text, "Nhánh mới"),
            color: isMindmapColor(color) ? color : "",
            collapsed: false,
            checked: false,
            children: [],
          };
        }

        function setMindmapSubtreeChecked(node, checked) {
          if (!node) return;
          node.checked = !!checked;
          (node.children || []).forEach((child) =>
            setMindmapSubtreeChecked(child, checked),
          );
        }

        function reconcileMindmapCompletion(node, isRoot) {
          if (!node) return false;
          const children = Array.isArray(node.children) ? node.children : [];
          children.forEach((child) =>
            reconcileMindmapCompletion(child, false),
          );
          if (children.length)
            node.checked = children.every((child) => !!child.checked);
          if (isRoot) node.checked = false;
          return !!node.checked;
        }

        function buildMindmapProgressMap(root) {
          const progressMap = new Map();
          const visit = (node, isRoot) => {
            const children = Array.isArray(node.children)
              ? node.children
              : [];
            if (!children.length) {
              const total = isRoot ? 0 : 1;
              const done = !isRoot && node.checked ? 1 : 0;
              const stats = {
                done,
                total,
                percent: done ? 100 : 0,
              };
              progressMap.set(node.id, stats);
              return stats;
            }
            let done = 0;
            let total = 0;
            children.forEach((child) => {
              const childStats = visit(child, false);
              done += childStats.done;
              total += childStats.total;
            });
            const percent =
              total === 0
                ? 0
                : done === total
                  ? 100
                  : done === 0
                    ? 0
                    : Math.min(
                        99,
                        Math.max(1, Math.round((done / total) * 100)),
                      );
            const stats = { done, total, percent };
            progressMap.set(node.id, stats);
            return stats;
          };
          if (root) visit(root, true);
          return progressMap;
        }

