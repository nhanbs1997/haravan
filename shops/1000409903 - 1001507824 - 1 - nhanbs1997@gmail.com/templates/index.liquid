}
.cal-nav button {

  color: var(--ui-ink);
  padding: 5px 10px;
  border-radius: 6px;
  font-size: 12px;
  flex: none;
}
.view-switch {
  display: flex;
  gap: 4px;
  margin-bottom: 10px;
}
.view-switch button {

  color: #8e8e93;
  padding: 6px 14px;
  border-radius: 6px;
  font-size: 12px;
}
.view-switch button.active {
  background: #4a6cf7;
  color: white;
}

.cal-scroll {
  overflow-x: auto;
}
.cal-wrap {
  border: 1px solid #2c2c2e;
  border-radius: 8px;
  overflow: hidden;
  min-width: 320px;
}
.cal-grid {
  display: grid;
}
.cal-head-cell {

  padding: 6px 2px;
  text-align: center;
  font-size: 10px;
  color: #8e8e93;
  border-bottom: 1px solid #2c2c2e;
  border-left: 1px solid #2c2c2e;
}
.cal-head-cell.today {
  color: #4a6cf7;
}
.cal-fixed-row .cal-fixed-cell {

  border-bottom: 1px solid #2c2c2e;
  border-left: 1px solid #2c2c2e;
  padding: 3px;
  min-height: 16px;
}
.cal-corner {

  border-bottom: 1px solid #2c2c2e;
}
.cal-hour-label {
  font-size: 9px;
  color: #6e6e73;
  text-align: right;
  padding: 2px 4px;
  border-top: 1px solid #2c2c2e;
}
.cal-cell {
  position: relative;
  border-top: 1px solid #2c2c2e;
  border-left: 1px solid #2c2c2e;
  height: 60px;

}
.cal-event {
  position: absolute;
  left: 2px;
  right: 2px;
  border-radius: 4px;
  padding: 2px 4px;
  font-size: 9px;
  font-weight: 700;
  overflow: hidden;
  line-height: 1.2;
  color: #1c1c1e;
}
.cal-event.is-doing {
  background: #f2b94a;
  box-shadow: 0 0 0 1px #f2b94a;
}
.cal-event.is-done {
  background: #4cd964;
}
.cal-event.is-caltask {
  background: #3aa8f0;
  color: #1c1c1e;
  cursor: pointer;
  z-index: 0;
}
.cal-event.is-pomo-break {
  background: repeating-linear-gradient(45deg, rgba(154, 106, 255, 0.22), rgba(154, 106, 255, 0.22) 6px, rgba(154, 106, 255, 0.32) 6px, rgba(154, 106, 255, 0.32) 12px);
  border: 1px dashed rgba(154, 106, 255, 0.6);
  color: #c9b6ff;
  z-index: 0;
}
.cal-event-label {
  display: block;
  padding-right: 12px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cal-event-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 13px;
  height: 13px;
  line-height: 12px;
  text-align: center;
  padding: 0;
  border: none;
  border-radius: 0 3px 0 4px;
  background: rgba(0, 0, 0, 0.35);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
  z-index: 1;
  min-height: 13px
}
#app button.cal-event-del {
  min-height: 13px
}
.cal-event-del:hover {
  background: #ff3b5c;
}
.cal-drag-select {
  position: absolute;
  left: 2px;
  right: 2px;
  background: rgba(74, 108, 247, 0.35);
  border: 1px dashed #4a6cf7;
  border-radius: 4px;
  z-index: 4;
  pointer-events: none;
}
.cal-quickcreate {
  position: fixed;
  z-index: 200;
  width: 220px;

  border: 1px solid #3a3a3c;
  border-radius: 10px;
  padding: 10px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  font-family: "Segoe UI"
  , "Futura6"
  , Arial
  , sans-serif;
}
.cal-popup-time {
  font-size: 12px;
  font-weight: 700;
  color: #f2f2f2;
  margin-bottom: 6px;
  word-break: break-word;
}
.cal-popup-input {
  width: 100%;
  box-sizing: border-box;
  background: #1c1c1e;
  border: 1px solid #3a3a3c;
  border-radius: 6px;
  color: #f2f2f2;
  padding: 6px 8px;
  font-size: 12px;
  margin-bottom: 8px;
}
.cal-popup-date {
  width: 100%;
  box-sizing: border-box;
  background: #1c1c1e;
  border: 1px solid #3a3a3c;
  border-radius: 6px;
  color: #f2f2f2;
  padding: 6px 8px;
  font-size: 12px;
  margin-bottom: 8px;
  color-scheme: dark;
}
.cal-popup-repeat-label {
  font-size: 10px;
  color: #9b9ba1;
  margin-bottom: 4px;
}
.cal-popup-repeat {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-bottom: 10px;
}
.cal-repeat-chip {
  flex: 1;
  min-width: 24px;
  background: #1c1c1e;
  border: 1px solid #3a3a3c;
  color: #9b9ba1;
  border-radius: 6px;
  padding: 4px 0;
  font-size: 10px;
  cursor: pointer;
}
.cal-repeat-chip.active {
  background: #4a6cf7;
  border-color: #4a6cf7;
  color: #fff;
}
.cal-popup-actions {
  display: flex;
  justify-content: flex-end;
  gap: 6px;
}
.cal-popup-actions button {
  border: none;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 11px;
  cursor: pointer;
}
.cal-popup-cancel {

  color: #f2f2f2;
}
.cal-popup-save {
  background: #4a6cf7;
  color: #fff;
}
.cal-popup-delete {
  background: #ff3b5c;
  color: #fff;
}
.now-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 0;
  border-top: 2px solid #ff3b5c;
  z-index: 5;
  pointer-events: none;
}
.now-line .now-dot {
  position: absolute;
  left: -4px;
  top: -4px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ff3b5c;
}
.now-line .now-label {
  position: absolute;
  left: 4px;
  top: -8px;
  font-size: 8px;
  font-weight: 800;
  color: #ff3b5c;
  background: #1c1c1e;
  padding: 0 3px;
  border-radius: 3px;
  white-space: nowrap;
}
.due-date-control {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  color: var(--ui-muted);
  font-size: 10px;
  white-space: nowrap;
}
.due-date-control input {
  width: 120px;
  min-height: 26px;
  padding: 3px 5px;
  border: 1px solid #3a3a3c;
  border-radius: 6px;

  color: #d1d1d6;
  font: inherit;
}
#app {
  max-width: 100%;
  padding: 0;
}
.workspace-shell {
  display: grid;
  grid-template-columns: 230px minmax(0, 1fr);
  gap: 16px;
  align-items: start;
}
.workspace-tabs {
  position: sticky;
  top: 16px;
  padding: 12px;
  border: 1px solid #32324a;
  border-radius: 16px;
  background: linear-gradient(180deg, #252238 0%, #1f1f23 100%);
  box-shadow: 0 14px 36px rgba(0, 0, 0, 0.26);
}
.workspace-brand {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 3px 6px 16px;
  color: #f2f2f2;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.04em;
}
.workspace-brand-mark {
  display: inline-grid;
  width: 28px;
  height: 28px;
  place-items: center;
  border-radius: 9px;
  color: #fff;
  background: linear-gradient(135deg, #9b59f6, #4a6cf7);
  box-shadow: 0 0 20px rgba(128, 89, 246, 0.46);
}
.workspace-tab-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.workspace-tab {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 40px;
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: #aaaab4;
  text-align: left;
  transition: 0.18s ease;
}
.workspace-tab:hover {
  background: #302e3c;
  color: #f2f2f2;
}
.workspace-tab.active {
  border-color: rgba(148, 104, 255, 0.64);
  background: linear-gradient(90deg, rgba(125, 70, 241, 0.52), rgba(74, 108, 247, 0.13));
  color: #fff;
  box-shadow: inset 3px 0 #b476ff
  , 0 0 18px rgba(111, 70, 241, 0.18);
}
.workspace-tab-icon {
  width: 20px;
  color: #a883ff;
  font-size: 16px;
  text-align: center;
}
.workspace-tab.active .workspace-tab-icon {
  color: #d9c5ff;
}
.workspace-main {
  min-width: 0;
  padding: 18px;
  border: 1px solid #303039;
  border-radius: 16px;
  background: #202023;
  box-shadow: 0 14px 36px rgba(0, 0, 0, 0.2);
}
.workspace-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 16px;
}
.workspace-eyebrow {
  margin: 0 0 4px;
  color: #a883ff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}
.workspace-title {
  margin: 0;
  color: #f7f4ff;
  font-size: 22px;
  line-height: 1.2;
}
.workspace-subtitle {
  margin: 5px 0 0;
  color: #9b9ba1;
  font-size: 13px;
}
.tab-panel {
  display: none;
}
.tab-panel.active {
  display: block;
  animation: tab-panel-in 0.18s ease-out;
}
@keyframes tab-panel-in {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.calendar-widget-slot {
  margin: 12px 0;
}
#left-sidebar,
#right-sidebar {
  display: none;
}

@media (max-width: 560px) {
  .top-bar,
  .fixed-form {
    flex-direction: column;
  }
  .actions {
    margin-left: 0;
    width: 100%;
    justify-content: flex-start;
  }
  .row > .actions {
    width: auto;
  }
  .row {
    padding: 10px;
  }
  .root-add-row {
    flex-wrap: wrap;
  }
  .show-done-toggle-row {
    align-items: flex-start;
    flex-direction: column;
  }
  .task-work-actions {
    justify-content: flex-start;
  }
  #next-unfinished-task-btn {
    right: 12px;
    bottom: 12px;
  }
}
@media (max-width: 900px) {
  #app {
    padding: 0;
  }
  .workspace-shell {
    grid-template-columns: 1fr;
  }
  .workspace-tabs {
    position: static;
    overflow-x: auto;
  }
  .workspace-brand {
    margin-bottom: 10px;
  }
  .workspace-tab-list {
    flex-direction: row;
    width: max-content;
  }
  .workspace-tab {
    width: auto;
    white-space: nowrap;
  }
  .workspace-main {
    padding: 14px;
  }
}


/* Dark multicolor dashboard theme. */
:root {
  --ui-page: #020713;
  --ui-surface: #07101f;
  --ui-surface-raised: #0b1628;
  --ui-surface-soft: #0e1b30;
  --ui-ink: #f5f7ff;
  --ui-muted: #8e9ab4;
  --ui-line: rgba(111, 147, 206, 0.18);
  --ui-line-strong: rgba(125, 164, 231, 0.34);
  --ui-purple: #a855f7;
  --ui-blue: #2b8cff;
  --ui-cyan: #18c8e9;
  --ui-green: #20d88b;
  --ui-orange: #ff8a24;
  --ui-red: #ff5e72;
  --ui-gold: #f6c344;
  --active-accent: var(--ui-purple);
  --pomo-work: var(--ui-blue);
  --pomo-short-break: var(--ui-green);
  --pomo-long-work: var(--ui-purple);
  --pomo-long-break: var(--ui-orange);
}
html,
body {
  margin: 0;
  background: radial-gradient(circle at 14% -8%, rgba(126, 72, 255, 0.16), transparent 34%), radial-gradient(circle at 92% 8%, rgba(43, 140, 255, 0.12), transparent 30%), var(--ui-page);
  color: var(--ui-ink);
  color-scheme: dark;
}
#app {
  max-width: 100%;
  min-height: 100vh;
  padding: 0;
  background: linear-gradient(rgba(5, 12, 27, 0.78), rgba(2, 7, 19, 0.94)), radial-gradient(circle at 72% 0%, rgba(32, 216, 139, 0.05), transparent 30%);
  color: var(--ui-ink);
}
.workspace-shell {
  display: grid;
  grid-template-columns: 230px minmax(0, 1fr);
  gap: 14px;
  min-height: 100vh;
  padding: 14px;
  background: transparent;
}
.workspace-tabs,
.workspace-main,
.current-doing-widget,
.mini-timeline-widget,
.pomodoro-widget,
.cal-quickcreate {
  border: 1px solid var(--ui-line);
  border-radius: 16px;
  background: linear-gradient(145deg, rgba(10, 21, 40, 0.98), rgba(4, 11, 25, 0.98));
  color: var(--ui-ink);
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.025)
  , 0 16px 38px rgba(0, 0, 0, 0.3);
}
.workspace-tabs {
  position: sticky;
  top: 16px;
  padding: 12px;
  height: fit-content;
  background: linear-gradient(180deg, rgba(8, 17, 34, 0.99), rgba(3, 9, 22, 0.99));
}
.workspace-main {
  min-width: 0;
  padding: 18px;
  overflow: hidden;
}
.workspace-brand {
  color: var(--ui-ink);
}
.workspace-brand-mark {
  border-radius: 9px;
  background: linear-gradient(135deg, var(--ui-blue), var(--ui-purple));
  color: #fff;
  box-shadow: 0 0 0 1px rgba(168, 85, 247, 0.42)
  , 0 0 22px rgba(88, 101, 242, 0.36);
}
.workspace-tab {
  --tab-accent: var(--ui-purple);
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: var(--ui-muted);
  box-shadow: none;
}
.workspace-tab[data-tab="tasks"] {
  --tab-accent: var(--ui-blue);
}
.workspace-tab[data-tab="mindmap"] {
  --tab-accent: var(--ui-purple);
}
.workspace-tab[data-tab="haravan-code"] {
  --tab-accent: var(--ui-cyan);
}
.workspace-tab[data-tab="music"] {
  --tab-accent: #4f7cff;
}
.workspace-tab:hover {
  border-color: color-mix(in srgb, var(--tab-accent) 30%, transparent);
  background: color-mix(in srgb, var(--tab-accent) 10%, var(--ui-surface));
  color: var(--ui-ink);
}
.workspace-tab.active {
  border: 1px solid color-mix(in srgb, var(--tab-accent) 68%, transparent);
  background: linear-gradient(90deg, color-mix(in srgb, var(--tab-accent) 34%, transparent), color-mix(in srgb, var(--tab-accent) 8%, transparent));
  color: #fff;
  box-shadow: inset 3px 0 var(--tab-accent)
  , 0 0 20px color-mix(in srgb, var(--tab-accent) 17%, transparent);
}
.workspace-tab-icon {
  color: var(--tab-accent);
  text-shadow: 0 0 12px color-mix(in srgb, var(--tab-accent) 70%, transparent);
}
.workspace-tab.active .workspace-tab-icon {
  color: color-mix(in srgb, var(--tab-accent) 72%, #fff);
}
.workspace-shell[data-active-tab="tasks"] {
  --active-accent: var(--ui-blue);
}
.workspace-shell[data-active-tab="mindmap"] {
  --active-accent: var(--ui-purple);
}
.workspace-shell[data-active-tab="haravan-code"] {
  --active-accent: var(--ui-cyan);
}
.workspace-shell[data-active-tab="ideas"] {
  --active-accent: #d25cff;
}
.workspace-shell[data-active-tab="music"] {
  --active-accent: #4f7cff;
}
.workspace-shell[data-active-tab="finance"] {
  --active-accent: var(--ui-orange);
}
.workspace-shell[data-active-tab="history"] {
  --active-accent: var(--ui-green);
}
.workspace-shell[data-active-tab="trash"] {
  --active-accent: var(--ui-red);
}
.workspace-shell[data-active-tab] .workspace-main {
  border-color: color-mix(in srgb, var(--active-accent) 26%, var(--ui-line));
  background: radial-gradient(circle at 100% 0, color-mix(in srgb, var(--active-accent) 9%, transparent), transparent 30%), linear-gradient(145deg, rgba(10, 21, 40, 0.98), rgba(4, 11, 25, 0.98));
}
.workspace-eyebrow,
.workspace-subtitle,
.section-title,
.file-note,
.music-category-label {
  color: var(--ui-muted);
  text-shadow: none;
}
.workspace-eyebrow {
  color: var(--active-accent);
  text-shadow: 0 0 14px color-mix(in srgb, var(--active-accent) 45%, transparent);
}
.workspace-title,
.music-title {
  color: var(--ui-ink);
}
#app button,
#app .file-btn,
#left-sidebar button,
#right-sidebar button,
#music-player-bar button,
.cal-quickcreate button {
  border: 1px solid var(--ui-line);
  border-radius: 9px;
  background: var(--ui-surface-raised);
  color: var(--ui-ink);
  box-shadow: none;
}

#app .file-btn:hover,
#left-sidebar button:hover,
#right-sidebar button:hover,
#music-player-bar button:hover,
.cal-quickcreate button:hover {
  border-color: var(--ui-line-strong);
  background: var(--ui-surface-soft);
  color: #fff;
  box-shadow: 0 0 14px rgba(43, 140, 255, 0.1);
  transform: translateY(-1px);
}
#app input,
#app select,
#app textarea,
.cal-quickcreate input {
  border: 1px solid var(--ui-line);
  border-radius: 9px;
  background: #050d1c;
  color: var(--ui-ink);
  box-shadow: none;
}
#app input:focus,
#app select:focus,
#app textarea:focus {
  border-color: var(--active-accent);
  outline: none;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--active-accent) 14%, transparent);
}
.section-body,
.tab-panel {
  background: transparent;
  color: var(--ui-ink);
}

.music-widget,
.note-editor-wrap,
.row,
.music-item,
.music-category-chip,
.note-editor,
.note-source-editor,
.cal-container,
.calendar-widget-slot {
  border: 1px solid var(--ui-line);
  border-radius: 12px;
  background: linear-gradient(145deg, rgba(10, 22, 42, 0.96), rgba(5, 12, 27, 0.98));
  color: var(--ui-ink);
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.02);
}
.current-doing-widget {
  border-color: rgba(255, 138, 36, 0.36);
  background: radial-gradient(circle at 100% 0, rgba(255, 138, 36, 0.11), transparent 38%), var(--ui-surface);
}
.mini-timeline-widget {
  border-color: rgba(43, 140, 255, 0.32);
  background: radial-gradient(circle at 100% 0, rgba(43, 140, 255, 0.1), transparent 38%), var(--ui-surface);
}
.pomodoro-widget {
  border-color: rgba(168, 85, 247, 0.34);
  background: radial-gradient(circle at 100% 0, rgba(168, 85, 247, 0.11), transparent 38%), var(--ui-surface);
}
.music-widget {
  border-color: rgba(79, 124, 255, 0.34);
  background: radial-gradient(circle at 100% 0, rgba(79, 124, 255, 0.1), transparent 35%), var(--ui-surface);
}
.note-editor-wrap {
  border-color: rgba(24, 200, 233, 0.3);
  background: radial-gradient(circle at 100% 0, rgba(24, 200, 233, 0.09), transparent 38%), var(--ui-surface);
}
.cal-container,
.calendar-widget-slot {
  border-color: rgba(43, 140, 255, 0.3);
  background: radial-gradient(circle at 100% 0, rgba(43, 140, 255, 0.09), transparent 38%), var(--ui-surface);
}
.row:hover,
.music-item:hover {
  background: var(--ui-surface-soft);
}
.row.doing,
.row.done,
.row.pending,
.row.kienthuc {
  border-left: 3px solid var(--active-accent);
}
.row.fixed-today .fixed-today-label {
  font-weight: 800;
}
.today-pomodoro-slot {
  margin-bottom: 12px;
}
.today-pomodoro-slot .pomodoro-widget {
  width: 100%;
  padding: 12px;
}
.today-pomodoro-header,
.today-pomodoro-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.today-pomodoro-header {
  margin-bottom: 10px;
  font-size: 14px;
}
.today-pomodoro-sound-card {
  margin: 14px 0;
  padding: 16px 20px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(43, 140, 255, 0.08), rgba(168, 85, 247, 0.08));
  border: 1px solid rgba(242, 185, 74, 0.35);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
}
.today-pomo-sound-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}
.today-pomo-sound-title {
  display: flex;
  align-items: center;
  gap: 12px;
}
.pomo-sound-icon {
  font-size: 26px;
}
.pomo-sound-sub {
  margin: 2px 0 0;
  font-size: 12px;
  color: #9b9ba1;
}
.today-pomo-sound-actions,
.today-pomodoro-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.today-pomo-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
