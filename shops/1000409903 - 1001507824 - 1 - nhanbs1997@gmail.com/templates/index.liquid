              if (
                e.target?.closest?.(".row, [data-knowledge-root-drop-zone]")
              )
                return;
              e.preventDefault();
              e.stopPropagation();
              const draggedId =
                dragInfo || e.dataTransfer?.getData?.("text/plain");
              knowledgeRootDropZone?.classList.remove("is-active", "drag-over");
              dragInfo = null;
              if (draggedId) promoteTaskToRoot(draggedId);
            });
          }

          const taskSelectionRoot = document.documentElement;
          if (taskSelectionRoot.dataset.taskSelectionBound !== "true") {
            taskSelectionRoot.dataset.taskSelectionBound = "true";
            document.addEventListener(
              "pointermove",
              (event) => {
                const drag = taskSelectionDragState;
                if (
                  !drag ||
                  drag.pointerId !== event.pointerId ||
                  (event.buttons & 1) !== 1
                )
                  return;
                const distance = Math.hypot(
                  event.clientX - drag.startX,
                  event.clientY - drag.startY,
                );
                if (!drag.moved && distance < 6) return;
                if (!drag.moved) {
                  drag.moved = true;
                  drag.suppressClick = true;
                  if (!drag.additive) selectedTaskIds.clear();
                  selectedTaskIds.add(drag.rowId);
                  document.body.classList.add("task-selection-dragging");
                  updateTaskSelectionUi();
                }
                const targetRow = event.target?.closest?.(
                  "#section-body-tasks-task .row[data-row-id]",
                );
                const targetNode = targetRow
                  ? findNodeAny(targetRow.dataset.rowId)
                  : null;
                if (
                  targetRow &&
                  targetRow.dataset.viewKind !== "knowledge" &&
                  isSelectableTaskNode(targetNode) &&
                  !selectedTaskIds.has(targetRow.dataset.rowId)
                ) {
                  selectedTaskIds.add(targetRow.dataset.rowId);
                  updateTaskSelectionUi();
                }
                event.preventDefault();
              },
              { passive: false },
            );
            const finishTaskSelectionDrag = (event) => {
              const drag = taskSelectionDragState;
              if (
                !drag ||
                (event.pointerId !== undefined &&
                  drag.pointerId !== event.pointerId)
              )
                return;
              if (!drag.moved && drag.additive) {
                toggleTaskSelection(drag.rowId);
              }
              if (drag.moved || drag.additive)
                taskSelectionSuppressClickUntil = Date.now() + 500;
              document.body.classList.remove("task-selection-dragging");
              taskSelectionDragState = null;
            };
            document.addEventListener("pointerup", finishTaskSelectionDrag);
            document.addEventListener("pointercancel", finishTaskSelectionDrag);
            document.addEventListener(
              "click",
              (event) => {
                if (!taskSelectionSuppressClickUntil) return;
                if (Date.now() > taskSelectionSuppressClickUntil) {
                  taskSelectionSuppressClickUntil = 0;
                  return;
                }
                if (
                  !event.target?.closest?.(
                    "#section-body-tasks-task .row[data-row-id]",
                  )
                ) {
                  taskSelectionSuppressClickUntil = 0;
                  return;
                }
                taskSelectionSuppressClickUntil = 0;
                event.preventDefault();
                event.stopPropagation();
              },
              true,
            );
          }

          // drag & drop -> nest dragged task as child of drop target
          app.querySelectorAll(".row").forEach((rowEl) => {
            rowEl.addEventListener("pointerdown", (event) => {
              if (
                activeTab !== "tasks" ||
                event.button !== 0 ||
                event.isPrimary === false ||
                rowEl.dataset.viewKind === "knowledge"
              )
                return;
              const target = event.target;
              if (
                target?.closest?.(
                  "button, input, textarea, select, a, [contenteditable=\"true\"], .drag-handle, .note-editor-wrap",
                )
              )
                return;
              const node = findNodeAny(rowEl.dataset.rowId);
              if (!isSelectableTaskNode(node)) return;
              const additive = event.ctrlKey || event.metaKey;
              taskSelectionDragState = {
                pointerId: event.pointerId,
                rowId: rowEl.dataset.rowId,
                startX: event.clientX,
                startY: event.clientY,
                additive,
                moved: false,
                suppressClick: false,
              };
              if (additive) {
                event.preventDefault();
                event.stopPropagation();
              }
            });
            rowEl.addEventListener("mouseenter", () => {
              hoveredTaskRowId = rowEl.dataset.rowId || null;
              if (document.activeElement !== rowEl)
                rowEl.focus({ preventScroll: true });
            });
            rowEl.addEventListener("mouseleave", () => {
              if (
                hoveredTaskRowId === rowEl.dataset.rowId &&
                document.activeElement !== rowEl
              )
                hoveredTaskRowId = null;
            });
            rowEl.addEventListener("focus", () => {
              hoveredTaskRowId = rowEl.dataset.rowId || null;
            });
            rowEl.addEventListener("blur", () => {
              if (hoveredTaskRowId === rowEl.dataset.rowId)
                hoveredTaskRowId = null;
            });
            rowEl.addEventListener("keydown", (e) => {
              if (
                e.target === rowEl &&
                !e.altKey &&
                !e.ctrlKey &&
                !e.metaKey &&
                activeTab === "tasks" &&
                rowEl.dataset.viewKind !== "knowledge"
              ) {
                const taskNode = findNodeAny(rowEl.dataset.rowId);
                if (taskNode && !isPinnedDayTask(taskNode) && taskNode.kind !== "kienthuc") {
                  if (e.key === "Enter") {
                    e.preventDefault();
                    e.stopPropagation();
                    toggleTaskSiblingInput(rowEl.dataset.rowId);
                    return;
                  }
                  if (e.key === "Tab") {
                    e.preventDefault();
                    e.stopPropagation();
                    toggleTaskChildInput(rowEl.dataset.rowId);
                    return;
                  }
                }
              }
              if (
                e.target === rowEl &&
                !e.altKey &&
                !e.ctrlKey &&
                !e.metaKey &&
                (e.key === "ArrowDown" || e.key === "ArrowUp")
              ) {
                const collapseButton = rowEl.querySelector(
                  ':scope > button[data-action="collapse"]',
                );
                if (collapseButton) {
                  const rowId = rowEl.dataset.rowId;
                  const isCollapsed = !!state.collapsed[rowId];
                  const shouldToggle =
                    e.key === "ArrowDown" ? isCollapsed : !isCollapsed;
                  if (shouldToggle) toggleCollapse(rowId);
                  e.preventDefault();
                  e.stopPropagation();
                  return;
                }
              }
              if (e.target !== rowEl || !e.altKey || !e.shiftKey) return;
              if (e.key === "ArrowRight") {
                e.preventDefault();
                indentTask(rowEl.dataset.rowId);
              } else if (e.key === "ArrowLeft") {
                e.preventDefault();
                outdentTask(rowEl.dataset.rowId);
              }
            });
            rowEl.addEventListener("dragstart", (e) => {
              if (taskSelectionDragState?.rowId === rowEl.dataset.rowId) {
                e.preventDefault();
                return;
              }
              dragInfo = rowEl.dataset.rowId;
              rowEl.classList.add("dragging");
              taskRootDropZone?.classList.add("is-active");
              e.dataTransfer.effectAllowed = "move";
            });
            rowEl.addEventListener("dragend", () => {
              rowEl.classList.remove("dragging");
              taskRootDropZone?.classList.remove("is-active", "drag-over");
              app
                .querySelectorAll(".row.drag-over-child")
                .forEach((r) => r.classList.remove("drag-over-child"));
            });
            rowEl.addEventListener("dragover", (e) => {
              e.preventDefault();
              rowEl.classList.add("drag-over-child");
            });
            rowEl.addEventListener("dragleave", () =>
              rowEl.classList.remove("drag-over-child"),
            );
            rowEl.addEventListener("drop", (e) => {
              e.preventDefault();
              rowEl.classList.remove("drag-over-child");
              if (dragInfo && dragInfo !== rowEl.dataset.rowId)
                makeChild(dragInfo, rowEl.dataset.rowId);
              dragInfo = null;
            });
          });
        }

        // ---------- phím tắt: gõ "p1" -> Pending, "d1" -> Xong (cho việc đang làm) ----------
        (function setupDoingShortcuts() {
          let keyBuffer = "";
          let bufferTimer = null;

          function resetBuffer() {
            keyBuffer = "";
            if (bufferTimer) {
              clearTimeout(bufferTimer);
              bufferTimer = null;
            }
          }

          document.addEventListener("keydown", (e) => {
            const target = e.target;
            if (
              (e.ctrlKey || e.metaKey) &&
              !e.altKey &&
              e.key.toLowerCase() === "k"
            ) {
              e.preventDefault();
              resetBuffer();
              openCommandPalette();
              return;
            }
            if (
              e.key === "Escape" &&
              document.getElementById("command-palette")
            ) {
              e.preventDefault();
              resetBuffer();
              closeCommandPalette();
              return;
            }
            if (
              activeTab === "mindmap" &&
              target?.closest?.("#mindmap-shell")
            ) {
              resetBuffer();
              return;
            }
            const isTyping =
              target &&
              (target.tagName === "INPUT" ||
                target.tagName === "TEXTAREA" ||
                target.isContentEditable);
            if (isTyping) {
              resetBuffer();
              return;
            }
            if (
              (e.key === "ArrowDown" || e.key === "ArrowUp") &&
              !e.altKey &&
              !e.ctrlKey &&
              !e.metaKey &&
              hoveredTaskRowId
            ) {
              const hoveredRow = Array.from(
                document.querySelectorAll("#panel-tasks .row"),
              ).find((row) => row.dataset.rowId === hoveredTaskRowId);
              const collapseButton = hoveredRow?.querySelector(
                ':scope > button[data-action="collapse"]',
              );
              if (collapseButton) {
                const isCollapsed = !!state.collapsed[hoveredTaskRowId];
                const shouldToggle =
                  e.key === "ArrowDown" ? isCollapsed : !isCollapsed;
                if (shouldToggle) toggleCollapse(hoveredTaskRowId);
                e.preventDefault();
                resetBuffer();
                return;
              }
            }
            if (e.key === "Escape" && document.getElementById("cal-popup")) {
              e.preventDefault();
              closeCalPopup();
              return;
            }
            if (e.altKey && e.ctrlKey && !e.metaKey) {
              const shortcut = e.key.toLowerCase();
              if (shortcut === "n") {
                e.preventDefault();
                toggleRootAdd("task");
                return;
              }
              if (shortcut === "p" || shortcut === "d") {
                const current = findCurrentDoingNode();
                if (!current) {
                  showToast("Chưa có task nào đang Doing");
                } else if (shortcut === "p") {
                  setPending(current.id);
                } else {
                  setDone(current.id);
                }
                e.preventDefault();
                return;
              }
            }
            if (e.metaKey || e.ctrlKey || e.altKey) return;
            const key = e.key.toLowerCase();
            if (!/^[a-z0-9]$/.test(key)) return;

            keyBuffer = (keyBuffer + key).slice(-2);
            if (bufferTimer) clearTimeout(bufferTimer);
            bufferTimer = setTimeout(resetBuffer, 800);

            if (keyBuffer === "p1" || keyBuffer === "d1") {
              e.preventDefault();
              const n = findCurrentDoingNode();
              if (n) {
                if (keyBuffer === "p1") setPending(n.id);
                else setDone(n.id);
              } else showToast("Chưa có task nào đang Doing");
              resetBuffer();
            }
          });
        })();

        (function setupMusicBarControls() {
          const prevBtn = document.getElementById("music-bar-prev");
          const nextBtn = document.getElementById("music-bar-next");
          const playPauseBtn = document.getElementById("music-bar-playpause");
          const expandBtn = document.getElementById("music-bar-expand");
          const closeBtn = document.getElementById("music-bar-close");
          if (prevBtn) prevBtn.addEventListener("click", () => playAdjacentTrack(-1));
          if (nextBtn) nextBtn.addEventListener("click", () => playAdjacentTrack(1));
          if (playPauseBtn)
            playPauseBtn.addEventListener("click", () => toggleMusicPlayPause());
          if (expandBtn)
            expandBtn.addEventListener("click", () => toggleMusicPlayerExpanded());
          if (closeBtn)
            closeBtn.addEventListener("click", () => {
              stopMusicPlayback();
              render();
            });
        })();

        document.addEventListener("fullscreenchange", () => {
          if (activeTab === "mindmap")
            requestAnimationFrame(() => fitMindmapToViewport(false));
        });

        let mindmapResizeFrame = 0;
        window.addEventListener("resize", () => {
          if (activeTab !== "mindmap") return;
          cancelAnimationFrame(mindmapResizeFrame);
          mindmapResizeFrame = requestAnimationFrame(() =>
            fitMindmapToViewport(false),
          );
        });

        // Haravan phục vụ asset qua CDN; không đăng ký service worker từ theme
        // vì service worker yêu cầu tệp cùng origin với storefront.

        (async function init() {
          await loadState();
          ensureMindmapState();
          ensureDayTasks();
          loadTaskViewFilters();
          render();
          startTicking();
          startPomodoroTicking();
        })();
      })();
</script>
