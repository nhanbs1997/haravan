        function deleteNode(id) {
          const target = findNodeAny(id);
          if (isPinnedTodayTask(target)) {
            showToast(`${pinnedDayTaskLabel(target)} là task cố định và không thể xoá`);
            return;
          }
          const parent = findParentNodeAny(id);
          const syncKeysToRemove = collectSyncKeysDeep(target, new Set());
          const removed = removeNodeAny(id);
          if (!removed) return;
          const idsToRemove = collectIdsDeep(removed, []);
          const idSet = new Set(idsToRemove);
          // Xoá luôn các sự kiện (timeline/đồng hồ) gắn với task này và các task con
          state.events = state.events.filter((e) => !idSet.has(e.taskId));
          // Xoá luôn khỏi Lịch sử hoàn thành
          if (state.completedArchive) {
            Object.keys(state.completedArchive).forEach((dk) => {
              state.completedArchive[dk] = state.completedArchive[dk].filter(
                (it) => !idSet.has(it.taskId),
              );
              if (state.completedArchive[dk].length === 0)
                delete state.completedArchive[dk];
            });
          }
          idsToRemove.forEach((rid) => {
            delete state.collapsed[rid];
          });

          if (!state.trash) state.trash = [];
          state.trash.unshift({
            id: genId("trash"),
            node: removed,
            parentId: parent ? parent.id : null,
            deletedAt: Date.now(),
          });
          if (state.trash.length > 50) state.trash.length = 50; // giới hạn thùng rác

          removeMindmapLinksForSyncKeys(syncKeysToRemove);

