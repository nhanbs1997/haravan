/* Lịch sử hoàn thành nhanh trong tab Công việc */
#app .task-completion-history {
  margin-top: 16px;
  overflow: hidden;
  border: 1px solid var(--ui-line);
  border-radius: 14px;
  background: var(--ui-surface);
}
#app .task-completion-history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--ui-line);
  background: linear-gradient(90deg, rgba(32, 216, 139, 0.1), transparent 68%);
}
#app .task-completion-history-heading {
  min-width: 0;
}
#app .task-completion-history-title {
  color: var(--ui-ink);
  font-size: 14px;
  font-weight: 700;
}
#app .task-completion-history-subtitle {
  margin-top: 3px;
  color: var(--ui-muted);
  font-size: 11px;
}
#app .task-completion-history-controls {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
  flex-wrap: wrap;
}
#app button.task-completion-history-nav,
#app button.task-completion-history-today {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28px;
  min-height: 28px;
  padding: 4px 8px;
  border: 1px solid var(--ui-line);
  border-radius: 7px;
  background: var(--ui-surface-soft);
  color: var(--ui-ink);
  font-size: 12px;
  line-height: 1;
}
#app button.task-completion-history-nav:hover,
#app button.task-completion-history-today:hover {
  border-color: var(--ui-line-strong);
  background: color-mix(in srgb, var(--ui-green) 16%, var(--ui-surface-soft));
}
#app .task-completion-history-date {
  min-height: 28px;
  padding: 4px 7px;
  border: 1px solid var(--ui-line);
  border-radius: 7px;
  background: var(--ui-surface-soft);
  color: var(--ui-ink);
  font: inherit;
  font-size: 12px;
}
#app .task-completion-history-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 10px;
}
#app .task-completion-history-period {
  --history-period-color: #8fa8d5;
  --history-period-surface: rgba(143, 168, 213, 0.08);
  --history-period-line: rgba(143, 168, 213, 0.32);
  overflow: hidden;
  border: 1px solid var(--history-period-line);
  border-radius: 10px;
  background: color-mix(in srgb, var(--history-period-surface) 72%, var(--ui-surface));
}
#app .task-completion-history-period-morning {
  --history-period-color: #20d88b;
  --history-period-surface: rgba(32, 216, 139, 0.1);
  --history-period-line: rgba(32, 216, 139, 0.36);
}
#app .task-completion-history-period-afternoon {
  --history-period-color: #ffb347;
  --history-period-surface: rgba(255, 179, 71, 0.1);
  --history-period-line: rgba(255, 179, 71, 0.38);
}
#app .task-completion-history-period-evening {
  --history-period-color: #a78bfa;
  --history-period-surface: rgba(167, 139, 250, 0.11);
  --history-period-line: rgba(167, 139, 250, 0.4);
}
#app .task-completion-history-period-night {
  --history-period-color: #73a7ff;
  --history-period-surface: rgba(115, 167, 255, 0.09);
  --history-period-line: rgba(115, 167, 255, 0.34);
}
#app .task-completion-history-period-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
  padding: 9px 10px;
  border-left: 4px solid var(--history-period-color);
  background: var(--history-period-surface);
}
#app .task-completion-history-period-title {
  color: var(--history-period-color);
  font-size: 13px;
  font-weight: 800;
}
#app .task-completion-history-period-meta {
  color: var(--ui-muted);
  font-size: 10px;
  font-variant-numeric: tabular-nums;
}
#app .task-completion-history-hours {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 8px;
}
#app .task-completion-history-hour {
  overflow: hidden;
  border: 1px solid color-mix(in srgb, var(--history-period-color) 30%, var(--ui-line));
  border-radius: 8px;
  background: color-mix(in srgb, var(--history-period-surface) 46%, var(--ui-surface-soft));
}
#app .task-completion-history-hour-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
  padding: 5px 8px;
  border-bottom: 1px solid color-mix(in srgb, var(--history-period-color) 22%, var(--ui-line));
  color: var(--history-period-color);
  font-size: 10px;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}
#app .task-completion-history-hour-count {
  color: var(--ui-muted);
  font-weight: 600;
}
#app .task-completion-history-hour-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 4px;
}
#app .task-completion-history-period-empty {
  padding: 8px;
  color: var(--ui-muted);
  font-size: 11px;
}
#app .task-completion-history-item {
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr);
  align-items: center;
  gap: 10px;
  min-height: 34px;
  padding: 6px 9px;
  border-radius: 8px;
  background: color-mix(in srgb, var(--ui-surface-soft) 72%, transparent);
}
#app .task-completion-history-item:hover {
  background: color-mix(in srgb, var(--ui-green) 10%, var(--ui-surface-soft));
}
#app .task-completion-history-time {
  color: var(--ui-green);
  font-size: 12px;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}
#app .task-completion-history-text {
  min-width: 0;
  overflow-wrap: anywhere;
  color: var(--ui-ink);
  font-size: 13px;
}
#app .task-completion-history-empty {
  padding: 14px 10px;
  color: var(--ui-muted);
  font-size: 12px;
  text-align: center;
}
@media (max-width: 640px) {
  #app .task-completion-history-header {
    align-items: flex-start;
    flex-direction: column;
  }
  #app .task-completion-history-controls {
    width: 100%;
    justify-content: flex-start;
  }
}

