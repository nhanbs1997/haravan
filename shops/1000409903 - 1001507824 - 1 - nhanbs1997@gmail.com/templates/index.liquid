#app .row.done:hover {
  background: color-mix(in srgb, var(--task-branch-color, var(--pomo-short-break)) 22%, var(--ui-surface-soft));
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--task-branch-color, var(--pomo-short-break)) 62%, transparent)
  , 0 5px 16px rgba(0, 0, 0, 0.2);
}

#app .row.task-selected,
#app .row.task-selected:hover {
  background: linear-gradient(90deg, rgba(43, 140, 255, 0.24), rgba(117, 70, 232, 0.16));
  box-shadow: 0 0 0 2px rgba(105, 178, 255, 0.78) inset
  , 0 0 18px rgba(43, 140, 255, 0.2);
  filter: none;
}

#app .row.task-selected > .label {
  color: #fff;
}

#app .row {
  position: relative;
  overflow: visible;
  padding: 0;
  border: 0;
  border-bottom: 0;
  border-image: none;
  border-radius: 0;
}

#app .row.kienthuc {
  border-bottom: 0;
  border-image: none;
}

#app .row > .task-child-count {
  min-width: 0;
  height: auto;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--task-branch-color, var(--active-accent));
  font-size: 12px;
  line-height: 1;
}

#app .row > .toggle-btn:not(.leaf),
#app .row > .task-child-count {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
}

#app .row > .toggle-btn:not(.leaf) {
  left: calc(100% + 6px);
  margin: 0;
  color: var(--task-branch-color, var(--active-accent));
}

#app .row > .task-child-count {
  left: calc(100% + 34px);
}

#app .row.done > .label {
  color: var(--task-branch-color, var(--active-accent));
}


/*
   Task updates replace only the visual state in a short view transition so
   the workspace never appears to reload or flash between interactions.
*/
#app {
  view-transition-name: todolist-app;
}

::view-transition-old(todolist-app),
::view-transition-new(todolist-app) {
  animation-duration: 120ms;
  animation-timing-function: ease-out;
}

.command-palette-backdrop {
  position: fixed;
  z-index: 13000;
  inset: 0;
  display: grid;
  align-items: start;
  justify-items: center;
  padding: min(12vh, 120px) 18px 18px;
  background: rgba(1, 5, 15, 0.76);
  backdrop-filter: blur(10px);
}

.command-palette {
  width: min(680px, 100%);
  overflow: hidden;
  border: 1px solid rgba(125, 164, 231, 0.34);
  border-radius: 16px;
  background: linear-gradient(145deg, #0d1a30, #050c19);
  box-shadow: 0 28px 80px rgba(0, 0, 0, 0.58);
}

.command-palette-search {
  width: 100%;
  height: 54px;
  padding: 0 16px;
