/* ---------- Branch-Colored Task Checkbox ---------- */


/*
   The theme has broad #app button rules; keep this component-specific
   selector stronger so every task checkbox follows its branch color.
*/#app button.task-checkbox {
  --checkbox-color: var(--task-branch-color, var(--active-accent));
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  min-width: 22px;
  min-height: 22px;
  margin-right: 8px;
  padding: 0;
  border: 2px solid var(--checkbox-color);
  border-radius: 6px;
  background: color-mix(in srgb, var(--checkbox-color) 12%, transparent);
  color: #ffffff;
  font-size: 13px;
  font-weight: 900;
  line-height: 1;
  cursor: pointer;
  flex-shrink: 0;
  transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 2px 6px color-mix(in srgb, var(--checkbox-color) 22%, transparent);
  user-select: none;
}
#app button.task-checkbox:hover {
  transform: scale(1.08);
  border-color: var(--checkbox-color);
  background: color-mix(in srgb, var(--checkbox-color) 28%, transparent);
  box-shadow: 0 0 14px color-mix(in srgb, var(--checkbox-color) 58%, transparent)
  , 0 2px 8px rgba(0, 0, 0, 0.4);
}
#app button.task-checkbox:active:not(:disabled) {
  transform: scale(0.94);
  background: color-mix(in srgb, var(--checkbox-color) 34%, transparent);
  color: #ffffff;
}
#app button.task-checkbox:focus-visible {
  outline: 2px solid var(--checkbox-color);
  outline-offset: 3px;
}
#app button.task-checkbox.is-checked {
  border-color: var(--checkbox-color);
  background: transparent;
  color: var(--checkbox-color);
  box-shadow: 0 2px 0 color-mix(in srgb, var(--checkbox-color) 68%, #000)
  , 0 0 12px color-mix(in srgb, var(--checkbox-color) 55%, transparent);
  animation: checkBounce 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
#app button.task-checkbox.is-checked:active:not(:disabled) {
  background: transparent;
  color: var(--checkbox-color);
  box-shadow: 0 1px 0 color-mix(in srgb, var(--checkbox-color) 68%, #000)
  , 0 0 10px color-mix(in srgb, var(--checkbox-color) 55%, transparent);
}
.task-checkbox.is-checked::after {
  content: "✓";
  font-size: 14px;
  font-weight: 900;
  line-height: 1;
  color: var(--checkbox-color);
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
}
#app .row .task-checkbox::after {
  content: "";
}
#app .row.done .task-checkbox::after {
  content: "✓";
}
#app button.task-checkbox.is-partial {
  border-color: var(--checkbox-color);
  background: color-mix(in srgb, var(--checkbox-color) 18%, transparent);
}
.task-checkbox.is-partial::after {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 2px;
  background: var(--checkbox-color);
  box-shadow: 0 0 6px var(--checkbox-color);
}
@keyframes checkBounce {
  0% {
    transform: scale(0.7);
  }
  50% {
    transform: scale(1.28) rotate(-6deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
  }
}
.task-checkbox-ripple {
  position: absolute;
  inset: -6px;
  border-radius: 12px;
  border: 2px solid var(--checkbox-color, var(--task-branch-color, var(--active-accent)));
  pointer-events: none;
  animation: checkboxRipple 0.45s ease-out forwards;
}
@keyframes checkboxRipple {
  0% {
    transform: scale(0.8);
    opacity: 1;
  }
  100% {
    transform: scale(1.8);
    opacity: 0;
  }
}
