        function canCreateTaskFromActiveTab() {
          if (activeTab === "tasks") return true;
          showToast("Hãy mở Tab Công việc để thêm task.");
          return false;
        }

        function addTopLevel(text, kind = "task") {
          if (!text || !text.trim()) return false;
          const nodeKind = kind === "kienthuc" ? "kienthuc" : "task";
          if (nodeKind === "task" && !canCreateTaskFromActiveTab()) return false;
          const parts = text
            .split(";")
            .map((t) => t.trim())
            .filter((t) => t.length > 0);
          if (parts.length === 0) return false;
          parts.forEach((p) => {
            const node = newNode(p);
            node.kind = nodeKind;
            alphaInsert(state.tasks, node);
            if (node.kind === "task") linkTaskTreeToMindmap(node, null);
          });
          renderWithoutFlicker();
          scheduleAutoExport();
          return true;
        }
        function addChild(parentId, text) {
          if (!text || !text.trim()) return false;
          const parent = findNodeAny(parentId);
          if (!parent) return false;
          if (parent.kind !== "kienthuc" && !canCreateTaskFromActiveTab()) return false;
          const parts = text
            .split(";")
            .map((t) => t.trim())
            .filter((t) => t.length > 0);
          if (parts.length === 0) return false;
          const existingTexts = new Set(
            parent.children.map((c) => c.text.trim().toLowerCase()),
          );
          const seen = new Set();
          const newParts = parts.filter((p) => {
            const key = p.toLowerCase();
            if (existingTexts.has(key) || seen.has(key)) return false;
            seen.add(key);
            return true;
          });
          if (newParts.length === 0) return false;
          newParts.forEach((p) => {
            const child = newNode(p);
            if (parent.kind === "kienthuc") child.kind = "kienthuc";
            alphaInsert(parent.children, child);
            if (child.kind === "task") linkTaskTreeToMindmap(child, parent);
          });
          state.collapsed[parentId] = false;
          renderWithoutFlicker();
          scheduleAutoExport();
          return true;
        }
        function addSibling(nodeId, text) {
          if (!text || !text.trim()) return false;
          const node = findNodeAny(nodeId);
          if (!node || node._pinned) return false;
          if (node.kind !== "kienthuc" && !canCreateTaskFromActiveTab()) return false;
          const siblings = findParentListAny(nodeId);
          if (!siblings) return false;
          const parts = text
            .split(";")
            .map((t) => t.trim())
            .filter((t) => t.length > 0);
          if (parts.length === 0) return false;
          const existingTexts = new Set(
            siblings.map((sibling) => sibling.text.trim().toLowerCase()),
          );
          const seen = new Set();
          const newParts = parts.filter((part) => {
            const key = part.toLowerCase();
            if (existingTexts.has(key) || seen.has(key)) return false;
            seen.add(key);
            return true;
          });
          if (newParts.length === 0) return false;
          const parent = findParentNodeAny(nodeId);
          newParts.forEach((part) => {
            const sibling = newNode(part);
            sibling.kind = node.kind;
            alphaInsert(siblings, sibling);
            if (sibling.kind === "task")
              linkTaskTreeToMindmap(sibling, parent);
          });
          renderWithoutFlicker();
          scheduleAutoExport();
          return true;
        }
