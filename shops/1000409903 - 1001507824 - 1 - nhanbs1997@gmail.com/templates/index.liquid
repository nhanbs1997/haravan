        function prefixLiquidSettingsForLayout(liquid, prefix) {
          let output = String(liquid || "");

          // settings['key'] / settings["key"] -> settings.1key.
          // Biến động như settings[link] được giữ nguyên.
          output = output.replace(
            /(\bsettings)\s*\[\s*(["'])([^"']+)\2\s*\]/gi,
            (matched, settingsName, quote, key) =>
              `${settingsName}.${prefix}${key}`,
          );

          // settings.key -> settings.1key. Khóa bắt đầu bằng số vừa chuyển đổi
          // ở bước trên không khớp regex này nên không bị thêm tiền tố hai lần.
          output = output.replace(
            /(\bsettings)\s*\.\s*([a-z_][a-z0-9_]*)/gi,
            (matched, settingsName, key) =>
              `${settingsName}.${prefix}${key}`,
          );

          // Tên asset tĩnh dùng với asset_url cũng được thêm tiền tố layout.
          // Biểu thức asset động được giữ nguyên để không làm thay đổi logic Liquid.
          output = output.replace(
            /(\x7b\x7b\s*)(["'])([^"']+)\2(\s*\|\s*asset_url\b)/gi,
            (matched, openTag, quote, assetName, assetFilter) =>
              `${openTag}${quote}${prefix}${assetName}${quote}${assetFilter}`,
          );

          // Các capture dạng khóa setting/asset được thêm tiền tố nhưng tên
          // biến capture vẫn giữ nguyên để settings[use], settings[link] chạy đúng.
          output = output.replace(
            /(\x7b\x25-?\s*capture\s+[^%]*?-?%\x7d)([\s\S]*?)(\x7b\x25-?\s*endcapture\s*-?%\x7d)/gi,
            (matched, startTag, body, endTag) => {
              const leading = (body.match(/^\s*/) || [""])[0];
              const trailing = (body.match(/\s*$/) || [""])[0];
              const core = body.slice(
                leading.length,
                body.length - trailing.length,
              );
              if (!core || !/^[a-z_][^\s<>]*$/i.test(core)) return matched;
              return `${startTag}${leading}${prefix}${core}${trailing}${endTag}`;
            },
          );
          return output;
        }
        function prefixSettingMarkupForLayout(setting, prefix) {
          let output = String(setting || "");

          // name="key" -> name="1key"; giữ nguyên value và các số item con.
          output = output.replace(
            /(\bname\s*=\s*)(["'])([^"']*)\2/gi,
            (matched, head, quote, key) =>
              `${head}${quote}${prefix}${key}${quote}`,
          );

          // <legend>10. Chính sách</legend> -> ... Chính sách 1
          output = output.replace(
            /(<legend\b[^>]*>)([\s\S]*?)(<\/legend\s*>)/gi,
            (matched, startTag, body, endTag) => {
              const leading = (body.match(/^\s*/) || [""])[0];
              const trailing = (body.match(/\s*$/) || [""])[0];
              const core = body.trim();
              if (!core) return matched;
              return `${startTag}${leading}${core} ${prefix}${trailing}${endTag}`;
            },
          );
          return output;
        }

        function generateHaravanDoubleLayout(liquid, setting, count) {
          const cleanLiquid = String(liquid || "").trim();
