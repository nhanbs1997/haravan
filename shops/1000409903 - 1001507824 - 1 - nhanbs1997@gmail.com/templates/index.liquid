        function musicMatchesActiveCategory(item) {
          if (activeMusicCategoryId === "all") return true;
          if (activeMusicCategoryId === "uncategorized") return !item.categoryId;
          return item.categoryId === activeMusicCategoryId;
        }
        function filteredSortedMusicList() {
          return sortedMusicList().filter(musicMatchesActiveCategory);
        }
        function setMusicPlaybackMode(mode) {
          const supportedModes = [
            "repeat-one",
            "repeat-category",
            "shuffle-category",
          ];
          if (!supportedModes.includes(mode)) return;
          musicPlaybackMode = musicPlaybackMode === mode ? "normal" : mode;
          render();
        }
        function getCurrentMusicCategoryList() {
          const current = (state.music || []).find(
            (item) => item.id === nowPlayingMusicId,
          );
          if (!current) return [];
          return sortedMusicList().filter(
            (item) => item.categoryId === current.categoryId,
          );
        }
        function playTrackAfterEnd() {
          if (!nowPlayingMusicId) return;
          if (musicPlaybackMode === "repeat-one") {
            playMusicById(nowPlayingMusicId);
            return;
          }
          if (
            musicPlaybackMode === "repeat-category" ||
            musicPlaybackMode === "shuffle-category"
          ) {
            const categoryTracks = getCurrentMusicCategoryList();
            if (!categoryTracks.length) return;
            if (musicPlaybackMode === "shuffle-category") {
              const choices = categoryTracks.filter(
                (item) => item.id !== nowPlayingMusicId,
              );
              const next = choices.length
                ? choices[Math.floor(Math.random() * choices.length)]
                : categoryTracks[0];
              playMusicById(next.id);
              return;
            }
            const currentIndex = categoryTracks.findIndex(
              (item) => item.id === nowPlayingMusicId,
            );
            const nextIndex =
              currentIndex === -1
                ? 0
                : (currentIndex + 1) % categoryTracks.length;
            playMusicById(categoryTracks[nextIndex].id);
            return;
          }
          playAdjacentTrack(1);
        }
        async function addMusicByUrl(rawUrl, categoryId) {
          const url = String(rawUrl || "").trim();
          if (!url) return;
          const videoId = extractYouTubeId(url);
          if (!videoId) {
            showToast("Không nhận ra link YouTube, kiểm tra lại nhé");
            return;
          }
          if (!state.music) state.music = [];
          if (state.music.some((m) => m.videoId === videoId)) {
            showToast("Bài này đã có trong danh sách rồi");
            return;
          }
          const item = {
            id: genId("mu"),
            url,
            videoId,
            title: "Đang tải tiêu đề...",
            categoryId: (state.musicCategories || []).some(
              (category) => category.id === categoryId,
            )
              ? categoryId
              : null,
          };
          state.music.push(item);
          render();
          try {
            const oembedUrl = `https://www.youtube.com/oembed?url=${encodeURIComponent(
              `https://www.youtube.com/watch?v=${videoId}`,
            )}&format=json`;
            const res = await fetch(oembedUrl);
            if (res.ok) {
              const data = await res.json();
              if (item.title === "Đang tải tiêu đề...") {
                item.title = data.title || "(Không có tiêu đề)";
              }
            } else {
              if (item.title === "Đang tải tiêu đề...") {
                item.title = "(Không lấy được tiêu đề)";
              }
            }
          } catch (e) {
            console.error("Lấy tiêu đề YouTube lỗi", e);
            if (item.title === "Đang tải tiêu đề...") {
              item.title = "(Không lấy được tiêu đề)";
            }
          }
          render();
          scheduleAutoExport();
        }
        function sortedMusicList() {
          return [...(state.music || [])].sort((a, b) =>
            a.title.localeCompare(b.title, "vi", { sensitivity: "base" }),
          );
        }
        function deleteMusicItem(id) {
          if (nowPlayingMusicId === id) {
            stopMusicPlayback();
          }
          state.music = (state.music || []).filter((m) => m.id !== id);
          render();
          scheduleAutoExport();
        }

        // ---------- YouTube IFrame Player API ----------
        // Trình phát nhạc sống ở #music-player-bar — nằm NGOÀI #app, nên khi
        // #app render() lại (thêm/sửa task...) nhạc vẫn không bị gián đoạn.
        let ytApiReady = false;
        const ytApiWaitQueue = [];
        function ensureYouTubeApi(cb) {
          if (ytApiReady && window.YT && window.YT.Player) {
            cb();
            return;
          }
          ytApiWaitQueue.push(cb);
          if (window.__ytApiLoading) return;
          window.__ytApiLoading = true;
          window.onYouTubeIframeAPIReady = function () {
            ytApiReady = true;
            ytApiWaitQueue.forEach((fn) => fn());
            ytApiWaitQueue.length = 0;
          };
          const tag = document.createElement("script");
          tag.src = "https://www.youtube.com/iframe_api";
          document.head.appendChild(tag);
        }

        function updateMusicBarUI() {
          const bar = document.getElementById("music-player-bar");
          if (!bar) return;
          const item = (state.music || []).find(
            (m) => m.id === nowPlayingMusicId,
          );
          if (!item || activeTab !== "music") {
            bar.style.display = "none";
            return;
          }
          bar.style.display = "flex";
          bar.classList.toggle("is-expanded", musicPlayerExpanded);
          const titleEl = document.getElementById("music-bar-title");
          if (titleEl) titleEl.textContent = item.title;
          const playPauseBtn = document.getElementById("music-bar-playpause");
          if (playPauseBtn) playPauseBtn.textContent = musicIsPaused ? "▶" : "⏸";
          const expandBtn = document.getElementById("music-bar-expand");
          if (expandBtn) {
            expandBtn.textContent = musicPlayerExpanded ? "↙" : "⛶";
            expandBtn.title = musicPlayerExpanded ? "Thu nhỏ video" : "Phóng to video";
            expandBtn.setAttribute(
              "aria-label",
              musicPlayerExpanded ? "Thu nhỏ video đang phát" : "Phóng to video đang phát",
            );
            expandBtn.setAttribute("aria-pressed", String(musicPlayerExpanded));
          }
        }

        function updateMusicListPlaybackUI() {
          document
            .querySelectorAll('.music-item-row[data-action="toggle-music"]')
            .forEach((row) => {
              const isPlaying = row.dataset.id === nowPlayingMusicId;
              const item = row.closest(".music-item");
              const title = row.querySelector(".music-title");
              const titleText = title?.textContent?.trim() || "bài nhạc";
              const badge = row.querySelector(".music-now-playing-badge");

              if (item) item.classList.toggle("is-playing", isPlaying);
              row.setAttribute(
                "aria-label",
                `${isPlaying ? "Dừng" : "Phát"} bài ${titleText}`,
              );
              if (isPlaying) {
                const activeBadge = badge || document.createElement("span");
                activeBadge.className = "music-now-playing-badge";
                activeBadge.textContent = musicIsPaused ? "⏸ đang phát" : "▶ đang phát";
                if (!badge && title)
                  title.insertAdjacentElement("afterend", activeBadge);
              } else if (badge) {
                badge.remove();
              }
            });
        }

        function toggleMusicPlayerExpanded() {
          if (!nowPlayingMusicId) return;
          musicPlayerExpanded = !musicPlayerExpanded;
          updateMusicBarUI();
        }

        function playMusicById(id) {
          const item = (state.music || []).find((m) => m.id === id);
          if (!item) return;
          nowPlayingMusicId = id;
          musicIsPaused = false;
          updateMusicBarUI();
          updateMusicListPlaybackUI();
          ensureYouTubeApi(() => {
            const slot = document.getElementById("music-player-slot");
            if (!slot) return;
            if (ytPlayer && typeof ytPlayer.loadVideoById === "function") {
              ytPlayer.loadVideoById(item.videoId);
            } else {
              ytPlayer = new YT.Player(slot, {
                height: "68",
                width: "120",
                videoId: item.videoId,
                playerVars: { autoplay: 1 },
                events: {
                  onReady: (e) => {
                    try {
                      e.target.playVideo();
                    } catch (err) {}
                  },
                  onStateChange: handleYtStateChange,
                },
              });
            }
          });
        }
        function handleYtStateChange(e) {
          if (!window.YT) return;
          if (e.data === YT.PlayerState.ENDED) {
            playTrackAfterEnd();
          } else if (e.data === YT.PlayerState.PLAYING) {
            musicIsPaused = false;
            updateMusicBarUI();
            updateMusicListPlaybackUI();
          } else if (e.data === YT.PlayerState.PAUSED) {
            musicIsPaused = true;
            updateMusicBarUI();
            updateMusicListPlaybackUI();
          }
        }
        function stopMusicPlayback() {
          if (ytPlayer) {
            try {
              ytPlayer.destroy();
            } catch (e) {}
            ytPlayer = null;
          }
          nowPlayingMusicId = null;
          musicIsPaused = false;
          musicPlayerExpanded = false;
          updateMusicBarUI();
          updateMusicListPlaybackUI();
        }
        function toggleMusicPlayPause() {
          if (!ytPlayer) return;
          try {
            if (musicIsPaused) ytPlayer.playVideo();
            else ytPlayer.pauseVideo();
          } catch (e) {}
        }
        function playAdjacentTrack(delta) {
          const sorted = sortedMusicList();
          if (!sorted.length) return;
          const idx = sorted.findIndex((m) => m.id === nowPlayingMusicId);
          const nextIdx =
            idx === -1 ? 0 : (idx + delta + sorted.length) % sorted.length;
          playMusicById(sorted[nextIdx].id);
        }
        // Bấm vào 1 dòng trong danh sách: đang phát bài đó thì dừng, chưa thì phát.
        function toggleMusicPlayer(id) {
          if (nowPlayingMusicId === id) {
            stopMusicPlayback();
            return;
          }
          playMusicById(id);
        }

        function toggleNodeKind(id) {
          const n = findNodeAny(id);
          if (!n) return;
          n.kind = n.kind === "kienthuc" ? "task" : "kienthuc";
          // Kiến thức thì không cần trạng thái Doing/Pending nữa
          if (n.kind === "kienthuc" && n.status === "doing") {
            stopDoingNode(n);
          }
          if (n.kind === "kienthuc" && n.status === "pending") {
            n.status = "todo";
          }
          renderWithoutFlicker();
          scheduleAutoExport();
        }

        // Cho phép HTML do người dùng chèn, nhưng chặn mã có thể chạy trong trang.
        // Vẫn giữ lại các định dạng phổ biến: tiêu đề, bảng, ảnh, link, blockquote, pre...
        function sanitizeNoteHtml(html) {
          const box = document.createElement("div");
          box.innerHTML = String(html || "");
          box
            .querySelectorAll(
              "script, style, object, embed, base, form, input, button, textarea, frame, frameset, iframe",
            )
            .forEach((el) => el.remove());
          box.querySelectorAll("*").forEach((el) => {
            Array.from(el.attributes).forEach((attr) => {
              const name = attr.name.toLowerCase();
              const value = String(attr.value || "").trim();
              if (
                name.startsWith("on") ||
                (name === "style" && /(?:expression\s*\(|javascript\s*:)/i.test(value)) ||
                ((name === "href" || name === "src" || name === "xlink:href") &&
                  /^javascript:/i.test(value))
              ) {
                el.removeAttribute(attr.name);
              }
            });

            // Liên kết trong ghi chú luôn mở ở tab mới, kể cả khi được dán từ nơi khác.
            if (el.tagName === "A") {
              const href = String(el.getAttribute("href") || "").trim();
              if (href) {
                el.setAttribute("target", "_blank");
                el.setAttribute("rel", "noopener noreferrer");
              } else {
                el.removeAttribute("target");
                el.removeAttribute("rel");
              }
            }
          });
          return box.innerHTML;
        }

        function noteContentInfo(html) {
          const source = String(html || "").trim();
          if (!source) return null;
          const text = source
            .replace(/<br\s*\/?>(\s*)/gi, " ")
            .replace(/<[^>]*>/g, " ")
            .replace(/&nbsp;/gi, " ")
            .replace(/&amp;/gi, "&")
            .replace(/&lt;/gi, "<")
            .replace(/&gt;/gi, ">")
            .replace(/&quot;/gi, '"')
            .replace(/\s+/g, " ")
            .trim();
          const hasEmbeddedContent = /<(img|table|audio|video)\b/i.test(source);
          if (!text && !hasEmbeddedContent) return null;
          let bytes = 0;
          try {
            bytes = new TextEncoder().encode(source).length;
          } catch (e) {
            bytes = unescape(encodeURIComponent(source)).length;
          }
          return { bytes, characters: Array.from(text).length };
        }

        function formatNoteSize(bytes) {
          if (bytes < 1024) return `${bytes} B`;
          return `${(bytes / 1024).toFixed(bytes < 10240 ? 1 : 0)} KB`;
        }

        // Nút Note giữ icon cố định; việc ẩn/hiện theo nội dung xử lý bằng CSS
        // qua lớp .is-empty nên desktop vẫn ẩn nút khi task chưa có nội dung,
        // còn mobile luôn mở được editor để thêm note.
        function noteContentLabel(info) {
          return "📝";
        }

        function noteContentTitle(info) {
          if (!info) return "Chưa có nội dung";
          const characterLabel = info.characters
            ? ` · ${info.characters} ký tự`
            : " · có tệp/ảnh";
          return `Có nội dung · ${formatNoteSize(info.bytes)}${characterLabel}`;
        }

        function updateNoteContentInfo(id) {
          const node = findNodeAny(id);
          const info = node ? noteContentInfo(node.note) : null;
          const label = noteContentLabel(info);
          const title = noteContentTitle(info);
          document
            .querySelectorAll(`[data-note-info-for="${id}"]`)
            .forEach((el) => {
              el.textContent = label;
              el.title = title;
              el.classList.toggle("is-empty", !info);
            });
        }

        // Lưu nội dung ghi chú (HTML: văn bản định dạng + ảnh) của một task.
        // Không gọi render() để tránh làm mất con trỏ / nội dung đang gõ dở.
        function saveNodeNote(id, html) {
          const n = findNodeAny(id);
          if (!n) return;
          n.note = sanitizeNoteHtml(html);
          updateNoteContentInfo(id);
          scheduleAutoExport();
        }

        function getNoteElements(id) {
          return {
            editor: document.querySelector(`[data-note-editor="${id}"]`),
            source: document.querySelector(`[data-note-source="${id}"]`),
            sourceButton: document.querySelector(
              `[data-note-action="toggle-source"][data-id="${id}"]`,
            ),
          };
        }

        // Các input native (màu/cỡ chữ) có thể làm mất focus; lưu lại vùng đang chọn
        // để định dạng vẫn được áp dụng đúng đoạn văn bản người dùng bôi đen.
        const noteSelectionRanges = new Map();

        function rememberNoteSelection(id, editor) {
          const selection = window.getSelection && window.getSelection();
          if (!selection || !selection.rangeCount) return;
          const range = selection.getRangeAt(0);
          if (editor && editor.contains(range.commonAncestorContainer)) {
            noteSelectionRanges.set(id, range.cloneRange());
          }
        }

        function restoreNoteSelection(id, editor) {
          const range = noteSelectionRanges.get(id);
          if (!range || !editor) return;
          try {
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
          } catch (e) {
            noteSelectionRanges.delete(id);
          }
        }

        function applyNoteCommand(id, cmd, value) {
          const { editor, source } = getNoteElements(id);
          if (!editor) return;
          if (source && source.style.display !== "none") {
            showToast("Hãy chuyển khỏi chế độ HTML để dùng công cụ định dạng");
            return;
          }
          restoreNoteSelection(id, editor);
          editor.focus();
          try {
            if (cmd.startsWith("formatBlock:")) {
              document.execCommand("formatBlock", false, cmd.split(":")[1]);
            } else {
              document.execCommand(cmd, false, value || null);
            }
          } catch (e) {}
          rememberNoteSelection(id, editor);
          saveNodeNote(id, editor.innerHTML);
        }

        function insertHtmlIntoNote(id, html) {
          const { editor, source } = getNoteElements(id);
          if (!editor || !source) return;
          if (source.style.display !== "none") {
            const start = Number.isInteger(source.selectionStart)
              ? source.selectionStart
              : source.value.length;
            const end = Number.isInteger(source.selectionEnd)
              ? source.selectionEnd
              : start;
            source.setRangeText(html, start, end, "end");
            source.focus();
            saveNodeNote(id, source.value);
            return;
          }
          editor.focus();
          try {
            document.execCommand("insertHTML", false, html);
          } catch (e) {
            editor.insertAdjacentHTML("beforeend", html);
          }
          saveNodeNote(id, editor.innerHTML);
        }

        function moveCaretAfterCodeBlock(editor) {
          const selection = window.getSelection();
          if (!selection || selection.rangeCount === 0) return false;
          const range = selection.getRangeAt(0);
          if (!range.collapsed || !editor.contains(range.startContainer))
            return false;
          const startElement =
            range.startContainer.nodeType === Node.ELEMENT_NODE
              ? range.startContainer
              : range.startContainer.parentElement;
          const codeBlock = startElement?.closest("pre");
          if (!codeBlock || !editor.contains(codeBlock)) return false;

          const codeEnd = document.createRange();
          codeEnd.selectNodeContents(codeBlock);
          codeEnd.collapse(false);
          if (
            range.compareBoundaryPoints(Range.END_TO_END, codeEnd) !== 0
          )
            return false;

          const newLine = document.createElement("p");
          newLine.appendChild(document.createElement("br"));
          codeBlock.insertAdjacentElement("afterend", newLine);
          const newRange = document.createRange();
          newRange.setStart(newLine, 0);
          newRange.collapse(true);
          selection.removeAllRanges();
          selection.addRange(newRange);
          return true;
        }

        function toggleNoteSource(id) {
          const { editor, source, sourceButton } = getNoteElements(id);
          if (!editor || !source) return;
          const opening = source.style.display === "none";
          if (opening) {
            source.value = editor.innerHTML;
            editor.style.display = "none";
            source.style.display = "block";
            source.focus();
          } else {
            const safeHtml = sanitizeNoteHtml(source.value);
            editor.innerHTML = safeHtml;
            source.style.display = "none";
            editor.style.display = "block";
            editor.focus();
            saveNodeNote(id, safeHtml);
          }
          if (sourceButton) {
            sourceButton.classList.toggle("active", opening);
            sourceButton.setAttribute("aria-pressed", String(opening));
          }
        }

        function isAllowedNoteUrl(value, allowDataImage) {
          try {
            const url = new URL(value, window.location.href);
            return (
              url.protocol === "https:" ||
              url.protocol === "http:" ||
              (allowDataImage && /^data:image\//i.test(value))
            );
          } catch (e) {
            return false;
          }
        }

        function escapeNoteAttribute(value) {
          return String(value)
            .replace(/&/g, "&amp;")
            .replace(/"/g, "&quot;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
        }

        function insertNoteLink(id) {
          const url = window.prompt("Dán liên kết (https://...)");
          if (!url) return;
          if (!isAllowedNoteUrl(url, false)) {
            showToast("Liên kết cần bắt đầu bằng http:// hoặc https://");
            return;
          }
          const safeUrl = escapeNoteAttribute(url);
          const { editor, source } = getNoteElements(id);
          if (source && source.style.display !== "none") {
            insertHtmlIntoNote(id, `<a href="${safeUrl}" target="_blank" rel="noopener noreferrer">${safeUrl}</a>`);
            return;
          }
          if (!editor) return;
          editor.focus();
          const selected = window.getSelection && window.getSelection().toString();
          if (!selected) {
            insertHtmlIntoNote(id, `<a href="${safeUrl}" target="_blank" rel="noopener noreferrer">${safeUrl}</a>`);
            return;
          }
          try {
            document.execCommand("createLink", false, url);
          } catch (e) {
            insertHtmlIntoNote(id, `<a href="${safeUrl}" target="_blank" rel="noopener noreferrer">${safeUrl}</a>`);
            return;
          }
          editor.querySelectorAll("a").forEach((link) => {
            link.target = "_blank";
            link.rel = "noopener noreferrer";
          });
          saveNodeNote(id, editor.innerHTML);
        }

        function insertNoteImageUrl(id) {
          const url = window.prompt("Dán URL ảnh (https://...)");
          if (!url) return;
          if (!isAllowedNoteUrl(url, true)) {
            showToast("URL ảnh cần dùng http://, https:// hoặc data:image/");
            return;
          }
          const safeUrl = escapeNoteAttribute(url);
          insertHtmlIntoNote(
            id,
            `<img src="${safeUrl}" alt="Ảnh trong ghi chú" loading="lazy" />`,
          );
        }

        function insertNoteTable(id) {
          insertHtmlIntoNote(
            id,
            '<table><thead><tr><th>Tiêu đề 1</th><th>Tiêu đề 2</th></tr></thead><tbody><tr><td>Nội dung</td><td>Nội dung</td></tr><tr><td>Nội dung</td><td>Nội dung</td></tr></tbody></table><p><br></p>',
          );
        }

        // Nén ảnh (resize + giảm chất lượng JPEG) trước khi nhúng dạng base64,
        // để tránh làm dữ liệu vượt giới hạn 1MB/tài liệu của Firestore.
        function compressImageFile(file, maxDim, quality) {
          return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onerror = () => reject(reader.error);
            reader.onload = () => {
              const img = new Image();
              img.onerror = () => reject(new Error("Không đọc được ảnh"));
              img.onload = () => {
                let width = img.naturalWidth || img.width;
                let height = img.naturalHeight || img.height;
                if (width > maxDim || height > maxDim) {
                  if (width >= height) {
                    height = Math.round((height * maxDim) / width);
                    width = maxDim;
                  } else {
                    width = Math.round((width * maxDim) / height);
                    height = maxDim;
                  }
                }
                const canvas = document.createElement("canvas");
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext("2d");
                ctx.drawImage(img, 0, 0, width, height);
                try {
                  resolve(canvas.toDataURL("image/jpeg", quality));
                } catch (e) {
                  reject(e);
                }
              };
              img.src = String(reader.result);
            };
            reader.readAsDataURL(file);
          });
        }

        function setPending(id) {
          const n = findNodeAny(id);
          if (!n) return;
          if (isPinnedDayTask(n)) return;
          if (n.status === "pending") {
            n.status = "todo";
          } else {
            if (n.status === "doing" && n.runningEventId) {
              const ev = state.events.find((e) => e.id === n.runningEventId);
              if (ev) {
                ev.end = new Date().toISOString();
                ev.incomplete = true;
              }
              n.runningEventId = null;
            }
            n.status = "pending";
            n.startTime = null;
            syncTaskCompletionToMindmap(n);
          }
          syncTaskCompletionToMindmap(n);
          renderWithoutFlicker({ inPlace: true });
          scheduleAutoExport();
        }

        // ---------- Lịch sử hoàn thành theo ngày ----------
        function taskCompletionArchiveLabel(node) {
          const taskText = String(node?.text || "").trim();
          const parent = node?.id ? findParentNodeAny(node.id) : null;
          const parentText =
            parent && !isPinnedDayTask(parent)
              ? String(parent.text || "").trim()
              : "";
          return parentText && taskText ? `${parentText} - ${taskText}` : taskText;
        }

        function completedArchiveItemText(item) {
          const storedText = String(item?.displayText || "").trim();
          if (storedText) return storedText;
          const node = item?.taskId ? findNodeAny(item.taskId) : null;
          const liveText = taskCompletionArchiveLabel(node);
          return liveText || String(item?.text || "").trim() || "(Không có tên task)";
        }

        function addToCompletedArchive(node, completedAt, doingSummary = null) {
          // Vừa hoàn thành xong thì giữ task lại trong cây để người dùng thấy
          // trạng thái DONE ngay; nút "Ẩn việc đã hoàn thành" vẫn cho phép
          // thu gọn danh sách sau đó.
          state.showCompletedTasks = true;
          if (!state.completedArchive) state.completedArchive = {};
          const dk = dateKey(completedAt);
          if (!state.completedArchive[dk]) state.completedArchive[dk] = [];
          const firstStart = doingSummary?.firstStart
            ? new Date(doingSummary.firstStart).toISOString()
            : node.startTime || completedAt.toISOString();
          state.completedArchive[dk].push({
            id: genId("arc"),
            taskId: node.id,
            text: node.text,
            displayText: taskCompletionArchiveLabel(node),
            startTime: firstStart,
            endTime: completedAt.toISOString(),
            doingSeconds: Math.max(0, Number(doingSummary?.seconds) || 0),
          });
        }
        // Định dạng "15:00 – 15:30 (30p)"; hỗ trợ cả dữ liệu cũ chỉ có 1 mốc giờ (.time)
        function removeFromCompletedArchive(taskId, completedAt) {
          if (!state.completedArchive || !completedAt) return;
          const dk = dateKey(completedAt);
          if (!state.completedArchive[dk]) return;
          state.completedArchive[dk] = state.completedArchive[dk].filter(
            (it) => it.taskId !== taskId,
          );
          if (state.completedArchive[dk].length === 0)
            delete state.completedArchive[dk];
        }

        // Khi tất cả con trực tiếp đã hoàn thành, hoàn thành task cha và tiếp tục
        // kiểm tra các cấp phía trên. Task Hôm nay chỉ là nhóm cố định nên không
        // tự chuyển sang trạng thái hoàn thành.
        function completeFinishedParents(parent, completedAt) {
          let currentParent = parent;
          while (
            currentParent &&
            !currentParent._pinned &&
            currentParent.children.length > 0 &&
            currentParent.children.every((child) => child.status === "done")
          ) {
            if (currentParent.status !== "done") {
              currentParent.status = "done";
              currentParent.endTime = completedAt.toISOString();
              if (!currentParent.startTime)
                currentParent.startTime = currentParent.endTime;

              if (currentParent.runningEventId) {
                const event = state.events.find(
                  (item) => item.id === currentParent.runningEventId,
                );
                if (event) event.end = currentParent.endTime;
                currentParent.runningEventId = null;
              } else {
                state.events.push({
                  id: genId("e"),
                  taskId: currentParent.id,
                  text: currentParent.text,
                  date: dateKey(completedAt),
                  start: currentParent.startTime,
                  end: currentParent.endTime,
                  incomplete: false,
                });
              }
              addToCompletedArchive(
                currentParent,
                completedAt,
                getTaskDoingSummary(currentParent.id, completedAt),
              );
              syncTaskCompletionToMindmap(currentParent, true);
            } else {
              syncTaskCompletionToMindmap(currentParent, true);
            }
            currentParent = findParentNodeAny(currentParent.id);
          }
        }

        function completeSingleTaskNode(node, completedAt) {
          if (!node || isPinnedDayTask(node)) return false;
          if (node.status === "done") {
            syncTaskCompletionToMindmap(node, true);
            return false;
          }
          node.endTime = completedAt.toISOString();
          if (!node.startTime) node.startTime = node.endTime;
          node.status = "done";
          if (node.runningEventId) {
            const event = state.events.find((item) => item.id === node.runningEventId);
            if (event) event.end = node.endTime;
            node.runningEventId = null;
          } else {
            state.events.push({
              id: genId("e"),
              taskId: node.id,
              text: node.text,
              date: dateKey(completedAt),
              start: node.startTime,
              end: node.endTime,
              incomplete: false,
            });
          }
          addToCompletedArchive(
            node,
            completedAt,
            getTaskDoingSummary(node.id, completedAt),
          );
          syncTaskCompletionToMindmap(node, true);
          return true;
        }

        function completeTaskTree(root, completedAt) {
          const nodes = [];
          const visit = (node) => {
            if (!node || isPinnedDayTask(node)) return;
            nodes.push(node);
            (node.children || []).forEach(visit);
          };
          visit(root);

          let completedCount = 0;
          [...nodes].reverse().forEach((node) => {
            if (completeSingleTaskNode(node, completedAt)) completedCount++;
          });
          return completedCount;
        }

        function reopenTaskTree(root) {
          const nodes = [];
          const visit = (node) => {
            if (!node || isPinnedDayTask(node)) return;
            nodes.push(node);
            (node.children || []).forEach(visit);
          };
          visit(root);
          [...nodes].reverse().forEach((node) => reopenTaskFromMindmap(node));
          return nodes.length;
        }

        function reopenDoneAncestors(nodeId) {
          let parent = findParentNodeAny(nodeId);
          while (parent && !isPinnedDayTask(parent)) {
            if (parent.status === "done") reopenTaskFromMindmap(parent);
            parent = findParentNodeAny(parent.id);
          }
        }

        function clearTaskCheck(id) {
          const n = findNodeAny(id);
          if (!n || isPinnedDayTask(n)) return false;
          const reopenedCount = reopenTaskTree(n);
          reopenDoneAncestors(id);
          if (!reopenedCount) return false;
          renderWithoutFlicker();
          scheduleAutoExport();
          return true;
        }

        function formatArchiveDateTitle(dk) {
          const [y, m, d] = dk.split("-");
          return `${d}/${m}/${y}`;
        }

        function formatCompletionHistoryTime(item) {
          const startedAt = item?.startTime ? new Date(item.startTime) : null;
          const completedAt = item?.endTime ? new Date(item.endTime) : null;
          const hasStart = startedAt && !Number.isNaN(startedAt.getTime());
          const hasEnd = completedAt && !Number.isNaN(completedAt.getTime());
          if (hasStart && hasEnd) {
            const startMinute = String(startedAt.getMinutes()).padStart(2, "0");
            const endMinute = String(completedAt.getMinutes()).padStart(2, "0");
            return startedAt.getHours() === completedAt.getHours()
              ? `${startMinute}-${endMinute}`
              : `${fmtTime(startedAt)}-${fmtTime(completedAt)}`;
          }
          return hasEnd ? fmtTime(completedAt) : String(item?.time || "--:--");
        }

        function setCompletionHistoryDate(value) {
          if (!/^\d{4}-\d{2}-\d{2}$/.test(String(value || ""))) return;
          completionHistoryDate = value;
          renderWithoutFlicker();
        }

        function shiftCompletionHistoryDate(delta) {
          const selected = new Date(`${completionHistoryDate}T12:00:00`);
          if (Number.isNaN(selected.getTime())) {
            completionHistoryDate = dateKey(new Date());
            renderWithoutFlicker();
            return;
          }
          selected.setDate(selected.getDate() + Number(delta || 0));
          completionHistoryDate = dateKey(selected);
          renderWithoutFlicker();
        }

        function showCompletionHistoryToday() {
          completionHistoryDate = dateKey(new Date());
          renderWithoutFlicker();
        }

        const COMPLETION_HISTORY_PERIODS = [
          {
            key: "morning",
            label: "Sáng",
            range: "06:00–12:00",
            startHour: 6,
            endHour: 12,
          },
          {
            key: "afternoon",
            label: "Chiều",
            range: "12:00–18:00",
            startHour: 12,
            endHour: 18,
          },
          {
            key: "evening",
            label: "Tối",
            range: "18:00–24:00",
            startHour: 18,
            endHour: 24,
          },
          {
            key: "night",
            label: "Đêm",
            range: "00:00–06:00",
            startHour: 0,
            endHour: 6,
          },
        ];
        const COMPLETION_HISTORY_UNKNOWN_PERIOD = {
          key: "unknown",
          label: "Khác",
          range: "Không rõ giờ",
        };

        function completionHistoryItemHour(item) {
          const endTime = item?.endTime ? new Date(item.endTime) : null;
          if (endTime && !Number.isNaN(endTime.getTime())) return endTime.getHours();
          const legacyTime = String(item?.time || "").trim();
          const match = legacyTime.match(/^(?:[^\d]*)(\d{1,2})(?::|h)/i);
          if (!match) return null;
          const hour = Number(match[1]);
          return Number.isInteger(hour) && hour >= 0 && hour <= 23 ? hour : null;
        }

        function completionHistoryPeriodForHour(hour) {
          if (!Number.isInteger(hour)) return null;
          return (
            COMPLETION_HISTORY_PERIODS.find(
              (period) => hour >= period.startHour && hour < period.endHour,
            ) || null
          );
        }

        function groupCompletionHistoryItems(items) {
          const groups = COMPLETION_HISTORY_PERIODS.map((period) => ({
            period,
            items: [],
            hours: new Map(),
          }));
          const groupsByKey = new Map(
            groups.map((group) => [group.period.key, group]),
          );
          const unknownGroup = {
            period: COMPLETION_HISTORY_UNKNOWN_PERIOD,
            items: [],
            hours: new Map(),
          };
          (items || []).forEach((item) => {
            const hour = completionHistoryItemHour(item);
            const period = completionHistoryPeriodForHour(hour);
            const group = period ? groupsByKey.get(period.key) : unknownGroup;
            const hourKey = Number.isInteger(hour) ? String(hour) : "unknown";
            if (!group.hours.has(hourKey)) {
              group.hours.set(hourKey, { hour, items: [] });
            }
            group.items.push(item);
            group.hours.get(hourKey).items.push(item);
          });
          if (unknownGroup.items.length) groups.push(unknownGroup);
          return groups;
        }

        function completionHistoryHourLabel(hour) {
          if (!Number.isInteger(hour)) return "Không rõ giờ";
          const startLabel = `${String(hour).padStart(2, "0")}:00`;
          const endLabel = hour === 23
            ? "24:00"
            : `${String(hour + 1).padStart(2, "0")}:00`;
          return `${startLabel}–${endLabel}`;
        }

        function completionHistoryItemHtml(item) {
          return `<div class="task-completion-history-item">
              <time class="task-completion-history-time" datetime="${escapeHtml(item.endTime || "")}">${escapeHtml(formatCompletionHistoryTime(item))}</time>
              <span class="task-completion-history-text">${escapeHtml(completedArchiveItemText(item))}</span>
            </div>`;
        }

        function completionHistoryHtml() {
          const selectedDate = /^\d{4}-\d{2}-\d{2}$/.test(completionHistoryDate)
            ? completionHistoryDate
            : dateKey(new Date());
          completionHistoryDate = selectedDate;
          const sortedItems = ((state.completedArchive || {})[selectedDate] || [])
            .map((item, index) => ({ item, index }))
            .sort((left, right) => {
              const leftTime = Date.parse(left.item.endTime || "");
              const rightTime = Date.parse(right.item.endTime || "");
              const leftValid = Number.isFinite(leftTime);
              const rightValid = Number.isFinite(rightTime);
              if (leftValid && rightValid && leftTime !== rightTime)
                return leftTime - rightTime;
              if (leftValid !== rightValid) return leftValid ? -1 : 1;
              return left.index - right.index;
            })
            .map(({ item }) => item);
          const groupedPeriods = sortedItems.length
            ? groupCompletionHistoryItems(sortedItems)
            : [];
          const activePeriodCount = groupedPeriods.filter(
            (group) => group.items.length > 0,
          ).length;
          const listHtml = sortedItems.length
            ? groupedPeriods
                .map((group) => {
                  const hourGroups = Array.from(group.hours.values()).sort(
                    (left, right) => {
                      if (left.hour === right.hour) return 0;
                      if (!Number.isInteger(left.hour)) return 1;
                      if (!Number.isInteger(right.hour)) return -1;
                      return left.hour - right.hour;
                    },
                  );
                  const hoursHtml = hourGroups.length
                    ? hourGroups
                        .map(
                          (hourGroup) => `<section class="task-completion-history-hour">
                <header class="task-completion-history-hour-header">
                  <span>${escapeHtml(completionHistoryHourLabel(hourGroup.hour))}</span>
                  <span class="task-completion-history-hour-count">${hourGroup.items.length} task</span>
                </header>
                <div class="task-completion-history-hour-list">${hourGroup.items.map(completionHistoryItemHtml).join("")}</div>
              </section>`,
                        )
                        .join("")
                    : `<div class="task-completion-history-period-empty">Không có task trong khung này.</div>`;
                  return `<section class="task-completion-history-period task-completion-history-period-${escapeHtml(group.period.key)}" aria-labelledby="task-completion-history-period-${escapeHtml(group.period.key)}-title">
              <header class="task-completion-history-period-header">
                <span class="task-completion-history-period-title" id="task-completion-history-period-${escapeHtml(group.period.key)}-title">${escapeHtml(group.period.label)}</span>
                <span class="task-completion-history-period-meta">${escapeHtml(group.period.range)} · ${group.items.length} task</span>
              </header>
              <div class="task-completion-history-hours">${hoursHtml}</div>
            </section>`;
                })
                .join("")
            : `<div class="task-completion-history-empty">Không có task hoàn thành trong ngày ${escapeHtml(formatArchiveDateTitle(selectedDate))}.</div>`;
          return `<section class="task-completion-history" aria-labelledby="task-completion-history-title">
          <header class="task-completion-history-header">
            <div class="task-completion-history-heading">
              <div class="task-completion-history-title" id="task-completion-history-title">Lịch sử hoàn thành</div>
              <div class="task-completion-history-subtitle">${escapeHtml(formatArchiveDateTitle(selectedDate))} · ${sortedItems.length} task${activePeriodCount ? ` · ${activePeriodCount} khung` : ""}</div>
            </div>
            <div class="task-completion-history-controls" aria-label="Chọn ngày xem lịch sử hoàn thành">
              <button type="button" class="task-completion-history-nav" data-action="completion-history-shift" data-delta="-1" aria-label="Ngày trước">‹</button>
              <input type="date" id="completion-history-date" class="task-completion-history-date" value="${selectedDate}" aria-label="Chọn ngày lịch sử hoàn thành" />
              <button type="button" class="task-completion-history-nav" data-action="completion-history-shift" data-delta="1" aria-label="Ngày sau">›</button>
              <button type="button" class="task-completion-history-today" data-action="completion-history-today">Hôm nay</button>
            </div>
          </header>
          <div class="task-completion-history-list" aria-live="polite">${listHtml}</div>
        </section>`;
        }

        function setDone(id) {
          const n = findNodeAny(id);
          if (!n) return;
          if (isPinnedDayTask(n)) return;
          if (n.children.length > 0 && n.status !== "done") {
            const completedAt = new Date();
            const completedCount = completeTaskTree(n, completedAt);
            const parent = findParentNodeAny(id);
            if (parent) completeFinishedParents(parent, completedAt);
            renderWithoutFlicker();
            scheduleAutoExport();
            if (completedCount > 1)
              showToast(`Đã hoàn thành task cha và ${completedCount - 1} task con`);
            return;
          }
          if (n.status === "done") {
            // Bỏ hoàn thành ở cha thì mở lại cả nhánh; bỏ ở con thì mở lại
            // các task cha đang DONE để trạng thái checkbox luôn đồng bộ.
            reopenTaskTree(n);
            reopenDoneAncestors(id);
            renderWithoutFlicker();
            scheduleAutoExport();
            return;
          }
          const now = new Date();
          n.endTime = now.toISOString();
          if (!n.startTime) n.startTime = n.endTime;
          n.status = "done";
          if (n.runningEventId) {
            const ev = state.events.find((e) => e.id === n.runningEventId);
            if (ev) ev.end = now.toISOString();
            n.runningEventId = null;
          } else {
            state.events.push({
              id: genId("e"),
              taskId: n.id,
              text: n.text,
              date: dateKey(now),
              start: now.toISOString(),
              end: now.toISOString(),
              incomplete: false,
            });
          }
          addToCompletedArchive(n, now, getTaskDoingSummary(n.id, now));
          syncTaskCompletionToMindmap(n, true);
          const parent = findParentNodeAny(id);
          if (parent) {
            if (
              parent.children.length > 0 &&
              parent.children.every((child) => child.status === "done")
            ) {
              completeFinishedParents(parent, now);
            } else {
              reopenDoneAncestors(id);
            }
          }
          renderWithoutFlicker();
          scheduleAutoExport();
        }

        function escapeHtml(str) {
          const d = document.createElement("div");
          d.textContent = str;
          return d.innerHTML;
        }

        function sizeTaskEditInput(input) {
          if (!input) return;
          const style = window.getComputedStyle(input);
          const ruler = document.createElement("span");
          ruler.textContent = input.value || " ";
          ruler.style.position = "fixed";
          ruler.style.left = "-10000px";
          ruler.style.top = "-10000px";
          ruler.style.visibility = "hidden";
          ruler.style.whiteSpace = "pre";
          ruler.style.fontFamily = style.fontFamily;
          ruler.style.fontSize = style.fontSize;
          ruler.style.fontWeight = style.fontWeight;
          ruler.style.letterSpacing = style.letterSpacing;
          document.body.appendChild(ruler);
          const textWidth = ruler.getBoundingClientRect().width;
          ruler.remove();
          const horizontalSpace =
            parseFloat(style.paddingLeft || 0) +
            parseFloat(style.paddingRight || 0) +
            parseFloat(style.borderLeftWidth || 0) +
            parseFloat(style.borderRightWidth || 0) +
            2;
          input.style.width = `${Math.max(60, Math.ceil(textWidth + horizontalSpace))}px`;
        }

        // ---------- ẩn/hiện từng mục lớn ----------
        function isSectionCollapsed(key) {
          return !!(state.collapsedSections || {})[key];
        }
        function toggleSection(key) {
          if (!state.collapsedSections) state.collapsedSections = {};
          state.collapsedSections[key] = !state.collapsedSections[key];
          renderWithoutFlicker();
          scheduleAutoExport();
        }
        function toggleShowCompletedTasks() {
          state.showCompletedTasks = !state.showCompletedTasks;
          renderWithoutFlicker();
          scheduleAutoExport();
        }

        function toggleWidgetCollapse(key, rerenderFn) {
          if (!state.collapsedSections) state.collapsedSections = {};
          state.collapsedSections[key] = !state.collapsedSections[key];
          rerenderFn();
          scheduleAutoExport();
        }
        function sectionHeaderHtml(icon, title, key, extraClass, rootKind) {
          const collapsed = isSectionCollapsed(key);
          const rootLabel =
            rootKind === "kienthuc"
              ? "kiến thức"
              : rootKind === "haravan-code"
                ? "mục Haravan Code"
                : "task";
          return `<div class="section-title-row">
        <div class="section-title ${extraClass || ""}">${icon} ${title}</div>
        <div class="section-header-actions">
          ${rootKind ? `<button type="button" class="section-add-root-btn" data-action="toggle-root-add" data-kind="${rootKind}" aria-label="Thêm ${rootLabel} cấp 1" aria-expanded="${rootAddKind === rootKind}">＋</button>` : ""}
          <button type="button" class="section-toggle-btn" data-action="toggle-section" data-key="${key}" aria-expanded="${!collapsed}" aria-controls="section-body-${key}">${collapsed ? "Hiện ▸" : "Ẩn ▾"}</button>
        </div>
      </div>`;
        }
        function rootSectionKey(kind) {
          if (kind === "kienthuc") return "tasks-kienthuc";
          if (kind === "haravan-code") return "haravan-code-tree";
          return "tasks-task";
        }
        function toggleRootAdd(kind) {
          if (kind === "task" && !canCreateTaskFromActiveTab()) return;
          rootAddKind = rootAddKind === kind ? null : kind;
          if (rootAddKind) {
            if (!state.collapsedSections) state.collapsedSections = {};
            state.collapsedSections[rootSectionKey(kind)] = false;
          }
          render();
          if (rootAddKind) {
            requestAnimationFrame(() =>
              document.getElementById("root-add-input")?.focus(),
            );
          }
        }
        function addRootFromPanel(kind, text) {
          if (!text || !text.trim()) return;
          if (kind === "task" && !canCreateTaskFromActiveTab()) {
            rootAddKind = null;
            render();
            return false;
          }
          rootAddKind = null;
          if (kind === "haravan-code") addHaravanCodeRoot(text);
          else addTopLevel(text, kind);
          return true;
        }
        function rootAddFormHtml(kind) {
          if (rootAddKind !== kind) return "";
          const label =
            kind === "kienthuc"
              ? "kiến thức"
              : kind === "haravan-code"
                ? "tính năng hoặc nhóm code Haravan"
                : "task";
          return `<div class="root-add-row">
      <input type="text" id="root-add-input" aria-label="Nhập ${label} cấp 1" placeholder="Nhập ${label} cấp 1 (ngăn cách bằng dấu chấm phẩy)" />
      <button type="button" class="btn btn-add" data-action="confirm-root-add" data-kind="${kind}">Thêm</button>
      <button type="button" class="root-add-cancel" data-action="toggle-root-add" data-kind="${kind}" aria-label="Đóng ô thêm ${label}">×</button>
    </div>`;
        }
        function taskSelectionToolbarHtml() {
          const selectedCount = getSelectedTaskNodes().length;
          return `<div id="task-selection-toolbar" class="task-selection-toolbar" role="toolbar" aria-label="Thao tác hàng loạt với task" ${selectedCount ? "" : "hidden"}>
      <span class="task-selection-count" data-selection-count>${selectedCount} task đã chọn</span>
      <div class="task-selection-actions">
        <button type="button" data-action="bulk-task-action" data-bulk-action="done" ${selectedCount ? "" : "disabled"}>✓ Hoàn thành</button>
        <button type="button" data-action="bulk-task-action" data-bulk-action="pending" ${selectedCount ? "" : "disabled"}>⏸ Pending</button>
        <button type="button" class="danger" data-action="bulk-task-action" data-bulk-action="delete" ${selectedCount ? "" : "disabled"}>🗑 Xóa</button>
        <button type="button" data-action="clear-task-selection">Bỏ chọn</button>
      </div>
    </div>`;
        }
        {% comment %}Ticket tab lookup, update and render helpers removed from rendered theme.
        function formatSupportTicketsUpdatedAt(value) {
          const date = new Date(value);
          if (Number.isNaN(date.getTime())) return "Chưa có mốc cập nhật";
          return date.toLocaleString("vi-VN", {
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit",
          });
        }

        function getSupportTicketShopMetaUrl(value) {
          const raw = String(value || "").trim();
          if (!raw) return "";
          try {
            const parsed = new URL(raw);
            return `${parsed.origin}/meta.json`;
          } catch (error) {
            return "";
          }
        }

        function normalizeSupportTicketContentDomainCandidate(value) {
          let raw = String(value || "")
            .trim()
            .replace(/[.,;:!?]+$/g, "");
          if (!raw) return "";
          if (!/^https?:\/\//i.test(raw)) raw = `https://${raw}`;
          try {
            const parsed = new URL(raw);
            if (!/^https?:$/.test(parsed.protocol)) return "";
            const hostname = parsed.hostname.toLowerCase();
            const ignoredHosts = [
              "support.haravan.com",
              "haravan.com",
              "prnt.sc",
              "docs.google.com",
              "google.com",
              "facebook.com",
              "www.facebook.com",
              "youtube.com",
              "www.youtube.com",
              "youtu.be",
              "content.pancake.vn",
            ];
            if (
              ignoredHosts.includes(hostname) ||
              (hostname.endsWith(".haravan.com") &&
                !hostname.endsWith(".myharavan.com"))
            ) {
              return "";
            }
            return parsed.origin;
          } catch (error) {
            return "";
          }
        }

        function extractSupportTicketContentDomainCandidates(...values) {
          const source = values
            .map((value) => String(value || ""))
            .filter(Boolean)
            .join(" ");
          if (!source) return [];
          const candidates =
            source.match(
              /(?:https?:\/\/|www\.)[^\s<>'"`\)\]}]+|(?:^|[\s(])(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}(?::\d+)?(?:\/[^\s<>'"`\)\]}]*)?/gi,
            ) || [];
          return [
            ...new Set(
              candidates
                .map((candidate) => candidate.replace(/^[\s(]+/, ""))
                .map(normalizeSupportTicketContentDomainCandidate)
                .filter(Boolean),
            ),
          ];
        }

        function getSupportTicketContentMetaUrls(ticket) {
          const values = [
            ticket?.currentContent,
            ticket?.issue,
            ticket?.subject,
            ticket?.content,
            ticket?.body,
            ticket?.description,
            ticket?.handling,
          ];
          return [
            ...new Set([
              getSupportTicketShopMetaUrl(ticket?.adminUrl),
              ...extractSupportTicketContentDomainCandidates(...values).map(
                (origin) => `${origin}/meta.json`,
              ),
            ].filter(Boolean)),
          ];
        }

        function getSupportTicketMetaAdminUrl(payload) {
          const candidates = [];
          const visit = (value, depth) => {
            if (depth > 4 || value === null || value === undefined) return;
            if (typeof value === "string") {
              const adminUrl = normalizeSupportTicketAdminUrlCandidate(value);
              if (adminUrl) candidates.push(adminUrl);
              return;
            }
            if (Array.isArray(value)) {
              value.forEach((item) => visit(item, depth + 1));
              return;
            }
            if (typeof value !== "object") return;
            const priorityKeys = [
              "admin_url",
              "adminUrl",
              "myharavan_url",
              "myharavanUrl",
              "shop_url",
              "shopUrl",
              "url",
              "domain",
              "website",
            ];
            priorityKeys.forEach((key) => {
              if (Object.prototype.hasOwnProperty.call(value, key)) {
                visit(value[key], depth + 1);
              }
            });
            Object.entries(value).forEach(([key, item]) => {
              if (!priorityKeys.includes(key)) visit(item, depth + 1);
            });
          };
          visit(payload, 0);
          return candidates[0] || "";
        }

        function getSupportTicketDisplayName(ticket) {
          return String(
            supportTicketShopNameResults[String(ticket?.id)] || ticket?.account || "",
          ).trim();
        }

        function getSupportTicketDisplayAdminUrl(ticket) {
          return String(
            supportTicketContentAdminUrlResults[String(ticket?.id)] ||
              ticket?.adminUrl ||
              "",
          ).trim();
        }

        function getSupportTicketShopNameSignature(tickets) {
          return (Array.isArray(tickets) ? tickets : [])
            .map((ticket) =>
              [ticket.id, ...getSupportTicketContentMetaUrls(ticket)].join("::"),
            )
            .sort()
            .join("|");
        }

        function scheduleSupportTicketShopNameLookup() {
          const tickets = Array.isArray(state.supportTickets)
            ? state.supportTickets
            : [];
          const signature = getSupportTicketShopNameSignature(tickets);
          if (
            !signature ||
            signature === supportTicketShopNameSignature ||
            supportTicketShopNameBusy
          ) {
            return;
          }
          supportTicketShopNameSignature = signature;
          supportTicketShopNameBusy = true;
          lookupSupportTicketShopNames(tickets, signature);
        }

        async function lookupSupportTicketShopNames(tickets, signature) {
          const nextResults = {};
          const nextAdminUrlResults = {};
          try {
            const metaUrlsByTicketId = Object.fromEntries(
              (Array.isArray(tickets) ? tickets : []).map((ticket) => [
                String(ticket.id),
                getSupportTicketContentMetaUrls(ticket),
              ]),
            );
            const metaUrls = [
              ...new Set(
                Object.values(metaUrlsByTicketId).flat().filter(Boolean),
              ),
            ];
            const entries = await Promise.all(
              metaUrls.map(async (metaUrl) => {
                try {
                  const response = await fetch(metaUrl, { cache: "no-store" });
                  if (!response.ok) return [metaUrl, { name: "", adminUrl: "" }];
                  const payload = await response.json();
                  const name = String(
                    payload?.name || payload?.shop?.name || payload?.data?.name || "",
                  ).trim();
                  return [metaUrl, {
                    name,
                    adminUrl: getSupportTicketMetaAdminUrl(payload),
                  }];
                } catch (error) {
                  return [metaUrl, { name: "", adminUrl: "" }];
                }
              }),
            );
            const metadataByMetaUrl = Object.fromEntries(entries);
            (Array.isArray(tickets) ? tickets : []).forEach((ticket) => {
              const metadata = (metaUrlsByTicketId[String(ticket.id)] || [])
                .map((metaUrl) => metadataByMetaUrl[metaUrl])
                .filter((item) => item && (item.name || item.adminUrl));
              const firstMetadata =
                metadata.find((item) => item.name) || metadata[0] || {};
              if (firstMetadata.name) {
                nextResults[String(ticket.id)] = firstMetadata.name;
              }
              if (!ticket.adminUrl) {
                const metadataWithAdminUrl = metadata.find((item) => item.adminUrl);
                if (metadataWithAdminUrl?.adminUrl) {
                  nextAdminUrlResults[String(ticket.id)] =
                    metadataWithAdminUrl.adminUrl;
                }
              }
            });
          } catch (error) {
            // meta.json không public/CORS bị chặn: dùng fallback từ Org ID hoặc snapshot.
          }
          supportTicketShopNameResults = nextResults;
          supportTicketContentAdminUrlResults = nextAdminUrlResults;
          supportTicketShopNameBusy = false;
          if (getSupportTicketShopNameSignature(state.supportTickets) !== signature) {
            supportTicketShopNameSignature = "";
          }
          if (typeof render === "function") render();
        }

        function normalizeSupportTicketSheetText(value) {
          return String(value || "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/đ/gi, "d")
            .replace(/\s+/g, " ")
            .trim()
            .toLocaleLowerCase("vi");
        }

        function normalizeSupportTicketSheetUrl(value) {
          const raw = String(value || "").trim();
          if (!raw) return "";
          try {
            const parsed = new URL(raw);
            const pathname = parsed.pathname.replace(/\/+$/, "").toLowerCase() || "/";
            return `${parsed.hostname.toLowerCase()}${pathname}`;
          } catch (error) {
            return normalizeSupportTicketSheetText(raw);
          }
        }

        function getSupportTicketSheetHost(value) {
          const raw = String(value || "").trim();
          if (!raw) return "";
          try {
            return new URL(raw).hostname.toLowerCase();
          } catch (error) {
            return "";
          }
        }

        function parseSupportTicketSheetCsv(csvText) {
          const source = String(csvText || "").replace(/^\uFEFF/, "");
          const rows = [];
          let row = [];
          let cell = "";
          let inQuotes = false;
          for (let index = 0; index < source.length; index += 1) {
            const character = source[index];
            if (character === '"') {
              if (inQuotes && source[index + 1] === '"') {
                cell += '"';
                index += 1;
              } else {
                inQuotes = !inQuotes;
              }
            } else if (!inQuotes && character === ",") {
              row.push(cell);
              cell = "";
            } else if (!inQuotes && (character === "\n" || character === "\r")) {
              if (character === "\r" && source[index + 1] === "\n") index += 1;
              row.push(cell);
              if (row.some((value) => String(value || "").trim())) rows.push(row);
              row = [];
              cell = "";
            } else {
              cell += character;
            }
          }
          if (cell || row.length) {
            row.push(cell);
            if (row.some((value) => String(value || "").trim())) rows.push(row);
          }
          return rows.slice(1).map((values) => ({
            adminUrl: String(values[0] || "").trim(),
            shopName: String(values[1] || "").trim(),
            columnC: String(values[2] || "").trim(),
          }));
        }

        function mergeSupportTicketSheetValues(rows, field) {
          const values = [];
          const seen = new Set();
          (Array.isArray(rows) ? rows : []).forEach((row) => {
            const value = String(row?.[field] || "").trim();
            if (isSupportTicketSheetValueMissing(value)) return;
            const key = normalizeSupportTicketSheetText(value);
            if (!key || seen.has(key)) return;
            seen.add(key);
            values.push(value);
          });
          return values.join("\n");
        }

        function findSupportTicketSheetRowsByUrl(rows, value) {
          const ticketUrl = normalizeSupportTicketSheetUrl(value);
          const ticketHost = getSupportTicketSheetHost(value);
          if (!ticketUrl) return [];
          return (Array.isArray(rows) ? rows : [])
            .filter((row) => row && row.adminUrl)
            .filter((row) => {
              const rowUrl = normalizeSupportTicketSheetUrl(row.adminUrl);
              const rowHost = getSupportTicketSheetHost(row.adminUrl);
              return rowUrl === ticketUrl || (ticketHost && rowHost === ticketHost);
            });
        }

        function getSupportTicketSheetCsvUrl(value) {
          const raw = String(value || "").trim();
          if (!raw) return "";
          try {
            const parsed = new URL(raw);
            const publishedMatch = parsed.pathname.match(
              /^\/spreadsheets\/d\/e\/([^/]+)\/pubhtml\/?$/i,
            );
            if (publishedMatch) {
              const params = new URLSearchParams();
              const gid = parsed.searchParams.get("gid");
              if (gid) params.set("gid", gid);
              params.set("single", "true");
              params.set("output", "csv");
              return `${parsed.origin}/spreadsheets/d/e/${publishedMatch[1]}/pub?${params.toString()}`;
            }
            parsed.searchParams.set("output", "csv");
            return parsed.toString();
          } catch (error) {
            return raw;
          }
        }

        function getSupportTicketSheetLookupSignature(tickets) {
          return [
            SUPPORT_TICKET_SHEET_URL,
            ...(Array.isArray(tickets) ? tickets : [])
              .map((ticket) =>
                [
                  ticket.id,
                  ticket.orgId,
                  normalizeSupportTicketSheetUrl(
                    getSupportTicketDisplayAdminUrl(ticket),
                  ),
                  normalizeSupportTicketSheetText(getSupportTicketDisplayName(ticket)),
                ].join("::"),
              )
              .sort(),
          ].join("|");
        }

        function scheduleSupportTicketSheetLookup(force = false) {
          const tickets = Array.isArray(state.supportTickets)
            ? state.supportTickets
            : [];
          const signature = getSupportTicketSheetLookupSignature(tickets);
          if (
            !signature ||
            (!force && signature === supportTicketSheetLookupSignature) ||
            supportTicketSheetLookupBusy
          ) {
            return;
          }
          supportTicketSheetLookupSignature = signature;
          supportTicketSheetLookupBusy = true;
          lookupSupportTicketSheet(tickets, signature);
        }

        function startSupportTicketSheetLookupPolling() {
          clearInterval(supportTicketSheetLookupInterval);
          supportTicketSheetLookupInterval = setInterval(() => {
            if (supportTicketSheetLookupBusy) return;
            supportTicketSheetLookupSignature = "";
            scheduleSupportTicketSheetLookup(true);
          }, 5 * 60 * 1000);
        }

        async function lookupSupportTicketSheet(tickets, signature) {
          const nextResults = {};
          try {
            const response = await fetch(getSupportTicketSheetCsvUrl(SUPPORT_TICKET_SHEET_URL), {
              cache: "no-store",
            });
            if (!response.ok) throw new Error(`Sheet HTTP ${response.status}`);
            const rows = parseSupportTicketSheetCsv(await response.text());
            const nameRows = rows.filter((row) => row.shopName);
            (Array.isArray(tickets) ? tickets : []).forEach((ticket) => {
              const displayAdminUrl = getSupportTicketDisplayAdminUrl(ticket);
              const urlMatches = findSupportTicketSheetRowsByUrl(rows, displayAdminUrl);
              const nameKey = normalizeSupportTicketSheetText(
                getSupportTicketDisplayName(ticket),
              );
              const nameMatches = urlMatches.length || !nameKey
                ? []
                : nameRows.filter(
                    (row) => normalizeSupportTicketSheetText(row.shopName) === nameKey,
                  );
              const matches = urlMatches.length ? urlMatches : nameMatches;
              if (matches.length) {
                nextResults[String(ticket.id)] = {
                  columnB: mergeSupportTicketSheetValues(matches, "shopName"),
                  columnC: mergeSupportTicketSheetValues(matches, "columnC"),
                  matchType: urlMatches.length ? "adminUrl" : "shopName",
                  matchCount: matches.length,
                };
              }
            });
          } catch (error) {
            // Sheet lỗi hoặc chưa public: giữ bảng ticket hoạt động và chờ lần đổi link tiếp theo.
          }
          supportTicketSheetLookupResults = nextResults;
          supportTicketSheetLookupBusy = false;
          if (getSupportTicketSheetLookupSignature(state.supportTickets) !== signature) {
            supportTicketSheetLookupSignature = "";
          }
          if (typeof render === "function") render();
        }

        async function lookupSupportTicketSheetByUrl(value) {
          const rawUrl = String(value || "").trim();
          supportTicketManualLookupUrl = rawUrl;
          supportTicketManualLookupResult = null;
          supportTicketManualLookupError = "";
          if (!rawUrl) {
            supportTicketManualLookupError = "Hãy nhập URL website cần tra.";
            render();
            return false;
          }
          supportTicketManualLookupBusy = true;
          render();
          try {
            const response = await fetch(
              getSupportTicketSheetCsvUrl(SUPPORT_TICKET_SHEET_URL),
              { cache: "no-store" },
            );
            if (!response.ok) throw new Error(`Sheet HTTP ${response.status}`);
            const rows = parseSupportTicketSheetCsv(await response.text());
            const matches = findSupportTicketSheetRowsByUrl(rows, rawUrl);
            if (!matches.length) {
              supportTicketManualLookupError =
                "Không tìm thấy URL này trong CSV.";
              return false;
            }
            supportTicketManualLookupResult = {
              columnB: mergeSupportTicketSheetValues(matches, "shopName"),
              columnC: mergeSupportTicketSheetValues(matches, "columnC"),
              matchType: "adminUrl",
              matchCount: matches.length,
            };
            return true;
          } catch (error) {
            supportTicketManualLookupError =
              "Không đọc được CSV, hãy kiểm tra nguồn dữ liệu công khai.";
            return false;
          } finally {
            supportTicketManualLookupBusy = false;
            render();
          }
        }

        function openSupportTicketUpdateDialog() {
          const modal = document.getElementById("support-ticket-update-modal");
          const input = document.getElementById("support-ticket-update-input");
          if (!modal || !input) return;
          input.value = JSON.stringify(state.supportTickets || [], null, 2);
          modal.hidden = false;
          requestAnimationFrame(() => input.focus());
        }
        function closeSupportTicketUpdateDialog() {
          const modal = document.getElementById("support-ticket-update-modal");
          if (modal) modal.hidden = true;
        }
        function applySupportTicketUpdate(rawValue) {
          const raw = String(rawValue || "").trim();
          if (!raw) {
            showToast("Hãy nhập dữ liệu ticket trước khi cập nhật");
            return false;
          }
          let parsed;
          try {
            parsed = JSON.parse(raw);
          } catch (error) {
            showToast("JSON ticket không hợp lệ");
            return false;
          }
          const candidate = Array.isArray(parsed)
            ? parsed
            : Array.isArray(parsed?.supportTickets)
              ? parsed.supportTickets
              : null;
          if (!candidate) {
            showToast("JSON phải là một mảng ticket hoặc có khóa supportTickets");
            return false;
          }
          const normalized = candidate
            .map(normalizeSupportTicket)
            .filter(Boolean);
          const ids = normalized.map((ticket) => ticket.id);
          if (!normalized.length) {
            showToast("Chưa có ticket hợp lệ để cập nhật");
            return false;
          }
          if (new Set(ids).size !== ids.length) {
            showToast("Dữ liệu có Ticket ID bị trùng");
            return false;
          }
          state.supportTickets = normalized;
          state.supportTicketsUpdatedAt = new Date().toISOString();
          supportTicketSheetLookupResults = {};
          supportTicketSheetLookupSignature = "";
          supportTicketSheetLookupBusy = false;
          supportTicketShopNameResults = {};
          supportTicketShopNameSignature = "";
          supportTicketShopNameBusy = false;
          supportTicketContentAdminUrlResults = {};

          closeSupportTicketUpdateDialog();
          render();
          scheduleAutoExport("Cập nhật snapshot ticket");
          showToast(`Đã cập nhật ${normalized.length} ticket`);
          return true;
        }
        function toggleSupportTicketDone(ticketId) {
          const ticket = (state.supportTickets || []).find(
            (item) => String(item.id) === String(ticketId),
          );
          if (!ticket) return;
          ticket.done = !normalizeSupportTicketDone(ticket.done);
          state.supportTicketsUpdatedAt = new Date().toISOString();
          render();
          scheduleAutoExport(
            ticket.done
              ? "Đánh dấu ticket đã làm"
              : "Bỏ đánh dấu ticket đã làm",
          );
        }

        function isSupportTicketSheetValueMissing(value) {
          return ["", "chưa có", "n/a", "na", "-", "—"].includes(
            String(value || "").trim().toLocaleLowerCase("vi"),
          );
        }

        function getSupportTicketMissingSheetResultUrls(tickets) {
          if (supportTicketSheetLookupBusy) return [];
          return (Array.isArray(tickets) ? tickets : [])
            .filter((ticket) => {
              const adminUrl = getSupportTicketDisplayAdminUrl(ticket);
              const sheetLookup =
                supportTicketSheetLookupResults[String(ticket.id)] || {};
              return (
                adminUrl &&
                (isSupportTicketSheetValueMissing(sheetLookup.columnB) ||
                  isSupportTicketSheetValueMissing(sheetLookup.columnC))
              );
            })
            .sort((left, right) => (Number(left.id) || 0) - (Number(right.id) || 0))
            .map((ticket) => getSupportTicketDisplayAdminUrl(ticket));
        }

        async function copySupportTicketSheetValue(button) {
          const value = String(button?.dataset.copyValue || "").trim();
          if (!value) return;
          try {
            await navigator.clipboard.writeText(value);
          } catch (error) {
            const fallback = document.createElement("textarea");
            fallback.value = value;
            fallback.setAttribute("readonly", "readonly");
            fallback.style.position = "fixed";
            fallback.style.opacity = "0";
            document.body.appendChild(fallback);
            fallback.focus();
            fallback.select();
            try {
              document.execCommand("copy");
            } finally {
              fallback.remove();
            }
          }
          showToast(`Đã sao chép ${button.dataset.copyLabel || "nội dung"}`);
        }

        function supportTicketSheetCopyCellHtml(value, label, matchCount = 0) {
          const text = String(value || "").trim();
          const copyTitle = `Bấm để sao chép${
            Number(matchCount) > 1 ? ` (${Number(matchCount)} dòng CSV)` : ""
          }`;
          return text
            ? `<button type="button" class="support-ticket-copy-cell" data-action="copy-support-ticket-sheet-value" data-copy-value="${escapeHtml(text)}" data-copy-label="${escapeHtml(label)}" title="${escapeHtml(copyTitle)}">${escapeHtml(text)}</button>`
            : `<span class="support-ticket-copy-cell is-empty">Chưa có</span>`;
        }

        function supportTicketSheetCopyLinesHtml(value, label) {
          const lines = String(value || "")
            .split(/\r?\n/)
            .map((line) => line.trim())
            .filter(Boolean);
          if (!lines.length) {
            return `<span class="support-ticket-copy-cell is-empty">Chưa có</span>`;
          }
          return lines
            .map((line, index) => {
              const lineLabel =
                lines.length > 1 ? `${label} dòng ${index + 1}` : label;
              return `<button type="button" class="support-ticket-copy-cell" data-action="copy-support-ticket-sheet-value" data-copy-value="${escapeHtml(line)}" data-copy-label="${escapeHtml(lineLabel)}" title="Bấm để sao chép dòng này">${escapeHtml(line)}</button>`;
            })
            .join("");
        }

        function renderSupportTicketsHtml() {
          const tickets = Array.isArray(state.supportTickets)
            ? state.supportTickets
            : [];
          scheduleSupportTicketShopNameLookup();
          scheduleSupportTicketSheetLookup();

          const query = String(supportTicketSearchQuery || "")
            .trim()
            .toLocaleLowerCase("vi");
          const filteredTickets = tickets
            .filter((ticket) =>
              supportTicketStatusFilter === "all"
                ? true
                : ticket.status === supportTicketStatusFilter,
            )
            .filter((ticket) =>
              supportTicketWorkStatusFilter === "all"
                ? true
                : supportTicketWorkStatusFilter === "done"
                  ? normalizeSupportTicketDone(ticket.done)
                  : !normalizeSupportTicketDone(ticket.done),
            )
            .filter((ticket) =>
              supportTicketDifficultyFilter === "all"
                ? true
                : getSupportTicketDifficulty(ticket) === supportTicketDifficultyFilter,
            )
            .filter((ticket) => {
              const sheetLookup =
                supportTicketSheetLookupResults[String(ticket.id)] || {};
              const shopName = getSupportTicketDisplayName(ticket);
              if (!query) return true;
              return [
                ticket.id,
                ticket.status,
                getSupportTicketDifficulty(ticket),
                getSupportTicketDifficultyScore(ticket),
                getSupportTicketDisplayAdminUrl(ticket),
                ticket.currentContent,
                ticket.issue,
                ticket.handling,
                ticket.account,
                shopName,
                sheetLookup.columnB,
                sheetLookup.columnC,

                normalizeSupportTicketDone(ticket.done) ? "Đã làm" : "Chưa làm",
              ].some((value) =>
                String(value || "")
                  .toLocaleLowerCase("vi")
                  .includes(query),
              );
            })
            .sort((left, right) => {
              const leftId = Number(left.id) || 0;
              const rightId = Number(right.id) || 0;
              const leftDifficulty = getSupportTicketDifficultyScore(left);
              const rightDifficulty = getSupportTicketDifficultyScore(right);
              if (supportTicketSort === "id-desc") return rightId - leftId;
              if (supportTicketSort === "difficulty-asc") {
                return leftDifficulty - rightDifficulty || leftId - rightId;
              }
              if (supportTicketSort === "difficulty-desc") {
                return rightDifficulty - leftDifficulty || leftId - rightId;
              }
              return leftId - rightId;
            });
          const missingSheetResultUrls =
            getSupportTicketMissingSheetResultUrls(tickets);
          const statusOptions = [
            ["all", "Tất cả trạng thái"],
            ["Open", "Open"],
            ["Customer Responded", "Customer Responded"],
          ];
          const workStatusOptions = [
            ["all", "Tất cả xử lý"],
            ["todo", "Chưa làm"],
            ["done", "Đã làm"],
          ];
          const difficultyOptions = [
            ["all", "Tất cả độ khó"],
            ["Dễ", "Dễ"],
            ["Trung bình", "Trung bình"],
            ["Khó", "Khó"],
          ];
          const sortOptions = [
            ["id-asc", "ID tăng dần"],
            ["id-desc", "ID giảm dần"],
            ["difficulty-desc", "Độ khó: Khó → Dễ"],
            ["difficulty-asc", "Độ khó: Dễ → Khó"],
          ];
          const rows = filteredTickets.length
            ? filteredTickets
                .map((ticket) => {
                  const statusClass = ticket.status
                    .toLocaleLowerCase("en")
                    .includes("responded")
                    ? " is-responded"
                    : "";
                  const difficulty = getSupportTicketDifficulty(ticket);
                  const difficultyScore = getSupportTicketDifficultyScore(ticket);
                  const difficultyClass =
                    difficulty === "Khó"
                      ? " is-hard"
                      : difficulty === "Dễ"
                        ? " is-easy"
                        : " is-medium";
                  const sheetLookup =
                    supportTicketSheetLookupResults[String(ticket.id)] || {};
                  const shopName = getSupportTicketDisplayName(ticket);
                  const displayAdminUrl = getSupportTicketDisplayAdminUrl(ticket);
                  const resultValues = String(sheetLookup.columnC || "")
                    .split(/\r?\n/)
                    .map((value) => value.trim())
                    .filter((value) => !isSupportTicketSheetValueMissing(value));
                  const resultClass = resultValues.length === 0
                    ? "is-no-result"
                    : resultValues.every(
                        (value) =>
                          normalizeSupportTicketSheetText(value) ===
                          "html.tech@haravan.com",
                      )
                      ? "is-html-tech"
                      : "is-other-account";
                  const isDone = normalizeSupportTicketDone(ticket.done);
                  const workStatusCell = `
                    <button type="button"
                      class="support-ticket-work-toggle${isDone ? " is-done" : ""}"
                      data-action="toggle-support-ticket-done"
                      data-id="${escapeHtml(ticket.id)}"
                      aria-pressed="${isDone}"
                      title="${isDone ? "Bỏ đánh dấu đã làm" : "Đánh dấu đã làm"}">
                      <span class="support-ticket-work-icon" aria-hidden="true">${isDone ? "✓" : ""}</span>
                      <span>${isDone ? "Đã làm" : "Chưa làm"}</span>
                    </button>
                  `;
                  const linkCell = displayAdminUrl
