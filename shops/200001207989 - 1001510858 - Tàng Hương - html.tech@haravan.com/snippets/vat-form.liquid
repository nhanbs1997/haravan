{% assign invoice = 'Xuất hóa đơn' -%}
{% assign company_name = 'Tên công ty' -%}
{% assign company_address = 'Địa chỉ công ty' -%}
{% assign tax_code = 'Mã số thuế' -%}
{% assign invoice_email = 'Email nhận hóa đơn' -%}

<div class="bill-field  space-y-3 {% unless drawer %}hidden {% endunless %}" >
			
		   <div class="flex items-center">
        <div class="flex items-center ">
		<input class="invoice" type="hidden" name="attributes[{{invoice}}]"
			     value='{% if cart.attributes[invoice] == "có" %}có{%else%}không{% endif %}'>
          <input  class="invoice-checkbox form-checkbox"
				 {% if cart.attributes[invoice] == "có" %}checked{% endif %}
				 type="checkbox"  >
        </div>
        <div class="ml-2 text-sm">
          <label>{{invoice}}</label>
        </div>
      </div>
		<div class="form-group">
			<label class="label block mb-2">{{company_name}}</label>
			<input type="text" class="form-input" 
				   name="attributes[{{company_name}}]" 
				   value="{{ cart.attributes[company_name] }}"
				    data-rules="['required']"
				   data-messages="{'required':'Trường này không được bỏ trống' }"
				   placeholder="{{company_name}}" >
			<span class="error  text-error"></span>
		</div>	
		<div class="form-group">
			<label class="label block mb-2">{{tax_code}}</label>
			<input type="number" 
				   class="form-input" 
				   name="attributes[{{tax_code}}]" 
				   value="{{ cart.attributes[tax_code] }}" 
				   data-rules="['minLength:10','required']"
				   data-messages="{ 'minLength:10': 'Số kí tự tối thiểu [size]', 'require':'Trường này không được bỏ trống' }"
				   placeholder="{{tax_code}}">
			 <span class="error text-error"></span>

		</div>
		<div class="form-group">
			<label class="label block mb-2">{{company_address}}</label>
			<textarea  class="form-textarea" 
					  data-rules="['required']"
				   	  data-messages="{'required':'Trường này không được bỏ trống' }"
					  name="attributes[{{company_address}}]"
					  placeholder="{{company_address}}">{{ cart.attributes[company_address] }}</textarea>
			<span class="error  text-error"></span>

		</div>
		<div class="form-group">
			<label class="label block mb-2">{{invoice_email}}</label>
			<input type="email" class="form-input" 
				   name="attributes[{{invoice_email}}]" 
				   value="{{ cart.attributes[invoice_email] }}" 
				   placeholder="{{invoice_email}}"
				    data-rules="['required','email']"
				   	  data-messages="{'required':'Trường này không được bỏ trống', 'email': 'Email không đúng định dạng' }"
				   >
						<span class="error  text-error"></span>

		</div>
	
	</div>