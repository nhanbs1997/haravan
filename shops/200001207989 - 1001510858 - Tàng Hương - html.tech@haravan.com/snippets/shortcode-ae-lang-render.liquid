{% endcapture %} {% include 'ae-multilanguage-config' %}{% capture strip_html %}{% include 'shortcode-render' render:'strip' %}{% endcapture %}{% capture strip_newlines %}{% include 'shortcode-render' render:'stripnl' %}{% endcapture %}{% capture trun %}{% include 'shortcode-render' render:'truncatewords' %}{% endcapture %}{% capture hasShortcode %}{% include 'shortcode-render' render:'hasShortcode' %}{% endcapture %}{% capture tag %}{% include 'shortcode-render' render:'tag' %}{% endcapture %}{% capture tagValue %}{% include 'shortcode-render' render:'tagValue' %}{% endcapture %}{% capture source %}{% include 'shortcode-render' render:'source' %}{% endcapture %}{% capture only %}{% include 'shortcode-render' render:'only' %}{% endcapture %}{% assign attrConfig = '' %}{% if attr != '' %}{% assign attrConfig = 'data-attr="' | append: attr | append: '"' %}{% endif %}{% assign arr = text | split: "[APL]" %}{% assign defaultText = arr[0] %}{% assign sourceText = '' %}{% if source != '' %}{% assign sourceText = 'ae-' | append:source %}{% endif %}{% if only != blank %}{% if strip_html != '' %}{% assign text = text | strip_html %}{% assign text = text | replace: newLine, '' %}{% endif %}{% if strip_newlines != '' %}{% assign text = text | replace: newLine, '' %}{% endif %}{% if trun != '' %}{% assign val = val | truncatewords: trun %}{% endif %}{{ text }}{% else %}{% for la in lang %}{% assign val = arr[forloop.index0] %}{% assign lanConfig = 'data-lang="' | append: la | append: '"' %}{% assign clsDefault = 'ae-hide' %}{% if forloop.index0 == 0 %}{% assign clsDefault = '' %}{% endif %}{% if forloop.index > arr.size or val == '' %}{% assign val = defaultText %}{% endif %}{% if strip_html != '' %}{% assign val = val | strip_html | replace: newLine, ''%}{% endif %}{% if strip_newlines != '' %}{% assign val = val | strip_newlines %}{% endif %}{% if tag == 'option'%}<option {{ lanConfig }} {{ attrConfig }} class="ae-lang-{{ la }} ae-lang-div {{ sourceText }}" value="{{ tagValue }}">{{ val }}</option>{% else %}{% if trun != '' %}{% assign val = val | truncatewords: trun %}{% endif %}{% if hasShortcode == '' %}<div {{ lanConfig }} {{ attrConfig }} class="ae-lang-{{ la }} ae-lang-div {{ sourceText }}">{{ val }}</div>{% else %}<div {{ lanConfig }} {{ attrConfig }} class="ae-lang-{{ la }} ae-lang-div {{ sourceText }}">{% include 'shortcode' load: val %}</div>{% endif %}{% endif %}{% endfor %}{% endif %}