<div id="bunnyhill-location-selector" class="bunnyhill-location-selector" hidden aria-hidden="true">
  <div class="bunnyhill-location-selector__dialog" role="dialog" aria-modal="true" aria-labelledby="bunnyhill-location-selector-title">
    <div class="bunnyhill-location-selector__header">
      <h2 id="bunnyhill-location-selector-title" class="bunnyhill-location-selector__title">SELECT YOUR LOCATION</h2>
      <button type="button" class="bunnyhill-location-selector__close" aria-label="Close">×</button>
    </div>
    <div class="bunnyhill-location-selector__options">
      <a class="bunnyhill-location-selector__option" href="https://bunnyhill.vn/" data-location-choice="vi">Vietnamese version</a>
      <a class="bunnyhill-location-selector__option" href="https://bunnyhill.vn/?view=en" data-location-choice="en">International version</a>
    </div>
  </div>
</div>

<script>
  (function () {
    var selector = document.getElementById('bunnyhill-location-selector');
    var closeButton;
    var locationChoices;
    var storageKey = 'bunnyhill-location-choice';
    var dismissedKey = 'bunnyhill-location-selector-dismissed';
    var hasEnglishView = /(?:^|[?&])view=en(?:&|$)/i.test(window.location.search);

    if (!selector || hasEnglishView) {
      return;
    }

    function readStorage(storage, key) {
      try {
        return storage.getItem(key);
      } catch (error) {
        return null;
      }
    }

    function writeStorage(storage, key, value) {
      try {
        storage.setItem(key, value);
      } catch (error) {
        return false;
      }
      return true;
    }

    function hideSelector() {
      selector.hidden = true;
      selector.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('bunnyhill-location-selector-open');
    }

    if (readStorage(window.localStorage, storageKey) || readStorage(window.sessionStorage, dismissedKey)) {
      return;
    }

    selector.hidden = false;
    selector.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('bunnyhill-location-selector-open');
    closeButton = selector.querySelector('.bunnyhill-location-selector__close');
    locationChoices = selector.querySelectorAll('[data-location-choice]');

    closeButton.addEventListener('click', function () {
      writeStorage(window.sessionStorage, dismissedKey, '1');
      hideSelector();
    });

    Array.prototype.forEach.call(locationChoices, function (choice) {
      choice.addEventListener('click', function () {
        writeStorage(window.localStorage, storageKey, choice.getAttribute('data-location-choice'));
      });
    });
  }());
</script>

<script>
  (function () {
    function getMobileNav() {
      var mobileNavs = document.querySelectorAll('.mobile_nav');
      var visibleNav = null;
      var index;

      for (index = 0; index < mobileNavs.length; index += 1) {
        if (mobileNavs[index].offsetWidth || mobileNavs[index].offsetHeight) {
          visibleNav = mobileNavs[index];
        }
      }

      return visibleNav || mobileNavs[mobileNavs.length - 1] || null;
    }

    function placeLanguageFlagInMobileNav() {
      var flag = document.querySelector('.header-translate-flag');
      var mobileNav = getMobileNav();

      if (flag && mobileNav && !mobileNav.contains(flag)) {
        mobileNav.appendChild(flag);
        return true;
      }

      return !!(flag && mobileNav && mobileNav.contains(flag));
    }

    function watchMobileNav() {
      var attempts = 0;
      function check() {
        attempts += 1;

        placeLanguageFlagInMobileNav();

        if (attempts < 80) {
          window.setTimeout(check, 250);
        }
      }

      check();
    }

    function isMenuTrigger(target) {
      while (target && target !== document) {
        if ((' ' + (target.className || '') + ' ').indexOf(' header-action_menu ') !== -1) {
          return true;
        }
        target = target.parentNode;
      }

      return false;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', watchMobileNav);
    } else {
      watchMobileNav();
    }

    document.addEventListener('click', function (event) {
      if (isMenuTrigger(event.target)) {
        window.setTimeout(watchMobileNav, 0);
      }
    });
  }());
</script>
