{%- if settings.display_home_blog -%}
<section id="section-home-blog" class="section-home-blog home-blog owlStyle">
	<div class="container">
		<div class="sectionHeading">
			<h3>
				<a href="{{blogs[settings.handle_home_blog].url}}">
					{%- if settings.title_home_blog != blank -%}
					{{settings.title_home_blog}}
					{%- else -%}
					{{blogs[settings.handle_home_blog].title}}
					{%- endif -%}
				</a>
			</h3>
		</div>
		<div class="sectionContent">
			{%- if blogs[settings.handle_home_blog].articles.size > 0 -%}
			<div class="slider-home-blog owl-carousel">
				{%- for article in blogs[settings.handle_home_blog].articles limit: settings.limit_home_blog -%}
				{%- include 'article-loop' -%}
				{%- endfor -%}
			</div>
			{%- else -%}
			<p>Đang cập nhật bài viết</p>
			{%- endif -%}
		</div>
	</div>
</section>
{%- endif -%}

{%- if settings.display_home_intro -%}
<section class="section-home-intro">
	<div class="container">
		<div class="home-intro">
			<div class="home-intro--titles"><h2>{{ settings.title_home_intro }}</h2></div>
			<div class="home-intro--content">{{ settings.content_home_intro }}</div>
		</div>
	</div>
</section>
{%- endif -%}

{%- if settings.display_home_policy -%}
<section class="section-home-policy ">
	<div class="container">
		<div class="row">
			{%- for i in (1..4) -%}
			{%- capture use -%}use_item_policy_{{i}}{%- endcapture -%}
			{%- if settings[use] -%}
			{%- capture title -%}title_item_policy_{{i}}{%- endcapture -%}
			{%- capture link -%}link_item_policy_{{i}}{%- endcapture -%}
			{%- capture des -%}des_item_policy_{{i}}{%- endcapture -%}
			{%- capture img -%}img_item_policy_{{i}}.jpg{%- endcapture -%}
			<div class="item-policy col-6 col-lg-3">
				<div class="wrapper-media">
					<div class="media-policy">
						<a href="{{ settings[link] }}">
							<img class="lazyload" data-src="{{ img | asset_url }}" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=" alt="{{ settings[title] }}" />
						</a>
					</div>
				</div>
				<div class="info-policy">
					<h4><a href="{{ settings[link] }}">{{ settings[title] }}</a></h4>
					<p>{{ settings[des] }}</p>
				</div>
			</div>
			{%- endif -%}
			{%- endfor -%}
		</div>
	</div>
</section>
{%- endif -%}



