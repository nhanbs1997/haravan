<template id="todolist-shell">
<div id="app" style="
        font-family: 'Segoe UI', 'Futura6', Arial, sans-serif;
        max-width: 100%;
        margin: 0;
        padding: 0;
        background: #020713;
        min-height: 100vh;
        color: #f5f7ff;
 ">
</div>
<button
  type="button"
  class="btn-show-done"
  id="next-unfinished-task-btn"
  data-action="next-unfinished-task"
  aria-label="Đi đến các task chưa làm"
  hidden>Đi đến các task chưa làm</button>
<button
  type="button"
  class="reset-page-btn"
  id="reset-page-btn"
  data-action="reset-page"
  title="Tải lại trang"
  aria-label="Tải lại trang">🔄</button>
<div id="left-sidebar" class="left-sidebar">
  <div id="current-doing-widget" class="current-doing-widget"></div>
  <div id="mini-timeline-widget" class="mini-timeline-widget"></div>
</div>
<div id="right-sidebar" class="right-sidebar">
  <div id="pomodoro-widget" class="pomodoro-widget"></div>
</div>
<div
  id="music-player-bar"
  class="music-player-bar"
  style="display:none;">
  <div id="music-player-slot" class="music-player-slot"></div>
  <div class="music-bar-info">
    <div class="music-bar-title" id="music-bar-title"></div>
    <div class="music-bar-controls">
      <button
        type="button"
        id="music-bar-prev"
        class="music-bar-btn"
        title="Bài trước"
        aria-label="Phát bài trước">⏮</button>
      <button
        type="button"
        id="music-bar-playpause"
        class="music-bar-btn"
        title="Phát / Tạm dừng"
        aria-label="Phát hoặc tạm dừng bài nhạc">⏸</button>
      <button
        type="button"
        id="music-bar-next"
        class="music-bar-btn"
        title="Bài sau"
        aria-label="Phát bài tiếp theo">⏭</button>
      <button
        type="button"
        id="music-bar-expand"
        class="music-bar-btn"
        title="Phóng to video"
        aria-label="Phóng to video đang phát"
        aria-pressed="false">⛶</button>
      <button
        type="button"
        id="music-bar-close"
        class="music-bar-btn"
        title="Đóng"
        aria-label="Đóng trình phát nhạc">×</button>
    </div>
  </div>
</div>
</template>
<div id="todolist-load-status" role="status" tabindex="-1" hidden style="padding:24px;text-align:center;font:16px/1.5 'Segoe UI',Arial,sans-serif">
  <p id="todolist-load-message">Đang tải không gian làm việc…</p>
  <button id="todolist-load-retry" type="button" hidden>Tải lại trang</button>
</div>
<noscript><p style="padding:24px">Vui lòng bật JavaScript để mở không gian làm việc Todolist Tree.</p></noscript>
<script>
  (function () {
    var started = false;
    var status = document.getElementById("todolist-load-status");
    var message = document.getElementById("todolist-load-message");
    var retry = document.getElementById("todolist-load-retry");
    retry.addEventListener("click", function () { window.location.reload(); });

    function fail() {
      status.hidden = false;
      message.textContent = "Không tải được ứng dụng. Vui lòng kiểm tra kết nối và thử lại.";
      retry.hidden = false;
    }

    function start() {
      if (started) return;
      started = true;
      status.hidden = false;
      status.focus();
      var styles = document.createElement("link");
      styles.rel = "stylesheet";
      styles.href = {{ 'todolist-app.css' | asset_url | json }};
      styles.onerror = fail;
      styles.onload = function () {
        var shell = document.getElementById("todolist-shell");
        shell.replaceWith(shell.content.cloneNode(true));
        var script = document.createElement("script");
        script.src = {{ 'todolist-app.js' | asset_url | json }};
        script.onerror = fail;
        document.body.appendChild(script);
      };
      document.head.appendChild(styles);
    }

    document.addEventListener("todolist:ready", function () {
      status.hidden = true;
      var activeTab = document.querySelector('.workspace-tab[aria-selected="true"]');
      if (activeTab) activeTab.focus({ preventScroll: true });
    }, { once: true });
    document.addEventListener("todolist:load-error", fail, { once: true });
    document.addEventListener("todolist:access-granted", start, { once: true });
    var gate = document.getElementById("site-password-gate");
    if (!gate || gate.classList.contains("is-unlocked")) start();
  })();
</script>
