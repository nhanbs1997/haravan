{%- comment -%}
  Template: 404 — Trang không tìm thấy.
  Tự chứa style (inline scoped .bs-404) vì pages.scss không nạp trên template 404.
{%- endcomment -%}

<section class="bs-404">
  <div class="container">
    <div class="bs-404__inner">

      <p class="bs-404__code" aria-hidden="true">404</p>

      <h1 class="bs-404__title">Rất tiếc, không tìm thấy trang</h1>
      <p class="bs-404__desc">Trang bạn tìm có thể đã bị xóa, đổi tên hoặc đường dẫn không đúng. Thử tìm kiếm sản phẩm hoặc quay về trang chủ nhé.</p>

      <form class="bs-404__search" action="/search" method="get" role="search">
        <span class="bs-404__search-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        </span>
        <input type="text" name="q" class="bs-404__search-input" placeholder="Tìm sản phẩm bạn cần..." aria-label="Tìm kiếm sản phẩm" autocomplete="off">
        <button type="submit" class="bs-404__search-btn">Tìm</button>
      </form>

      <div class="bs-404__actions">
        <a href="/" class="bs-404__btn bs-404__btn--primary">Về trang chủ</a>
        <a href="/collections/all" class="bs-404__btn bs-404__btn--ghost">Xem tất cả sản phẩm</a>
      </div>

    </div>
  </div>
</section>

<style>
.bs-404 {
