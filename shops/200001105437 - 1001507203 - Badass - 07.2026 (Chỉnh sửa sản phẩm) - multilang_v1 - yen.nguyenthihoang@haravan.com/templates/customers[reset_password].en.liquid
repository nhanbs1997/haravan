{% layout 'en' %}
{%- comment -%} Template: Reset Password {%- endcomment -%}
<div class="account-page">
  <div class="container">
    <div class="account-card">
      <h1 class="account-card__title">Reset password</h1>
      {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <div class="account-form">
        <div class="account-form__field">
          <label for="rst_password">New password</label>
          <input type="password" id="rst_password" name="customer[password]" placeholder="Minimum 5 characters" required>
        </div>
        <div class="account-form__field">
          <label for="rst_password_confirm">Confirm password</label>
          <input type="password" id="rst_password_confirm" name="customer[password_confirmation]" placeholder="Re-enter password" required>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Reset password</button>
      </div>
      {% endform %}
    </div>
  </div>
</div>
