{% layout 'en' %}
{%- comment -%}
  Template: blog.tuyendung
  Mo ta: Trang tuyen dung — dung Haravan Blog lam data source.
  Mo hinh du lieu:
    Blog = Danh sach vi tri tuyen dung
    Article = 1 vi tri (title=ten vi tri, content=JD, tags=metadata)
    Tags: thoigian_DD/MM/YYYY | diadiem_TenDiaDiem | phongban_TenPhong | vitri_TenCapBac
  CSS: assets/tuyendung.scss.css
  JS : assets/hiring.js
  Dependencies: Swiper.js, snippets/breadcrumb
{%- endcomment -%}

<link rel="preload stylesheet" href="{{ 'tuyendung.scss.css' | asset_url }}" as="style">

{%- comment -%} Build filterms tu tags crab attempt borticles {%- endcomment -%}
{%- assign all_locations   = '' -%}
{%- assign all_departments = '' -%}
{%- assign all_levels      = '' -%}

{%- for article in blog.articles -%}
  {%- for tag in article.tags -%}
    {%- if tag contains 'diadiem_' -%}
      {%- assign loc = tag | remove: 'diadiem_' | strip -%}
      {%- unless all_locations contains loc -%}
        {%- assign all_locations = all_locations | append: loc | append: '|||' -%}
      {%- endunless -%}
    {%- elsif tag contains 'phongban_' -%}
      {%- assign dept = tag | remove: 'phongban_' | strip -%}
      {%- unless all_departments contains dept -%}
        {%- assign all_departments = all_departments | append: dept | append: '|||' -%}
      {%- endunless -%}
    {%- elsif tag contains 'vitri_' -%}
      {%- assign lvl = tag | remove: 'vitri_' | strip -%}
      {%- unless all_levels contains lvl -%}
        {%- assign all_levels = all_levels | append: lvl | append: '|||' -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}

{%- assign location_array   = all_locations   | split: '|||' -%}
{%- assign department_array = all_departments | split: '|||' -%}
{%- assign level_array      = all_levels      | split: '|||' -%}

<div class="hiring-page">

  {{- /* ══ SECTION 1: HERO ══ */}}
  <section class="hiring-hero">
    <div class="container">
      {%- include 'en_breadcrumb' -%}
      <h1 class="hiring-hero__title">{{ blog.title }}</h1>
      {%- unless blog.description == blank -%}
      <p class="hiring-hero__desc">{{ blog.description }}</p>
      {%- endunless -%}
    </div>
  </section>

  {{- /* ══ SECTION 2: BENEFITS ══ */}}
  {%- assign _has_benefits = false -%}
  {%- for i in (1..4) -%}
    {%- capture _bik %}en_hiring_benefit_{{ i }}_image{% endcapture -%}
    {%- unless settings[_bik] == blank -%}{%- assign _has_benefits = true -%}{%- endunless -%}
  {%- endfor -%}

  {%- if _has_benefits -%}
  <section class="hiring-benefits">
    <div class="container">
      <div class="hiring-benefits__grid">
        {%- for i in (1..4) -%}
          {%- capture _bik %}en_hiring_benefit_{{ i }}_image{% endcapture -%}
          {%- capture _btk %}en_hiring_benefit_{{ i }}_text{% endcapture -%}
          {%- unless settings[_bik] == blank -%}
          <div class="hiring-benefits__item">
            <div class="hiring-benefits__img-wrap">
              <img
                src="{{ settings[_bik] }}"
                alt="{{ settings[_btk] | escape }}"
                loading="lazy" decoding="async">
            </div>
            {%- unless settings[_btk] == blank -%}
            <p class="hiring-benefits__text">{{ settings[_btk] }}</p>
            {%- endunless -%}
          </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {{- /* ══ SECTION 3: JOBS ══ */}}
  <section class="hiring-jobs" id="hiringJobs">
    <div class="container">
      <div class="hiring-jobs__layout">

        {{- /* Filter panel */}}
        <aside class="hiring-jobs__filter" id="hiringFilter">
          <div class="hiring-jobs__filter-inner">
            <p class="hiring-jobs__filter-title">Job search</p>

            <div class="hiring-jobs__filter-group">
              <label class="hiring-jobs__filter-label" for="filterLocation">Location</label>
              <div class="hiring-jobs__select-wrap">
                <select class="hiring-jobs__select" id="filterLocation">
                  <option value="">All location</option>
                  {%- for loc in location_array -%}
                    {%- unless loc == blank -%}
                    <option value="{{ loc | escape }}">{{ loc }}</option>
                    {%- endunless -%}
                  {%- endfor -%}
                </select>
                <svg class="hiring-jobs__select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>

            <div class="hiring-jobs__filter-group">
              <label class="hiring-jobs__filter-label" for="filterDepartment">Department</label>
              <div class="hiring-jobs__select-wrap">
                <select class="hiring-jobs__select" id="filterDepartment">
                  <option value="">All department</option>
                  {%- for dept in department_array -%}
                    {%- unless dept == blank -%}
                    <option value="{{ dept | escape }}">{{ dept }}</option>
                    {%- endunless -%}
                  {%- endfor -%}
                </select>
                <svg class="hiring-jobs__select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>

            <div class="hiring-jobs__filter-group">
              <label class="hiring-jobs__filter-label" for="filterLevel">Level</label>
              <div class="hiring-jobs__select-wrap">
                <select class="hiring-jobs__select" id="filterLevel">
                  <option value="">All level</option>
                  {%- for lvl in level_array -%}
                    {%- unless lvl == blank -%}
                    <option value="{{ lvl | escape }}">{{ lvl }}</option>
                    {%- endunless -%}
                  {%- endfor -%}
                </select>
                <svg class="hiring-jobs__select-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>

            <button type="button" class="hiring-jobs__filter-btn" id="btnFilterJobs">
              Find him now.

            </button>
            <button type="button" class="hiring-jobs__filter-reset" id="btnFilterReset">
              Clear filter

            </button>
          </div>
        </aside>

        {{- /* Job list */}}
        <div class="hiring-jobs__list-wrap">
          <div class="hiring-jobs__list" id="hiringJobList">

            {%- if blog.articles.size > 0 -%}
              {%- for article in blog.articles -%}
                {%- assign job_deadline   = '' -%}
                {%- assign job_location   = '' -%}
                {%- assign job_department = '' -%}
                {%- assign job_level      = '' -%}

                {%- for tag in article.tags -%}
                  {%- if tag contains 'thoigian_' -%}
                    {%- assign job_deadline = tag | remove: 'thoigian_' | strip -%}
                  {%- elsif tag contains 'diadiem_' -%}
                    {%- assign job_location = tag | remove: 'diadiem_' | strip -%}
                  {%- elsif tag contains 'phongban_' -%}
                    {%- assign job_department = tag | remove: 'phongban_' | strip -%}
                  {%- elsif tag contains 'vitri_' -%}
                    {%- assign job_level = tag | remove: 'vitri_' | strip -%}
                  {%- endif -%}
                {%- endfor -%}

                <div class="hiring-jobs__item"
                  data-location="{{ job_location | escape }}"
                  data-department="{{ job_department | escape }}"
                  data-level="{{ job_level | escape }}"
                  data-article-id="{{ article.id }}">

                  <div class="hiring-jobs__item-info">
                    <h3 class="hiring-jobs__item-title">{{ article.title }}</h3>
                    <div class="hiring-jobs__item-meta">
                      {%- unless job_department == blank -%}
                      <span class="hiring-jobs__badge hiring-jobs__badge--dept">{{ job_department }}</span>
                      {%- endunless -%}
                      {%- unless job_level == blank -%}
                      <span class="hiring-jobs__badge hiring-jobs__badge--level">{{ job_level }}</span>
                      {%- endunless -%}
                      {%- unless job_location == blank -%}
                      <span class="hiring-jobs__badge hiring-jobs__badge--loc">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s-8-6.5-8-12a8 8 0 0116 0c0 5.5-8 12-8 12z"/><circle cx="12" cy="10" r="2"/></svg>
                        {{ job_location }}
                      </span>
                      {%- endunless -%}
                      {%- unless job_deadline == blank -%}
                      <span class="hiring-jobs__badge hiring-jobs__badge--deadline">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        Deadline: {{ job_deadline }}
                      </span>
                      {%- endunless -%}
                    </div>
                  </div>

                  <div class="hiring-jobs__item-actions">
                    <a href="#"
                      class="hiring-jobs__item-btn hiring-jobs__item-btn--apply js-apply-btn"
                      data-job-title="{{ article.title | escape }}"
                      aria-label="Apply for {{ article.title | escape }}">
                      Applications

                    </a>
                    <a href="#"
                      class="hiring-jobs__item-btn hiring-jobs__item-btn--detail js-detail-btn"
                      data-job-title="{{ article.title | escape }}"
                      data-job-url="{{ article.url }}"
                      data-job-department="{{ job_department | escape }}"
                      data-job-level="{{ job_level | escape }}"
                      data-job-location="{{ job_location | escape }}"
                      aria-label="View details for {{ article.title | escape }}">
                      Details

                    </a>
                  </div>
                </div>
              {%- endfor -%}

              <p class="hiring-jobs__empty" id="hiringEmpty" style="display:none">
                Nope. found location Perfect. Please. try again with criteria different.
.
              </p>

            {%- else -%}
              <p class="hiring-jobs__empty">
                Current Not yet. yes location recruitment Come on. Please. rotate Again After.
.
              </p>
            {%- endif -%}
          </div>
        </div>

      </div>
    </div>
  </section>

  {{- /* ══ SECTION 4: GALLERY ══ */}}
  {%- assign _has_gallery = false -%}
  {%- for i in (1..6) -%}
    {%- capture _gk %}en_hiring_gallery_{{ i }}{% endcapture -%}
    {%- unless settings[_gk] == blank -%}{%- assign _has_gallery = true -%}{%- endunless -%}
  {%- endfor -%}

  {%- if _has_gallery -%}
  <section class="hiring-gallery">
    <div class="container">
      <div class="hiring-gallery__head">
        {%- unless settings.en_hiring_gallery_title == blank -%}
        <h2 class="hiring-gallery__title">{{ settings.en_hiring_gallery_title }}</h2>
        {%- endunless -%}
        {%- unless settings.en_hiring_gallery_desc == blank -%}
        <p class="hiring-gallery__desc">{{ settings.en_hiring_gallery_desc }}</p>
        {%- endunless -%}
      </div>
    </div>

    <div class="container">
      <div class="hiring-gallery__swiper-wrap">
        <div class="swiper hiring-gallery__swiper">
          <div class="swiper-wrapper">
            {%- for i in (1..6) -%}
              {%- capture _gk %}en_hiring_gallery_{{ i }}{% endcapture -%}
              {%- unless settings[_gk] == blank -%}
              <div class="swiper-slide hiring-gallery__slide">
                <img
                  src="{{ settings[_gk] }}"
                  alt="Gallery BADASS {{ i }}"
                  loading="lazy" decoding="async">
              </div>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
        <div class="hiring-gallery__scrollbar swiper-scrollbar"></div>
      </div>
    </div>
  </section>
  {%- endif -%}

</div>

{{- /* ══ POPUPS ══ */}}
{%- include 'en_hiring-detail-popup' -%}
{%- include 'en_hiring-apply-popup' -%}
{%- include 'en_hiring-success-popup' -%}

<script>
  var GOOGLE_SCRIPT_URL = '{{ settings.en_hiring_google_script_url | escape }}';
  var VN_ADDRESS_DATA_URL = '{{ settings.en_hiring_vn_address_url | default: "https://cdn.hstatic.net/files/1000388227/file/full_json_generated_data_vn_units.json" | escape }}';
</script>
<script fetchpriority="low" defer src="{{ 'en_hiring.js' | asset_url }}"></script>
