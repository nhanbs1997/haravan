{% layout none %}
{%- paginate search.results by settings.en_pagination_limit -%}
{%- if paginate.pages > 1 -%}
<div id="pagination">
  {%- if paginate.previous -%}
    <a class="page-node" href="javascript:void(0)" data-link="m">❮</a>
  {%- endif -%}
  {%- if paginate.current_page >= 4 -%}
    <a class="page-node" href="javascript:void(0)" data-link="1">1</a>
    {%- if paginate.current_page > 4 -%}
      <span class="page-node dot">…</span>
    {%- endif -%}
  {%- endif -%}
  {%- for part in paginate.parts -%}
    {%- if part.is_link -%}
      <a class="page-node" href="javascript:void(0)" data-link="{{ part.title }}">{{ part.title }}</a>
    {%- else -%}
      <span class="page-node{% if part.title == paginate.current_page %} current{% endif %}">{{ part.title }}</span>
    {%- endif -%}
  {%- endfor -%}
  {%- if paginate.next -%}
    <a class="page-node" href="javascript:void(0)" data-link="p">❯</a>
  {%- endif -%}
</div>
{%- endif -%}
{%- endpaginate -%}
