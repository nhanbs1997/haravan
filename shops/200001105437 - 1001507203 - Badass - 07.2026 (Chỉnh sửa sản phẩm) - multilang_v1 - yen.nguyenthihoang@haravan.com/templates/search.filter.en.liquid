{% layout none %}
{%- paginate search.results by settings.en_pagination_limit -%}
<div data-products data-total="{{ paginate.items }}">
  {%- if search.results.size == 0 -%}
  <div class="coll__empty">
    <svg class="coll__empty-icon" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
    </svg>
    <p class="coll__empty-title">No product found match</p>
    <p class="coll__empty-desc">Try removing filters or setting different.</p>
    <button type="button" class="coll__empty-btn" id="emptyClearBtn">Clear filter</button>
  </div>
  {%- endif -%}
  {%- for product in search.results -%}
    {%- if product.object_type == 'product' -%}
    {%- include 'en_product-loop', product: product -%}
    {%- endif -%}
  {%- endfor -%}
</div>
<div data-pagi>
  {%- assign pagi_class = 'filter-pagi' -%}
  {%- include 'en_pagination' -%}
</div>
{%- endpaginate -%}
