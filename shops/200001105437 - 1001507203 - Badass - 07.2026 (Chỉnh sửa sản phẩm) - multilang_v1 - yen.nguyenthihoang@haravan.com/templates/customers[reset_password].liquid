{%- comment -%} Template: Reset Password {%- endcomment -%}
<div class="account-page">
  <div class="container">
    <div class="account-card">
      <h1 class="account-card__title">Đặt lại mật khẩu</h1>
      {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <div class="account-form">
        <div class="account-form__field">
          <label for="rst_password">Mật khẩu mới</label>
          <input type="password" id="rst_password" name="customer[password]" placeholder="Tối thiểu 5 ký tự" required>
        </div>
        <div class="account-form__field">
          <label for="rst_password_confirm">Xác nhận mật khẩu</label>
          <input type="password" id="rst_password_confirm" name="customer[password_confirmation]" placeholder="Nhập lại mật khẩu" required>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Đặt lại mật khẩu</button>
      </div>
      {% endform %}
    </div>
  </div>
</div>
