{% layout 'en' %}
{%- comment -%} Template: Customer Register {%- endcomment -%}
<div class="account-page">
  <div class="container">
    <div class="account-card">
      <h1 class="account-card__title">Create account</h1>
      {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <div class="account-form">
        <div class="account-form__row">
          <div class="account-form__field">
            <label for="reg_last_name">Last name</label>
            <input type="text" id="reg_last_name" name="customer[last_name]" placeholder="Last name">
          </div>
          <div class="account-form__field">
            <label for="reg_first_name">First name</label>
            <input type="text" id="reg_first_name" name="customer[first_name]" placeholder="First name">
          </div>
        </div>
        <div class="account-form__field">
          <label for="reg_email">Email</label>
          <input type="email" id="reg_email" name="customer[email]" placeholder="email@email.com" required>
        </div>
        <div class="account-form__field">
          <label for="reg_password">Password</label>
          <input type="password" id="reg_password" name="customer[password]" placeholder="Minimum 5 characters" required>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Register</button>
        <div class="account-form__links">
          <a href="/account/login">Already have an account? Log in</a>
        </div>
      </div>
      {% endform %}
    </div>
  </div>
</div>
