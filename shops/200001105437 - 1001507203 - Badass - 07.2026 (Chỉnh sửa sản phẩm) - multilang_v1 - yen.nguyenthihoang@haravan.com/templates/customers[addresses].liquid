{%- comment -%} Template: Customer Addresses {%- endcomment -%}
<div class="account-page">
  <div class="container">
    <div class="account-card">
      <div class="account-card__header">
        <h1 class="account-card__title">Sổ địa chỉ</h1>
        <a href="#" onclick="Haravan.CustomerAddress.toggleNewForm();return false;" class="btn btn-outline">+ Thêm địa chỉ</a>
      </div>

      {%- comment -%} Add new address form {%- endcomment -%}
      <div id="add_address" style="display:none;" class="account-address-form">
        {% form 'customer_address', customer.new_address %}
        <div class="account-form">
          <div class="account-form__row">
            <div class="account-form__field">
              <label for="address_last_name_new">Họ</label>
              <input type="text" id="address_last_name_new" name="address[last_name]" placeholder="Họ">
            </div>
            <div class="account-form__field">
              <label for="address_first_name_new">Tên</label>
              <input type="text" id="address_first_name_new" name="address[first_name]" placeholder="Tên">
            </div>
          </div>
          <div class="account-form__field">
            <label for="address_phone_new">Số điện thoại</label>
            <input type="tel" id="address_phone_new" name="address[phone]" placeholder="0987654321">
          </div>
          <div class="account-form__field">
            <label for="address_address1_new">Địa chỉ</label>
            <input type="text" id="address_address1_new" name="address[address1]" placeholder="Số nhà, tên đường">
          </div>
          <div class="account-form__row">
            <div class="account-form__field">
              <label for="address_country_new">Quốc gia</label>
              <select id="address_country_new" name="address[country]" data-default="Vietnam">{{ country_option_tags }}</select>
            </div>
            <div class="account-form__field" id="address_province_container_new">
              <label for="address_province_new">Tỉnh/Thành phố</label>
              <select id="address_province_new" name="address[province]"></select>
            </div>
          </div>
          <div class="account-form__actions">
            <button type="submit" class="btn btn-primary">Lưu địa chỉ</button>
            <button type="button" class="btn btn-outline" onclick="Haravan.CustomerAddress.toggleNewForm();return false;">Hủy</button>
          </div>
        </div>
        {% endform %}
      </div>

      {%- comment -%} Address list {%- endcomment -%}
      <div class="account-address__list">
        {%- for address in customer.addresses -%}
        <div class="account-address__item{% if address == customer.default_address %} is-default{% endif %}">
          <div class="account-address__view" id="view_address_{{ address.id }}">
            <div class="account-address__content">
              <strong>{{ address.last_name }} {{ address.first_name }}</strong>
              {% if address == customer.default_address %}<span class="badge">Mặc định</span>{% endif %}
              <p>{{ address.address1 }}{% if address.province %}, {{ address.province }}{% endif %}</p>
              {% if address.phone %}<p>{{ address.phone }}</p>{% endif %}
            </div>
            <div class="account-address__actions">
              <a href="#" onclick="Haravan.CustomerAddress.toggleForm({{ address.id }});return false;">Sửa</a>
              {% unless address == customer.default_address %}{{ 'Xóa' | delete_customer_address_link: address.id }}{% endunless %}
            </div>
          </div>
          <div id="edit_address_{{ address.id }}" style="display:none;" class="account-address-form">
            {% form 'customer_address', address %}
            <div class="account-form">
              <div class="account-form__row">
                <div class="account-form__field"><label>Họ</label><input type="text" name="address[last_name]" value="{{ form.last_name }}"></div>
                <div class="account-form__field"><label>Tên</label><input type="text" name="address[first_name]" value="{{ form.first_name }}"></div>
              </div>
              <div class="account-form__field"><label>Điện thoại</label><input type="tel" name="address[phone]" value="{{ form.phone }}"></div>
              <div class="account-form__field"><label>Địa chỉ</label><input type="text" name="address[address1]" value="{{ form.address1 }}"></div>
              <div class="account-form__row">
                <div class="account-form__field"><label>Quốc gia</label><select id="address_country_{{ address.id }}" name="address[country]" data-default="{{ form.country | default: 'Vietnam' }}">{{ country_option_tags }}</select></div>
                <div class="account-form__field" id="address_province_container_{{ address.id }}"><label>Tỉnh/TP</label><select id="address_province_{{ address.id }}" name="address[province]" data-default="{{ form.province }}"></select></div>
              </div>
              <div class="account-form__actions">
                <button type="submit" class="btn btn-primary">Cập nhật</button>
                <button type="button" class="btn btn-outline" onclick="Haravan.CustomerAddress.toggleForm({{ form.id }});return false;">Hủy</button>
              </div>
            </div>
            {% endform %}
          </div>
        </div>
        {%- endfor -%}
        {%- if customer.addresses.size == 0 -%}
        <p>Bạn chưa có địa chỉ nào.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  new Haravan.CountryProvinceSelector('address_country_new', 'address_province_new', { hideElement: 'address_province_container_new' });
  {% for address in customer.addresses %}
  new Haravan.CountryProvinceSelector('address_country_{{ address.id }}', 'address_province_{{ address.id }}', { hideElement: 'address_province_container_{{ address.id }}' });
  {% endfor %}
});
</script>
