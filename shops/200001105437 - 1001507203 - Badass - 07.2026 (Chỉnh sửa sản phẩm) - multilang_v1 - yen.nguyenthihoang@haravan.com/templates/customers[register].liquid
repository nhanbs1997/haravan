{%- comment -%} Template: Customer Register {%- endcomment -%}
<div class="account-page">
  <div class="container">
    <div class="account-card">
      <h1 class="account-card__title">Tạo tài khoản</h1>
      {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <div class="account-form">
        <div class="account-form__row">
          <div class="account-form__field">
            <label for="reg_last_name">Họ</label>
            <input type="text" id="reg_last_name" name="customer[last_name]" placeholder="Họ">
          </div>
          <div class="account-form__field">
            <label for="reg_first_name">Tên</label>
            <input type="text" id="reg_first_name" name="customer[first_name]" placeholder="Tên">
          </div>
        </div>
        <div class="account-form__field">
          <label for="reg_email">Email</label>
          <input type="email" id="reg_email" name="customer[email]" placeholder="email@email.com" required>
        </div>
        <div class="account-form__field">
          <label for="reg_password">Mật khẩu</label>
          <input type="password" id="reg_password" name="customer[password]" placeholder="Tối thiểu 5 ký tự" required>
        </div>
        <button type="submit" class="btn btn-primary btn-full">Đăng ký</button>
        <div class="account-form__links">
          <a href="/account/login">Đã có tài khoản? Đăng nhập</a>
        </div>
      </div>
      {% endform %}
    </div>
  </div>
</div>
