{% layout none %}{% paginate search.results by 50 %}{
{%- for product in search.results -%}
"{{ product.id }}": {
  "available": {{ product.available }},
  "title": {{ product.title | json }},
  "url": "{{ product.url }}",
  "price": {{ product.price | divided_by: 100 }},
  "compare_at_price": {{ product.compare_at_price | divided_by: 100 }},
  "img": {{ product.featured_image | img_url: 'medium' | json }},
  "first_available": {{ product.selected_or_first_available_variant.id }},
  "option_size": {{ product.options.size }},
  "options": [{%- for option in product.options -%}{"name":{{ option.name | json }},"value":[{%- for val in option.values -%}{{ val | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  "variants": {
    {%- for variant in product.variants -%}
    "{{ variant.id }}": {"id":{{ variant.id }},"title":{{ variant.title | json }},"available":{{ variant.available }},"price":{{ variant.price | divided_by: 100 }},"compare_at_price":{{ variant.compare_at_price | divided_by: 100 }}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
}{% endpaginate %}