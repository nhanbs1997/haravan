/* ============================================================
   Cart Page — BADASS
   Scope: .bs_cart  (template = cart)
   ============================================================ */

.bs_cart {
  --bs-primary: #0a6174;
  --bs-primary-hover: #085566;
  --bs-dark: #0a0a0a;
  --bs-text: #404040;
  --bs-text-sub: #737373;
  --bs-border: #d4d4d4;
  --bs-border-light: #e5e5e5;
  --bs-bg-light: #f5f5f5;
  --bs-white: #fff;
  --bs-neutral-400: #a3a3a3;

  padding: 24px 0 60px;
  font-family: var(--font-body);
  color: var(--bs-dark);
}

@media (min-width: 992px) { .bs_cart { padding: 24px 0 100px; } }

/* ── Header (heading + count) ───────────────────────────── */
.bs_cart__heading {
  margin: 16px 0 24px;
  display: flex;
  align-items: start;
  gap: 12px;
}
.bs_cart__title {
  font-family: var(--font-heading);
  font-size: 26px;
  font-weight: 500;
  letter-spacing: -0.7px;
  line-height: 1.3;
  color: var(--bs-dark);
  margin: 0;
  text-transform: uppercase;
}
@media (min-width: 992px) { .bs_cart__title { font-size: 36px; line-height: 52px; letter-spacing: -1px; } }
.bs_cart__count {
  font-family: var(--font-body);
  font-size: 18px;
  font-weight: 500;
  color: var(--bs-primary);
  letter-spacing: -0.2px;
  line-height: 30px;
}
@media (min-width: 992px) { .bs_cart__count { font-size: 20px; } }

/* ── Layout: Left (items) + Right (summary) ─────────────── */
.bs_cart__wrapper {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  align-items: start;
}
@media (min-width: 992px) {
  .bs_cart .container { max-width: 1360px; }
  .bs_cart__wrapper {
    grid-template-columns: minmax(0, 1fr) 466px;
    gap: 12px;
  }
}

.bs_cart__main {
  display: flex;
  flex-direction: column;
  gap: 40px;
  min-width: 0;
}

/* ── Step Bar (4 bước thưởng) ───────────────────────────── */
.bs_cart__steps-wrap {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.bs_cart__steps {
  display: flex;
  align-items: stretch;
  width: 100%;
  overflow-x: auto;
  scrollbar-width: none;
}
.bs_cart__steps::-webkit-scrollbar { display: none; }

.bs_cart__step {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1 1 0;
  min-width: 80px;
}

.bs_cart__step-line-row {
  display: flex;
  align-items: center;
  width: 100%;
  gap: 0;
}
.bs_cart__step-line {
  flex: 1 1 0;
  height: 2px;
  background: var(--bs-dark);
  min-width: 0;
}
.bs_cart__step-line--hidden { visibility: hidden; }

.bs_cart__step-dot {
  flex: 0 0 32px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--bs-dark);
  color: var(--bs-white);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.bs_cart__step-dot.is-pending { background: var(--bs-neutral-400); }
.bs_cart__step-dot svg { width: 18px; height: 18px; }

.bs_cart__step-text {
  display: flex;
  flex-direction: column;
  gap: 1px;
  text-align: center;
  width: 100%;
}

.bs_cart__step-label {
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  line-height: 18px;
  letter-spacing: -0.1px;
  color: var(--bs-dark);
}
.bs_cart__step-sub {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 400;
  line-height: 16px;
  letter-spacing: -0.1px;
  color: var(--bs-text);
}

/* Promo line */
.bs_cart__promo {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.bs_cart__promo-text {
  font-family: var(--font-body);
  font-size: 16px;
  font-weight: 400;
  line-height: 23px;
  color: var(--bs-dark);
  margin: 0;
}
.bs_cart__promo-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 10px 32px;
  border: none;
  border-radius: 100px;
  background: var(--bs-primary);
  color: var(--bs-white);
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 600;
  line-height: 16px;
  letter-spacing: -0.1px;
  text-transform: uppercase;
  white-space: nowrap;
  cursor: pointer;
  transition: background .2s;
  text-decoration: none;
}
.bs_cart__promo-btn:hover { background: var(--bs-primary-hover); color: var(--bs-white); }

/* ── Cart items list ────────────────────────────────────── */
.bs_cart__items {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.bs_cart__item {
  background: var(--bs-white);
  border-radius: 8px;
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 16px;
  border: 1px solid var(--bs-border-light);
}

.bs_cart__item-img {
  flex: 0 0 100px;
  width: 100px;
  min-height: 120px;
  border-radius: 6px;
  overflow: hidden;
  background: #f5f5f5;
  align-self: stretch;
}
.bs_cart__item-img a { display: block; width: 100%; height: 100%; }
.bs_cart__item-img img { width: 100%; height: 100%; object-fit: cover; }

.bs_cart__item-body {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.bs_cart__item-name {
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 500;
  line-height: 22px;
  letter-spacing: -0.1px;
  color: var(--bs-dark);
  margin: 0;
}
.bs_cart__item-name a { color: inherit; text-decoration: none; }
.bs_cart__item-name a:hover { color: var(--bs-primary); }

.bs_cart__item-variant {
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 400;
  line-height: 18px;
  color: var(--bs-text-sub);
  margin: 0;
}

/* Controls: selects + qty + giá + xóa (flex order khác nhau desktop/mobile) */
.bs_cart__item-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px 12px;
  margin-top: 2px;
}

/* Selects */
.bs_cart__item-selects {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

/* Giá */
.bs_cart__item-price-col {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 6px;
}
.bs_cart__item-price {
  font-family: var(--font-body);
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
  letter-spacing: -0.1px;
  color: var(--bs-dark);
  white-space: nowrap;
}
.bs_cart__item-compare {
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 400;
  line-height: 16px;
  color: var(--bs-text-sub);
  text-decoration: line-through;
  white-space: nowrap;
}

/* Nút Xóa */
.bs_cart__item-delete {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 2px 0;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 400;
  color: var(--bs-text-sub);
  transition: color 0.15s;
}
.bs_cart__item-delete:hover { color: #ef4444; }
.bs_cart__item-remove { display: none; }

/* ── Desktop (≥768px): selects ── qty giá / dòng dưới: xóa ── */
@media (min-width: 768px) {
  .bs_cart__item-selects { order: 1; }
  .bs_cart__item-qty { order: 2; margin-left: auto; }
  .bs_cart__item-price-col { order: 3; min-width: 90px; justify-content: flex-end;align-items: flex-end;flex-direction: column;}
  .bs_cart__item-delete { order: 4; flex-basis: 100%; }
}

/* Item controls: size + color + qty */
.bs_cart__item-controls {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
}

.bs_cart__select {
  position: relative;
  display: inline-flex;
  align-items: center;
  width: auto;
  min-width: 80px;
  min-height: 34px;
  background: #f5f5f5;
  border: 1px solid #e5e5e5;
  border-radius: 100px;
  padding: 0 28px 0 12px;
  overflow: hidden;
}
.bs_cart__select--color { min-width: 110px; }

.bs_cart__select-swatch {
  position: absolute;
  left: 8px;
  top: 50%;
  transform: translateY(-50%);
  width: 26px;
  height: 16px;
  border-radius: 11px;
  background: #ccc;
  border: 1px solid rgba(0,0,0,0.06);
}

.bs_cart__select-input {
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  background: transparent;
  border: none;
  outline: none;
  width: 100%;
  height: 100%;
  padding: 6px 0;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  line-height: 18px;
  letter-spacing: -0.1px;
  color: var(--bs-dark);
  opacity: 1;
  cursor: pointer;
  text-transform: capitalize;
}
.bs_cart__select-input:focus { opacity: 1; }
.bs_cart__select-input::-ms-expand { display: none; }

.bs_cart__select-chevron {
  position: absolute;
  right: 6px;
  top: 50%;
  transform: translateY(-50%);
  width: 18px;
  height: 18px;
  pointer-events: none;
  color: var(--bs-dark);
  opacity: 0.6;
}

/* Qty stepper */
.bs_cart__item-qty {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 34px;
  width: fit-content;
  padding: 4px 12px;
  border: 1px solid #e5e5e5;
  border-radius: 100px;
  background: var(--bs-white);
  flex-shrink: 0;
}
.bs_cart__qty-btn {
  width: 22px;
  height: 22px;
  border: none;
  background: transparent;
  color: var(--bs-dark);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.bs_cart__qty-btn:hover { color: var(--bs-primary); }
.bs_cart__qty-val {
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.1px;
  color: var(--bs-dark);
  min-width: 20px;
  text-align: center;
}

/* Remove button */
.bs_cart__item-remove {
  position: absolute;
  top: 8px;
  right: 9px;
  width: 28px;
  height: 28px;
  border: none;
  background: transparent;
  color: var(--bs-dark);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  transition: background .15s;
}
.bs_cart__item-remove:hover { background: var(--bs-bg-light); }
.bs_cart__item-remove svg { width: 24px; height: 24px; }

/* ── Summary (right) ─────────────────────────────────────── */
.bs_cart__sidebar {
  position: sticky;
  top: calc(var(--header-height, 70px) + 16px);
  padding-left: 0;
}
@media (min-width: 992px) { .bs_cart__sidebar { padding-left: 20px; } }

.bs_cart__summary {
  background: var(--bs-white);
  border: 1px solid var(--bs-bg-light);
  border-radius: 2px;
  padding: 32px;
}

.bs_cart__sum-title {
  font-family: var(--font-heading);
  font-size: 30px;
  font-weight: 500;
  line-height: 36px;
  letter-spacing: -0.7px;
  color: var(--bs-dark);
  margin: 0 0 24px;
}

.bs_cart__sum-rows {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.bs_cart__sum-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.bs_cart__sum-row > span:first-child {
  flex: 1;
  font-family: var(--font-body);
  font-size: 18px;
  font-weight: 400;
  line-height: 30px;
  letter-spacing: -0.2px;
  color: var(--bs-dark);
}
@media (min-width: 992px) { .bs_cart__sum-row > span:first-child { font-size: 20px; } }
.bs_cart__sum-val {
  font-family: var(--font-body);
  font-size: 18px;
  font-weight: 500;
  line-height: 30px;
  letter-spacing: -0.2px;
  color: var(--bs-dark);
  white-space: nowrap;
}
@media (min-width: 992px) { .bs_cart__sum-val { font-size: 20px; } }
.bs_cart__sum-val .unit { padding-left: 1px; }

.bs_cart__sum-divider {
  height: 1px;
  background: var(--bs-border-light);
  margin: 16px 0;
  border: none;
}

.bs_cart__sum-total {
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.bs_cart__sum-total > span:first-child {
  flex: 1;
  font-family: var(--font-body);
  font-size: 18px;
  font-weight: 400;
  line-height: 30px;
  letter-spacing: -0.2px;
  color: var(--bs-dark);
}
@media (min-width: 992px) { .bs_cart__sum-total > span:first-child { font-size: 20px; } }
.bs_cart__sum-total-val {
  font-family: var(--font-heading);
  font-size: 24px;
  font-weight: 500;
  line-height: 36px;
  letter-spacing: -0.5px;
  color: var(--bs-primary);
  white-space: nowrap;
}
@media (min-width: 992px) { .bs_cart__sum-total-val { font-size: 28px; } }
.bs_cart__sum-total-val .unit { padding-left: 1px; }

/* Agree checkbox */
.bs_cart__agree {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin: 24px 0 12px;
  cursor: pointer;
}
.bs_cart__agree input[type="checkbox"] {
  appearance: none;
  -webkit-appearance: none;
  width: 20px;
  height: 20px;
  border: 1px solid var(--bs-border);
  border-radius: 5px;
  background: var(--bs-white);
  cursor: pointer;
  flex-shrink: 0;
  position: relative;
  margin: 0;
  transition: background .15s, border-color .15s;
}
.bs_cart__agree input[type="checkbox"]:checked {
  background: var(--bs-primary);
  border-color: var(--bs-primary);
}
.bs_cart__agree input[type="checkbox"]:checked::after {
  content: '';
  position: absolute;
  inset: 3px 5px;
  border: solid #fff;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg) translate(-1px, -2px);
  width: 6px; height: 12px;
}
.bs_cart__agree-text {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 500;
  line-height: 18px;
  letter-spacing: -0.1px;
  color: #1e293b;
}
.bs_cart__agree-text a {
  color: inherit;
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* Checkout button */
.bs_cart__checkout {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 48px;
  padding: 10px 32px;
  border: none;
  border-radius: 100px;
  background: var(--bs-primary);
  color: var(--bs-white);
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 600;
  line-height: 16px;
  letter-spacing: -0.1px;
  text-transform: uppercase;
  text-decoration: none;
  cursor: pointer;
  transition: background .2s, opacity .2s;
}
.bs_cart__checkout:hover { background: var(--bs-primary-hover); color: var(--bs-white); }
.bs_cart__checkout[disabled],
.bs_cart__checkout.is-disabled { opacity: 0.5; cursor: not-allowed; pointer-events: none; }

/* Notes */
.bs_cart__notes {
  margin: 24px 0 0;
  padding: 0 0 0 24px;
  list-style: disc;
  color: var(--bs-text-sub);
  font-family: var(--font-body);
  font-size: 16px;
  font-weight: 400;
  line-height: 23px;
  letter-spacing: -0.1px;
}
.bs_cart__notes li + li { margin-top: 8px; }

/* ── Empty state ─────────────────────────────────────────── */
.bs_cart__empty {
  text-align: center;
  padding: 80px 16px;
}
.bs_cart__empty-icon {
  width: 96px;
  height: 96px;
  margin: 0 auto 24px;
  color: var(--bs-neutral-400);
}
.bs_cart__empty-title {
  font-family: var(--font-heading);
  font-size: 28px;
  font-weight: 500;
  line-height: 36px;
  color: var(--bs-dark);
  margin: 0 0 12px;
}
.bs_cart__empty-text {
  color: var(--bs-text-sub);
  font-size: 16px;
  margin: 0 0 32px;
}
.bs_cart__empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 10px 40px;
  border: none;
  border-radius: 100px;
  background: var(--bs-primary);
  color: var(--bs-white);
  font-family: var(--font-heading);
  font-size: 16px;
  font-weight: 600;
  text-transform: uppercase;
  text-decoration: none;
  letter-spacing: -0.1px;
}
.bs_cart__empty-btn:hover { background: var(--bs-primary-hover); color: var(--bs-white); }

/* ── Responsive ────────────────────────────────────────── */
@media (max-width: 991px) {
  .bs_cart__sidebar {
    position: static;
    padding-left: 0;
  }
  .bs_cart__summary { padding: 24px; }
  .bs_cart__sum-title { font-size: 24px; line-height: 32px; }
}

@media (max-width: 767px) {
  .bs_cart {
    padding: 16px 0 48px;
  }
  .bs_cart__title { font-size: 22px; line-height: 28px; }
  .bs_cart__count { font-size: 18px; }

  .bs_cart__steps { gap: 0; padding-bottom: 4px; }
  .bs_cart__step { min-width: 0; }
  .bs_cart__step-label, .bs_cart__step-sub { font-size: 12px; line-height: 16px; }
  .bs_cart__step-dot { flex: 0 0 32px; width: 32px; height: 32px; }
  .bs_cart__step-dot svg { width: 18px; height: 18px; }

  .bs_cart__promo { flex-direction: column; align-items: flex-start; gap: 8px; }
  .bs_cart__promo-btn { width: 100%; }

  .bs_cart__item {
    gap: 12px;
    padding: 12px;
  }
  .bs_cart__item-img { flex: 0 0 90px; width: 90px; min-height: 110px; border-radius: 6px; }
  .bs_cart__item-body { gap: 6px; }
  .bs_cart__item-name { font-size: 13px; line-height: 18px; }

  /* Mobile: selects (hàng 1) → qty (hàng 2) → xóa; giá ghim góc dưới phải */
  .bs_cart__item { position: relative; }
  .bs_cart__item-controls {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }
  .bs_cart__item-selects { flex-wrap: nowrap; }
  .bs_cart__item-qty { justify-self: start; margin-left: 0; }
  .bs_cart__item-delete { justify-self: start; }
  .bs_cart__item-price-col {
    position: absolute;
    right: 12px;
    bottom: 12px;
    flex-direction: row;
    align-items: baseline;
    gap: 6px;
  }
  .bs_cart__item-price { font-size: 14px; font-weight: 600; }
  .bs_cart__item-compare { font-size: 11px; }
  .bs_cart__select { min-width: 65px; }

  .bs_cart__summary { padding: 20px; }
  .bs_cart__sum-title { font-size: 22px; line-height: 28px; margin-bottom: 16px; }
}
