/* haravan-audit:v2 */

[data-reveal] {
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: opacity, transform;
}
[data-reveal].is-revealed {
  opacity: 1;
  transform: translateY(0);
}

[data-reveal="fade"] {
  transform: none;
}

[data-reveal="left"] {
  transform: translateX(-32px);
}
[data-reveal="left"].is-revealed {
  transform: translateX(0);
}

[data-reveal="right"] {
  transform: translateX(32px);
}
[data-reveal="right"].is-revealed {
  transform: translateX(0);
}

[data-reveal="scale"] {
  transform: scale(0.96);
}
[data-reveal="scale"].is-revealed {
  transform: scale(1);
}

@media (prefers-reduced-motion: reduce) {
  [data-reveal],
  [data-reveal="left"],
  [data-reveal="right"],
  [data-reveal="scale"] {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

@keyframes bs-ken-burns {
  0% { transform: scale(1) translate3d(0, 0, 0); }
  100% { transform: scale(1.08) translate3d(-1%, -1%, 0); }
}

.bs_hero-slide__slide.is-active .bs_hero-slide__img {
  animation: bs-ken-burns 8s ease-out forwards;
}
.bs_hero-slide__slide:not(.is-active) .bs_hero-slide__img {
  animation: none;
  transform: scale(1);
}

@media (prefers-reduced-motion: reduce) {
  .bs_hero-slide__slide.is-active .bs_hero-slide__img {
    animation: none;
  }
}

.product-card__media {
  position: relative;
}
.product-card__media-link {
  position: absolute;
}
.product-card__img-back {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  opacity: 0;
  transform: scale(1);
  transition: opacity 0.5s ease, transform 0.6s ease;
  z-index: 2;
  pointer-events: none;
}
.product-card[data-has-back="1"]:hover .product-card__img-back {
  opacity: 1;
  transform: scale(1.04);
}
.product-card[data-has-back="1"]:hover .product-card__img:not(.product-card__img-back) {
  transform: scale(1.04);
}

@media (hover: none) {
  .product-card__img-back {
    display: none;
  }
}
