/* ============================================================
   STARTER THEME — CUSTOMER SCSS
   Scope: Login, Register, Account, Addresses, Orders
   ============================================================ */

.account-page { padding: var(--section-padding-mobile) 0; }
@media (min-width: 992px) { .account-page { padding: var(--section-padding) 0; } }

.account-card { max-width: 560px; margin: 0 auto; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 32px; }
@media (max-width: 575px) { .account-card { padding: 20px; border: none; } }
.account-card__title { font-size: 24px; font-weight: 700; margin: 0 0 24px; }
.account-card__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
.account-card__logout { font-size: 14px; color: var(--color-text-sub); text-decoration: underline; }
.account-card__date { font-size: 14px; color: var(--color-text-sub); margin-bottom: 24px; }

/* Form */
.account-form { display: flex; flex-direction: column; gap: 16px; }
.account-form__field { display: flex; flex-direction: column; gap: 4px; }
.account-form__field label { font-size: 14px; font-weight: 500; }
.account-form__field input, .account-form__field select { height: 44px; }
.account-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 575px) { .account-form__row { grid-template-columns: 1fr; } }
.account-form__links { display: flex; justify-content: space-between; font-size: 14px; margin-top: 8px; }
.account-form__links a { color: var(--color-text-sub); text-decoration: underline; text-underline-offset: 3px; }
.account-form__actions { display: flex; gap: 12px; margin-top: 8px; }

/* Account Info */
.account-info { margin-bottom: 32px; }
.account-info h3 { font-size: 18px; font-weight: 600; margin: 0 0 12px; }
.account-info p { font-size: 14px; margin: 0 0 6px; color: var(--color-text-sub); }
.account-info p strong { color: var(--color-text); }

/* Orders */
.account-orders { margin-bottom: 32px; }
.account-orders h3 { font-size: 18px; font-weight: 600; margin: 0 0 12px; }
.account-orders__item { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; padding: 12px 0; border-bottom: 1px solid var(--color-border); font-size: 14px; text-decoration: none; color: var(--color-text); }
.account-orders__item:hover { background: var(--color-bg-alt); }
.account-orders__item .order-name { font-weight: 600; }
.account-orders__item .order-date { color: var(--color-text-sub); }
.account-orders__item .order-total { text-align: right; font-weight: 600; }

/* Order Detail */
.order-cancelled { background: #fef2f2; border: 1px solid #fecaca; border-radius: var(--radius); padding: 12px 16px; margin-bottom: 24px; font-size: 14px; color: #991b1b; }
.order-items { margin-bottom: 24px; }
.order-item { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--color-border); font-size: 14px; }
.order-item__title { flex: 1; }
.order-item__qty { width: 60px; text-align: center; color: var(--color-text-sub); }
.order-item__price { width: 120px; text-align: right; font-weight: 600; }
.order-summary { margin-bottom: 24px; }
.order-summary__row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 14px; }
.order-summary__total { border-top: 1px solid var(--color-border); padding-top: 8px; font-size: 16px; }
.order-address { margin-bottom: 24px; }
.order-address h3 { font-size: 16px; font-weight: 600; margin: 0 0 8px; }
.order-address p { font-size: 14px; color: var(--color-text-sub); margin: 0 0 4px; }

/* Addresses */
.account-address__list { display: flex; flex-direction: column; gap: 12px; }
.account-address__item { border: 1px solid var(--color-border); border-radius: var(--radius); padding: 16px; }
.account-address__item.is-default { border-color: var(--color-primary); }
.account-address__view { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
.account-address__content strong { font-size: 15px; }
.account-address__content .badge { display: inline-block; background: var(--color-bg-alt); border: 1px solid var(--color-border); border-radius: 2px; padding: 2px 8px; font-size: 11px; font-weight: 600; margin-left: 8px; }
.account-address__content p { font-size: 14px; color: var(--color-text-sub); margin: 4px 0 0; }
.account-address__actions { display: flex; gap: 12px; font-size: 14px; flex-shrink: 0; }
.account-address__actions a { color: var(--color-text-sub); text-decoration: underline; }
.account-address-form { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--color-border); }
.account-links { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--color-border); }
.account-links a { font-size: 14px; color: var(--color-primary); text-decoration: underline; }
