/* haravan-audit:v2 */
.bs_feedback {
  padding: 60px 0 0;
  background: #fff;
}

.bs_feedback__heading {
  font-family: var(--font-heading);
  font-size: 36px;
  font-weight: 500;
  line-height: 52px;
  letter-spacing: -1px;
  color: #0a0a0a;
  text-transform: uppercase;
  text-align: center;
  margin: 0 0 40px;
}

.bs_feedback__marquee {
  width: 100%;
  overflow: hidden;
  position: relative;
  border-radius: 10px;
  -webkit-mask-image: linear-gradient(to right, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);
          mask-image: linear-gradient(to right, transparent 0, #000 40px, #000 calc(100% - 40px), transparent 100%);
}

.bs_feedback__track {
  display: flex;
  gap: 12px;
  width: max-content;
  animation: bs-feedback-scroll 40s linear infinite;
  will-change: transform;
}
.bs_feedback__marquee:hover .bs_feedback__track {
  animation-play-state: paused;
}

.bs_feedback__item {
  flex: 0 0 320px;
  min-width: 240px;
  border-radius: 10px;
  overflow: hidden;
  background: #f5f5f5;
  aspect-ratio: 1 / 1;
  display: block;
  text-decoration: none;
  cursor: pointer;
}
.bs_feedback__item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}
/*.bs_feedback__item:hover img {
  transform: scale(1.04);
}*/

@keyframes bs-feedback-scroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  .bs_feedback__track {
    animation: none;
  }
}

@media (max-width: 991px) {
  .bs_feedback { padding: 48px 0 0; }
  .bs_feedback__heading { font-size: 28px; line-height: 40px; margin-bottom: 28px; }
  .bs_feedback__item { flex: 0 0 280px; }
  .bs_feedback__track { animation-duration: 32s; }
}

@media (max-width: 767px) {
  .bs_feedback { padding: 36px 0 0; }
  .bs_feedback__heading { font-size: 22px; line-height: 32px; margin-bottom: 20px; }
  .bs_feedback__item { flex: 0 0 240px; }
  .bs_feedback__track { animation-duration: 28s; }
}
