/* ── Suggest row: label + teal pills ── */
.pd-sizeguide__suggest-row {
  display: flex;
  align-items: center;
  gap: 24px;
}
.pd-sizeguide__suggest-label {
  font-family: var(--font-body);
  font-size: 16px;
  font-weight: 500;
  line-height: 23px;
  letter-spacing: -0.1px;
