/* haravan-audit:v2 */
.bs_policy {
  padding: 20px 0;
  background: #fff;
}

.bs_policy__list {
  display: flex;
  gap: 12px;
  align-items: center;
}

.bs_policy__item {
  flex: 1 0 0;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  border-radius: 2px;
}

.bs_policy__icon {
  width: 40px;
  height: 40px;
  flex-shrink: 0;
  position: relative;
}
.bs_policy__icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
}

.bs_policy__text {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 400;
  line-height: 18px;
  letter-spacing: -0.1px;
  color: #020617;
  margin: 0;
  flex: 1 0 0;
  min-width: 0;
}

@media (max-width: 991px) {
  .bs_policy__list {
    flex-wrap: wrap;
    gap: 12px 16px;
  }
  .bs_policy__item {
    flex: 0 0 calc(50% - 8px);
  }
}

@media (max-width: 767px) {
  .bs_policy { padding: 16px 0; }
  .bs_policy__item {
    flex: 0 0 100%;
  }
}
