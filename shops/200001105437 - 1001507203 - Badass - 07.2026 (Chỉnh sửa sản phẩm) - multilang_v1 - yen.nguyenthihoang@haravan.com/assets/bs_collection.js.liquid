/* haravan-audit:v2 */
window.BS = window.BS || {};
BS.CollectionSlider = BS.CollectionSlider || {
  initOne: function(wrap) {
    var track   = wrap.querySelector('[data-bs-collection-track]');
    var prevBtn = wrap.querySelector('[data-bs-collection-prev]');
    var nextBtn = wrap.querySelector('[data-bs-collection-next]');
    if (!track) return;

    function getScrollAmount() {
      var item = track.querySelector('.bs_collection__item');
      if (!item) return 300;
      return item.offsetWidth + 12;
    }

    function updateButtons() {
      if (!prevBtn || !nextBtn) return;
      var atStart = track.scrollLeft <= 4;
      var atEnd   = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      prevBtn.classList.toggle('is-hidden', atStart);
      nextBtn.classList.toggle('is-hidden', atEnd);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        track.scrollBy({ left: -getScrollAmount() * 2, behavior: 'smooth' });
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        track.scrollBy({ left: getScrollAmount() * 2, behavior: 'smooth' });
      });
    }

    track.addEventListener('scroll', updateButtons, { passive: true });
    updateButtons();
  },

  init: function() {
    var wraps = document.querySelectorAll('.bs_collection__track-wrap');
    wraps.forEach(function(wrap) {
      BS.CollectionSlider.initOne(wrap);
    });
  }
};

document.addEventListener('DOMContentLoaded', function() {
  if (typeof BS !== 'undefined' && BS.CollectionSlider) {
    BS.CollectionSlider.init();
  }
});
