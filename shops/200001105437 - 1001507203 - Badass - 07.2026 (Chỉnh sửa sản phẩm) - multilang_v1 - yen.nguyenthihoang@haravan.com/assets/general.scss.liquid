/* Hiệu ứng shimmer quét ngang */
.sk-shimmer {
  position: relative;
  background: #ececec;
  overflow: hidden;
}
.sk-shimmer::after {
  content: "";
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.75) 50%, transparent 100%);
  animation: bsCartShimmer 1.25s ease-in-out infinite;
}

@keyframes bsCartFadeIn { to { opacity: 1; } }
@keyframes bsCartShimmer { 100% { transform: translateX(100%); } }

/* Tôn trọng người dùng tắt animation: ẩn shimmer, chỉ hiện khối tĩnh */
@media (prefers-reduced-motion: reduce) {
  .bs-cart-skeleton { animation: none; opacity: 1; }
  .sk-shimmer::after { animation: none; display: none; }
}

/* Close button: góc phải trên trong drawer — cả desktop lẫn mobile */
.sc__close {
