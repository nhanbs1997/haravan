{%- if settings.recently_viewed_show -%}
<section class="rv-section" id="recentlyViewedSection" style="display:none">
  <div class="container">
    <div class="rv__head">
      <h2 class="rv__title">{{ settings.recently_viewed_title | default: 'SẢN PHẨM ĐÃ XEM' }}</h2>
    </div>

    <div class="rv__wrap">
      <button type="button" class="rv__nav rv__nav--prev" id="rvPrev" aria-label="Trước">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M5 12l7 7M5 12l7-7"/></svg>
      </button>
      <div class="rv__track" id="rvTrack">
        <div class="rv__grid" id="rvGrid"></div>
      </div>
      <button type="button" class="rv__nav rv__nav--next" id="rvNext" aria-label="Tiếp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M14 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
(function() {
  var STORAGE_KEY = 'products_viewed';
  var STORAGE_DATE_KEY = 'products_viewed_date';
  var MAX_PRODUCTS = {{ settings.recently_viewed_count | default: 8 }};
  var EXPIRY_DAYS = {{ settings.recently_viewed_expiry_days | default: 30 }};
  var CURRENT_HANDLE = '{{ product.handle | default: '' }}';

  function getList() {
    try {
      var now = new Date().getTime();
      var expiry = parseInt(localStorage.getItem(STORAGE_DATE_KEY) || '0');
      if (expiry && expiry < now) {
        localStorage.removeItem(STORAGE_KEY);
        localStorage.removeItem(STORAGE_DATE_KEY);
        return [];
      }
      var raw = localStorage.getItem(STORAGE_KEY) || '';
      return raw ? raw.split('##').filter(function(h) { return h && h.trim(); }) : [];
    } catch(e) { return []; }
  }

  function saveList(list) {
    try {
      var now = new Date().getTime();
      if (!localStorage.getItem(STORAGE_DATE_KEY)) {
        localStorage.setItem(STORAGE_DATE_KEY, now + (EXPIRY_DAYS * 86400000));
      }
      localStorage.setItem(STORAGE_KEY, list.join('##'));
    } catch(e) {}
  }

  function updateCurrentProduct() {
    if (!CURRENT_HANDLE) return;
    var list = getList();
    var idx = list.indexOf(CURRENT_HANDLE);
    if (idx !== -1) list.splice(idx, 1);
    list.unshift(CURRENT_HANDLE);
    saveList(list);
  }

  function initSlider() {
    var track = document.getElementById('rvTrack');
    var prev = document.getElementById('rvPrev');
    var next = document.getElementById('rvNext');
    if (!track) return;
    function getStep() {
      var card = track.querySelector('.rv__grid .product-card, .product-card');
      return card ? card.offsetWidth + 12 : 306;
    }
    function update() {
      if (prev) prev.classList.toggle('is-hidden', track.scrollLeft <= 4);
      if (next) next.classList.toggle('is-hidden', track.scrollLeft + track.clientWidth >= track.scrollWidth - 4);
    }
    if (prev) prev.addEventListener('click', function() { track.scrollBy({ left: -getStep() * 4, behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function() { track.scrollBy({ left: getStep() * 4, behavior: 'smooth' }); });
    track.addEventListener('scroll', update, { passive: true });
    update();
  }

  function renderRV() {
    var section = document.getElementById('recentlyViewedSection');
    var grid = document.getElementById('rvGrid');
    if (!section || !grid) return;

    var list = getList().filter(function(h) { return h !== CURRENT_HANDLE; });
    if (list.length > MAX_PRODUCTS) list = list.slice(0, MAX_PRODUCTS);
    if (list.length === 0) return;

    var promises = list.map(function(handle, index) {
      return fetch('/products/' + handle + '?view=viewed')
        .then(function(r) { return r.ok ? r.text() : ''; })
        .then(function(html) { return { index: index, html: html ? html.trim() : '' }; })
        .catch(function() { return { index: index, html: '' }; });
    });

    Promise.all(promises).then(function(results) {
      results.sort(function(a, b) { return a.index - b.index; });
      var validCount = 0;
      results.forEach(function(r) {
        if (r.html) {
          var tmp = document.createElement('div');
          tmp.innerHTML = r.html;
          var card = tmp.firstElementChild;
          if (card) {
            grid.appendChild(card);
            validCount++;
          }
        }
      });
      if (validCount > 0) {
        section.style.display = '';
        grid.querySelectorAll('img[data-src]').forEach(function(img) {
          img.src = img.getAttribute('data-src');
          img.removeAttribute('data-src');
          img.classList.remove('lazyload', 'isHideTBT');
        });
        initSlider();
      }
    });
  }

  updateCurrentProduct();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderRV);
  } else {
    renderRV();
  }
})();
</script>
{%- endif -%}
