{%- comment -%}
  Snippet: article-loop
  Mô tả: Article card — dùng cho blog grid, homepage news section
  Params:
    - article (object, required)
    - show_excerpt (boolean, optional, default: true)
    - excerpt_length (number, optional, default: 120)
  Figma: node 40009482:91753
{%- endcomment -%}

{%- assign _show_excerpt = show_excerpt | default: true -%}
{%- assign _excerpt_length = excerpt_length | default: 120 -%}
{%- assign _img = article.image | img_url: 'large' -%}

<article class="article-card">
  {%- comment -%} ── Image ── {%- endcomment -%}
  <a href="{{ article.url }}" class="article-card__media" aria-label="{{ article.title | escape }}" tabindex="-1">
    {%- if article.image -%}
    <img
      class="article-card__img lazyload isHideTBT"
      src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
      data-src="{{ _img }}"
      alt="{{ article.title | escape }}"
      width="480" height="320"
      loading="lazy" decoding="async">
    {%- else -%}
    <img
      class="article-card__img"
      src="{{ 'en_logo.png' | asset_url }}"
      alt="{{ article.title | escape }}"
      width="480" height="320"
      loading="lazy" decoding="async">
    {%- endif -%}

    {%- comment -%} Soft overlay {%- endcomment -%}
    <div class="article-card__overlay" aria-hidden="true"></div>

    {%- comment -%} Brand Tag Top Corner right {%- endcomment -%}
    <span class="article-card__brand" aria-hidden="true">BADASS</span>
  </a>

  {%- comment -%} ── Content ── {%- endcomment -%}
  <div class="article-card__body">
    <div class="article-card__content">

      {%- comment -%} Debian {%- endcomment -%}
      <div class="article-card__meta">
        <span class="article-card__date-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0a6174" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="8" cy="8" r="6"/>
            <path d="M8 5v3l2 1.5"/>
          </svg>
        </span>
        <time class="article-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%d/%m/%Y' }}
        </time>
      </div>

      {%- comment -%} Excerpt / Title {%- endcomment -%}
      {%- if _show_excerpt -%}
      <p class="article-card__excerpt">
        <a href="{{ article.url }}">{{ article.excerpt_or_content | strip_html | truncate: _excerpt_length }}</a>
      </p>
      {%- else -%}
      <h3 class="article-card__title">
        <a href="{{ article.url }}">{{ article.title }}</a>
      </h3>
      {%- endif -%}

    </div>
  </div>
</article>
