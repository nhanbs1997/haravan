{% comment %}haravan-audit:v2{% endcomment %}
{% if settings.en_product_recommendations_show %}

{% comment %} Chỉ hiển thị khi app Product Recommend đã thiết lập (metafield ProductRecommend).
   Dùng snippet product-loop-rec (biến rec_product) để KHÔNG đụng biến `product` của trang.
   Không có metafield / không có sản phẩm hợp lệ → ẩn hẳn section (bỏ fallback collection). {% endcomment %}
{% assign productscommend = product.metafields.ProductRecommend %}
{% assign rec_count = 0 %}
{% for value in productscommend %}
  {% assign rec_product = collections.all.products[value.last] %}
  {% if rec_product != null and rec_product.handle != product.handle %}
    {% assign rec_count = rec_count | plus: 1 %}
  {% endif %}
{% endfor %}

{% if rec_count > 0 %}
<section class="prec" id="productRecommendations">
  <div class="container">
    <h2 class="prec__title">{{ settings.en_product_recommendations_title | default: 'PRODUCT SUGGESTION' | escape }}</h2>

    <div class="prec__wrap">
      <button type="button" class="prec__nav prec__nav--prev" id="precPrev" aria-label="Previous">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M5 12l7 7M5 12l7-7"/></svg>
      </button>

      <div class="prec__track" id="precTrack">
        <div class="prec__grid" id="precGrid">
          {% for value in productscommend %}
            {% assign rec_product = collections.all.products[value.last] %}
            {% if rec_product != null and rec_product.handle != product.handle %}
              {%- include 'en_product-loop-rec', rec_product: rec_product -%}
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <button type="button" class="prec__nav prec__nav--next" id="precNext" aria-label="Next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M14 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
</section>
{% endif %}

{% endif %}
