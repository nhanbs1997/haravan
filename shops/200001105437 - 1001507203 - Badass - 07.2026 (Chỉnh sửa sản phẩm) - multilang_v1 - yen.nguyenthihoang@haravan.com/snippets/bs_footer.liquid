{% comment %}haravan-audit:v2{% endcomment %}
{% if settings.bs_footer_show %}
<link rel="preload stylesheet" href="{{ 'bs_footer.scss.css' | asset_url }}" as="style">

{%- assign _logo = settings.bs_footer_logo | default: settings.logo_url -%}
{%- assign _hotline = settings.bs_footer_hotline | default: shop.phone -%}
{%- assign _email = settings.bs_footer_email | default: shop.email -%}
{%- assign _tel_link = _hotline | strip | replace: ' ', '' | replace: '.', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' -%}
{%- assign _blank_img = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=' -%}

<footer class="bs_footer" data-filename="bs_footer"
  style="--bs-footer-bg: {{ settings.bs_footer_bg | default: '#f5f5f5' }};
         --bs-footer-text: {{ settings.bs_footer_text_color | default: '#404040' }};
         --bs-footer-title: {{ settings.bs_footer_title_color | default: '#404040' }};
         --bs-footer-link: {{ settings.bs_footer_link_color | default: '#404040' }};
         --bs-footer-link-hover: {{ settings.bs_footer_link_hover_color | default: '#0a0a0a' }};
         --bs-footer-icon: {{ settings.bs_footer_icon_color | default: '#0a0a0a' }};
         --bs-footer-divider: {{ settings.bs_footer_divider_color | default: '#e5e5e5' }};">
  <div class="container">
    <div class="wrapper">

      <div class="cols">

        <div class="col col--brand">
          <a href="/" class="logo" aria-label="{{ shop.name }}">
            {%- if _logo != blank -%}
            <img src="{{ _logo }}" alt="{{ shop.name }}" width="196" height="37" loading="lazy" decoding="async">
            {%- else -%}
            <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="196" height="37" loading="lazy" decoding="async">
            {%- endif -%}
          </a>

          <ul class="contact">
            {%- unless _hotline == blank -%}
            <li class="contact-item">
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
              </span>
              <span class="contact-text">
                <span class="contact-label">Hotline:</span>
                <a class="contact-value" href="tel:{{ _tel_link }}" itemprop="telephone">{{ _hotline | escape }}</a>
              </span>
            </li>
            {%- endunless -%}

            {%- unless _email == blank -%}
            <li class="contact-item">
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
              </span>
              <span class="contact-text">
                <span class="contact-label">Email:</span>
                <a class="contact-value" href="mailto:{{ _email }}" itemprop="email">{{ _email | escape }}</a>
              </span>
            </li>
            {%- endunless -%}
          </ul>
        </div>

        {%- unless settings.bs_footer_menu1_linklist == blank -%}
        <div class="col col--menu">
          <h2 class="title">{{ settings.bs_footer_menu1_title | default: 'Về chúng tôi' | escape }}</h2>
          <ul class="links">
            {%- for link in linklists[settings.bs_footer_menu1_linklist].links -%}
            <li><a href="{{ link.url }}"{% if link.url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
        {%- endunless -%}

        {%- unless settings.bs_footer_menu2_linklist == blank -%}
        <div class="col col--menu">
          <h2 class="title">{{ settings.bs_footer_menu2_title | default: 'Chính sách' | escape }}</h2>
          <ul class="links">
            {%- for link in linklists[settings.bs_footer_menu2_linklist].links -%}
            <li><a href="{{ link.url }}"{% if link.url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
        {%- endunless -%}

        <div class="col col--right">

          <div class="connect">
            <h2 class="title">{{ settings.bs_footer_social_title | default: 'Kết nối với BADASS' | escape }}</h2>
            <ul class="socials">
              {%- unless settings.bs_footer_social_fb == blank -%}
              <li><a href="{{ settings.bs_footer_social_fb }}" target="_blank" rel="noopener" aria-label="Facebook">
                <img src="{{ 'i1.png' | asset_url }}">
              </a></li>
              {%- endunless -%}
              {%- unless settings.bs_footer_social_yt == blank -%}
              <li><a href="{{ settings.bs_footer_social_yt }}" target="_blank" rel="noopener" aria-label="YouTube">
                <img src="{{ 'i2.png' | asset_url }}">
              </a></li>
              {%- endunless -%}
              {%- unless settings.bs_footer_social_tt == blank -%}
              <li><a href="{{ settings.bs_footer_social_tt }}" target="_blank" rel="noopener" aria-label="TikTok">
                 <img src="{{ 'i3.png' | asset_url }}">
              </a></li>
              {%- endunless -%}
              {%- unless settings.bs_footer_social_ins == blank -%}
              <li><a href="{{ settings.bs_footer_social_ins }}" target="_blank" rel="noopener" aria-label="Instagram">
                 <img src="{{ 'i4.png' | asset_url }}">
              </a></li>
              {%- endunless -%}
            </ul>
          </div>

          <div class="payment">
            <h2 class="title">{{ settings.bs_footer_payment_title | default: 'Thanh toán' | escape }}</h2>
            <ul class="payments">
              <li class="payment-item" aria-label="Mastercard">
                <svg class="payment-card" viewBox="0 0 22 14" fill="none" aria-hidden="true">
                  <circle cx="8" cy="7" r="5.6" fill="#EB001B"/>
                  <circle cx="14" cy="7" r="5.6" fill="#F79E1B"/>
                  <path d="M11 3.1a5.6 5.6 0 0 1 0 7.8 5.6 5.6 0 0 1 0-7.8Z" fill="#FF5F00"/>
                </svg>
              </li>
              <li class="payment-item" aria-label="Visa">
                <svg class="payment-card" viewBox="0 0 26 8" fill="#1A1F71" aria-hidden="true">
                  <text x="0" y="7" font-family="Arial Black, Arial, sans-serif" font-weight="900" font-style="italic" font-size="9" letter-spacing="-0.4">VISA</text>
                </svg>
              </li>
              <li class="payment-item payment-item--text" aria-label="Tiền mặt">
                <span class="payment-icon" aria-hidden="true">
                  <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3.5" width="10" height="5" rx="0.5"/><circle cx="6" cy="6" r="1.5"/><circle cx="2.6" cy="6" r="0.3" fill="currentColor"/><circle cx="9.4" cy="6" r="0.3" fill="currentColor"/></svg>
                </span>
                <span class="payment-label">TIỀN MẶT</span>
              </li>
              <li class="payment-item payment-item--text" aria-label="Banking">
                <span class="payment-icon" aria-hidden="true">
                  <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 4.5 6 1.8l4.5 2.7H1.5Z"/><path d="M2.5 5v3M5 5v3M7 5v3M9.5 5v3"/><path d="M1 8.5h10v1.7H1z"/></svg>
                </span>
                <span class="payment-label">BANKING</span>
              </li>
            </ul>
          </div>

        </div>

      </div>

      <hr class="divider">

      <div class="bottom" itemscope itemtype="https://schema.org/Organization">
        <meta itemprop="name" content="{{ shop.name }}">
        <meta itemprop="url" content="{{ shop.url }}">
        <div class="company-row">
          <span class="company-name" itemprop="legalName">{{ settings.bs_footer_company_name | default: 'CÔNG TY CỔ PHẦN OKAPI VIỆT NAM' | escape }}</span>
          {%- unless settings.bs_footer_bct_img == blank -%}
          <a class="bct" href="{{ settings.bs_footer_bct_link | default: '#' }}" target="_blank" rel="noopener nofollow" aria-label="Đã thông báo Bộ Công Thương">
            <img class="lazyload isHideTBT" src="{{ _blank_img }}" data-src="{{ settings.bs_footer_bct_img }}" alt="Đã thông báo Bộ Công Thương" loading="lazy" decoding="async">
          </a>
          {%- endunless -%}
        </div>
        {%- unless settings.bs_footer_company_id == blank -%}
        <p class="company-id" itemprop="taxID">{{ settings.bs_footer_company_id | escape }}</p>
        {%- endunless -%}
      </div>

    </div>
  </div>
</footer>
{% endif %}
