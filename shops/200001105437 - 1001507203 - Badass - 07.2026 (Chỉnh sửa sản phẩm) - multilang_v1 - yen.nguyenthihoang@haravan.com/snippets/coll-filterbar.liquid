<div class="coll__filterbar container">
  <div class="coll__filterbar-left">
    <button type="button" class="coll__filter-toggle" id="sidebarToggle" aria-label="Mở bộ lọc" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
      <span class="coll__filterbar-title">Bộ lọc</span>
      <svg class="coll__filter-toggle-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <span class="coll__filterbar-count" id="filterCount">{{ collection.products_count }} kết quả</span>
  </div>
  <div class="coll__filterbar-right">
    <div class="coll__filterbar-tags-wrap">
      <div class="coll__active-tags" id="activeTags"></div>
      <button type="button" class="coll__clear-btn" id="filterClear" style="display:none">Xóa lọc</button>
    </div>
    <div class="coll__sort">
      <span class="coll__sort-label">Xếp theo:</span>
      <div class="coll__sort-wrap" id="sortWrap">
        {%- comment -%} Custom dropdown button {%- endcomment -%}
        <button type="button" class="coll__sort-btn" id="sortBtn" aria-haspopup="listbox" aria-expanded="false">
          <span id="sortBtnLabel">Mới nhất</span>
          <svg class="coll__sort-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        {%- comment -%} Custom dropdown list {% endcomment %}
        <ul class="coll__sort-dropdown" id="sortDropdown" role="listbox">
          <li role="option" class="is-active" data-sort="(updated_at:product=desc)"><button type="button">MỚI NHẤT</button></li>
          <li role="option" data-sort="(price:product=asc)"><button type="button">GIÁ THẤP TỚI CAO</button></li>
          <li role="option" data-sort="(price:product=desc)"><button type="button">GIÁ CAO TỚI THẤP</button></li>
          <li role="option" data-sort="(title:product=asc)"><button type="button">TÊN: A-Z</button></li>
          <li role="option" data-sort="(title:product=desc)"><button type="button">TÊN: Z-A</button></li>
          <li role="option" data-sort="(sold_quantity:product=desc)"><button type="button">BÁN CHẠY</button></li>
        </ul>
        {%- comment -%} Native select ẩn — dùng để trigger filter JS {% endcomment %}
        <select class="sort-select coll__sort-select" aria-hidden="true" tabindex="-1" style="display:none">
          <option value="(updated_at:product=desc)" selected>Mới nhất</option>
          <option value="(price:product=asc)">Giá thấp tới cao</option>
          <option value="(price:product=desc)">Giá cao tới thấp</option>
          <option value="(title:product=asc)">Tên: A-Z</option>
          <option value="(title:product=desc)">Tên: Z-A</option>
          <option value="(sold_quantity:product=desc)">Bán chạy</option>
        </select>
      </div>
    </div>
  </div>
</div>
