{%- comment -%}
  Snippet: og-tags
  Mô tả: Facebook Open Graph tags
{%- endcomment -%}

{%- if template contains 'product' -%}
<meta property="og:type" content="product">
<meta property="og:title" content="{{ product.title | strip_html | escape }}">
<meta property="og:image" content="https:{{ product.featured_image.src | product_img_url: 'grande' | remove: 'http:' | remove: 'https:' }}">
<meta property="og:price:amount" content="{{ product.price | money_without_currency | remove: '.' | remove: ',' | remove: '₫' | strip }}">
<meta property="og:price:currency" content="{{ shop.currency }}">
{%- elsif template contains 'article' -%}
<meta property="og:type" content="article">
<meta property="og:title" content="{{ article.title | strip_html | escape }}">
{%- if article.image -%}
<meta property="og:image" content="https:{{ article.image.src | remove: 'http:' | remove: 'https:' }}">
{%- elsif settings.share_fb_home_url != blank -%}
<meta property="og:image" content="{{ settings.share_fb_home_url }}">
{%- endif -%}
{%- elsif template contains 'collection' -%}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ collection.title | strip_html | escape }}">
{%- if collection.image -%}
<meta property="og:image" content="https:{{ collection.image.src | remove: 'http:' | remove: 'https:' }}">
{%- elsif settings.share_fb_home_url != blank -%}
<meta property="og:image" content="{{ settings.share_fb_home_url }}">
{%- endif -%}
{%- else -%}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ page_title | strip_html | escape }}">
{%- assign _og_img = settings.share_fb_home_url | default: settings.logo_url -%}
{%- unless _og_img == blank -%}
<meta property="og:image" content="{{ _og_img }}">
{%- endunless -%}
{%- endif -%}

{%- if page_description -%}
<meta property="og:description" content="{{ page_description | strip_html | strip_newlines | escape }}">
{%- else -%}
<meta property="og:description" content="{{ shop.name }}">
{%- endif -%}
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:site_name" content="{{ shop.name }}">
