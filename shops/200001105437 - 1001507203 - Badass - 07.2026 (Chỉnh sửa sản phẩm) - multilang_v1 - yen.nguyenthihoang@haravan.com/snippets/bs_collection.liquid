{% comment %}haravan-audit:v2{% endcomment %}
{% if settings.bs_collection_show %}
<link rel="preload stylesheet" href="{{ 'bs_collection.scss.css' | asset_url }}" as="style">

{%- assign _blank = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=' -%}
{%- assign _collection = collections[settings.bs_collection_handle] -%}

<section class="bs_collection" data-filename="bs_collection" data-reveal>

  {%- unless settings.bs_collection_banner_img == blank -%}
  {%- assign _banner_link = settings.bs_collection_banner_link -%}
  {%- assign _banner_mb = settings.bs_collection_banner_img_mb -%}
  {%- if _banner_link != blank -%}
  <a href="{{ _banner_link }}" class="bs_collection__banner" aria-label="{{ settings.bs_collection_banner_title | default: 'Xem bộ sưu tập' | escape }}">
  {%- else -%}
  <div class="bs_collection__banner">
  {%- endif -%}
    <picture class="bs_collection__banner-picture">
      {%- unless _banner_mb == blank -%}
      <source media="(max-width: 767px)" data-srcset="{{ _banner_mb }}" srcset="{{ _banner_mb }}">
      {%- endunless -%}
      <img class="bs_collection__banner-img lazyload isHideTBT"
        src="{{ _blank }}"
        data-src="{{ settings.bs_collection_banner_img }}"
        alt="{{ settings.bs_collection_banner_title | escape }}"
        loading="lazy" decoding="async">
    </picture>
    <div class="bs_collection__banner-overlay" aria-hidden="true"></div>
    <div class="bs_collection__banner-content">
      <div class="container">
        {%- unless settings.bs_collection_banner_title == blank -%}
        <h2 class="bs_collection__banner-title">{{ settings.bs_collection_banner_title | escape }}</h2>
        {%- endunless -%}
        {%- if settings.bs_collection_banner_btn_show and _banner_link != blank -%}
        <span class="bs_collection__banner-btn" aria-hidden="true">
          {{ settings.bs_collection_banner_btn | default: 'Mua ngay' | escape }}
        </span>
        {%- endif -%}
      </div>
    </div>
  {%- if _banner_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
  {%- endunless -%}

  <div class="bs_collection__products">
    <div class="container">
      <div class="bs_collection__products-header">
        {%- unless settings.bs_collection_title == blank -%}
        <h3 class="bs_collection__products-title">{{ settings.bs_collection_title | escape }}</h3>
        {%- endunless -%}
        {%- unless settings.bs_collection_viewall_link == blank -%}
        <a href="{{ settings.bs_collection_viewall_link }}" class="bs_collection__viewall">
          {{ settings.bs_collection_viewall_text | default: 'Xem tất cả' | escape }}
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
        {%- endunless -%}
      </div>

      <div class="bs_collection__track-wrap">
        <div class="bs_collection__track" data-bs-collection-track>
          {%- if _collection.products.size > 0 -%}
            {%- assign _limit = settings.bs_collection_limit | default: 8 -%}
            {%- for product in _collection.products limit: _limit -%}
            <div class="bs_collection__item">
              {%- include 'product-loop' -%}
            </div>
            {%- endfor -%}
          {%- else -%}
          <p class="bs_collection__empty">Đang cập nhật sản phẩm...</p>
          {%- endif -%}
        </div>

        <button class="bs_collection__nav bs_collection__nav--prev" data-bs-collection-prev aria-label="Trước">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M5 12l7 7M5 12l7-7"/>
          </svg>
        </button>
        <button class="bs_collection__nav bs_collection__nav--next" data-bs-collection-next aria-label="Tiếp theo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M14 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
      {%- unless settings.bs_collection_viewall_link == blank -%}
      <a href="{{ settings.bs_collection_viewall_link }}" class="bs_collection__viewall--mobile">
        {{ settings.bs_collection_viewall_text | default: 'Xem tất cả' | escape }}
      </a>
      {%- endunless -%}
    </div>
  </div>

</section>

<script fetchpriority="low" defer src="{{ 'bs_collection.js' | asset_url }}"></script>
{% endif %}
