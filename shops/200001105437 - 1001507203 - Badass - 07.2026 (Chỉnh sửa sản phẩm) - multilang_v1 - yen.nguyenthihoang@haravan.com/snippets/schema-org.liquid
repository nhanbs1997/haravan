{%- comment -%}
  Snippet: schema-org
  Mô tả: JSON-LD structured data — WebSite (+SearchAction), Organization, và Product (trang sản phẩm).
  Giá schema lấy theo giá hiển thị (money_without_currency) để khớp UI bất kể đơn vị đồng/xu.
{%- endcomment -%}

{%- if template contains 'product' -%}
{%- assign _pd_var = product.selected_or_first_available_variant -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | strip_html | json }},
  "url": "{{ shop.url }}{{ product.url }}",
  "image": [
    {%- for image in product.images limit: 5 -%}
    "https:{{ image.src | img_url: 'grande' | remove: 'http:' | remove: 'https:' }}"{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  {%- unless product.vendor == blank -%}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- endunless -%}
  {%- unless _pd_var.sku == blank -%}
  "sku": {{ _pd_var.sku | json }},
  {%- endunless -%}
  "offers": {
    "@type": "Offer",
    "priceCurrency": "{{ shop.currency }}",
    "price": "{{ product.price | money_without_currency | replace: '.', '' | replace: ',', '' | replace: '₫', '' | replace: ' ', '' | strip }}",
    "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "url": "{{ shop.url }}{{ product.url }}"
  }
}
</script>
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": "{{ shop.url }}",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": "{{ shop.url }}",
  {%- assign _org_logo = settings.logo_url | default: '' -%}
  {%- unless _org_logo == blank -%}
  "logo": "{{ _org_logo }}",
  {%- endunless -%}
  {%- assign _org_phone = settings.bs_footer_hotline | default: shop.phone -%}
  {%- unless _org_phone == blank -%}
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": {{ _org_phone | json }},
    "contactType": "customer service",
    "areaServed": "VN"
  },
  {%- endunless -%}
  "sameAs": [
    {%- assign _socials = '' -%}
    {%- unless settings.bs_footer_social_fb == blank -%}{%- assign _socials = _socials | append: settings.bs_footer_social_fb | append: '|' -%}{%- endunless -%}
    {%- unless settings.bs_footer_social_yt == blank -%}{%- assign _socials = _socials | append: settings.bs_footer_social_yt | append: '|' -%}{%- endunless -%}
    {%- unless settings.bs_footer_social_tt == blank -%}{%- assign _socials = _socials | append: settings.bs_footer_social_tt | append: '|' -%}{%- endunless -%}
    {%- unless settings.bs_footer_social_ins == blank -%}{%- assign _socials = _socials | append: settings.bs_footer_social_ins | append: '|' -%}{%- endunless -%}
    {%- assign _socials = _socials | split: '|' -%}
    {%- for _s in _socials -%}
    {{ _s | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
