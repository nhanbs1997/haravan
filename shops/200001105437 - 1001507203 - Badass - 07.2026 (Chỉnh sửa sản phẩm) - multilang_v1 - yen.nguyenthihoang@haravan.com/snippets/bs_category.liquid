{% comment %}haravan-audit:v2{% endcomment %}
{% if settings.bs_category_show %}
<link rel="preload stylesheet" href="{{ 'bs_category.scss.css' | asset_url }}" as="style">

{%- assign _blank = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=' -%}

<section class="bs_category" data-filename="bs_category" data-reveal>
  <div class="container">

    {%- unless settings.bs_category_title == blank -%}
    <h2 class="bs_category__heading">{{ settings.bs_category_title | escape }}</h2>
    {%- endunless -%}

    <div class="bs_category__slider-wrap">
      <div class="bs_category__track" id="bsCategoryTrack">

        {% for i in (1..8) %}
          {% capture show_key %}bs_category_show_{{ i }}{% endcapture %}
          {% capture title_key %}bs_category_title_{{ i }}{% endcapture %}
          {% capture img_key %}bs_category_img_{{ i }}{% endcapture %}
          {% capture link_key %}bs_category_link_{{ i }}{% endcapture %}

          {% if settings[show_key] %}
          {%- assign _cat_link = settings[link_key] -%}
          {%- capture _cat_inner -%}
            <div class="bs_category__img-wrap">
              <img class="bs_category__img lazyload isHideTBT"
                src="{{ _blank }}"
                data-src="{{ settings[img_key] }}"
                alt="{{ settings[title_key] | escape }}"
                loading="lazy" decoding="async">
            </div>
            <div class="bs_category__content">
              <span class="bs_category__name">{{ settings[title_key] | escape }}</span>
              <span class="bs_category__arrow" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </span>
            </div>
          {%- endcapture -%}
          {%- if _cat_link != blank -%}
          <a href="{{ _cat_link }}" class="bs_category__item">{{ _cat_inner }}</a>
          {%- else -%}
          <div class="bs_category__item bs_category__item--nolink">{{ _cat_inner }}</div>
          {%- endif -%}
          {% endif %}
        {% endfor %}

      </div>

      <button class="bs_category__nav bs_category__nav--prev" id="bsCategoryPrev" aria-label="Trước">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M5 12l7 7M5 12l7-7"/>
        </svg>
      </button>
      <button class="bs_category__nav bs_category__nav--next" id="bsCategoryNext" aria-label="Tiếp theo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M14 5l7 7-7 7"/>
        </svg>
      </button>
    </div>

  </div>
</section>

<script fetchpriority="low" defer src="{{ 'bs_category.js' | asset_url }}"></script>
{% endif %}
