<div class="apply-popup-overlay" id="applyPopupOverlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="applyPopupTitle" tabindex="-1">
  <div class="apply-popup">

    <div class="apply-popup__loading" id="applyLoading" aria-live="polite" style="display:none">
      <div class="apply-popup__spinner" aria-hidden="true"></div>
      <p>Submitting application...</p>
    </div>

    <button type="button" class="apply-popup__close" id="applyPopupClose" aria-label="Close application form">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>

    <div class="apply-popup__head">
      <p class="apply-popup__eyebrow">Apply for position</p>
      <h2 class="apply-popup__title" id="applyPopupTitle"></h2>
      <div class="apply-popup__meta" id="applyPopupMeta"></div>
    </div>

    <div class="apply-popup__body">
      <form class="apply-popup__form" id="applyForm" novalidate autocomplete="on">
        <input type="hidden" name="jobPosition" id="inputJobPosition">
        <input type="hidden" name="jobUrl"      id="inputJobUrl">

        <div class="apply-form__row apply-form__row--2col">
          <div class="apply-form__group">
            <label class="apply-form__label" for="inputFullName">Full name <span class="apply-form__required">*</span></label>
            <input type="text" id="inputFullName" name="fullName" class="apply-form__input"
              placeholder="Nguyễn Văn A" autocomplete="name" required>
            <p class="apply-form__error" id="errFullName" role="alert"></p>
          </div>
          <div class="apply-form__group">
            <label class="apply-form__label" for="inputBirthYear">Year of birth</label>
            <input type="text" id="inputBirthYear" name="birthYear" class="apply-form__input"
              placeholder="1993" maxlength="4" inputmode="numeric" autocomplete="bday-year">
            <p class="apply-form__error" id="errBirthYear" role="alert"></p>
          </div>
        </div>

        <div class="apply-form__group">
          <span class="apply-form__label">Gender <span class="apply-form__required">*</span></span>
          <div class="apply-form__radio-group">
            <label class="apply-form__radio"><input type="radio" name="gender" value="Male" checked> Male</label>
            <label class="apply-form__radio">"input type= "radio" name= "gonder" value= "Keys"</label>
            <label class="apply-form__radio">"input type= "radio" name= "gonder" value= "Ooc"] Other</label>
          </div>
        </div>

        <div class="apply-form__row apply-form__row--2col">
          <div class="apply-form__group">
            <label class="apply-form__label" for="inputEmail">Email <span class="apply-form__required">*</span></label>
            <input type="email" id="inputEmail" name="email" class="apply-form__input"
              placeholder="email@example.com" autocomplete="email" required>
            <p class="apply-form__error" id="errEmail" role="alert"></p>
          </div>
          <div class="apply-form__group">
            <label class="apply-form__label" for="inputPhone">Phone number <span class="apply-form__required">*</span></label>
            <input type="tel" id="inputPhone" name="phone" class="apply-form__input"
              placeholder="0901234567" autocomplete="tel" required>
            <p class="apply-form__error" id="errPhone" role="alert"></p>
          </div>
        </div>

        <div class="apply-form__group">
          <label class="apply-form__label" for="inputAddress">Address</label>
          <input type="text" id="inputAddress" name="address" class="apply-form__input"
            placeholder="City, province..." autocomplete="address-level2">
        </div>

        <div class="apply-form__row apply-form__row--2col">
          <div class="apply-form__group">
            <label class="apply-form__label" for="selectChannel">How did you hear about us <span class="apply-form__required">*</span></label>
            <div class="apply-form__select-wrap">
              <select id="selectChannel" name="channel" class="apply-form__select" required>
                <option value="">-- Select channel --</option>
                <option value="Facebook">Facebook</option>
                <option value="Instagram">Instagram</option>
                <option value="YouTube">YouTube</option>
                <option value="TikTok">TikTok</option>
                <option value="Website">Website BADASS</option>
                <option value="Friend referral">Friend referral</option>
                <option value="Other">Other</option>
              </select>
              <svg class="apply-form__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </div>
            <p class="apply-form__error" id="errChannel" role="alert"></p>
          </div>
          <div class="apply-form__group">
            <label class="apply-form__label" for="inputReferrer">Introduction</label>
            <input type="text" id="inputReferrer" name="referrer" class="apply-form__input"
              placeholder="Referrer name (if any)">
          </div>
        </div>

        <div class="apply-form__group">
          <label class="apply-form__label" for="inputIntro">About self</label>
          <textarea id="inputIntro" name="intro" class="apply-form__textarea" rows="3"
            placeholder="Experience, strengths, why you are applying..."></textarea>
        </div>

        <div class="apply-form__group">
          <label class="apply-form__label">CV of You <span class="apply-form__required">*</span></label>
          <input type="file" id="inputCV" name="cv" accept=".pdf,.doc,.docx"
            class="apply-form__input-file sr-only" aria-label="Upload CVV files">
          <div class="apply-form__dropzone" id="cvDropzone"
            role="button" tabindex="0" aria-label="Drag or click to select CVV files">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0a6174" stroke-width="1.5" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <p class="apply-form__dropzone-text">Drag Drop or <span>click to select files</span></p>
            <p class="apply-form__dropzone-hint">PDF, DOC, DOCX — 5MB Maximum</p>
          </div>
          <div class="apply-form__file-preview" id="cvPreview" style="display:none">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0a6174" stroke-width="1.5" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span id="cvFileName" class="apply-form__file-name"></span>
            <button type="button" id="cvRemove" class="apply-form__file-remove" aria-label="Delete CVV files">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <p class="apply-form__error" id="errCV" role="alert"></p>
        </div>

        <div class="apply-form__submit-row">
          <button type="submit" class="apply-form__submit-btn" id="btnSubmitApply">
            Send Draft Profile

            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M14 5l7 7-7 7"/></svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  var WEBHOOK_URL = '{{ settings.en_bs_recruit_webhook_url | escape }}';
  var MAX_FILE_SIZE = 5 * 1024 * 1024;

  var overlay   = document.getElementById('applyPopupOverlay');
  var closeBtn  = document.getElementById('applyPopupClose');
  var form      = document.getElementById('applyForm');
  var loading   = document.getElementById('applyLoading');
  var titleEl   = document.getElementById('applyPopupTitle');
  var metaEl    = document.getElementById('applyPopupMeta');
  var posInput  = document.getElementById('inputJobPosition');
  var urlInput  = document.getElementById('inputJobUrl');
  var cvInput   = document.getElementById('inputCV');
  var dropzone  = document.getElementById('cvDropzone');
  var cvPreview = document.getElementById('cvPreview');
  var cvFileName = document.getElementById('cvFileName');
  var cvRemove  = document.getElementById('cvRemove');
  var submitBtn = document.getElementById('btnSubmitApply');

  if (!overlay || !form) return;

  function openPopup(btn) {
    var jobTitle    = btn.getAttribute('data-job-title') || '';
    var jobUrl      = btn.getAttribute('data-job-url')   || '';
    var jobDept     = btn.getAttribute('data-job-dept')  || '';
    var jobLocation = btn.getAttribute('data-job-location') || '';
    var jobLevel    = btn.getAttribute('data-job-level') || '';
    var jobDeadline = btn.getAttribute('data-job-deadline') || '';

    if (titleEl) titleEl.textContent = jobTitle;
    if (posInput) posInput.value = jobTitle;
    if (urlInput) urlInput.value = jobUrl;

    var metaParts = [];
    if (jobDept)     metaParts.push('<span class="apply-popup__meta-tag">' + escHtml(jobDept) + '</span>');
    if (jobLocation) metaParts.push('<span class="apply-popup__meta-tag"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s-8-6.5-8-12a8 8 0 0116 0c0 5.5-8 12-8 12z"/><circle cx="12" cy="10" r="2"/></svg>' + escHtml(jobLocation) + '</span>');
    if (jobLevel)    metaParts.push('<span class="apply-popup__meta-tag">' + escHtml(jobLevel) + '</span>');
    if (jobDeadline) metaParts.push('<span class="apply-popup__meta-tag apply-popup__meta-tag--deadline">Deadline: ' + escHtml(jobDeadline) + '</span>');
    if (metaEl) metaEl.innerHTML = metaParts.join('');

    resetForm();
    overlay.removeAttribute('aria-hidden');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    overlay.focus();
  }

  function closePopup() {
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    loading.style.display = 'none';
    resetForm();
  }

  function resetForm() {
    if (form) form.reset();
    clearAllErrors();
    hideCvPreview();
    if (submitBtn) submitBtn.disabled = false;
    if (loading) loading.style.display = 'none';
  }

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.js-open-apply');
    if (btn) { e.preventDefault(); openPopup(btn); }
  });

  closeBtn && closeBtn.addEventListener('click', closePopup);

  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closePopup();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.getAttribute('aria-hidden') === 'false') closePopup();
  });

  function showCvPreview(file) {
    if (cvPreview) cvPreview.style.display = '';
    if (cvFileName) cvFileName.textContent = file.name + ' (' + formatSize(file.size) + ')';
    if (dropzone) dropzone.style.display = 'none';
  }

  function hideCvPreview() {
    if (cvPreview) cvPreview.style.display = 'none';
    if (dropzone) dropzone.style.display = '';
    if (cvInput) cvInput.value = '';
  }

  dropzone && dropzone.addEventListener('click', function () { cvInput && cvInput.click(); });
  dropzone && dropzone.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); cvInput && cvInput.click(); }
  });

  dropzone && dropzone.addEventListener('dragover', function (e) {
    e.preventDefault(); dropzone.classList.add('is-dragover');
  });
  dropzone && dropzone.addEventListener('dragleave', function () {
    dropzone.classList.remove('is-dragover');
  });
  dropzone && dropzone.addEventListener('drop', function (e) {
    e.preventDefault(); dropzone.classList.remove('is-dragover');
    var files = e.dataTransfer.files;
    if (files && files[0]) handleCvFile(files[0]);
  });

  cvInput && cvInput.addEventListener('change', function () {
    if (cvInput.files && cvInput.files[0]) handleCvFile(cvInput.files[0]);
  });

  cvRemove && cvRemove.addEventListener('click', hideCvPreview);

  function handleCvFile(file) {
    var allowed = ['application/pdf',
      'application/msword',
      'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
    if (allowed.indexOf(file.type) === -1) {
      setError('errCV', 'Only Accept PDF file, DOC, DOCX.');
      return;
    }
    if (file.size > MAX_FILE_SIZE) {
      setError('errCV', 'The file exceeds 5MB.');
      return;
    }
    clearError('errCV');
    var dt = new DataTransfer();
    dt.items.add(file);
    cvInput.files = dt.files;
    showCvPreview(file);
  }

  function validate() {
    var ok = true;
    clearAllErrors();

    var fullName = document.getElementById('inputFullName');
    if (!fullName || !fullName.value.trim()) {
      setError('errFullName', 'Please. join them and names.');
      ok = false;
    }

    var birthYear = document.getElementById('inputBirthYear');
    if (birthYear && birthYear.value.trim()) {
      var yr = parseInt(birthYear.value.trim(), 10);
      if (isNaN(yr) || yr < 1940 || yr > new Date().getFullYear() - 16) {
        setError('errBirthYear', 'Year of birth valid.');
        ok = false;
      }
    }

    var email = document.getElementById('inputEmail');
    if (!email || !email.value.trim()) {
      setError('errEmail', 'Please. email.');
      ok = false;
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
      setError('errEmail', 'No Email Yes. Format.');
      ok = false;
    }

    var phone = document.getElementById('inputPhone');
    if (!phone || !phone.value.trim()) {
      setError('errPhone', 'Please. entry Phone.');
      ok = false;
    } else if (!/^[0-9+\s\-]{8,15}$/.test(phone.value.trim())) {
      setError('errPhone', 'No number. valid.');
      ok = false;
    }

    var channel = document.getElementById('selectChannel');
    if (!channel || !channel.value) {
      setError('errChannel', 'Please. select channel you know To BADASS.');
      ok = false;
    }

    if (!cvInput || !cvInput.files || !cvInput.files[0]) {
      setError('errCV', 'Please. CVV file attachment.');
      ok = false;
    }

    return ok;
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!validate()) return;

    if (!WEBHOOK_URL) {
      alert('Not yet. configuration The address for the file. Please. Advisor contact.');
      return;
    }

    submitBtn && (submitBtn.disabled = true);
    loading.style.display = '';

    var fd = new FormData(form);

    var cvFile = cvInput.files[0];
    var reader = new FileReader();
    reader.onload = function (evt) {
      fd.set('cvBase64', evt.target.result);
      fd.set('cvName',   cvFile.name);
      fd.delete('cv');

      fetch(WEBHOOK_URL, { method: 'POST', body: fd })
        .then(function (res) { return res.json(); })
        .then(function (json) {
          loading.style.display = 'none';
          if (json && json.result === 'success') {
            closePopup();
            openSuccessPopup();
          } else {
            var msg = (json && json.error) ? json.error : 'Send failed. Please. Try again.';
            alert(msg);
            submitBtn && (submitBtn.disabled = false);
          }
        })
        .catch(function () {
          loading.style.display = 'none';
          alert('Error Connection. Please. Check. The line and try again.');
          submitBtn && (submitBtn.disabled = false);
        });
    };
    reader.readAsDataURL(cvFile);
  });

  function openSuccessPopup() {
    var sp = document.getElementById('successPopupOverlay');
    if (!sp) return;
    sp.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function setError(id, msg) {
    var el = document.getElementById(id);
    if (el) el.textContent = msg;
  }
  function clearError(id) {
    var el = document.getElementById(id);
    if (el) el.textContent = '';
  }
  function clearAllErrors() {
    ['errFullName','errBirthYear','errEmail','errPhone','errChannel','errCV'].forEach(clearError);
  }
  function escHtml(s) {
    return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function formatSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

})();
</script>
