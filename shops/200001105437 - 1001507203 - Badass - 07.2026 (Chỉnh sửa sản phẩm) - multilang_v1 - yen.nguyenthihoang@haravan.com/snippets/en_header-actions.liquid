<div class="site-header__actions">

  <button class="site-header__action site-header__action--search d-none d-lg-flex" aria-label="Search" data-action="open-search">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M21 21L16.65 16.65M19 11C19 15.4183 15.4183 19 11 19C6.58172 19 3 15.4183 3 11C3 6.58172 6.58172 3 11 3C15.4183 3 19 6.58172 19 11Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="site-header__action-label">Search</span>
  </button>

  <button class="site-header__action site-header__action--cart" aria-label="Cart ({{ cart.item_count }} items)" data-action="open-cart">
    <span class="site-header__cart-wrap">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="21" viewBox="0 0 20 21" fill="none">
        <path d="M13.6625 7.5V4.5C13.6625 2.29086 11.8716 0.5 9.66248 0.5C7.45334 0.5 5.66248 2.29086 5.66248 4.5V7.5M1.25448 8.85196L0.654482 15.252C0.483885 17.0717 0.398586 17.9815 0.700529 18.6843C0.965777 19.3016 1.4306 19.8121 2.0205 20.1338C2.692 20.5 3.60585 20.5 5.43353 20.5H13.8914C15.7191 20.5 16.633 20.5 17.3045 20.1338C17.8944 19.8121 18.3592 19.3016 18.6244 18.6843C18.9264 17.9815 18.8411 17.0717 18.6705 15.252L18.0705 8.85197C17.9264 7.31535 17.8544 6.54704 17.5088 5.96616C17.2045 5.45458 16.7548 5.04511 16.2171 4.78984C15.6065 4.5 14.8348 4.5 13.2914 4.5L6.03353 4.5C4.49017 4.5 3.71849 4.5 3.1079 4.78984C2.57014 5.04511 2.12049 5.45458 1.81614 5.96616C1.47057 6.54704 1.39854 7.31534 1.25448 8.85196Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="cart-count{% if cart.item_count == 0 %} is-hidden{% endif %}" aria-hidden="true">{{ cart.item_count }}</span>
    </span>
  </button>

  <a href="/account" class="site-header__action site-header__action--account" aria-label="Account">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M3 20C5.33579 17.5226 8.50702 16 12 16C15.493 16 18.6642 17.5226 21 20M16.5 7.5C16.5 9.98528 14.4853 12 12 12C9.51472 12 7.5 9.98528 7.5 7.5C7.5 5.01472 9.51472 3 12 3C14.4853 3 16.5 5.01472 16.5 7.5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="site-header__action-label">
      {%- if customer -%}{{ customer.first_name | default: 'Account' }}{%- else -%}Log in{%- endif -%}
    </span>
  </a>
<div class="header-translate-flag"></div>
</div>
