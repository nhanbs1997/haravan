{%- comment -%}
  Snippet: ldp-section2
  Mo ta: Section 4 — Banner full-width (1600x533px) + product slider + nav arrows + "Xem tat ca".
  Figma node: 40009444:83233
  Settings:
    bs_ldp_section2_show       : bat/tat module
    bs_ldp_section2_collection : collection (select dropdown)
    bs_ldp_section2_banner     : URL anh banner full-width (desktop)
    bs_ldp_section2_banner_mb  : URL anh banner full-width (mobile)
    bs_ldp_section2_title      : tieu de hien thi tren banner
    bs_ldp_section2_limit      : so luong san pham slider (10-15)
{%- endcomment -%}

{%- assign _col    = settings.bs_ldp_section2_collection -%}
{%- assign _title  = settings.bs_ldp_section2_title | default: 'Section nhóm sản phẩm kiểu 1' -%}
{%- assign _banner = settings.bs_ldp_section2_banner -%}
{%- assign _banner_mb = settings.bs_ldp_section2_banner_mb -%}
{%- assign _limit  = settings.bs_ldp_section2_limit | default: 12 | times: 1 -%}
{%- assign _spv    = settings.bs_ldp_section2_slides_per_view | default: 4 | times: 1 -%}
{%- assign _spv_mb = settings.bs_ldp_section2_slides_per_view_mb | default: 2 | times: 1 -%}

{%- if settings.bs_ldp_section2_show and _col != blank -%}
{%- assign _coll = collections[_col] -%}
<section class="bs_ldp__section bs_ldp__section--type2" id="ldpSection2">

  {%- comment -%} Banner full-bleed 1600x533px {%- endcomment -%}
  {%- unless _banner == blank -%}
  <div class="bs_ldp__s2-banner">
    <picture>
      {%- unless _banner_mb == blank -%}
      <source media="(max-width: 767px)" srcset="{{ _banner_mb | img_url: 'master' }}">
      {%- endunless -%}
      <img
        src="{{ _banner | img_url: 'master' }}"
        alt="{{ _title | escape }}"
        loading="lazy" decoding="async"
        width="1600" height="533">
    </picture>
    <div class="bs_ldp__s2-banner-overlay">
      <div class="container">
        <h3 class="bs_ldp__s2-title">{{ _title | escape }}</h3>
      </div>
    </div>
  </div>
  {%- endunless -%}

  {%- comment -%} Product slider: x=80 w=1440 (container), 6 cards 351px, gap 12px {%- endcomment -%}
  <div class="container">
    <div class="bs_ldp__s2-sliderwrap">
      <div class="bs_ldp__s2-slider swiper" id="ldpS2Swiper"
        data-spv="{{ _spv }}"
        data-spv-mb="{{ _spv_mb }}">
        <div class="swiper-wrapper">
          {%- for product in _coll.products limit: _limit -%}
            <div class="swiper-slide">
              {%- include 'product-loop' -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Nav arrows: sibling của slider (ngoài vùng overflow:hidden) — Figma x=28/1508 {%- endcomment -%}
      <button type="button" class="bs_ldp__nav bs_ldp__nav--prev" aria-label="Trước">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M5 12l7 7M5 12l7-7"/></svg>
      </button>
      <button type="button" class="bs_ldp__nav bs_ldp__nav--next" aria-label="Tiếp">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M14 5l7 7-7 7"/></svg>
      </button>
    </div>

    <p class="bs_ldp__swipe-hint" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      Vuốt để xem thêm
    </p>

    <div class="bs_ldp__more">
      <a href="{{ _coll.url }}" class="bs_ldp__more-btn">{{ settings.bs_ldp_section2_btn | default: 'Xem tất cả' | escape }}</a>
    </div>
  </div>

</section>
{%- endif -%}
