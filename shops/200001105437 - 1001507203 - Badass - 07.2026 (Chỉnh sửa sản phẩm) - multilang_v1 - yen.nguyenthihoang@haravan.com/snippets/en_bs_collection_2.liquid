{% comment %}haravan-audit:v2{% endcomment %}
{% if settings.en_bs_collection2_show %}
<link rel="preload stylesheet" href="{{ 'bs_collection.scss.css' | asset_url }}" as="style">
{%- assign _blank = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=' -%}
{%- assign _collection = collections[settings.en_bs_collection2_handle] -%}

<section class="bs_collection" data-filename="bs_collection_2" data-reveal>

  {%- unless settings.en_bs_collection2_banner_img == blank -%}
  {%- assign _banner_link = settings.en_bs_collection2_banner_link -%}
  {%- assign _banner_mb = settings.en_bs_collection2_banner_img_mb -%}
  {%- if _banner_link != blank -%}
  <a href="{{ _banner_link }}" class="bs_collection__banner" aria-label="{{ settings.en_bs_collection2_banner_title | default: 'View Collection' | escape }}">
  {%- else -%}
  <div class="bs_collection__banner">
  {%- endif -%}
    <picture class="bs_collection__banner-picture">
      {%- unless _banner_mb == blank -%}
      <source media="(max-width: 767px)" data-srcset="{{ _banner_mb }}" srcset="{{ _banner_mb }}">
      {%- endunless -%}
      <img class="bs_collection__banner-img lazyload isHideTBT"
        src="{{ _blank }}"
        data-src="{{ settings.en_bs_collection2_banner_img }}"
        alt="{{ settings.en_bs_collection2_banner_title | escape }}"
        loading="lazy" decoding="async">
    </picture>
    <div class="bs_collection__banner-overlay" aria-hidden="true"></div>
    <div class="bs_collection__banner-content">
      <div class="container">
        {%- unless settings.en_bs_collection2_banner_title == blank -%}
        <h2 class="bs_collection__banner-title">{{ settings.en_bs_collection2_banner_title | escape }}</h2>
        {%- endunless -%}
        {%- if settings.en_bs_collection2_banner_btn_show and _banner_link != blank -%}
        <span class="bs_collection__banner-btn" aria-hidden="true">
          {{ settings.en_bs_collection2_banner_btn | default: 'Buy now' | escape }}
        </span>
        {%- endif -%}
      </div>
    </div>
  {%- if _banner_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
  {%- endunless -%}

  <div class="bs_collection__products">
    <div class="container">
      <div class="bs_collection__products-header">
        {%- unless settings.en_bs_collection2_title == blank -%}
        <h3 class="bs_collection__products-title">{{ settings.en_bs_collection2_title | escape }}</h3>
        {%- endunless -%}
        {%- unless settings.en_bs_collection2_viewall_link == blank -%}
        <a href="{{ settings.en_bs_collection2_viewall_link }}" class="bs_collection__viewall">
          {{ settings.en_bs_collection2_viewall_text | default: 'View all' | escape }}
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
        {%- endunless -%}
      </div>

      <div class="bs_collection__track-wrap">
        <div class="bs_collection__track" data-bs-collection-track>
          {%- if _collection.products.size > 0 -%}
            {%- assign _limit = settings.en_bs_collection2_limit | default: 8 -%}
            {%- for product in _collection.products limit: _limit -%}
            <div class="bs_collection__item">
              {%- include 'en_product-loop' -%}
            </div>
            {%- endfor -%}
          {%- else -%}
          <p class="bs_collection__empty">Updating products...</p>
          {%- endif -%}
        </div>

        <button class="bs_collection__nav bs_collection__nav--prev" data-bs-collection-prev aria-label="Previous">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M5 12l7 7M5 12l7-7"/>
          </svg>
        </button>
        <button class="bs_collection__nav bs_collection__nav--next" data-bs-collection-next aria-label="Next">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M14 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
      {%- unless settings.en_bs_collection2_viewall_link == blank -%}
      <a href="{{ settings.en_bs_collection2_viewall_link }}" class="bs_collection__viewall--mobile">
        {{ settings.en_bs_collection2_viewall_text | default: 'View all' | escape }}
      </a>
      {%- endunless -%}
    </div>
  </div>

</section>

<script fetchpriority="low" defer src="{{ 'en_bs_collection.js' | asset_url }}"></script>
{% endif %}
