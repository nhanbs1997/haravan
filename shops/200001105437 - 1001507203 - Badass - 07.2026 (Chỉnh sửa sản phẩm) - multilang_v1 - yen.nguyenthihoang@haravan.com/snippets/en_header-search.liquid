<div class="search-overlay" id="searchOverlay" role="search">
  <div class="search-overlay__inner">
    <form class="search-form" action="/search" method="get">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/>
      </svg>
      <input type="text" name="q" id="inputSearchAuto" placeholder="Search products..." autocomplete="off" aria-label="Search products">
      <button type="button" class="search-overlay__close" aria-label="Close Search" data-action="open-search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </form>
    <div class="search-results" id="searchResults" aria-live="polite"></div>
  </div>
</div>
