{%- assign _blank = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=' -%}

<section class="about-mission">
  <div class="container">
    <div class="about-mission__card">
      <div class="about-mission__content">
        <div class="about-mission__content-inner">
          {%- unless settings.bs_about_mission_title == blank -%}
          <h2 class="about-mission__title">{{ settings.bs_about_mission_title }}</h2>
          {%- endunless -%}
          {%- unless settings.bs_about_mission_text_bold == blank and settings.bs_about_mission_text == blank -%}
          <div class="about-mission__text">
            {%- unless settings.bs_about_mission_text_bold == blank -%}
            <p class="about-mission__text-bold">{{ settings.bs_about_mission_text_bold }}</p>
            {%- endunless -%}
            {%- unless settings.bs_about_mission_text == blank -%}
            <p class="about-mission__text-regular">{{ settings.bs_about_mission_text }}</p>
            {%- endunless -%}
          </div>
          {%- endunless -%}
        </div>
      </div>
      <div class="about-mission__media">
        {%- unless settings.bs_about_mission_img == blank -%}
        <img
          class="about-mission__img lazyload isHideTBT"
          src="{{ _blank }}"
          data-src="{{ settings.bs_about_mission_img }}"
          alt="{{ settings.bs_about_mission_title | default: shop.name | escape }}"
          loading="lazy" decoding="async"
          width="714" height="476">
        {%- else -%}
        <div class="about-mission__img-placeholder" aria-hidden="true"></div>
        {%- endunless -%}
      </div>
    </div>
  </div>
</section>
