{%- comment -%}
  Snippet: pd-info-actions
  Mo ta: Qty +/- + nut Them vao gio hang.
{%- endcomment -%}

<div class="pd__actions">
  <div class="pd__qty">
    <button type="button" class="pd__qty-btn" id="pdQtyMinus" aria-label="Giảm">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M5 12h14"/></svg>
    </button>
    <span class="pd__qty-val" id="pdQtyVal">01</span>
    <button type="button" class="pd__qty-btn" id="pdQtyPlus" aria-label="Tăng">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
    </button>
  </div>
  <button type="button" class="pd__atc" id="pdAddToCart">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
    <span>THÊM VÀO GIỎ HÀNG</span>
  </button>
</div>
