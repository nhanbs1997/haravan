<div class="coll__filterbar container">
  <div class="coll__filterbar-left">
    <button type="button" class="coll__filter-toggle" id="sidebarToggle" aria-label="Open Filter" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
      <span class="coll__filterbar-title">Filter</span>
      <svg class="coll__filter-toggle-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <span class="coll__filterbar-count" id="filterCount">{{ collection.products_count }} result</span>
  </div>
  <div class="coll__filterbar-right">
    <div class="coll__filterbar-tags-wrap">
      <div class="coll__active-tags" id="activeTags"></div>
      <button type="button" class="coll__clear-btn" id="filterClear" style="display:none">Filter</button>
    </div>
    <div class="coll__sort">
      <span class="coll__sort-label">Sort by:</span>
      <div class="coll__sort-wrap" id="sortWrap">
        {%- comment -%} Custom dropdown button {%- endcomment -%}
        <button type="button" class="coll__sort-btn" id="sortBtn" aria-haspopup="listbox" aria-expanded="false">
          <span id="sortBtnLabel">Latest</span>
          <svg class="coll__sort-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        {%- comment -%} Custom dropdown List {% endcomment %}
        <ul class="coll__sort-dropdown" id="sortDropdown" role="listbox">
          <li role="option" class="is-active" data-sort="(updated_at:product=desc)"><button type="button">LATEST</button></li>
          <li role="option" data-sort="(price:product=asc)"><button type="button">LOW TO HIGH PRICE</button></li>
          <li role="option" data-sort="(price:product=desc)"><button type="button">HIGH TO LOW PRICE</button></li>
          <li role="option" data-sort="(title:product=asc)"><button type="button">NAME: A-Z</button></li>
          <li role="option" data-sort="(title:product=desc)"><button type="button">NAME: Z-A</button></li>
          <li role="option" data-sort="(sold_quantity:product=desc)"><button type="button">TO SELL WELL</button></li>
        </ul>
        {%- comment -%} Hidden Natives – Use to trigger Donnell JS {% endcomment %}
        <select class="sort-select coll__sort-select" aria-hidden="true" tabindex="-1" style="display:none">
          <option value="(updated_at:product=desc)" selected>Latest</option>
          <option value="(price:product=asc)">Low to High</option>
          <option value="(price:product=desc)">High to low</option>
          <option value="(title:product=asc)">Name: A-Z</option>
          <option value="(title:product=desc)">Name: Z-A</option>
          <option value="(sold_quantity:product=desc)">Selling</option>
        </select>
      </div>
    </div>
  </div>
</div>
