      const flagDefault = flags['vi'];
      $('.header-translate-flag').html(`
          <div class="header-multilanguage">
            <button>${flags[multi_language]||flagDefault}</button>
            <ul>
              <li data-lang="">${flags['vi']||flagDefault} Tiếng việt</li>
              <li data-lang="en">${flags['en']||flagDefault} English</li>
            </ul>
          </div>
      `);
      $('.header-multilanguage button').click(function () {
        $(this).parent().find('ul').toggle('fast');
      });
      $('.header-multilanguage ul li').click(function () {
        const langSet = $(this).attr('data-lang') || '';
        localStorage.setItem('template', langSet);
        if(checkRedirectToHome().length > 0) {
          window.location.href = "/";
        }else{
          let multi_getQuery = multi_url.match(/(?:\?|\&).*/)?multi_url.match(/(?:\?|\&).*/)[0]:'';
