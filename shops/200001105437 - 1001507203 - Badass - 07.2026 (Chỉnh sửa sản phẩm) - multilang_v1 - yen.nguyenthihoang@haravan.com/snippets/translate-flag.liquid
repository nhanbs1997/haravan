              const checkUrlBefore = multi_url.match(/(?:\?view\=|\&view\=)(.*)#/i);
              window.location.href = multi_url.replace(checkUrlBefore[0], '#');
            }else{
              const checkUrlBefore = multi_url.match(/(?:\?view\=|\&view\=)([a-zA-Z0-9\%\{\}\-\_\=\:\!\(\)\.\>\<]*)/i);
              window.location.href = multi_url.replace(checkUrlBefore[0], '');
            }
          }
          
        }
        
      });
    });
