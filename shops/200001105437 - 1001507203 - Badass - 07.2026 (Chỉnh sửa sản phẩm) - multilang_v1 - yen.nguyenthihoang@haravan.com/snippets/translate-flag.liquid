<script>
    const multi_template = "{{template}}";
    const multi_language = localStorage.getItem('template');
    const multi_url = window.location.href;
    const objectTemplateView = {
      "en" : {
        'page.about' : 'about.en',
        'page.contact' : 'contact.en',
        'page.he_thong_cua_hang' : 'he_thong_cua_hang.en',
        'page.stores' : 'stores.en',
        'page.landing' : 'landing.en',
        'collection.uudai' : 'uudai.en',
        'collection.style2' : 'style2.en'
      }
    }
    if(multi_language && multi_language.length > 0){
        let multi_getQuery = multi_url.match(/(?:\?|\&).*/)?multi_url.match(/(?:\?|\&).*/)[0]:'';
        if(multi_url.search('#') > 0){
                  multi_getQuery = multi_url.match(/\?(.*)#/)?multi_url.match(/\?(.*)#/)[0]:multi_getQuery;
          if(!multi_getQuery){
            if(checkTemplateView()){
              window.location.href = multi_url.replace('#', ('?view=' + checkTemplateView() + '#'));
            }else{
              window.location.href = multi_url.replace('#', ('?view=' + multi_language + '#'));
            }
            
          }
              }else if(!multi_getQuery){
          window.location.href = (multi_url + '?view=' + (checkTemplateView()?checkTemplateView():multi_language));
        }
        console.log(multi_getQuery);
        const multi_match = multi_url.match(/(?:\?view\=|\&view\=)/i);
        if(!multi_match){
          let multi_buildURL = '';
          if(multi_url.search('#') > 0){
            if(multi_url.search('\\?') > 0){
              multi_buildURL = multi_getQuery.replace('#', '&view='+ checkTemplateView() + '#');
            }else{
              multi_buildURL = multi_getQuery.replace('#', '?view='+ checkTemplateView() + '#');
            }
          }else{
            if(multi_url.search('\\?') > 0){
              multi_buildURL = multi_getQuery +  '&view='+ (checkTemplateView()?checkTemplateView():multi_language);
            }else{
              multi_buildURL = multi_getQuery +  '?view='+ (checkTemplateView()?checkTemplateView():multi_language);
            }
          }
         window.location.href = multi_buildURL;
        }else if(multi_match && multi_match.length > 0){
          //redirect to view
        }
    }
    function checkTemplateView() {
      const getObjWithLang = objectTemplateView[localStorage.getItem('template')];
      if(!getObjWithLang) return null;
      return getObjWithLang[multi_template]?getObjWithLang[multi_template]:null;
    }
    
    function checkRedirectToHome() {
      var check = false;
              const arrayTemplateLock = ['blog.en', 'blog', 'article', 'article.en'];
        return arrayTemplateLock.filter((tempCheck) => multi_template == tempCheck);
    }
    
    document.addEventListener('DOMContentLoaded', () => {
