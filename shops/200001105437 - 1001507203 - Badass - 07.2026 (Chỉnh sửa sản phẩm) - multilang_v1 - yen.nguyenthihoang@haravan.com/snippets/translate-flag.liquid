                  multi_buildURL = multi_getQuery +  '&view='+ (checkTemplateView()?checkTemplateView():langSet);
                }else{
                  multi_buildURL = multi_getQuery +  '?view='+ (checkTemplateView()?checkTemplateView():langSet);
                }
              }
             window.location.href = multi_buildURL;
            }else{
              //template replace
            }
            
