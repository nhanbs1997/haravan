{%- comment -%}
  Snippet: blog-article-card
  Mô tả: Card bài viết dùng trong blog grid (section 2).
  Vars:
    article : object bai viet
{%- endcomment -%}

<article class="article-card">
  <a href="{{ article.url }}" class="article-card__media" aria-label="{{ article.title | escape }}" tabindex="-1">
    {%- if article.image -%}
    <img class="article-card__img"
      src="{{ article.image | img_url: 'grande' }}"
      alt="{{ article.title | escape }}"
      loading="lazy" decoding="async" width="392" height="294">
    {%- else -%}
    <img class="article-card__img article-card__img--placeholder"
      src="{{ 'en_logo.png' | asset_url }}"
      alt="{{ article.title | escape }}"
      width="392" height="294">
    {%- endif -%}
    <div class="article-card__overlay" aria-hidden="true"></div>
  </a>
  <div class="article-card__body">
    <div class="article-card__meta">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#0a6174" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 5v3l2 1.5"/></svg>
      <time class="article-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d/%m/%Y' }}</time>
    </div>
    <p class="article-card__excerpt">
      <a href="{{ article.url }}">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</a>
    </p>
  </div>
</article>
