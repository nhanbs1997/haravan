<div class="header_dropdown_content site_account {% if customer %}site-account--info{% endif %}">
	<span class="box-triangle">
		<svg viewBox="0 0 20 9">
			<path d="M.47108938 9c.2694725-.26871321.57077721-.56867841.90388257-.89986354C3.12384116 6.36134886 5.74788116 3.76338565 9.2467995.30653888c.4145057-.4095171 1.0844277-.40860098 1.4977971.00205122L19.4935156 9H.47108938z" fill="#ffffff"></path>
		</svg>
	</span>
	<div class="site-nav-container text-center">
		{%- if shop.customer_accounts_enabled -%}
		{%- if customer -%}
		{%- if customer.default_address.first_name == empty and customer.default_address.last_name == empty -%}
		<div class="site_account_info">
			<div class="site_account_header">
				<h2>Thông tin tài khoản</h2>
			</div>
			<ul>
				<li><span>{{customer.first_name}} {{customer.last_name}}</span></li>
				<li><a href="/account">Thông tin tài khoản</a></li>
				<li><a href="/account/addresses">Danh sách địa chỉ</a></li>
				<li><a href="/account/logout">Đăng xuất</a></li>
			</ul>
		</div>
		{%- else -%}
		<div class="site_account_info">
			<div class="site_account_header">
				<h2>Thông tin tài khoản</h2>
			</div>
			<ul>
				<li><span>{{customer.default_address.first_name}} {{customer.default_address.last_name}}</span></li>
				<li><a href="/account">Thông tin tài khoản</a></li>
				<li><a href="/account/addresses">Danh sách địa chỉ</a></li>
				<li><a href="/account/logout">Đăng xuất</a></li>
			</ul>
		</div>
		{%- endif -%}
		{%- else -%}
		<div class="site_account_panel_list">
			<div id="header-login-panel" class="site_account_panel site_account_default is-selected">
				<div class="site-account-list">
					{%- capture formLoginHeader -%}
					{%- form 'customer_login' -%}
					{{ form.errors | default_errors }}
					<div class="site_account_header">
						<h2 class="site_account_title heading">Đăng nhập tài khoản</h2>
						<p class="site_account_legend">Nhập email và mật khẩu của bạn:</p>
					</div>
					<div class="form__input-wrapper form__input-wrapper--labelled">
						<input type="email" id="login-customer[email]" class="form__field form__field--text" name="customer[email]" required="required" autocomplete="email">
						<label for="login-customer[email]" class="form__floating-label">Email</label>
					</div>
					<div class="form__input-wrapper form__input-wrapper--labelled">
						{%- if form.password_needed -%}
						<input type="password" id="login-customer[password]" class="form__field form__field--text" name="customer[password]" required="required" autocomplete="current-password">
						<label for="login-customer[password]" class="form__floating-label">Mật khẩu</label>
						{%- endif -%}
						<div class="sitebox-recaptcha">
							This site is protected by reCAPTCHA and the Google
							<a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">Privacy Policy</a> 
							and <a href="https://policies.google.com/terms" target="_blank" rel="noreferrer">Terms of Service</a> apply.
						</div>
					</div>
					<button type="submit" class="form__submit button dark" id="form_submit-login">Đăng nhập</button>
					{%- endform -%}
					{%- endcapture -%}
					{{ formLoginHeader | replace: 'script','noscript'}}		
					<div class="site_account_secondary-action">
						<p>Khách hàng mới? 
							<a href="/account/register" class="link">Tạo tài khoản</a>
							<!--<button aria-controls="header-register-panel" class="js-link link" >Tạo tài khoản</button>-->
						</p>
						<p>Quên mật khẩu? 
							<button aria-controls="header-recover-panel" class="js-link link">Khôi phục mật khẩu</button>
						</p>
					</div>
				</div>
			</div>
			<div id="header-recover-panel" class="site_account_panel site_account_sliding">
				<div class="site-account-list">
					{%- capture formRecoverHeader -%}
					{%- form 'recover_customer_password' -%}
					{{ form.errors | default_errors }}
					<div class="site_account_header">
						<h2 class="site_account_title heading">Khôi phục mật khẩu</h2>
						<p class="site_account_legend">Nhập email của bạn:</p>
					</div>
					<div class="form__input-wrapper form__input-wrapper--labelled">
						<input type="email" id="recover-customer[recover_email]" class="form__field form__field--text" name="email" required="required" autocomplete="email">
						<label for="recover-customer[recover_email]" class="form__floating-label">Email</label>
						<div class="sitebox-recaptcha">
							This site is protected by reCAPTCHA and the Google
							<a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">Privacy Policy</a> 
							and <a href="https://policies.google.com/terms" target="_blank" rel="noreferrer">Terms of Service</a> apply.
						</div>
					</div>
					<button type="submit" class="form__submit button dark" id="form_submit-recover">Khôi phục</button>
					{%- endform -%}
					{%- endcapture -%}
					{{ formRecoverHeader | replace: 'script','noscript'}}
					<div class="site_account_secondary-action">
						<p>Bạn đã nhớ mật khẩu? 
							<button aria-controls="header-login-panel" class="js-link link">Trở về đăng nhập</button>
						</p>
					</div>
				</div>
			</div>
		</div>
		{%- endif -%}
		{%- endif -%}
	</div>
</div>




