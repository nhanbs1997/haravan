<footer class="footer {% if settings.addthis_iconList_show%} mainfooter-toolbar {% endif%} {% if template == 'product'%} mainfooter-product{% endif%} ">
	<div class="main-footer" id="fter-content">
		<div class="container-fluid">
			<div class="row">
        <div class="col-xs-12 col-lg col-md-3 col-sm-6">
          <div class="footer-col footer-block">
						<div class="gt">
              {{ settings.te1 }}
            </div>
            {%- if settings.1footer_info_bct != empty -%}
              <div class="footer_info_bct">
                <a href="{{settings.1footer_info_bct}}">
                  <img src="https://cdn.hstatic.net/files/200001075971/file/dathongbao.png" alt="bo cong thuong"/>
                </a>
              </div>
            {%- endif -%}
					</div>
        </div>
				{% if settings.footer_link1_show %}
				<div class="col-xs-12 col-sm-6 col-md-3 col-lg">
					<div class="footer-col footer-block">
						<h4 class="footer-title">
							{{settings.footer_link1_title}}
						</h4>
						<div class="footer-content toggle-footer">
							<ul>
								{%for link in linklists[settings.footer_link1_menu].links%}
								<li class="item">
									<a href="{{link.url}}" title="{{link.title}}">{{link.title}}</a>
								</li>
								{%endfor%}	
							</ul>
						</div>
					</div>
				</div>
				{% endif %}
        
				{% if settings.footer_link2_show %}
				<div class="col-xs-12 col-sm-6 col-md-3 col-lg">
					<div class="footer-col footer-block">
						<h4 class="footer-title">
							{{settings.footer_link2_title}}
						</h4>
						<div class="footer-content toggle-footer">
							{{ settings.footer_link2_txt }}
						</div>
					</div>
				</div>
				{% endif %}
				{% if settings.mailing_list_show %}
				<div class="col-xs-12 col-sm-6 col-md-3 col-lg">
					<div class="footer-col footer-content1">
						<h4 class="footer-title">
							{{settings.mailing_list_heading}}
						</h4>
						<div class="footer-content">
							<p>{{settings.mailing_list_caption}}</p>
							<div class="form_newsletter"> 
								{%- capture formFooter -%}
								{%- form 'customer'-%}
								<div class="input-group">
									<input type="hidden" id="newsletter_tags" name="contact[tags]" value="khách hàng tiềm năng, bản tin" />     
									<input required type="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$" value="" placeholder="Nhập email của bạn" name="contact[email]"  aria-label="Email Address">
									<button type="submit" class="button dark">Đăng ký</button>
								</div>
								<div class="sitebox-recaptcha hidden" >
									This site is protected by reCAPTCHA and the Google
									<a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">Privacy Policy</a> 
									and <a href="https://policies.google.com/terms" target="_blank" rel="noreferrer">Terms of Service</a> apply.
								</div>	
								{%- if form.posted_successfully? -%}<p class="newsletter-success success feedback accent-text">Cảm ơn bạn đã đăng ký email theo dõi!</p>{% endif %}
								{%- if form.errors -%}
								<div class="error-box newsletter-error">
									{%- for field in form.errors -%}
									{{ field }} {{ form.errors.messages[field] }}
									{%- endfor -%} 
								</div>
								{%- endif -%}
								{%- endform -%}
								{%- endcapture -%}
								{{ formFooter | replace: 'script','noscript'}}
							</div>
						</div>
					</div>
				</div>
				{% endif %}
