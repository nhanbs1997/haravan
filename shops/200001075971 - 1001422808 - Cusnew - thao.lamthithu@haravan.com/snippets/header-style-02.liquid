<header id="site-header" class="main-header mainHeader_temp02 {%if template contains 'product'%}mainHeader_tempPr{%endif%}">
	{% if settings.use_info_header %}
	<div id="topbar">
		<div class="container-fluid">
			<div class="topbar-content">
				<div class="topbar-center">
					<p class="text-center">{{ settings.info_header }}</p>
				</div>
			</div>	
		</div>
	</div>
	{% endif %}
	<div class="header-middle">
		<div class="container-fluid">
			<div class="flexContainer-header">
				<div class="header-wrap-nav header-action">
					{%- if template contains 'product' -%}
					<div class="site-handle backto-page">
						<a href="javascript:void(0);" aria-label="Trở về" onclick="window.history.back();"><i class="fa fa-angle-left" aria-hidden="true"></i></a>
					</div>
					{%- endif-%}
					<div id="site-menu-handle" class="header-action-toggle site-handle">
						<span class="hamburger-menu" aria-hidden="true">
							<span class="bar"></span>
						</span>
					</div>
					{%- include 'menu-mb'-%}
				</div>
				<div class="header-wrap-logo">
					<div class="wrap-logo" itemscope="" itemtype="http://schema.org/Organization">
						{% if settings.use_logo %}
						{% if template == 'index' %}
						<a href="{{shop.url}}" itemprop="url" aria-label="logo">
							<img itemprop="logo" src="{{ 'logo.png'|asset_url }}" alt="{{ shop.name }}" class="img-responsive logoimg"/>
						</a>
						<h1 style="display:none"><a href="{{shop.url}}" itemprop="url">{{ shop.name }}</a></h1>
						{% else %}
						<a href="{{shop.url}}"  itemprop="url" aria-label="logo">
							<img itemprop="logo" src="{{ 'logo.png'|asset_url }}" alt="{{ shop.name }}" class="img-responsive logoimg"/>
						</a>
						{% endif %}
						{% else %}
						{% if template == 'index' %}
						<h1><a href="{{shop.url}}" itemprop="url">{{ shop.name }}</a></h1>
						{% else %}
						<a href="{{shop.url}}" itemprop="url">{{ shop.name }}</a>
						{% endif %}
						{% endif %}
					</div>
				</div>
				<div class="header-wrap-menu hidden-xs hidden-sm">
					<div class="menu-desktop">
						{% include 'menu' %}
					</div>
				</div>
				<div class="header-wrap-icon">
					<div class="header-action-icon">
						<div class="header-action header_wrap_search">
							<a id="site-search-handle" class="header-action-toggle" href="javascript:void(0)" arial-label="Tìm kiếm" title="tìm kiếm">
