<div class="site-nav-container-last">
	<p class="title">Menu</p>
	<div class="main-navbar">
		<nav class="primary-menu">
			<ul class="menu-collection">	
				{% for link1 in linklists[settings.mainmenu_link].links %}
				{% if linklists[link1.handle].links == empty %}				
				<li class="navi1"><a href="{{link1.url}}"><span>{{link1.title}}</span></a></li>
				{% else %}
				<li class="navi1 has-sub level0">
					<a href="{{ link1.url }}">{{ link1.title }}</a>
					<span class="icon-subnav"><i class="fa fa-angle-down"></i></span>
					<ul class=" submenu subnav-children">
						{% for link2 in linklists[link1.handle].links %}
						{% if linklists[link2.handle].links == empty %}
						<li class="navi2"><a href="{{ link2.url }}">{{ link2.title }}</a></li>
						{% else %}
						<li class="navi2 has-sub level1">
							<a href="{{ link2.url }}">{{ link2.title }}</a>
							<span class="icon-subnav"><i class="fa fa-angle-down"></i></span>
							<ul class="submenu subnav-child" >
								{% for link3 in linklists[link2.handle].links %}						
								<li class=""><a href="{{ link3.url }}">{{ link3.title }}</a></li>
								{% endfor %}
							</ul>
						</li>
						{% endif %}
						{% endfor %}
					</ul>
				</li>
				{% endif %}
				{% endfor%}
			</ul>
			<ul class="menu-about">
				{% for childlink in linklists[settings.childrenmenu__link].links %}
				<li><a  href="{{childlink.url}}"><span>{{childlink.title}}</span></a></li>		
				{% endfor %}
				{% if shop.customer_accounts_enabled or shop.customer_accounts_optional %}
				{% if customer  %}
