.product-sharing{	
	display: none;
	height: auto;	
	width: 26px;
	left: 10%;	
	bottom: 50px;
	cursor: pointer;
	padding-bottom: 30px;
	-ms-transition: transform 500ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	-webkit-transition:transform 500ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	transition: transform 500ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
