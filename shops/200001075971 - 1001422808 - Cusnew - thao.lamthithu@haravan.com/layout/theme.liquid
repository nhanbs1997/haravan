	<body id="{{shop.name | downcase }}" class="{{template | handle }}">  
		{% include 'svg-icon' %}
		<div class="main-body {% if settings.addthis_iconList_show %} layoutProduct_scroll {% endif %}">

			{%include 'header'%}
			<main class="mainContent-theme{% if template == 'index' %} main-index	{% endif %}">
				{{ content_for_layout }}
			</main>
			{% include 'footer' %}
			{%- include 'addthis-sharing' -%}
			{%- if settings.show_icon_mess -%}
