<div class="wolf-products-block mb-4 mt-5">
	<div class="container wolf-products-block-3">
		<div class="wolf-products-block-product-titles d-flex justify-content-between align-items-center flex-column flex-lg-row mb-2">
			<h4 class="wolf-products-block-product-title text-uppercase h4 fw-semibold mb-2">
				<a href="{{ collections[settings.section_product_3_col].url }}" title="{{ settings.section_product_3_title }}">{{ settings.section_product_3_title }}</a>
			</h4>
			{%- if linklists[settings.section_product_3_menu].links.size > 0 -%}
			<ul class="list-group list-group-horizontal wolf-scroll-mb">
				{%- for link in linklists[settings.section_product_3_menu].links limit: 4 -%}
				<li class="list-group-item border-0 text-uppercase fw-medium"><a href="{{ link.url }}" title="{{ link.title }}">{{ link.title }}</a></li>
				{%- endfor -%}
			</ul>
			{%- endif -%}
		</div>
		{%- if collections[settings.section_product_3_col].products_count > 0 -%}
		<div class="row g-2 g-md-3 g-lg-2 wolf-products-block-product-product">
			<div class="col-xxl-4 col-xl-4 col-lg-4 col-md-12 col-12">
				<div class="wolf-products-block-img mt-0 row g-2">
					<a class="col-xxl-12 col-xl-12 col-lg-12 col-md-6 col-sm-6 col-6 mt-0 rounded-4" href="{{ settings.section_product_3_img_link }}" title="{{ settings.section_product_3_img_alt }}">
						<img width="427" height="510" src="{{ 'section_product_3_img.jpg' | asset_url }}" alt="{{ settings.section_product_3_img_alt }}" class="img-fluid rounded-4" loading="lazy" >
					</a>
					<a class="col-xxl-12 col-xl-12 col-lg-12 col-md-6 col-sm-6 col-6 mt-0 mt-lg-2 rounded-4" href="{{ settings.section_product_3_img_link_1 }}" title="{{ settings.section_product_3_img_alt_1 }}">
						<img width="427" height="510" src="{{ 'section_product_3_img_1.jpg' | asset_url }}" alt="{{ settings.section_product_3_img_alt_1 }}" class="img-fluid rounded-4" loading="lazy" >
					</a>
				</div>
			</div>
			<div class="col-xxl-8 col-xl-8 col-lg-8 col-md-12 col-12 mt-lg-0 mt-2">
				<div class="row g-2 g-md-2 g-lg-2 wolf-scroll-tab">
					{%- for product in collections[settings.section_product_3_col].products limit: settings.section_product_3_limit -%}
					<div class="col-xxl-4 col-xl-4 col-lg-4 col-md-5 col-6 product-item">
						{%- include 'wolf-product-grid' -%}
					</div>
					{%- endfor -%}
				</div>
			</div>
		</div>
		<div class="d-flex justify-content-center mt-3 wolf-products-block-view-more">
			<a class="btn rounded-pill fw-semibold" href="{{ collections[settings.section_product_3_col].url }}" title="Xem thêm">Xem thêm</a>
		</div>
		{%- else -%}
		<div class="alert alert-danger" role="alert">Danh mục này đang cập nhật.</div>
		{%- endif -%}
	</div>
</div>