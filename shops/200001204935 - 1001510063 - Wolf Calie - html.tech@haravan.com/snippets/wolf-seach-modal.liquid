<div id="search-popup" class="rounded-4">
	<h5 class="mb-3 text-center text-uppercase">Tìm kiếm</h5>
	<div class="search-body">
		<form action="/search" method="get" class="d-flex input-group smart-search position-relative" role="search">
			<input class="form-control" name="q" type="text" placeholder="Tìm kiếm trong {{ shop.name }}" aria-label="Search" autocomplete="off" required id="smartSearchInput" >
			<button class="btn btn-outline-success" type="submit" aria-label="Search">
				<svg width="24" height="24"><use xlink:href="#icon-search" /></svg>
			</button>
			<div id="searchLoader" class="text-center py-2 w-100 d-none">
				<div class="spinner-border text-primary" role="status" style="width: 1.5rem; height: 1.5rem;">
					<span class="visually-hidden">Đang tìm...</span>
				</div>
			</div>
		</form>
		<div id="searchHistoryBox" class="mt-3 w-100 d-none"></div>
		<div id="searchResultsBox" class="mt-3 w-100 d-none"></div>
		<div id="defaultCategoryModule" class="mt-3 rounded-4">
			<h5 class="text-center mb-2"><a href="{{ settings.search_product_col }}" title="{{ settings.search_product_title }}">{{ settings.search_product_title }}</a></h5>
			{%- if collections[settings.search_product_col].products_count > 0 -%}
			<div class="row g-2 wolf-products-block-product-product">
				{%- for product in collections[settings.search_product_col].products limit: settings.search_product_limit -%}
				<div class="col-xxl-2 col-xl-2 col-lg-3 col-md-4 col-6 product-item">
					{%- include 'wolf-product-grid' -%}
				</div>
				{%- endfor -%}
			</div>
			<div class="text-center mt-4 wolf-products-block-view-more">
				<a class="wolf-btn btn d-inline-flex" href="{{ settings.search_product_col }}" title="Xem thêm {{ settings.search_product_title }}">Xem thêm {{ settings.search_product_title }}</a>
			</div>
			{%- else -%}
			<div class="alert alert-danger" role="alert">Không có sản phẩm nào trong danh mục này.</div>
			{%- endif -%}
		</div>
	</div>
</div>