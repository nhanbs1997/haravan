{%- capture content -%}{%- include 'shortcode-render' render:'content' -%}{%- endcapture -%}
{%- capture image1 -%}{%- include 'shortcode-render' render:'image1' -%}{%- endcapture -%}
{%- capture alt1 -%}{%- include 'shortcode-render' render:'alt1' -%}{%- endcapture -%}
{%- capture image2 -%}{%- include 'shortcode-render' render:'image2' -%}{%- endcapture -%}
{%- capture alt2 -%}{%- include 'shortcode-render' render:'alt2' -%}{%- endcapture -%}
<div class="lookbook-textimg py-3 py-md-5">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-xxl-5 col-xl-5 col-lg-5 col-md-12 col-sm-12 col-12">
				<div class="lookbook-textimg-text mb-4 mb-lg-0">{{ content }}</div>
			</div>
			<div class="col-xxl-7 col-xl-7 col-lg-7 col-md-12 col-sm-12 col-12">
				<div class="row g-2">
					<div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
						<img src="{{ image1 }}" alt="{{ alt1 }}" class="img-fluid" loading="lazy" >
					</div>
					<div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
						<img src="{{ image2 }}" alt="{{ alt2 }}" class="img-fluid" loading="lazy" >
					</div>
				</div>
			</div>
		</div>
	</div>
</div>