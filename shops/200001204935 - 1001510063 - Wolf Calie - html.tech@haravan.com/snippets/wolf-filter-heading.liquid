{%- assign combine_pretext = false -%}
{%- assign description = collection.description -%}
{%- if description contains "<h6>" -%}
{%- assign tab_heads = '' -%}
{%- assign tab_texts = '' -%}
{%- assign pretext = '' -%}
{%- assign chunks = description | strip | split: "<h6>" -%}
{%- for c in chunks -%}
{%- if c contains "</h6>" -%}
{%- assign chunk = c | split: "</h6>" -%}
{%- assign tab_heads = tab_heads | append: ",," | append: chunk.first -%}
{%- assign tab_texts = tab_texts | append: ",," -%}
{%- if pretext != blank  and combine_pretext -%}
{%- assign tab_texts = tab_texts | append: pretext | append: "<br>" -%}
{%- assign pretext = '' -%}
{%- endif -%}
{%- assign tab_texts = tab_texts | append: chunk.last  -%}
{%- elsif forloop.first -%}
{%- assign pretext =  c -%}
{%- endif -%}
{%- endfor -%}
{%- assign tab_heads = tab_heads | remove_first: ",," | split: ",," -%}
{%- assign tab_texts = tab_texts | remove_first: ",," | split: ",," -%}
{%- assign index =  1 -%}
{%- for head in tab_heads -%}
<aside class="aside-item filter-tag-style-{{index}} tag-filtster position-static">
	<div class="aside-title rounded-2 d-flex align-items-center">{{ head }} <svg width="24" height="24"><use xlink:href="#icon-chevron-down" /></svg></div>
	<div class="aside-content filter-group rounded-2 shadow position-absolute">
		<ul>
			{%- assign tags = tab_texts[forloop.index0] |strip_html | split: ',' -%}
			{%- for t in tags -%}
			{%- assign tag = t | strip -%}
			{%- assign tag_value = tag | handleize -%}
			{%- if tag != '' -%}
			<li class="filter-item filter-item--check-box filter-item--green">
				<label for="filter-{{ tag | handleize }}" title="{{tag}}">
					<input type="checkbox"
                      id="filter-{{ tag | handleize }}"
                      class="filter-checkbox" data-group="tag"
                      value="{{ tag | escape }}">
					{{tag}}
				</label>
			</li>	
			{%- endif -%}
			{%- endfor -%}
		</ul>
	</div>
</aside>
{%- assign index =  index | plus: 1  -%}
{%- endfor -%}
{%- endif -%}