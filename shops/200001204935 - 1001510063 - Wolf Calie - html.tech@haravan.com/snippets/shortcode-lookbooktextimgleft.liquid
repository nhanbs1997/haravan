{%- capture leftcontent -%}{%- include 'shortcode-render' render:'leftcontent' -%}{%- endcapture -%}
{%- capture leftimage1 -%}{%- include 'shortcode-render' render:'leftimage1' -%}{%- endcapture -%}
{%- capture leftalt1 -%}{%- include 'shortcode-render' render:'leftalt1' -%}{%- endcapture -%}
{%- capture leftimage2 -%}{%- include 'shortcode-render' render:'leftimage2' -%}{%- endcapture -%}
{%- capture leftalt2 -%}{%- include 'shortcode-render' render:'leftalt2' -%}{%- endcapture -%}
<div class="lookbook-textimg-left py-5">
	<div class="container">
		<div class="row align-items-center">
			<div class="col-xxl-7 col-xl-7 col-lg-7 col-md-12 col-sm-12 col-12">
				<div class="row g-2">
					<div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
						<img src="{{ leftimage1 }}" alt="{{ leftalt1 }}" class="img-fluid" loading="lazy" >
					</div>
					<div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
						<img src="{{ leftimage2 }}" alt="{{ leftalt2 }}" class="img-fluid" loading="lazy" >
					</div>
				</div>
			</div>
			<div class="col-xxl-5 col-xl-5 col-lg-5 col-md-12 col-sm-12 col-12">
				<div class="lookbook-textimg-text mt-3 mt-lg-0">{{ leftcontent }}</div>
			</div>
		</div>
	</div>
</div>