{%- include 'wolf-split-heading' -%}
<section class="wolf-collections-page mb-3 mt-3"> 
	<div class="container">
		<div class="row collection-header mb-4 pb-4 mt-2 align-items-center">
			<div class="{%- if settings.collection_banner_enable -%}col-xxl-4 col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12 order-2 order-sm-2 order-md-2 order-lg-1{%- else -%}col-xxl-12 col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12 text-center mt-3{%- endif -%}">
				<h1 class="title-head h4">{%- if collection.title == 'Products' -%}Tất cả sản phẩm{%- else -%}{{ collection.title }}{%- endif -%}</h1>
			</div>
			{%- if settings.collection_banner_enable -%}
			{%- include 'wolf-gallery_collections' -%}
			{%- endif -%}
		</div>
		{%- if settings.wolf-collections-sales -%}
		{%- include 'wolf-collections-sales' -%}
		{%- endif -%}
		{%- if settings.wolf-collections-menu -%}
		{%- include 'wolf-subcategories' -%}
		{%- endif -%}
		{%- include 'wolf-filter' -%}
		<div class="category-products products category-products-grids clearfix" id="product-list">
			{%- paginate collection.products by settings.collection_number_product -%}
			{%- if collection.products.size > 0 -%}
			{%- include 'products-grid-item' -%}
			{%- else -%}
			<div class="alert alert-danger" role="alert">Sản phẩm đang được cập nhật.</div>
			{%- endif -%}
			{%- endpaginate -%}
		</div>
		{%- include 'wolf-collections-description' -%}
	</div>
</section>
<script>
var selectedFilters = {
vendor: [],
type: [],
price: [],
tag: []
};
var currentPage = 1;
var currentSort = 'manual';
var currentSortKey = '';
var SORT_MAP = {
'alpha-asc':   'title:product=asc',
'alpha-desc':  'title:product=desc',
'price-asc':   'price:product=asc',
'price-desc':  'price:product=desc',
'created-desc':'created_on:product=desc',
'created-asc': 'created_on:product=asc'
};
function findSortKeyByHaravan(val) {
for (var k in SORT_MAP) {
  if (SORT_MAP[k] === val) return k;
}
return '';
}

// -------------------- Build filter Haravan --------------------
function buildHaravanFilter() {
let conditions = [];
if (window.collectionHandle !== 'all') {
  conditions.push(`(collectionid:product=${window.collectionId})`);
} else {
  conditions.push(`(id:product > 0)`);
}
console.log(window.collectionHandle);
if (selectedFilters.vendor.length > 0) {
  let vendors = selectedFilters.vendor.map(v => `(vendor:product**${v})`);
  conditions.push(vendors.join("||"));
}
if (selectedFilters.type.length > 0) {
  let types = selectedFilters.type.map(t => `(product_type:product**${t})`);
  conditions.push(types.join("||"));
}
if (selectedFilters.tag.length > 0) {
  let tags = selectedFilters.tag.map(t => `(tag:product**${t})`);
  conditions.push(tags.join("||"));
}

if (selectedFilters.price.length > 0) {
  let val = selectedFilters.price[0].trim();

  if (val.includes('-')) {
    let range = val.split('-');
    let min = parseInt(range[0]) || 0;
    let max = parseInt(range[1]) || 0;
    conditions.push(`((price:product>=${min})&&(price:product<=${max}))`);
  } else if (val.startsWith('<=') || val.startsWith('<')) {
    let max = parseInt(val.replace(/[^0-9]/g,'')) || 0;
    conditions.push(`((price:product>=0)&&(price:product<=${max}))`);
  } else if (val.startsWith('>=') || val.startsWith('>')) {
    let min = parseInt(val.replace(/[^0-9]/g,'')) || 0;
    conditions.push(`((price:product>=${min}))`);
  } else {
    let price = parseInt(val) || 0;
    conditions.push(`((price:product>=${price})&&(price:product<=${price}))`);
  }
}

return "filter=(" + conditions.join("&&") + ")";
}


// -------------------- Build friendly URL --------------------
function buildFriendlyUrl() {
let params = new URLSearchParams();

if (selectedFilters.vendor.length > 0) params.set("vendor", selectedFilters.vendor.join(','));
if (selectedFilters.type.length > 0) params.set("type", selectedFilters.type.join(','));
if (selectedFilters.tag.length > 0) params.set("tag", selectedFilters.tag.join(','));
if (selectedFilters.price.length > 0) params.set("price", selectedFilters.price[0]);

params.set("page", currentPage);
if (currentSort && currentSort !== 'manual') params.set("sort_by", encodeURIComponent(currentSort));

return `/collections/${window.collectionHandle}?${params.toString()}`;
}

// -------------------- Render filter đã chọn --------------------
function renderSelectedFilters() {
let $container = $('.filter-container__selected-filter');
let $list = $container.find('ul');
$list.empty();

let hasFilter = false;

Object.keys(selectedFilters).forEach(group => {
  selectedFilters[group].forEach(val => {
    hasFilter = true;
    let label = val;

    if (group === 'price') {
      if (val.startsWith('<=') ) {
        let price = Number(val.replace('<=','').trim());
        label = 'Dưới ' + price.toLocaleString('vi-VN') + '₫';
      } else if (val.startsWith('>=') ) {
        let price = Number(val.replace('>=','').trim());
        label = 'Trên ' + price.toLocaleString('vi-VN') + '₫';
      } else if (val.includes('-')) {
        let parts = val.split('-');
        let min = Number(parts[0].trim());
        let max = Number(parts[1].trim());
        label = min.toLocaleString('vi-VN') + '₫ - ' + max.toLocaleString('vi-VN') + '₫';
      }
    }

    let li = `
      <li class="filter-tag">
        <a href="javascript:void(0)" data-group="${group}" data-value="${val}" class="remove-filter">
          ${label} <i class="fa fa-times"></i>
        </a>
      </li>`;
    $list.append(li);
  });
});

if (hasFilter) $container.show(); else $container.hide();
}

// -------------------- Apply filter --------------------
function applyFilter(pushState = true) {
// 1. Kiểm tra xem có đang dùng bộ lọc nào không
    let isFilterActive = (
        selectedFilters.vendor.length > 0 ||
        selectedFilters.type.length > 0 ||
        selectedFilters.tag.length > 0 ||
        selectedFilters.price.length > 0
    );

    let isSortActive = (currentSort && currentSort !== 'manual');

    let ajaxUrl = '';
    let friendlyUrl = '';
    if (!isFilterActive && !isSortActive) {
        ajaxUrl = `/collections/${window.collectionHandle}?view=data&page=${currentPage}`;
        friendlyUrl = `/collections/${window.collectionHandle}?page=${currentPage}`;
    } 
    else {
        let filterQuery = buildHaravanFilter();
        ajaxUrl = `/search?q=${encodeURIComponent(filterQuery)}&page=${currentPage}`
                + (isSortActive ? `&sortby=${encodeURIComponent(currentSort)}` : '')
                + `&view=data`;
        friendlyUrl = buildFriendlyUrl();
    }
$.ajax({
  url: ajaxUrl,
  type: 'GET',
  success: function (html) {
    $('#product-list').html(html);
    renderSelectedFilters();
    $('.add_to_cart').click(function(e){
				e.preventDefault();
				var $this = $(this);						   
				var form = $this.parents('form');						   
				$.ajax({
					type: 'POST',
					url: '/cart/add.js',
					async: false,
					data: form.serialize(),
					dataType: 'json',
					error: addToCartFail,
					beforeSend: function() {  
						if(window.theme_load == "icon"){
							awe_showLoading('.btn-addToCart');
						} else{
							awe_showPopup('.loading');
						}
					},
					success: addToCartSuccess,
					cache: false
				});
			});
    $('.aside-filter').removeClass('active');
    $('html, body').animate({ scrollTop: $('.category-products').offset().top }, 0);
    if (pushState) history.pushState(null, null, friendlyUrl);
     $('.sort-cate-left .btn-quick-sort').removeClass('active');
    if (currentSortKey) $('.sort-cate-left .btn-quick-sort.' + currentSortKey).addClass('active');
    window.comparison.init();
			initSwatchImageSwitcher();
			countFilterItem();
			$(document).ready(function () {
				var modal = $('#quick-view-product');
				var btn = $('.quick-view');
				btn.click(function () {
					modal.modal('show');
				});
			});
  }
});
}
function parseFiltersFromUrl() {
let params = new URLSearchParams(window.location.search);
if (params.get('vendor')) selectedFilters.vendor = params.get('vendor').split(',');
if (params.get('type')) selectedFilters.type = params.get('type').split(',');
if (params.get('tag')) selectedFilters.tag = params.get('tag').split(',');
if (params.get('price')) selectedFilters.price = [params.get('price')];
if (params.get('sort_by')) {
  currentSort = decodeURIComponent(params.get('sort_by'));
  currentSortKey = findSortKeyByHaravan(currentSort);
}
if (params.get('page')) currentPage = parseInt(params.get('page')) || 1;
Object.keys(selectedFilters).forEach(group => {
  selectedFilters[group].forEach(val => {
    $(`.filter-checkbox[data-group="${group}"][value="${val}"]`).prop('checked', true);
  });
});
}
$(document).on('change', '.filter-checkbox', function () {
let group = $(this).data('group');
let val = $(this).val();
if (group === 'price') {
  selectedFilters.price = this.checked ? [val] : [];
  $('.filter-checkbox[data-group="price"]').not(this).prop('checked', false);
} else {
  if (this.checked) {
    selectedFilters[group].push(val);
  } else {
    selectedFilters[group] = selectedFilters[group].filter(v => v !== val);
  }
}
currentPage = 1;
applyFilter();
});
$(document).on('click', '.remove-filter', function () {
let group = $(this).data('group');
let val = $(this).data('value');
selectedFilters[group] = selectedFilters[group].filter(v => v !== val);
$(`.filter-checkbox[data-group="${group}"][value="${val}"]`).prop('checked', false);
currentPage = 1;
applyFilter();
});
$(document).on('click', '.pagination a', function (e) {
e.preventDefault();
let page = $(this).data('page');
if (page) {
  currentPage = page;
  applyFilter();
}
});
function changeSort(sortKey) {
currentSortKey = sortKey;
currentSort = SORT_MAP[sortKey] || 'manual';
currentPage = 1;
applyFilter();
}
function clearAllFiltered() {
$('.filter-checkbox').prop('checked', false);
selectedFilters = { vendor: [], type: [], price: [], tag: [] };
currentPage = 1;
applyFilter();
}

// -------------------- Init --------------------
$(document).ready(function () {
if (typeof window.collectionId === 'undefined') window.collectionId = {{ collection.id }};
if (typeof window.collectionHandle === 'undefined') window.collectionHandle = "{{ collection.handle }}";

parseFiltersFromUrl();
let hasFilterInUrl = (
  selectedFilters.vendor.length > 0 ||
  selectedFilters.type.length > 0 ||
  selectedFilters.tag.length > 0 ||
  selectedFilters.price.length > 0 ||
  currentSort !== 'manual' ||
  currentPage > 1
);
if (hasFilterInUrl) {
  applyFilter(false);
}

// highlight sort nút khi load
if (currentSortKey) {
  $('.sort-cate-left .btn-quick-sort.' + currentSortKey).addClass('active');
}

// toggle filter aside
	});
  $(document).ready(function(){
	$(".aside-title").click(function (e) {
		e.stopPropagation(); // Ngăn sự kiện lan ra ngoài
		const $clickedTitle = $(this);
		const $parentItem = $clickedTitle.closest(".aside-item");
		if ($parentItem.hasClass("open")) {
			$parentItem.removeClass("open");
			$clickedTitle.removeClass("active");
		} else {
			$(".aside-item").removeClass("open");
			$(".aside-title").removeClass("active");
			$parentItem.addClass("open");
			$clickedTitle.addClass("active");
		}
	});
	// Ngăn không đóng khi click vào aside-content
	$(".aside-content").click(function (e) {
		e.stopPropagation();
	});
	// Click ra ngoài => đóng tất cả
	$(document).click(function () {
		$(".aside-item").removeClass("open");
		$(".aside-title").removeClass("active");
	});
	$('#show-admin-bar').click(function(e){
		$('.aside.aside-mini-products-list.filter').toggleClass('active');
	});
});
</script>