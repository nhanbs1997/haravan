<section class="wolf-lookbook-page">
	{%- include 'shortcode' load: collection.description -%}
	<div class="container">
		<div class="my-4 text-center">
			<h1 class="title-head h4">{%- if collection.title == 'All' -%}Tất cả sản phẩm{%- else -%}{{ collection.title }}{%- endif -%}</h1>
		</div>
		<div class="category-products products category-products-grids clearfix mb-4">
			{%- paginate collection.products by settings.lookbook_number_product -%}
			{%- if collection.products.size > 0 -%}
			<div class="products-view products-view-grid row g-2 mb-3">
				{%- for product in collection.products -%}
				<div class="col-xxl-3 col-xl-3 col-lg-3 col-md-3 col-sm-4 col-6">
					{%- include 'wolf-product-grid' -%}
				</div>	
				{%- endfor -%}
			</div>
			{%- if paginate.pages > 1 -%}
			<div class="paginate-pages d-flex justify-content-center">
				{%- include 'paginate-pages' -%}
			</div>
			{%- endif -%}
			{%- else -%}
			<div class="alert alert-danger" role="alert">Sản phẩm đang được cập nhật.</div>
			{%- endif -%}
			{%- endpaginate -%}
		</div>
	</div>
</section>