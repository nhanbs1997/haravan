{%- include 'breadcrumb' -%}
<div class="wolf-page-content mb-4 mt-4">
	<div class="container">
		<div class="row">
			<div class="col-xxl-12 col-xl-12 col-lg-12 col-md-12 col-12">
				<h1 class="title-head h4 mb-5 text-center {% if page_title == "Giới thiệu" %}d-none{% endif %}">{{ page_title }}</h1>
				<div class="wolf-content-page">
					{%- if page.content != '' -%}
					{%- include 'shortcode' load: page.content -%}
					{%- else -%}
					<div class="alert alert-warning" role="alert">Nội dung đang cập nhật.</div>
					{%- endif -%}
				</div>
			</div>
		</div>
	</div>
</div>