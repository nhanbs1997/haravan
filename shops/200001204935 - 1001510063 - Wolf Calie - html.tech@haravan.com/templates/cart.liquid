{%- include 'breadcrumb' -%}
<div class="container my-5">
	<h1 class="title-head h4 mb-3">Giỏ hàng của bạn</h1>
	<form action="/cart" method="post" id="cart-form" class="cart-form-wrapper" style="display:none;">
		<div class="row g-2">
			<div class="col-lg-8 mt-lg-0">
				<div class="cart-items-wrapper">
					
				</div>
				<div class="mt-4">
					<div class="form-floating">
						<textarea class="form-control" id="cart-note" name="note">{{ cart.note }}</textarea>
						<label for="cart-note">Ghi chú đơn hàng:</label>
					</div>
				</div>
			</div>
			<div class="col-lg-4 mt-4 mt-lg-0">
				<div class="card">
					<div class="card-body">
						<h5 class="card-title mb-3">Tóm tắt đơn hàng</h5>
						<ul class="list-group list-group-flush">
							<li class="list-group-item d-flex justify-content-between align-items-center">
								Tổng tiền sản phẩm:
								<span id="cart-total-price-desktop" class="fw-bold">{{ cart.total_price | money }}</span>
							</li>
							<li class="list-group-item" id="shipping-progress-bar">
								<div class="d-flex justify-content-between align-items-center mb-2">
									<small id="countdown-amount" class="text-muted"></small>
								</div>
								<div class="progress" style="height: 5px;">
									<div class="progress-bar bg-success" role="progressbar" id="shipping-progress" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
								</div>
							</li>
						</ul>
						<div class="d-grid mt-3">
							<a href="/checkout" class="btn wolf-btn-checkout-cart btn-lg" title="Thanh toán đơn hàng">Thanh toán đơn hàng</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</form>
	<div class="text-center empty-cart-message-container" role="alert" style="display:none;">
		<svg width="150" height="150" class="mb-3"><use xlink:href="#icon-cart-empty"></use></svg>
		<p class="lead">Giỏ hàng của bạn đang trống.</p>
		<p>Hãy khám phá các sản phẩm của chúng tôi và thêm vào giỏ hàng nhé!</p>
		<a href="/collections/all" class="btn btn-empty-cart mt-3">Tiếp tục mua sắm</a>
	</div>
</div>