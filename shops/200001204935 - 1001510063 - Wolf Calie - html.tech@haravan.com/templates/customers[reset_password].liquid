{%- include 'breadcrumb' -%}
<section class="wolf-customer-account mt-5 mb-5">
	<div class="container">
		<div class="row">
			<div class="col-md-6 offset-md-3">
				<h1 class="title-head h4 mb-2 text-center">Lấy lại mật khẩu</h1>
				<p class="note">Nhập mật khẩu mới</p>      
				{%- form 'reset_customer_password' -%}
				{%- if form.errors.size > 0 -%}
				<div>
					<button type="button" class="close" data-dismiss="alert">×</button>
					{{ form.errors | default_errors }}
				</div>
				{%- else -%}
				<div class="form-signup success hidden" style="color: green;">
					Đổi mật khẩu thành công
				</div>
				{%- endif -%}
				<div id="customer_password" class="form-group clearfix mb-3">
					<label class="form-label">Mật khẩu <span class="required">*</span></label>
					<input type="password" value="" name="customer[password]" id="customer_password" class="form-control" />
				</div>
				<div id="password_confirm" class="form-group clearfix mb-3">
					<label class="form-label">Xác nhận mật khẩu <span class="required">*</span></label>
					<input type="password" value="" name="customer[password_confirmation]" id="customer_password_confirmation" class="form-control" />
				</div>
				<div class="others-bottom">
					<button class="btn btn-style wolf-btn-main rounded-3" type="submit">Đặt lại mật khẩu</button>
					<a class="btn btn-style wolf-btn-main rounded-3 mt-2" onclick="window.location.href='/'" title="Hủy">Hủy</a>
				</div>
				{%- endform -%}
			</div>
		</div>
	</div>
</section>