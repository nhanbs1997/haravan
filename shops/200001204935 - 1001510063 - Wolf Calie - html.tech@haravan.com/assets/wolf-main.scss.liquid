/*End Menu*/
/*Footer*/
.wolf-footer{
	background-color: var(--footer-bg-color);
	color: var(--footer-text-color);
	.wolf-footer-top{
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		.footer-phone-email{
			.footer-phone{
				flex: 0 0 auto;
				width: 170px;
				@media(max-width: 569px){
					width: 100%;
				}
			}
			svg{
				flex: 0 0 auto;
			}
			.reason{
				color: var(--footer-text-color);
				.reason-content{
					font-weight: 500;
					font-size: 18px;
				}
				@media(min-width: 992px){
					&:hover{
						.reason-content{
							color: var(--main-color);
						}
					}
				}
			}
		}
	}
	ul{
		list-style: none;
		padding-left: 0;
	}
	.footer-social{
		grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
		a{
			border: 1px solid rgba(255, 255, 255, 0.2);
			padding: 5px;
			img{
				background-color: #fff;
			}
			@media(min-width: 992px){
				&:hover{
					border-color: var(--main-color);
				}
			}
		}
	}
	.wolf-footer-menu{
		a{
			color: var(--footer-text-color);
			@media(min-width: 992px){
				&:hover{
					color: var(--main-color);
				}
			}
		}
		&.wolf-footer-payment{
			.grid-4 {
				grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
			}
		}
	}
	.zalo-app {
		color: var(--footer-text-color);
		img {
			max-width: 80px;
			height: auto;
		}
		@media(min-width: 992px){
			&:hover{
				color: var(--main-color);
			}
		}
	}
	.copyright{
		a{
			color: var(--footer-text-color);
			@media(min-width: 992px){
				&:hover{
					color: var(--main-color);
				}
			}
		}
	}
	@media(max-width: 991px){
		.copyright-bct{
			text-align: center;
		}
	}
}
/*End Footer*/
/*Breadcrumb*/
.wolf-breadcrumb{
	border-top: 1px solid var(--border-color);
	border-bottom: 1px solid var(--border-color);
	.breadcrumb{
		font-size: 15px;
		a{
			color: var(--second-color);
			@media(min-width: 992px){
				&:hover, &:focus{
					color: var(--main-color);
				}
			}
		}
	}
}
/*End Breadcrumb*/
/*Product Card*/
.wolf-product-item-card{
	background-color: #fff;
	.wolf-product-box-image{
		overflow: hidden;
		width: 100%;
		aspect-ratio: 450/600;
		img{
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
		}
		img{
			&.wolf-img-main-products{
				top: 0;
				bottom: 0;
				left: 0;
				right: 0;
				margin: auto;
				position: absolute;
				object-fit: contain;
				width: auto;
				max-height: 100%;
			}
		}
	}
	.wolf-product-img-sale{
		position: absolute;
		bottom: 0;
		width: 100%;
		z-index: 1;
	}
	.button-set{
		z-index: 2;
		top: 10px;
		right: 10px;
		transform: translateX(60px);
		transition: 0.4s;
		.cart-button{
			width: 40px;
			height: 40px;
			transition-duration: 0.3s;
			box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 5px;
			background: #fff;
			color: var(--main-text-color);
			&:hover, &:focus, &.active{
				background-color: var(--main-color);
				color: #fff;
			}
		}
	}
	.wolf-product-action{
		width: 100%;
		bottom: 20px;
		opacity: 0;
		visibility: hidden;
		transform: translateY(100px);
		z-index: 2;
		transition: 0.4s;
		padding: 0px 18px;
		.cart-button{
			transition-duration: 0.3s;
			box-shadow: rgba(0, 0, 0, 0.1) 0px 0px 5px;
			background: #fff;
			color: var(--main-text-color);
			width: 100%;
			&:hover, &:focus{
				background-color: var(--main-color);
				color: #fff;
			}
		}
	}
	.label-sale{
		background-color: var(--color_tag_sale);
		color: #fff;
		z-index: 1;
		font-size: 14px;
		width: 40px;
		top: 10px;
		right: 10px;
		font-weight: 500;
	}
	.wolf-product-box-info{
		.wolf-product-title{
			line-height: 1.3;
			font-size: 15px;
			text-align: left;
			@media(max-width: 767px){
				font-size: 14px;
			}
			a{
				color: var(--main-text-color);
			}
			@media(min-width: 992px){
				&:hover, &:focus{
					a{
						color: var(--second-color);
					}
				}
			}
		}
		.wolf-product-box-price{
			span{
				color: var(--main-color);
				font-weight: 600;
				font-size: 17px;
				@media(max-width: 767px){
					font-size: 15px;
				}
			}
			del{
				color: #666666;
				@media(max-width: 767px){
					font-size: 13px;
				}
			}
		}
		.wolf-product-color-swatches{
			.swatch-mixed{
				width: 16px;
				height: 16px;
				&:before{
					content: "";
					position: absolute;
					left: -3px;
					right: -3px;
					bottom: -3px;
					top: -3px;
					transition: box-shadow .3s ease;
					box-shadow: 0 0 0 1px #ddd, inset 0 0 0 -3px #fff;
					border-radius: 50%;
				}
				.image-dot{
					width: 100%;
					height: 100%;
					background-size: cover;
					background-repeat: no-repeat;
				}
				&.active, &:hover{
					&:before{
						box-shadow: 0 0 0 1px var(--main-color), inset 0 0 0 -3px #fff;
					}
				}
				.color-dot{
					width: 100%;
					height: 100%;
					{%- assign lines = settings.color_swatch | split: ';' -%}
					{%- for line in lines -%}
					{%- assign parts = line | split: '|' -%}
					{%- assign name = parts[0] | strip -%}
					{%- assign value = parts[1] | strip -%}
					{%- assign handle = name | downcase | handle | replace: '-', '' -%}
					{%- if value contains 'https://' or value contains 'http://' -%}
					&.color-{{ handle }}{
						background-image: url('{{ value }}');
							background-size: cover;
							background-position: center;
							}
					{%- else -%}
					&.color-{{ handle }}{
						background-color: {{ value }}; 
					}
					{%- endif -%}
					{%- endfor -%}
				}
			}
			.swatch-more{
				width: 16px;
				height: 16px;
				background-color: #f3f3f3;
				border: 1px dashed #dee2e6;
				font-size: 12px;
				font-weight: 500;
				color: var(--main-text-color);
				display: flex;
				align-items: center;
				justify-content: center;
				user-select: none;
				cursor: default;
				transition: background-color 0.3s, border-color 0.3s;
				&:before{
					content: "";
					position: absolute;
					left: -3px;
					right: -3px;
					bottom: -3px;
					top: -3px;
					transition: box-shadow .3s ease;
					box-shadow: 0 0 0 1px #ddd, inset 0 0 0 -3px #fff;
					border-radius: 50%;
				}
			}
		}
	}
	.line-clamp-2 {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: 39px;
	}
	@media(min-width: 992px){
		&:hover{
			.button-set{
				transform: translateX(0px);
			}
			.wolf-product-action{
				transform: translateX(0px);
				opacity: 1;
				visibility: visible;
			}
		}
	}
}
/*End Product Card*/
/*Paginate*/
.paginate-pages{
	.pagination{
		margin-bottom: 0;
		margin-top: 10px;
		.page-item{
			.page-link{
				background-color: #fff;
				color: var(--main-text-color);
				font-size: 16px;
				border: 1px solid transparent;
				padding: 5px 10px;
				text-align: center;
				font-weight: 500;
				min-width: 50px;
				@media(min-width: 992px){
					&:hover, &:focus{
						background-color: rgba(19, 19, 19, 0.06);
						border-color: --border-color;
						color: var(--main-text-color);
						box-shadow: none;
						outline: none;
					}
				}
			}
			&.disabled{
				.page-link{
					background-color: #e9ecef;
					color: #212529;
				}
			}
			&.active{
				.page-link{
					background-color: rgba(19, 19, 19, 0.06);
					border-color: --border-color;
					color: var(--main-text-color);
					box-shadow: none;
					outline: none;
				}
			}
		}
	}
}
/*End Paginate*/
/*Banner Popup*/
#promoBannerPopup{
	top: 0 !important;
	background-color: transparent;
	.modal-content{
		background-color: transparent;
		img{
			max-width: 350px;
		}
	}
	.btn-close{
		color: #fff;
