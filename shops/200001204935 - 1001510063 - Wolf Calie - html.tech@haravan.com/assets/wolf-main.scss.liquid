	box-shadow:
		0px 4px 12px rgba(0,0,0,.2),
		0px 1px 3px rgba(0,0,0,.1);
	opacity: 0;
	transform: scale(0.95) translateY(-5px);
	pointer-events: none;
	transform-origin: top right;
	transition: opacity 0.2s ease, transform 0.2s ease;
	z-index: 1001;
	max-height: 100%;
	overflow-y: scroll;
	@media(max-width: 767px){
		padding: 15px;
	}
	&.show {
		opacity: 1;
		pointer-events: auto;
