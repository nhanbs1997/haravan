	.color-comparison{
		width: 25px;
		height: 25px;
		border-radius: 50%;
		font-size: 0;
		background-color: #fff;
		border: 1px solid #dee2e6;
		{%- assign lines = settings.color_swatch | split: ';' -%}
		{%- for line in lines -%}
		{%- assign parts = line | split: '|' -%}
		{%- assign name = parts[0] | strip -%}
		{%- assign value = parts[1] | strip -%}
		{%- assign handle = name | downcase | handle | replace: ' ', '-' -%}
		{%- if value contains 'https://' or value contains 'http://' -%}
		&.color-{{ handle }}{
			background-image: url('{{ value }}');
				background-size: cover;
				background-position: center;
				}
		{%- else -%}
		&.color-{{ handle }}{
			background-color: {{ value }};
		}
		{%- endif -%}
		{%- endfor -%}
	}
	.size-comparison{
		height: 25px;
		width: auto;
		border-radius: 5px;
		border: 1px solid #dee2e6;
		text-align: center;
		padding: 2px 10px;
		line-height: 23px;
	}
}
