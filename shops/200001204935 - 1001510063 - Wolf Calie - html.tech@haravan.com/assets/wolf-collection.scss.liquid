$collections-sales-title-bg: {{ settings.collections-sales-title-bg-color }};
.line-clamp-2-cate {
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
	min-height: 42px;
	line-height: 1.3;
	white-space: normal;
}
.wolf-collections-sales{
	background: rgba(255, 255, 255, 0.95);
	backdrop-filter: blur(10px);
	border: 2px solid var(--collections-sales-bg-color);
	.wolf-products-block-product-title{
		left: 0;
		right: 0;
		z-index: 1;
		font-size: 18px;
		top: -20px;
		a{
			background-color: var(--collections-sales-title-bg-color);
			color: var(--collections-sales-bg-color);
			padding: 10px 15px;
			border: 1px solid var(--collections-sales-bg-color);
			&:before{
				content: "";
				border: 0 solid #f4f6f9;
				border-top-color: transparent;
				border-right-color: var(--collections-sales-bg-color);
				border-top-width: 20px;
				border-right-width: 9px;
				position: absolute;
				left: -8px;
				top: -1px;
			}
			&:after{
				content: "";
				border: 0 solid #f4f6f9;
				border-top-color: transparent;
				border-left-color: var(--collections-sales-bg-color);
				border-top-width: 20px;
				border-left-width: 9px;
				position: absolute;
				right: -8px;
				top: -1px;
			}
			@media(min-width: 992px){
				&:hover, &:focus{
					color: var(--second-color);
				}
			}
		}
	}
	.block-product-sale{
		.wolf-product-item-card{
			margin-top: 0 !important;
		}
		.wolf-sale-swiper{
			background-color: #fff;
			.swiper-pagination{
				position: relative;
				top: 0;
				margin-top: 10px;
			}
		}
	}
}
.wolf-scroll{
	overflow-x: auto;
	overflow-y: hidden;
	white-space: nowrap;
	-webkit-overflow-scrolling: touch; /* mượt trên iOS */
	scrollbar-width: thin; /* Firefox */
	&::-webkit-scrollbar {
		height: 6px;
	}
	&::-webkit-scrollbar-thumb {
		background-color: #ccc;
		border-radius: 3px;
	}
}
.wolf-subcategories{
	background-color: #f2f2f2;
	padding: 10px;
	.cate-item{
		overflow: hidden;
		width: 100%;
		aspect-ratio: 1/1;
		border: 1px solid transparent;
		img{
			max-width: 100%;
			max-height: 100%;
			object-fit: contain;
		}
		.cate-info-title{
			color: #fff;
			text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.6);
			font-weight: 500;
			display: -webkit-box;
			-webkit-line-clamp: 1;
			-webkit-box-orient: vertical;
			overflow: hidden;
			bottom: 15px;
			left: 15px;
		}
		@media(min-width: 992px){
			&:hover{
				border-color: var(--main-color);
				.cate-info-title{
					color: var(--main-color);
				}
			}
		}
	}
}
.wolf-filter-cate{
	.filter-containers{
		@media(max-width: 767px){
			margin-bottom: 15px;
			position: fixed;
			top: 0 !important;
			width: 100%;
			left: 0;
			right: 0;
			z-index: 99;
		}
		.aside-title{
			border: 1px solid #f4f1f1;
			background-color: #f4f1f1;
			padding: 6px 8px;
			color: #171212;
			font-weight: 400;
			font-size: 15px;
			@media(min-width: 992px){
				&:hover{
					border-color: var(--main-color);
					cursor: pointer;
					color: var(--main-color);
					.wolf-clear-filter{
						color: var(--main-color);
					}
				}
			}
			.wolf-clear-filter{
				color: #171212;
			}
			.count-filter-val{
				right: -10px;
				@media(max-width: 767px){
					right: auto;
					left: 20px;
					top: 20px !important;
				}
			}
			@media(max-width: 767px){
				font-weight: 600;
				background-color: var(--second-color); 
				color: #fff;
				font-size: 18px;
				text-transform: uppercase;
				border-radius: 0 !important;
			}
		}
	}
	.aside-item{
		@media(max-width: 767px){
			position: relative !important;
			margin-bottom: 15px;
		}
		.aside-title{
			border: 1px solid #f4f1f1;
			background-color: #f4f1f1;
			padding: 6px 8px;
			color: #171212;
			position: relative;
			font-weight: 400;
			font-size: 15px;
			min-height: 38px;
			@media(min-width: 992px){
				&:hover, &.active{
					border-color: var(--main-color);
					cursor: pointer;
					color: var(--main-color);
				}
			}
			@media(max-width: 767px){
				margin-bottom: 10px;
			}
			svg{
				transition: transform 0.25s ease;
				@media(max-width: 767px){
					margin-left: auto;
					display: none;
				}
			}
		}
		.aside-content{
			background-color: #f4f1f1;
			z-index: 99;
			top: 100%;
			display: none;
			@media(max-width: 767px){
				display: block;
				box-shadow: none !important;
				position: relative !important;
				z-index: 1;
			}
			.form-check-input{
				background-color: transparent;
				&:checked{
					border-color: var(--main-color);
					background-color: var(--main-color);
				}
			}
			&::before {
				border-width: 9px;
				border-style: solid;
				border-color: transparent transparent #f4f1f1;
				border-image: initial;
				margin-left: -9px;
				bottom: 100%;
				left: 15px;
				content: " ";
				height: 0px;
				width: 0px;
				position: absolute;
				pointer-events: none;
				@media(max-width: 767px){
					display: none;
				}
			}
			ul{
				list-style: none;
				padding-left: 0;
				margin-bottom: 0;
				min-width: 250px;
				max-height: 270px;
				overflow-y: auto;
				&::-webkit-scrollbar-track {
					border-radius: 0px;
					background-color: #f5f5f5;
				}
				&::-webkit-scrollbar {
					width: 6px
				}
				&::-webkit-scrollbar-thumb {
					border-radius: 0px;
					background-color: #e5e5e5;
				}
			}
			&.filter-group{
				ul{
					li{
						padding: 6px 10px;
						@media(min-width: 992px){
							&:hover{
								background-color: rgba(#f2f2f2, 0.4);
								color: var(--main-color);
							}
						}
						&+li{
							border-top: 1px solid var(--border-color);
						}
					}
				}
			}
		}
		&.sort-cate-left{
			.aside-content{
				ul{
					li{
						padding: 6px 10px;
						a{
							display: block;
							color: var(--main-text-color);
						}
						&+li{
							border-top: 1px solid #e4e9f2;
						}
						@media(min-width: 992px){
							&:hover{
								background-color: rgba(#f2f2f2, 0.4);
								a{
									color: var(--main-color);
								}
							}
						}
					}
				}
			}
		}
		&.open{
			.aside-title{
				svg{
					transform: rotate(180deg);
				}
			}
			.aside-content{
				display: block;
			}
		}
	}
}
.wolf-filter-scroll{
	@media(min-width: 992px){
		&.is-sticky{
			position: sticky !important;
			top: 0 !important;
			left: 0;
			right: 0;
			z-index: 999;
			background-color: rgba(255, 255, 255, 0.95);
			backdrop-filter: blur(10px);
			animation: fadeSlideDown 0.3s ease;
		}
	}
	.wolf-filter-fix{
		overflow-x: hidden;
		overflow-y: hidden;
		display: block;
	}
	.sort-cate{
		overflow: visible;
	}
}
.wolf-collections-description{
	border: 1px solid var(--border-color);
	.wolf-collections-article-content{
		&.wolf-collections-article-content-more{
			height: 140px;
			overflow: hidden;
			-webkit-transition: height 0.2s;
			-moz-transition: height 0.2s;
			transition: height 0.2s;
		}
	}
	p:last-child{
		margin-bottom: 0;
	}
	.btn--view-more{
		text-align: center;
		color: var(--main-text-color);
		border: 1px solid #f4f1f1;
		background-color: #f4f1f1;
		max-width: 150px;
		margin-left: auto;
		margin-right: auto;
		&:hover{
			border-color: var(--main-color);
			cursor: pointer;
			color: var(--main-color);
		}
		.less-text{
			display: none;
		}
	}
	&.full-content{
		.wolf-collections-article-content{
			height: auto;
		}
		.btn--view-more{
			.less-text{
				display: block;
			}
			.more-text{
				display: none;
			}
		}
	}
}
@media(max-width: 767px){
	.wolf-filter-mobile{
		font-weight: 600;
		background-color: var(--second-color);
		border-color: var(--second-color);
		color: #fff;
	}
	.wolf-clear-filter{
		color: #fff;
		margin-left: 20px;
	}
	.wolf-filter-scroll{
		max-height: 100vh;
		width: 100%;
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(10px);
		z-index: 99;
		top: 0 !important;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 45px 15px 15px 15px;
		overflow-y: scroll;
		transform: translateY(100%);
		transition: transform 0.3s ease-in-out;
		display: block;
		position: fixed !important;
		&.active{
			transform: translateY(0);
		}
	}
	.wolf-filter-mobile-close{
		position: sticky;
		bottom: 0;
		top: auto !important;
		width: 100%;
		left: 0;
		right: 0;
		font-size: 17px;
		z-index: 99;
	}
}
@keyframes fadeSlideDown {
	from {
		opacity: 0;
		transform: translateY(-10px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}