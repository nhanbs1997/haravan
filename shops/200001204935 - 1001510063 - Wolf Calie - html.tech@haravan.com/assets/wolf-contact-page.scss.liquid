.contact-info{
	a{
		color: var(--second-color);
		&:hover, &:focus{
			color: var(--main-color);
		}
	}
}
#comment{
	height: 150px;
}
.wolf-btn-main{
	width: 100%;
	height: 50px;
	color: var(--second-color);
	border: none;
	font-size: 16px;
	line-height: 46px;
	background-color: rgba({{ settings.sup-color }}, 0.2);
	padding: 0;
	text-align: center;
	text-transform: uppercase;
	font-weight: 600;
	&:hover, &:focus{
		color: #fff;
		background-color: var(--second-color);
	}
}
.wolf-contact-map{
	iframe{
		width: 100%;
		height: 515px;
	}
}