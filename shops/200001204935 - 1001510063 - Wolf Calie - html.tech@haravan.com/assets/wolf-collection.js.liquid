document.addEventListener("DOMContentLoaded", function () {
	const openBtn = document.querySelector(".wolf-filter-mobile");
	const closeBtn = document.querySelector(".wolf-filter-mobile-close");
	const filterPanel = document.querySelector(".wolf-filter-scroll");
	if (openBtn && closeBtn && filterPanel) {
		openBtn.addEventListener("click", () => {
			filterPanel.classList.add("active");
			document.body.style.overflow = "hidden"; // ngăn cuộn nền
		});
		closeBtn.addEventListener("click", () => {
			filterPanel.classList.remove("active");
			document.body.style.overflow = ""; // bật lại cuộn
		});
	}
	/*Fix Fillter */
	const target = document.querySelector(".wolf-filter-scroll");
	if (!target) return;
	const offsetTop = target.offsetTop;
	const stickyClass = "is-sticky";
	window.addEventListener("scroll", function () {
		if (window.scrollY >= offsetTop) {
			target.classList.add(stickyClass);
		} else {
			target.classList.remove(stickyClass);
		}
	});
});