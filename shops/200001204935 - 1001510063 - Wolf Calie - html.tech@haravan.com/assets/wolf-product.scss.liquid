/* Container trong Modal */
#size-chart-content-wrapper {
	padding: 0; /* Loại bỏ padding nếu modal-body đã có */
}

/* Tiêu đề trong Modal */
#size-chart-content-wrapper h3 {
	font-size: 1.5rem;
	margin-bottom: 15px;
	color: #333;
	text-align: center; /* Căn giữa tiêu đề */
}

/* Dropdown chọn loại sản phẩm */
#product-type-select {
	margin-bottom: 20px;
	border-radius: 5px;
	padding: 8px 12px;
}

/* Bảng */
#size-chart-table {
	width: 100%;
	margin-bottom: 20px;
	border-collapse: collapse;
}

#size-chart-table th,
#size-chart-table td {
	padding: 12px 15px;
	text-align: center;
	border: 1px solid #ddd;
	vertical-align: middle;
}

#size-chart-table thead th {
	background-color: #f8f8f8;
	font-weight: bold;
	color: #555;
	text-transform: uppercase;
	font-size: 0.95rem;
}

#size-chart-table tbody tr:nth-child(even) {
	background-color: #f9f9f9;
}

#size-chart-table tbody tr:hover {
	background-color: #f2f2f2;
}

/* Form tính size */
#size-calculator-form {
	padding: 15px; /* Thêm padding cho form */
	border: 1px solid #e0e0e0;
	border-radius: 8px;
	background-color: #fcfcfc;
}

#size-calculator-form label {
	font-weight: 500;
	margin-bottom: 5px;
	color: #444;
}

#size-calculator-form .form-control {
	border-radius: 5px;
	border: 1px solid #ccc;
	padding: 10px;
}

#size-calculator-form .btn {
	padding: 10px 20px;
	border-radius: 5px;
	font-size: 1rem;
	cursor: pointer;
}

#size-calculator-form .btn-primary {
	background-color: #007bff;
	border-color: #007bff;
	color: #fff;
}

#size-calculator-form .btn-primary:hover {
	background-color: #0056b3;
	border-color: #0056b3;
}

#size-calculator-form .btn-outline-secondary {
	border-color: #6c757d;
	color: #6c757d;
	margin-left: 10px;
}

#size-calculator-form .btn-outline-secondary:hover {
	background-color: #e2e6ea;
}

/* Kết quả */
#result-container {
	padding: 15px;
	border-radius: 8px;
	background-color: #e9f5ff;
	border: 1px solid #b3d9ff;
	color: #0056b3;
}

#recommended-size {
	font-size: 1.2rem;
	color: #007bff;
	font-weight: bold;
}

#size-calculator-form{
	.btn-size{
		background-color: var(--second-color);
		border-color: var(--second-color);
		color: #fff;
	}
	#reset-size-calculator{

	}
}

/* Responsive cho bảng trên mobile */
@media (max-width: 767.98px) {
	#size-chart-table thead {
		display: none; /* Ẩn header trên mobile */
	}

	#size-chart-table,
	#size-chart-table tbody,
	#size-chart-table tr,
	#size-chart-table td {
		display: block; /* Chuyển thành block để xếp chồng */
		width: 100%; /* Chiếm toàn bộ chiều rộng */
	}

	#size-chart-table tr {
		margin-bottom: 15px;
		border: 1px solid #ddd;
		border-radius: 5px;
		overflow: hidden;
	}

	#size-chart-table td {
		text-align: right;
		padding-left: 50%;
		position: relative;
		border: none;
	}

	#size-chart-table td::before {
		content: attr(data-label);
		position: absolute;
		left: 15px;
		width: calc(50% - 30px);
		text-align: left;
		font-weight: bold;
		color: #555;
	}
	#sizeChartModal{
		.modal-dialog {
			margin: 0;
			max-width: 100vw;
		}
		.modal-content {
			height: 100vh;
			border-radius: 0;
		}
		.modal-body {
			overflow-y: auto;
		}
	}
}