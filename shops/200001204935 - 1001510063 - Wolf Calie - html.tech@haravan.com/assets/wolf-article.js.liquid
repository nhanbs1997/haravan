document.addEventListener("DOMContentLoaded", function () {
	const content = document.querySelector('.wolf-template-content');
	const imgs = content.querySelectorAll('img');
	const swiperContainer = document.querySelector('.article-image-swiper');
	const wrapper = document.querySelector('#extracted-images');
	if (imgs.length === 0) {
		if (swiperContainer) swiperContainer.style.display = 'none';
		return;
	} else {
		swiperContainer.style.display = 'block';
	}
	wrapper.innerHTML = '';
	imgs.forEach(img => {
		const slide = document.createElement('div');
		slide.className = 'swiper-slide';
		const clone = img.cloneNode();
		clone.loading = "lazy";
		slide.appendChild(clone);
		wrapper.appendChild(slide);
	});
	if (imgs.length > 0) {
		new Swiper('.article-image-swiper', {
			slidesPerView: 3,
			loop: true,
			grabCursor: true,
			roundLengths: true,
			slideToClickedSlide: false,
			spaceBetween: 0,
			autoplay: {
				delay: 2000,
				disableOnInteraction: false
			},
			pagination: {
				el: ".article-image-swiper .swiper-pagination",
				type: "progressbar",
			},
			navigation: {
				nextEl: '.article-image-swiper .swiper-button-next',
				prevEl: '.article-image-swiper .swiper-button-prev',
			},
			breakpoints: {
				1: {
					slidesPerView: 2
				},
				768: {
					slidesPerView: 3
				},
				992: {
					slidesPerView: 4
				},
				1024: {
					slidesPerView: 4
				}
			}
		});
	}
});