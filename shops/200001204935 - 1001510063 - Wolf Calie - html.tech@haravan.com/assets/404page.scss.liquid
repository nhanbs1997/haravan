.wolf-btn-main{
	height: 50px;
	color: var(--second-color);
	border: none;
	font-size: 16px;
	line-height: 46px;
	background-color: rgba({{ settings.sup-color }}, 0.1);
	padding: 0 40px;
	text-align: center;
	text-transform: uppercase;
	font-weight: 600;
	&:hover, &:focus{
		color: #fff;
		background-color: var(--second-color);
	}
}