$btn-color: {{ settings.sup-color }};
/*Hệ thống cửa hàng*/
.wolf-page-store{
	.option-chos{
		@media(max-width: 991px){
			margin-bottom: 30px;
		}
		.form-select{
			font-size: 14px;
		}
		.info-store{
			overflow-y: scroll;
			-webkit-overflow-scrolling: touch;
			-ms-scroll-chaining: none;
			overscroll-behavior: none;
			max-height: 380px;
			/* width */
			&::-webkit-scrollbar {
				width: 10px;
			}

			/* Track */
			&::-webkit-scrollbar-track {
				background: #f5f5f5;
			}

			/* Handle */
			&::-webkit-scrollbar-thumb {
				background: #888;
			}

			/* Handle on hover */
			&::-webkit-scrollbar-thumb:hover {
				background: #555;
			}
			.store-list{
				&+.store-list{
					border-top: 1px solid #dee2e6;
				}
				padding: 10px 5px;
				&:hover{
					background-color: rgba($btn-color, 0.05);
					cursor: pointer;
				}
				p{
					margin-bottom: 10px;
				}
				.store-title{
					font-weight: 600;
				}
				.store-info{
					display: flex;
					align-items: center;
					width: 100%;
					svg{
						height: 20px;
						width: 20px;
						path{
							fill: var(--main-text-color);
						}
						margin-right: 5px;
					}
					a{
						&:hover, &:focus{
							color: var(--second-color);
						}
					}
					&:last-child{
						margin-bottom: 0;
					}
				}
			}
		}
	}
	.wolf-store-maps{
		iframe{
			width: 100%;
			height: 530px;
			@media(max-width: 991px){
				height: 300px;
			}
		}
	}
}
/*End Hệ thống cửa hàng*/
/*Shortcode Giới thiệu*/
.wolf-scroll-mb{
	@media(max-width: 767px){
		display: flex;
		flex-wrap: nowrap;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}
}
/*END Shortcode Giới thiệu*/