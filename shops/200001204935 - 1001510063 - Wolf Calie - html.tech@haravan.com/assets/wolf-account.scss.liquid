a{
	color: var(--second-color);
	&:hover, &:focus{
		color: var(--main-color);
	}
}
.price-color{
	color: var(--main-color) !important;
	font-weight: 600;
}
.required{
	color: red;
}
.wolf-btn-main{
	width: 100%;
	height: 50px;
	color: var(--second-color);
	border: none;
	font-size: 16px;
	line-height: 46px;
	background-color: rgba({{ settings.sup-color }}, 0.1);
	padding: 0;
	text-align: center;
	text-transform: uppercase;
	font-weight: 600;
	&:hover, &:focus{
		color: #fff;
		background-color: var(--second-color);
	}
}
.wolf-account-content{
	.wolf-account-title{
		font-size: 20px;
		color: var(--main-text-color);
	}
}
.social-login{
	a{
		&:hover{
			opacity: 0.7;
		}
	}
}
.max-widths{
	@media(min-width: 768px){
		max-width: 250px;
	}
}
#my-orders-table{
	thead{
		th{
			font-weight: 600;
		}
		@media(max-width: 767px){
			display: none;
		}
	}
	@media(max-width: 767px){
		display: flex;
		tbody{
			display: flex;
			flex-direction: column;
			flex: 0 0 auto;
			width: 100%;
		}
		tr{
			display: flex;
			flex-direction: column;
			flex: 0 0 auto;
			width: 100%;
			td{
				display: inline-block;
				padding-left: 0;
				padding-right: 0;
				border: none;
				&:before{
					font-weight: 500;
					padding-right: 3px;
				}
				&:nth-of-type(1):before{
					content: "Đơn hàng:";
				}
				&:nth-of-type(2):before{
					content: "Ngày đặt hàng:";
				}
				&:nth-of-type(3):before{
					content: "Địa chỉ:";
				}
				&:nth-of-type(4):before{
					content: "Giá trị đơn hàng:";
				}
				&:nth-of-type(5):before{
					content: "TT Thanh toán:";
				}
			}
			&+tr{
				border-top: 1px solid #dee2e6;
				margin-top: 10px;
				padding-top: 10px;
			}
		}
	}
}
.wolf-order-details{
	.order-detail-status{
		span{
			font-weight: 500;
			color: var(--second-color);
		}
	}
}
#order_details{
	img{
		max-width: 100%;
	}
	thead{
		th{
			font-weight: 600;
		}
		@media(max-width: 767px){
			display: none;
		}
	}
	@media(max-width: 767px){
		display: flex;
		tbody{
			display: flex;
			flex-direction: column;
			flex: 0 0 auto;
			width: 100%;
		}
		tr{
			display: flex;
			flex-direction: column;
			flex: 0 0 auto;
			width: 100%;
			td{
				display: inline-block;
				padding-left: 0;
				padding-right: 0;
				border: none;
				&:before{
					font-weight: 500;
					content: attr(data-title);
				}
			}
			&+tr{
				border-top: 1px solid #dee2e6;
				margin-top: 10px;
				padding-top: 10px;
			}
		}
	}
	.content_right{
		.title-order{
			color: var(--main-text-color);
			font-weight: 500;
			&:hover, &:focus{
				color: var(--second-color);
			}
		}
	}
}
.table.totalorders{
	tr{
		td{
			border: none;
			padding-left: 0;
			padding-right: 0;
			&:first-child {
				text-align: left;
				font-weight: 600;
			}
			&:last-child {
				text-align: right;
				color: var(--second-color);
			}
		}
	}
}
.wolf-customer-account{
	.list-group{
		.list-group-item{
			background-color: transparent;
			a{
				color: var(--main-text-color);
				&:hover, &:focus{
					color: var(--second-color);
				}
			}
		}
	}
	.table>:not(caption)>*>*{
		background-color: transparent;
	}
}