.skeleton-container {
	background-color: #fff;
	min-height: 350px;
	position: relative;
}
.skeleton-image,
.skeleton-image-large,
.skeleton-text,
.skeleton-button,
.skeleton-product-card {
	background-color: #e0e0e0;
	border-radius: 4px;
	overflow: hidden;
	position: relative;
}
.skeleton-product-card {
	border: 1px solid #f0f0f0;
	padding: 10px;
	height: 300px;
	display: flex;
	flex-direction: column;
	gap: 10px;
}

.skeleton-image {
	width: 100%;
	height: 190px;
}

.skeleton-image-large {
	width: 100%;
	height: 300px;
}

.skeleton-text {
	height: 18px;
	margin-bottom: 8px;
}

.skeleton-title {
	width: 80%;
}

.skeleton-price {
	width: 50%;
}

.skeleton-button {
	width: 100px;
	height: 35px;
	margin-top: auto;
	align-self: center;
}
.skeleton-image::after,
.skeleton-image-large::after,
.skeleton-text::after,
.skeleton-button::after,
.skeleton-product-card::after {
	content: '';
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background: linear-gradient(90deg, #e0e0e0 8%, #f0f0f0 18%, #e0e0e0 33%);
	background-size: 200% 100%;
	animation: skeleton-shimmer 1.5s infinite;
}
@keyframes skeleton-shimmer {
	0% {
		background-position: -200% 0;
	}
	100% {
		background-position: 200% 0;
	}
}
.wolf-lookbook-masonry-module{
	.wolf-masonry-grid {
		opacity: 0;
		visibility: hidden;
		max-height: 0;
		overflow: hidden;
		transition: opacity 0.5s ease-in-out, max-height 0.8s ease-out, visibility 0s linear 0.5s; 
	}
	.wolf-masonry-grid.is-ready {
		opacity: 1;
		visibility: visible;
		height: auto;
		max-height: unset;
		transition: opacity 0.5s ease-in-out, max-height 0.8s ease-out;
	}
	.wolf-masonry-item{
		overflow: hidden;
		transition: transform 0.3s ease, box-shadow 0.3s ease; 
	}

	.wolf-masonry-item:hover {
		transform: translateY(-5px); 
		box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15); 
	}

	.wolf-masonry-item img {
		display: block; 
		width: 100%;
		height: auto;
		object-fit: cover;
		transition: transform 0.5s ease; 
	}

	.wolf-masonry-item:hover img {
		transform: scale(1.05); 
	}
}
