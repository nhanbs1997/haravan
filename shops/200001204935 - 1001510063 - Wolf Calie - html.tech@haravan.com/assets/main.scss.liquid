{%if settings.search_smart_enable%}
.list-search {
	.product-smart {
		display: flex;
		padding: 8px 5px;
		border-bottom: 1px solid #ededed;
		background: #fff;
		position: relative;
		width: 100%;
		&:first-child {
			margin-top: 5px;
		}
		&:last-child {
			border-bottom: none;
		}
		&:hover {
			background: #f5f5f5;
			border-radius: 5px;
		}
		.image_thumb {
			display: flex;
			justify-content: center;
			align-items: center;
			width: 60px;
			height: 60px;
			aspect-ratio: 1;
			border: 1px solid #f1f1f1;
			border-radius: 4px;
			position: relative;
			img {
				width: auto;
				max-height: 100%;
				position: absolute;
				top: 0;
				bottom: 0;
				left: 0;
				right: 0;
				margin: auto;
				object-fit: contain;
			}
		}
		.product-info {
			display: block;
			width: calc(100% - 60px);
			-o-width: calc(100% - 60px);
			-moz-width: calc(100% - 60px);
			-webkit-width: calc(100% - 60px);
			padding-left: 10px;
		}
		.product-info {
			margin: 5px 0 5px;
			position: relative;
			h3 {
				padding:0;
				font-size: 1.4rem;
				font-weight: 500;
				margin: 0 0 3px;
				padding-bottom: 3px;
				overflow: hidden;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 2;
				color: $text-color !important;
				&:hover{
					color:$sup-color;
				}
				a{
					color:$text-color;
					&:hover{
						color:$sup-color;
					}
				}
			}
			.price-box {
				color:$sup-color;
				line-height: 23px;
				display: block;
				font-size: 1.4rem;
				font-weight: 600;
				.price{
					padding-right:5px;
				}
				.compare-price {
					text-decoration: line-through;
					font-size: 1.3rem;
					color: #9e9e9e;
					line-height: 24px;
					font-weight: 300;
				}
			}
		}
	}
	.see-all-search {
		display: block;
		position: relative;
		text-align: center;
		line-height: initial;
		margin-top: 10px;
		&:hover {
			text-decoration: underline;
		}
	}
}
{% endif %}

{% if settings.compare_enable %}
.site-header__compare{
	position: fixed;
	right: 0;
	top: 50% !important;
	z-index: 2;
	background-color: #fff;
	padding: 10px 5px 10px 7px;	
	border-radius: 5px 0 0 5px;
	box-shadow: rgba(60,64,67,0.1) 0px 1px 2px 0px, rgba(60,64,67,0.15) 0px 2px 6px 2px;
	-webkit-transition: all ease .3s;
	-o-transition: all ease .3s;
	transition: all ease .3s;
	.js-compare-count{
		font-size: 12px;
		display: inline-block;
		color: #000;
	}
	svg{
		width: 20px;
		height: 20px;
	}
	@media(min-width: 1025px){
		&:hover, &:focus{
			background: $main-color;
			.js-compare-count{
				color: #fff;
			}
			svg{
				path{
					fill: #fff !important;
				}
			}
			&:before {
				content: attr(title);
				position: absolute;
				top: 50%;
				right: calc(100% + 10px);
				padding: 5px 7px;
				background: #666;
				color: #fff;
				border-radius: 5px;
				font-size: 1.3rem;
				white-space: nowrap;
				display: inline-block;
				line-height: initial;
				transform: translate(0 ,-50%);
			}
			&:after {
				display: block;
				position: absolute;
				border: 10px solid transparent;
				border-left-color: #666;
				content: "";
				top: 50%;
				right: calc(100% - 6px);
				transform: translate(0 ,-50%);
			}
		}
	}
}
{%endif%}
@keyframes alert-fade-in-up {
	0% {
		opacity: 0;
		transform: translateY(20px);
	}
	100% {
		opacity: 1;
		transform: translateY(0);
	}
}

@keyframes alert-fade-out {
	0% {
		opacity: 1;
	}
	100% {
		opacity: 0;
	}
}
#js-global-alert{
	position: fixed;
	top: 5%;
	right: 15px;
	width: 270px;
	transition: all ease .0.5s;
	z-index: 9999;
	padding: 10px;
	margin-bottom: 0;
	opacity: 0;
	animation-duration: 0.3s;
	animation-timing-function: ease-out;
	animation-fill-mode: forwards;
	display: none;
	.alert-heading{
		margin-bottom: 0;
		font-size: 1.6rem;
	}
	.alert-content{
		font-size:1.4rem;
		margin-bottom: 0;
		line-height: initial;
	}
	&.active{
		display: block;
		animation-name: alert-fade-in-up;
	}
	&.inactive {
		animation-name: alert-fade-out;
	}
	button.close {
		position: absolute;
		top: 0;
		right: 10px;
	}
}

{% if settings.popup_banner_enable %}
/*Modal banner*/
#modal-banner {
	bottom: 0;
	left: 0;
	overflow-x: auto;
	overflow-y: auto;
	position: fixed;
	right: 0;
	top: 0 !important;
	z-index: 9999;
	.modal-banner-promo {
		position: absolute;
		width:650px;

		top: 50%;
		left: 50%;
		height: auto;
		margin: 0 auto;
		padding: 5px;
		transform: translate(-50%, -50%);
		background-color: transparent;
		z-index: 8011;
		border-radius: 5px;
		.modal-body {
			width: 100%;
			aspect-ratio: 1;
			img.lazyload {
				opacity: 0;
				background:transparent !important;
				&.loaded {
					opacity: 1;
					background:transparent;
				}
			}
		}
		@media(max-width: 767px) {
			width: calc(100% - 40px);
			max-width: 480px;
		}
		.modalbanner-close{
			background-color: #5a5a5a;
			border: 3px solid #fff;
			border-radius: 50%;
			height: 30px;
			width: 30px;
			position: absolute;
			text-align: center;
			top: 0;
			right: 0;
			color: #fff;
			opacity: 1;
			font-weight: normal;
			text-shadow: none;
			padding: 0;
			display: flex;
			justify-content: center;
			align-items: center;
			float: none;
			svg {
				width: 20px;
				height: 20px;
			}
		}
	}
	.modalbanner-overlay {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 1040;
		width: 100vw;
		height: 100vh;
		background-color: #000;
		opacity: .5;
	}

}
{% endif %}
