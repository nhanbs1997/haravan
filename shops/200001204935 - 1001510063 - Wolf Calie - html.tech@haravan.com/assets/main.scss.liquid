		.col-menu {
			.title_menu { 
				display: none;
			}
			#nav {
				position: static;
				display: flex;
				justify-content: space-between;
				flex-wrap: nowrap;
				overflow: visible;
				.nav-item{ 
					float: none;		
					position: static;
					display: inline-block;
					@media (min-width: 992px) {
						&.has-mega{
							@media (min-width: 992px) {
								position: static;
								.mega-content {
									background: #fff none repeat scroll 0 0;
									display: block;
									opacity: 0;
									margin: 0;
									visibility: hidden;
									padding: 10px 15px 10px 10px;
									border-bottom-left-radius: 8px; 
									border-bottom-right-radius: 8px; 
									position: absolute;
									top: calc(100% + 10px);
									left: 0;
									z-index: 999;
									width: 100%;
									transition: all 0.2s ease-in-out;
									-webkit-box-shadow: 0px 2px 6px 0px rgba(50, 50, 50, 0.33);
									-moz-box-shadow: 0px 2px 6px 0px rgba(50, 50, 50, 0.33);
									box-shadow: 0px 2px 6px 0px rgba(50, 50, 50, 0.33);
									.mega-menu-list {
										overflow: hidden;
										max-height: 450px;
										overflow-y: auto;
										&::-webkit-scrollbar-track {
											-webkit-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
											-moz-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
											border-radius: 5px;
											background-color: #F5F5F5;
										}
										&::-webkit-scrollbar {
											width: 5px;
											background-color: #F5F5F5;
										}
										&::-webkit-scrollbar-thumb {
											border-radius:5px;
											-webkit-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
											-moz-box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.3);
											background-color: $main-color;
										}
										.level0{
											display: -ms-flexbox;
											display: -webkit-flex;
											display: flex;
											-webkit-flex-wrap: wrap;
											-ms-flex-wrap: wrap;
											flex-wrap: wrap;
										}
										.level1.item {
											float: left;
											width: 25%;
											padding: 10px;
											display: block;
											&>a{
												color: #000 !important;
												font-weight: 600;
												margin-bottom: 10px;
												text-transform: uppercase;
												display:block;
												line-height: normal;
												width: 100%;
												padding-bottom: 5px;
												&:hover, &:focus{
													text-decoration: underline;
												}
											}
											h2{
												font-size: 14px;
												margin-top: 0;
											}
											ul{
												&.level1{
													margin-bottom: 0px;
													li.level2{
														line-height: normal;
														margin-bottom: 5px;
														a{
															font-weight: normal !important;
															text-transform: none;
															color: #555;
															&:hover, &:focus{
																text-decoration: underline;
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
						&:hover, &:focus{
							background-color: transparent;
						}
						>a{
							color: #fff;
							font-size: 1.6rem;
							padding: 7px 15px;
							display: inline-block;
							text-align: center;
							position: relative;
							font-weight: 600;
							top: 1px;
							white-space: nowrap;
							&:before {
								content: "";
								height: 2px;
								width: 0px;
								position: absolute;
								bottom: 3px;
								left: 50%;
								transform: translateX(-50%);
								background: #fff;
								transition: all 200ms linear 0s;

							}
							&:hover, &:focus{
								&:before {
									width: 30px;
								}
							}
							@media(max-width: 1024px){
								padding: 7px;
							}
							svg{
								width: 5px;
								margin-left: 5px;
								transform: rotate(90deg);
								transition: all .4s;
								overflow: hidden;
								vertical-align: middle;
								margin-left: 3px;
								margin-bottom: 5px;
								path{
									stroke: #fff;
								}
							}
						}
						&.has-childs{
							&>a{
								&:after {
									content: "";
									width: 0px;
									height: 35px;
									border-style: solid;
									border-width: 0px 11px 12px;
									border-color: transparent transparent #FFF;
									display: inline-block;
									position: absolute;
									bottom: -24px;
									left: 0;
									right: 0px;
									margin: auto;
									opacity: 0;
									transition: opacity 300ms linear 0s;
								}
							}

							&:hover{
								>.dropdown-menu{
									opacity: 1;
									visibility: visible;
									top: 100%;
									margin-top: 0px;
									display: block;
								}
								>.mega-content{
									visibility: visible;
									opacity: 1;
									top: 100%;
									@media(min-width: 1025px){
										opacity: 1;
										filter: alpha(opacity=100);
										visibility: visible;
										-moz-transition: .3s ease-in;
										-o-transition: .3s ease-in;
										-webkit-transition: .3s ease-in;
										-ms-transition: .3s ease-in;
										transition: .3s ease-in;
										-moz-transform: translateY(0px);
										-o-transform: translateY(0px);
										-ms-transform: translateY(0px);
										-webkit-transform: translateY(0px);
										transform: translateY(0px);
									}
								}
							}

						}
						.nav-item-lv2 {
							padding: 0 10px;
						}
						.nav-item-lv3:not(.level2) {
							padding: 0 10px;
						}
						li.dropdown-submenu {
							position: relative;
							.dropdown-menu{
								left: -100%;
								top: 0;
							}
						}
						&.active{
							&:after {
								transform: scaleX(1) !important;
							}
							>a{
								&:before {
									width: 30px;
								}
							}
						}
						ul{
							&.dropdown-menu:not(.level1){
								-webkit-box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15%);
								box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15%);
								background: #ffffff;
								position: absolute;
								border: none;
								top: calc(100% + 10px);
								left: auto;
								width: 250px;
								z-index: 1030;
								display: block;
								opacity: 0;
								visibility: hidden;
								border-radius: 0;
								-webkit-transition: all 0.2s ease-in-out;
								transition: all 0.2s ease-in-out;
								padding: 0px;

								li{
									padding: 0;
									border-bottom: 1px solid #ebebeb;
									&+li{
										@media(max-width: 991px){
											margin-top: 0;
											border-top: 1px solid #f5f5f5;
										}
									}
									&:hover, &:focus{
										>a {
											text-decoration: underline;
											svg {
												transform: translateX(2px) !important;
											}
										}
									}
									a{
										padding: 7px 15px 7px 10px;
										line-height: 25px;
										position: relative;
										padding-right: 20px;
										-moz-transition: all 0.2s;
										-o-transition: all 0.2s;
										-webkit-transition: all 0.2s;
										transition: all 0.2s;
										color: #222;
										font-size: 1.6rem;
										display: block;
										i{
											float: right;
										}
									}
									&.dropdown-submenu{
										.dropdown-menu{
											top: 0;
											left: 100%;
											@media(max-width: 991px){
												left: 0;
												.nav-item-lv3{
													a{
														padding-left: 35px;
													}
												}
											}
										}
										>a{
											svg{
												height: 9px;
												position: absolute;
												right: 6px;
												top: calc(50% - 4px);
												transition: all .4s;
												path {
													stroke: #222;
												}
												@media(max-width: 991px){
													height: 20px;
													position: absolute;
													top: 50%;
													transform: translate(0, -50%);
													right: 10px;
													margin-right: 0;
													float: right;
													line-height: 22px;
													width: 20px;
													text-align: center;
												}
											}
											&:hover{
												svg{
													path{
														fill: $main-color;
													}
												}
											}
										}
										&:hover{
											.dropdown-menu{
												opacity: 1;
												visibility: visible;
												top: 0;
												margin-top: 0;
											}
										}
									}
								}
							}
						}
						&.hover-left {
							ul{
								&.dropdown-menu{
									right: 0;
									left: initial;
									@media(min-width: 1023px) and (max-width: 1024px){
										right: 0px;
										left: initial;
									}
									li{
										padding: 0;
										text-align: right;
										&:hover, &:focus{
											>a {
												svg {
													transform: rotate(-180deg) translateX(3px) !important;
												}
											}
										}
										a {
											padding: 7px 10px 7px 15px;
											svg {
												left: 6px;
												right: initial;
												-webkit-transform: rotate(-180deg) !important;
												-moz-transform: rotate(-180deg) !important;
												-ms-transform: rotate(-180deg)!important;
												-o-transform: rotate(-180deg) !important;
												transform: rotate(-180deg) !important;
											}
											&::after {
												right: 0px;
												left: initial !important;
											}
										}
										&.dropdown-submenu{
											.dropdown-menu{
												top: 0;
												right: 100%;
												left: initial !important;
											}
										}
									}
								}
							}
						}
					}

				}
			}
		}
	}
	@media (max-width: 991px) {
		.main-header {
