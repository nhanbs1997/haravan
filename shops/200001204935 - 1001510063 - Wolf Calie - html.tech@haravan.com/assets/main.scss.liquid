				img {
					width: auto;
					max-height: 100%;
					position: absolute;
					top: 0;
					bottom: 0;
					left: 0;
					right: 0;
					margin: auto;
					object-fit: contain;
				}
			}
			.tick-tag {
				display: flex;
				flex-flow: column;
				left: -10px;
				justify-content: end;
				flex-wrap: wrap;
				position: absolute;
				bottom: 0;
				left: -10px;
				gap: 4px;
