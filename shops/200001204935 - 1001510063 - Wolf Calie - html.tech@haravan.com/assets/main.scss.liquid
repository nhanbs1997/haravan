					text-decoration: none;
					font-size: 0px;
					img {
						width: 20px;
						height: 20px;
					}
					&:hover {
						@media (min-width: 1200px) {
							background: $main-color;
							img:not(.img-unlike) {
								filter: invert(1);
							}
							&:before {
								content: attr(title);
								position: absolute;
								top: 50%;
								right: calc(100% + 10px);
								padding: 3px 7px;
								background: #666;
								color: #fff;
								border-radius: 5px;
								font-size: 1.3rem;
								white-space: nowrap;
								display: inline-block;
								line-height: initial;
								transform: translate(0 ,-50%);
							}
							&:after {
								display: block;
								position: absolute;
								border: 10px solid transparent;
								border-left-color: #666;
								content: "";
								top: 50%;
								right: calc(100% - 6px);
								transform: translate(0 ,-50%);
