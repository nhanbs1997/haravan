				content: "";
				top: 50%;
				right: calc(100% - 6px);
				transform: translate(0 ,-50%);
			}
		}
	}
}
.content-page  {
	min-height:400px;
	ul, ol {
		padding-left:20px;
	}
}
.wd-icon:before {
	content: "\f180";
}

