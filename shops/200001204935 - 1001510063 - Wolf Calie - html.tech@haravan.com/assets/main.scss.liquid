/*Product loop gird main*/
.item_product_main {
	display: block;
	height: 100%;
	padding-bottom: 20px;
	position: relative;
	.product-action {
		background: #fff;
		border-radius: 10px;
		padding: 10px;
		height: 100%;
		overflow: hidden;
		box-shadow: 0px 0px 6px 0px rgba(50, 50, 93, 0.15), 1px 1px 5px rgba(0, 0, 0, 0.05);
